+# ── Risk Reduction ladder outputs (Trade Management → Risk Reduction) ──────────
+# Read-only views over outputs/risk_reduction_ladder/<ladder>/ produced by
+# scripts/risk_reduction_ladder.py (ladder_matrix.json + changed_trades/*.csv +
+# ladder_state.json). The sidecar never launches the sweep — runs are started
+# explicitly via the runner CLI (or /runs one config at a time).
+RISK_REDUCTION_LADDER_DIR = BACKTESTER_ROOT / "outputs" / "risk_reduction_ladder"
+_LADDER_NAME_RE = re.compile(r"^[A-Za-z0-9._-]+$")
+
+
+def _ladder_dir(name: str) -> Path:
+    if not _LADDER_NAME_RE.match(name or ""):
+        raise HTTPException(status_code=400, detail="invalid ladder name")
+    target = (RISK_REDUCTION_LADDER_DIR / name).resolve()
+    if RISK_REDUCTION_LADDER_DIR.resolve() not in target.parents:
+        raise HTTPException(status_code=400, detail="invalid ladder path")
+    if not target.is_dir():
+        raise HTTPException(status_code=404, detail="ladder not found")
+    return target
+
+
+@app.get("/risk-reduction/ladders")
+def list_risk_reduction_ladders() -> dict[str, Any]:
+    """Every ladder output dir with progress + matrix availability."""
+    ladders: list[dict[str, Any]] = []
+    if RISK_REDUCTION_LADDER_DIR.is_dir():
+        for folder in sorted(RISK_REDUCTION_LADDER_DIR.iterdir()):
+            if not folder.is_dir():
+                continue
+            state = read_json_file(folder / "ladder_state.json") or {}
+            runs = state.get("runs") or {}
+            completed = sum(1 for v in runs.values() if v.get("status") == "completed")
+            ladders.append({
+                "name": folder.name,
+                "has_matrix": (folder / "ladder_matrix.json").is_file(),
+                "runs_total": len(runs),
+                "runs_completed": completed,
+                "modified_at": datetime.fromtimestamp(folder.stat().st_mtime, tz=timezone.utc).isoformat(),
+            })
+    return {"ladders": ladders}
+
+
+@app.get("/risk-reduction/ladders/{name}")
+def get_risk_reduction_ladder(name: str) -> dict[str, Any]:
+    folder = _ladder_dir(name)
+    matrix = read_json_file(folder / "ladder_matrix.json")
+    if matrix is None:
+        raise HTTPException(status_code=404, detail="ladder_matrix.json not found (aggregate the ladder first)")
+    return {"name": name, "matrix": matrix, "state": read_json_file(folder / "ladder_state.json")}
+
+
+class LadderFilterRequest(BaseModel):
+    sessions: list[str] | None = None
+    directions: list[str] | None = None
+    structures: list[str] | None = None
+    states: list[str] | None = None
+    date_from: str | None = None
+    date_to: str | None = None
+
+
+@app.post("/risk-reduction/ladders/{name}/recompute")
+def recompute_risk_reduction_ladder(name: str, req: LadderFilterRequest) -> dict[str, Any]:
+    """Re-aggregate the ladder over a filtered trade population (spec §8).
+    Read-only over stored run CSVs; identical predicate on control and cells."""
+    folder = _ladder_dir(name)
+    if str(BACKTESTER_ROOT) not in sys.path:
+        sys.path.insert(0, str(BACKTESTER_ROOT))
+    from scripts.risk_reduction_ladder import recompute_matrix
+    filters = {k: v for k, v in req.dict().items() if v}
+    try:
+        return {"name": name, "matrix": recompute_matrix(folder, filters)}
+    except Exception as exc:
+        raise HTTPException(status_code=500, detail=f"recompute failed: {exc}")
+
+
+@app.get("/risk-reduction/ladders/{name}/changed/{cell_key}")
+def get_risk_reduction_changed_trades(name: str, cell_key: str) -> dict[str, Any]:
+    """Changed-trade table for one cell (drill-down)."""
+    folder = _ladder_dir(name)
+    if not _LADDER_NAME_RE.match(cell_key or ""):
+        raise HTTPException(status_code=400, detail="invalid cell key")
+    target = folder / "changed_trades" / f"{cell_key}.csv"
+    if not target.is_file():
+        raise HTTPException(status_code=404, detail="changed-trades file not found")
+    with target.open("r", encoding="utf-8", newline="") as handle:
+        rows = list(csv.DictReader(handle))
+    return {"name": name, "cell_key": cell_key, "rows": rows}
