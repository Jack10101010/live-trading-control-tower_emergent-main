+def news_coverage_stamp(config, news_events):
+    """News-calendar coverage provenance (Research-Integrity Audit P1-4 / gate H).
+
+    Records run window vs calendar window and any UNCOVERED periods — trades in an
+    uncovered period ran with NO news blackout/flatten protection even when news
+    handling was enabled (e.g. the 2020+ master calendar vs a 2015 run start).
+    Pure dict builder; callers merge it into the summary as `news_coverage`.
+    `news_events` may be a list of event dicts (each with a 'time'/'window_start')
+    or None. Never raises — a stamp must not fail a run.
+    """
+    try:
+        start = str(getattr(config, "start_date", "") or "")
+        end = str(getattr(config, "end_date", "") or "")
+        enabled = bool(getattr(config, "news_blackout_enabled", False)
+                       or getattr(config, "news_flatten_active_trades", False))
+        times = []
+        for e in (news_events or []):
+            t = e.get("time") if isinstance(e, dict) else None
+            if t is None and isinstance(e, dict):
+                t = e.get("window_start")
+            if t is not None:
+                times.append(str(t)[:10])
+        cal_start = min(times) if times else None
+        cal_end = max(times) if times else None
+        uncovered = []
+        if enabled and start and end:
+            if cal_start is None:
+                uncovered.append({"start": start, "end": end})
+            else:
+                if cal_start > start:
+                    uncovered.append({"start": start, "end": min(cal_start, end)})
+                if cal_end < end:
+                    uncovered.append({"start": max(cal_end, start), "end": end})
+        return {
+            "run_start": start, "run_end": end,
+            "news_enabled": enabled,
+            "news_file": str(getattr(config, "news_file", "") or ""),
+            "calendar_start": cal_start, "calendar_end": cal_end,
+            "uncovered_periods": uncovered,
+            "fully_covered": (not enabled) or not uncovered,
+        }
+    except Exception:  # pragma: no cover — provenance must never break a run
+        return {"error": "news_coverage_stamp_failed"}
+
+
 def save_summary(summary_dict, output_dir):
     with (output_dir / "summary.json").open("w", encoding="utf-8") as file:
         json.dump(summary_dict, file, indent=2)
