+    stop_r = getattr(config, "risk_reduction_stop_r", None)
+    mode = str(getattr(config, "risk_reduction_mode", "single_step") or "single_step")
+    if mode != "single_step":
+        raise ValueError(f"risk_reduction_mode={mode!r} not supported (only 'single_step' executes in v1)")
+    if not isinstance(trigger_r, (int, float)) or isinstance(trigger_r, bool) or float(trigger_r) <= 0:
