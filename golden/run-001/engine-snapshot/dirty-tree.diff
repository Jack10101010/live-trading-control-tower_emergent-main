+def validate_risk_reduction_config(config):
+    """Fail fast on an inconsistent standalone risk-reduction config (single_step v1).
+
+    Enabled requires: numeric trigger_r > 0, numeric stop_r with stop_r < trigger_r
+    (a stop at/above the trigger would exit instantly on arm), and mode
+    "single_step" (multi-step is schema-reserved, not executed). Disabled configs
