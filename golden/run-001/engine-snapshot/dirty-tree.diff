+class TargetPolicyRequest(BaseModel):
+    policy: dict[str, Any] = Field(default_factory=dict)
+    # Optimistic concurrency: the etag the client last read. When present and it no
+    # longer matches the on-disk file, the write is refused (409) — someone/something
+    # changed the file after the client loaded it. Absent/None ⇒ create-or-blind-write.
+    expected_etag: str | None = None
+
+
+@app.get("/target-policies")
+def list_target_policies() -> dict[str, Any]:
+    """List every saved Execution Policy (built-in + user). Read-only; always 200.
+    Each item carries its `etag` so the client can detect stale writes later."""
+    policies: list[dict[str, Any]] = []
+    if TARGET_POLICIES_DIR.is_dir():
+        for f in sorted(TARGET_POLICIES_DIR.glob("*.json")):
+            doc = read_json_file(f)
+            if isinstance(doc, dict) and doc.get("id"):
+                doc["readOnly"] = bool(doc.get("readOnly")) or _is_builtin_policy_id(doc.get("id"))
+                doc["etag"] = _policy_etag(f)
+                policies.append(doc)
+    return {"policies": policies}
+
+
+@app.get("/target-policies/{policy_id}")
+def get_target_policy(policy_id: str) -> dict[str, Any]:
+    target = _policy_path(policy_id)
+    doc = read_json_file(target)
+    if doc is None:
+        raise HTTPException(status_code=404, detail="policy not found")
+    doc["readOnly"] = bool(doc.get("readOnly")) or _is_builtin_policy_id(policy_id)
+    return {"policy": doc, "etag": _policy_etag(target)}
+
+
+@app.put("/target-policies/{policy_id}")
+def put_target_policy(policy_id: str, req: TargetPolicyRequest) -> dict[str, Any]:
+    """Create/overwrite a user policy file (atomic). Built-in ids refused (immutable).
+    Enforces optimistic concurrency via expected_etag → 409 on a stale write."""
+    if _is_builtin_policy_id(policy_id):
+        raise HTTPException(status_code=403, detail="built-in policies are read-only")
+    target = _policy_path(policy_id)
+    policy = req.policy if isinstance(req.policy, dict) else {}
+    if policy.get("id") != policy_id:
+        raise HTTPException(status_code=400, detail="policy.id must match the URL id")
+    if not isinstance(policy.get("body"), dict) or not str(policy.get("name") or "").strip():
+        raise HTTPException(status_code=400, detail="policy requires a name and a body")
+    if policy.get("schema_version") not in (1, 2):
+        raise HTTPException(status_code=400, detail="unsupported schema_version")
+    # Stale-write detection: if the client passed an etag, it must still match on disk.
+    current_etag = _policy_etag(target)
+    if req.expected_etag is not None and current_etag is not None and req.expected_etag != current_etag:
+        raise HTTPException(status_code=409, detail={
+            "error": "stale_write",
+            "message": "This policy changed on disk after you loaded it. Reload before saving.",
+            "current_etag": current_etag,
+        })
+    blob = json.dumps(policy, indent=2) + "\n"
+    if len(blob.encode("utf-8")) > MAX_POLICY_BYTES:
+        raise HTTPException(status_code=413, detail="policy too large")
+    _atomic_write_json(target, policy)
+    return {"ok": True, "id": policy_id, "etag": _policy_etag(target)}
+
+
+@app.delete("/target-policies/{policy_id}")
+def delete_target_policy(policy_id: str) -> dict[str, Any]:
+    if _is_builtin_policy_id(policy_id):
+        raise HTTPException(status_code=403, detail="built-in policies cannot be deleted")
+    target = _policy_path(policy_id)
+    if not target.is_file():
+        raise HTTPException(status_code=404, detail="policy not found")
+    try:
+        target.unlink()
+    except OSError as exc:
+        raise HTTPException(status_code=500, detail=f"could not delete: {exc}")
+    return {"ok": True, "id": policy_id}
