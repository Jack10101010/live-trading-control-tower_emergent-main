+# ── Target Policy library (repo file-backed) ────────────────────────────────────
+# Saveable/versioned Trade-Policy presets live as JSON files under
+# configs/target_policies/. Built-in policies (ids prefixed "builtin_") ship in the
+# repo and are READ-ONLY: PUT/DELETE against them is refused. This is a local-only
+# convenience store; it never runs anything and touches only that one directory.
+TARGET_POLICIES_DIR = BACKTESTER_ROOT / "configs" / "target_policies"
+# A policy id is a safe slug — this guards the path component (no traversal, no dots).
+_POLICY_ID_RE = re.compile(r"^[A-Za-z0-9_\-]{1,80}$")
+MAX_POLICY_BYTES = 256 * 1024
+
+
+def _policy_path(policy_id: str) -> Path:
+    if not _POLICY_ID_RE.match(policy_id or ""):
+        raise HTTPException(status_code=400, detail="invalid policy id")
+    target = (TARGET_POLICIES_DIR / f"{policy_id}.json").resolve()
+    # Defense in depth: ensure the resolved path stays inside the policies dir.
+    if TARGET_POLICIES_DIR.resolve() not in target.parents:
+        raise HTTPException(status_code=400, detail="invalid policy path")
+    return target
+
+
+def _is_builtin_policy_id(policy_id: str) -> bool:
+    return str(policy_id or "").startswith("builtin_")
+
+
+def _policy_etag(path: Path) -> str | None:
+    """Content etag (sha256 of the exact file bytes) for optimistic-concurrency /
+    stale-write detection. None when the file does not exist."""
+    if not path.is_file():
+        return None
+    try:
+        import hashlib
+        return hashlib.sha256(path.read_bytes()).hexdigest()[:16]
+    except OSError:
+        return None
+
+
+def _atomic_write_json(path: Path, data: dict[str, Any]) -> None:
+    """Write via a temp file + os.replace so a reader never sees a partial file."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_suffix(path.suffix + f".tmp-{uuid.uuid4().hex[:8]}")
+    tmp.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
+    os.replace(tmp, path)
