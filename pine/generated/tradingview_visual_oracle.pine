i_debug         = input.bool(false, "Debug mode",                   group = grpDebug)
i_showParsed    = input.bool(false, "Plot parsed high/low (S2)",
     tooltip = "Debug only. Parsed prices feed the ORDER-BLOCK BOX (Stage S5); " +
               "they do not feed swings or breaks, which read raw prices.",
     group = grpDebug)
i_showDayRoll   = input.bool(false, "Mark UTC day rollover",        group = grpDebug)

// RETENTION, and why the default is high.
//
// Pine hard-limits labels to `max_labels_count` (500, set in the indicator
// declaration). Beyond that the ENGINE evicts them, unpredictably. This script
// therefore evicts its own oldest label once the cap is reached, so the eviction
// is deterministic and ours.
//
// The first release defaulted this to 200. At roughly six session transitions a
// day that retained only ~33 days, so panning back through history showed NO
// markers at all — which reads as "the labels aren't anchored to the bars". They
// always were (`label.new(bar_index, …)`); there simply weren't any left to see.
// The default is now close to Pine's ceiling, and the debug panel reports how
// many are retained and the timestamp of the oldest, so the horizon is visible
// rather than surprising.
i_maxObjects    = input.int(450,    "Max retained markers", minval = 10, maxval = 480,
     tooltip = "Oldest markers are dropped beyond this. Pine's hard ceiling is 500; " +
               "at ~6 session transitions per day, 450 retains roughly 75 days. " +
               "Markers older than that are GONE, not misplaced — see limitation L-08.",
     group = grpDebug)

// ── shared chrome palette ────────────────────────────────────────────────────
// Defined HERE, in the first hand-written fragment, because both the legend (70)
// and the HUD (99) use it and Pine resolves top-to-bottom — declaring it in 99
// would be a forward reference from 70 and would not compile.
//
// Near-opaque on purpose: the first on-chart build used 75% TRANSPARENT panels,
// so candles bled through and the text was unreadable over price.
BG_HUD  = color.new(#0E1117, 8)
BG_WARN = color.new(#B00020, 5)
BG_STAT = color.new(#E08000, 10)
BG_HEAD = color.new(#1A2340, 5)

f_textSize() =>
    i_hudSize == "Normal" ? size.normal : i_hudSize == "Small" ? size.small : size.tiny

f_hudPosition() =>
    i_hudPos == "Top left"      ? position.top_left :
     i_hudPos == "Bottom right" ? position.bottom_right :
     i_hudPos == "Bottom left"  ? position.bottom_left :
     i_hudPos == "Middle right" ? position.middle_right :
     position.top_right

// ── packed-transport helper ─────────────────────────────────────────────────
// One field of a packed plot: apply the generated OFFSET, then CLAMP into the
// generated WIDTH.
//
// The clamp is the safety property. Pine has no range check, so a field that
// overflowed its radix would silently carry into its neighbour and BOTH sides
// would decode plausible-looking wrong values — the one failure mode a packed
// transport must not have. Clamping instead produces a packed integer that
// cannot equal Python's (whose `pack` raises outright on the same input), so the
// comparator reports a mismatch on that bar. A wrong number that is loudly wrong
// beats a wrong number that reads as agreement.
//
// `na` maps to 0 BEFORE the offset, which is why every optional field is
// specified with offset 1 — its absence gets code 0 and its smallest real value
// gets 1, rather than a blank cell whose meaning depends on the reader.
f_packv(float v, int width, int offset) =>
    x = (na(v) ? -offset : v) + offset
    x < 0 ? 0 : x > width - 1 ? width - 1 : x

// ── S5 order-block palette ──────────────────────────────────────────────────
// Deliberately distinct from the session palette: an order block is a level, not
// a time window, and the two must not be confusable at a glance.
COL_OB_BULL = #2E86DE
COL_OB_BEAR = #E67E22

// ─────────────────────────────────────────────────────────────────────────────
// 20 — DATA CONTEXT GUARD
//
// The oracle is generated for ONE symbol and a fixed set of timeframes. On any
// other chart it must say so loudly rather than reinterpret the data.
//
// Timeframe rule, and why it is not arbitrary: production assigns a session from
// the UTC HOUR of the bar-open timestamp over windows [start, end). A bar may
// therefore only be assigned one session if it cannot span an hour boundary —
// i.e. only when the timeframe divides 60. Measured against the production
// schedule: M1/M5/M15/H1 never straddle; H4 straddles 4 bars a day. So H4+ is
// refused even though the engine would happily accept the candles.
//
// Symbol matching is by NORMALISED ticker: feeds decorate the same instrument
// (EURUSD, EURUSD.a, FX:EURUSD, EURUSD_OTC …), and refusing all of them would
// make the oracle unusable on the very feed it is meant to be checked against.
// The accepted alias list is GENERATED from the contract, never hand-typed here.
// ─────────────────────────────────────────────────────────────────────────────

// Normalise: uppercase, strip the exchange prefix, drop separators/suffix noise.
f_normTicker(string raw) =>
    string s = str.upper(raw)
    int    c = str.pos(s, ":")
    s := na(c) ? s : str.substring(s, c + 1)
    s := str.replace_all(s, ".", "")
    s := str.replace_all(s, "_", "")
    s := str.replace_all(s, "-", "")
    s

var string CTX_TICKER_RAW  = syminfo.ticker
var string CTX_TICKER_NORM = f_normTicker(syminfo.ticker)

f_symbolSupported() =>
    bool ok = false
    for i = 0 to array.size(ORACLE_SYMBOL_ALIASES) - 1
        if CTX_TICKER_NORM == array.get(ORACLE_SYMBOL_ALIASES, i)
            ok := true
    ok

f_timeframeSupported() =>
    int secs = timeframe.in_seconds()
    bool ok = false
    for i = 0 to array.size(ORACLE_TF_SECONDS) - 1
        if secs == array.get(ORACLE_TF_SECONDS, i)
            ok := true
    ok

var bool   CTX_SYMBOL_OK = f_symbolSupported()
var bool   CTX_TF_OK     = f_timeframeSupported()
var bool   CTX_OK        = CTX_SYMBOL_OK and CTX_TF_OK

// Ordered reasons — same ordering discipline as the Python trace's
// data_context.reasons, so the two can be compared position by position.
var string CTX_REASON =
     CTX_OK ? "" :
     (not CTX_SYMBOL_OK ? "symbol " + CTX_TICKER_RAW + " != " + ORACLE_SYMBOL : "") +
     (not CTX_SYMBOL_OK and not CTX_TF_OK ? " | " : "") +
     (not CTX_TF_OK ? "timeframe " + timeframe.period + " (" +
                      str.tostring(timeframe.in_seconds()) + "s) unsupported" : "")

var string CTX_STATUS = CTX_OK ? "SUPPORTED" : "UNSUPPORTED_DATA_CONTEXT"
var int    CTX_CODE   = CTX_OK ? CODE_CTX_SUPPORTED : CODE_CTX_UNSUPPORTED

// ─────────────────────────────────────────────────────────────────────────────
// 30 — CANONICAL TIME AND UTC DAY SEMANTICS
//
// Production timestamps are UTC end to end above the MT5 gateway
// (live/config.py TIME_BASE = "utc-v2"), stored as
// datetime64[us, UTC] after strategy_core.execution.prepare_candles_for_simulation,
// and every bar label is the bar OPEN (pandas resample is left-labelled,
// left-closed — verified by execution).
//
// Pine's `time` is likewise the bar-OPEN in UTC epoch milliseconds, so the two
// agree WITHOUT conversion. Everything below therefore passes "UTC" explicitly
// to the calendar functions; the chart's display timezone is irrelevant to the
// computation and must not leak into it.
//
// UTC DAY: production uses strategy_core.regime.utc_date_key — the UTC CALENDAR
// day. It does NOT use an exchange session day. This is limitation L-06, and it
// is why `timeframe.change("D")` and `request.security(..., "D", ...)` are
// forbidden here: on FX those follow a 17:00 New York session boundary and would
// roll the day at the wrong instant.
// ─────────────────────────────────────────────────────────────────────────────

// Bar-open, UTC. Identical quantity to the trace's `bar_epoch_ms`.
utcEpochMs = time

utcYear  = year(time,        "UTC")
utcMonth = month(time,       "UTC")
utcDom   = dayofmonth(time,  "UTC")
utcHour  = hour(time,        "UTC")
utcMin   = minute(time,      "UTC")

// Canonical day key, integer form: 2026-03-08 -> 20260308.
// Mirrors tools/oracle/session_codes.day_key_to_int so the Data Window value is
// directly comparable to the trace's day_key without arithmetic.
dayKey = utcYear * 10000 + utcMonth * 100 + utcDom

var int prevDayKey = na
dayTransition = na(prevDayKey) or dayKey != prevDayKey

// Bar completeness. Production only ever admits CLOSED bars — the bridge pulls
// closed M1 bars only (live/mt5_bridge.py). A forming bar has no production
// counterpart, so the oracle marks it and the comparator ignores it.
barClosed = barstate.isconfirmed

// ─────────────────────────────────────────────────────────────────────────────
// 40 — SESSION ASSIGNMENT
//
// Mirrors strategy_core/sessions.py::_session_for_hour EXACTLY:
//
//     for start, end, label, key in _SESSION_SCHEDULE:
//         if start <= hour < end:
//             return label, key
//     return _SESSION_OUTSIDE
//
// Load-bearing properties, all verified by execution against the pinned engine:
//   * the window test is  start <= hour  AND  hour < end   — inclusive start,
//     EXCLUSIVE end. 07:00 is London; 06:59 is Asia; 17:00 is Outside.
//   * the input is the UTC HOUR ONLY. No minute, no weekday, no DST, no
//     exchange calendar. sessions.py contains no tz_convert / tz_localize /
//     zoneinfo / pytz / astimezone call of any kind.
//   * FIRST match wins. The production windows do not overlap, but the
//     first-match rule is what the code does, so it is what is reproduced.
//   * anything unmatched falls back to Outside — a real session key, not "none".
//
// The schedule arrays are GENERATED from the contract (fragment 05). Editing
// them here would be a second authority, which the design forbids.
// ─────────────────────────────────────────────────────────────────────────────

// Index into the generated schedule, or -1 meaning "fallback".
f_sessionIndexForHour(int h) =>
    int found = -1
    for i = 0 to array.size(SESSION_START_HOUR) - 1
        if found == -1
            int s = array.get(SESSION_START_HOUR, i)
            int e = array.get(SESSION_END_HOUR, i)
            if s <= h and h < e          // [start, end) — exactly production
                found := i
    found

sessIdx = f_sessionIndexForHour(utcHour)

sessKey    = sessIdx == -1 ? SESSION_FALLBACK_KEY   : array.get(SESSION_KEY,   sessIdx)
sessLabel  = sessIdx == -1 ? SESSION_FALLBACK_LABEL : array.get(SESSION_LABEL, sessIdx)
sessCode   = sessIdx == -1 ? SESSION_FALLBACK_CODE  : array.get(SESSION_CODE,  sessIdx)
sessIsFall = sessIdx == -1
sessStartH = sessIdx == -1 ? na : array.get(SESSION_START_HOUR, sessIdx)
sessEndH   = sessIdx == -1 ? na : array.get(SESSION_END_HOUR,   sessIdx)

// ── transition detection ─────────────────────────────────────────────────────
// Mirrors the trace's session.transition / transition_reason. `gap_resync` marks
// a change across a data gap: the previous bar was more than one timeframe step
// earlier, so unobserved sessions may sit between the two — the change is real
// but the oracle cannot claim it saw the open.
var int    prevSessCode = na
var string prevSessKey  = na
var int    prevBarTime  = na
var int    barsSinceTransition = 0

tfMs      = timeframe.in_seconds() * 1000
isGap     = not na(prevBarTime) and (time - prevBarTime) > tfMs
isFirst   = na(prevSessCode)
changed   = not isFirst and sessCode != prevSessCode

sessTransition = isFirst or changed

sessTransitionReason =
     isFirst   ? "first_bar" :
     not changed ? "" :
     isGap     ? "gap_resync" :
     sessCode == SESSION_FALLBACK_CODE ? "session_close_to_fallback" :
     prevSessCode == SESSION_FALLBACK_CODE ? "fallback_to_session" :
     "session_open"

sessTransitionCode =
     sessTransitionReason == "session_open"              ? CODE_TR_SESSION_OPEN :
     sessTransitionReason == "session_close_to_fallback" ? CODE_TR_CLOSE_TO_FALLBACK :
     sessTransitionReason == "fallback_to_session"       ? CODE_TR_FALLBACK_TO_SESSION :
     sessTransitionReason == "first_bar"                 ? CODE_TR_FIRST_BAR :
     sessTransitionReason == "gap_resync"                ? CODE_TR_GAP_RESYNC :
     CODE_NONE

barsSinceTransition := sessTransition ? 0 : barsSinceTransition + 1

// A session OPEN is a transition into a real session; a session CLOSE is a
// transition out of one. Production has no explicit close event — the close of
// London IS the open of Lull — so "close" here means only the fall to Outside.
isSessionOpen  = sessTransition and not isFirst and not sessIsFall
isSessionClose = sessTransition and not isFirst and sessIsFall

// SNAPSHOT the previous-bar values BEFORE the state carry below overwrites them.
// Later fragments (visuals, HUD, parity plots) run after this one, so reading
// `prevSessKey` directly there would return the CURRENT bar's key — the values
// would look self-consistent and be silently wrong.
dispPrevSessKey  = prevSessKey
dispPrevSessCode = prevSessCode
dispPrevDayKey   = prevDayKey

// State carry — last thing this fragment does, so every read above and every
// snapshot here sees the PREVIOUS bar's value, matching the trace's prev_key
// semantics.
if barClosed or barstate.islast
    prevSessCode := sessCode
    prevSessKey  := sessKey
    prevBarTime  := time
    prevDayKey   := dayKey

// ─────────────────────────────────────────────────────────────────────────────
// 45 — STAGE S2: TRUE RANGE, SEEDED RMA, PARSED PRICES
//
// Mirrors strategy_core/order_blocks.py::_true_range, ::_pine_rma and
// ::_add_parsed_prices.
//
// `ta.atr` AND `ta.rma` ARE FORBIDDEN HERE, and this is measured, not stylistic.
// Production seeds its RMA with the FIRST value; Pine's builtins seed with an SMA
// of the first `length` values. Over the F-S2-RMASEED fixture (1818 comparable
// 15m bars) the two agree on ZERO bars, peak at 27.4% relative difference, and
// are still not equal at the final bar. Since the parsed-price flip is decided by
// `(H-L) >= 2*measure`, any bar near that threshold can flip the other way and
// move an order block. tools/oracle/lint_pine.py rejects the builtins outright.
//
// WHAT THIS FEEDS: parsed_high/parsed_low are consumed ONLY by
// `_make_order_block` — they set the order-block BOX (Stage S5). They do NOT feed
// the swing loop or the break test, both of which read RAW prices. So an S2
// divergence cannot move a swing or a BOS; it can only move an order block.
// ─────────────────────────────────────────────────────────────────────────────

// ── true range ───────────────────────────────────────────────────────────────
// Bar 0 has no previous close. Production builds three columns and takes a
// row-wise max; pandas SKIPS NaN, so bar 0 resolves to high-low rather than NaN.
s2_hl = high - low
s2_hc = barstate.isfirst ? na : math.abs(high - close[1])
s2_lc = barstate.isfirst ? na : math.abs(low  - close[1])
s2_tr = barstate.isfirst ? s2_hl : math.max(s2_hl, s2_hc, s2_lc)

// ── first-value-seeded RMA (NOT ta.rma) ──────────────────────────────────────
// previous = value            on the first bar
// previous = (previous*(n-1) + value) / n   thereafter
var float s2_atr      = na
var float s2_atr_prev = na
s2_atr_prev := s2_atr
s2_atr := na(s2_atr) ? s2_tr : (s2_atr * (ATR_PERIOD - 1) + s2_tr) / ATR_PERIOD

// ── cumulative mean range (the ob_filter != "Atr" branch) ────────────────────
// Divisor is max(index, 1), so index 0 AND index 1 both divide by 1 — a genuine
// production quirk, reproduced rather than tidied.
var float s2_tr_sum = 0.0
s2_tr_sum := s2_tr_sum + s2_tr
s2_cmr = s2_tr_sum / math.max(bar_index, 1)

s2_measure   = OB_FILTER == "Atr" ? s2_atr : s2_cmr
s2_threshold = VOL_MULTIPLE * s2_measure
s2_range     = high - low

// ── parsed prices ────────────────────────────────────────────────────────────
// `>=`, not `>`. On a high-volatility bar the high and low are SWAPPED, so
// parsed_high < parsed_low and the resulting OB box has negative depth. That is
// production behaviour; do not "correct" it.
s2_high_vol    = s2_range >= s2_threshold
s2_parsed_high = s2_high_vol ? low  : high
s2_parsed_low  = s2_high_vol ? high : low

// True until 200 bars have been seen. The seed only fully decays after that, and
// the whole series depends on where the loaded chart BEGINS (limitation L-03).
s2_atr_warm = bar_index + 1 < ATR_PERIOD

// ─────────────────────────────────────────────────────────────────────────────
// 50 — CHART VISUALS
//
// Shading is an OUTPUT of the canonical session calculation, never an input.
// Nothing here reads a TradingView session string; every colour is selected from
// `sessCode`, which came from the production algorithm in fragment 40.
//
// Object budget: Pine hard-limits boxes/labels/lines to 500 each. Markers are
// created only on TRANSITION bars (≤ 6 per UTC day), and `i_maxObjects` trims the
// oldest deterministically so eviction is ours, not the engine's — limitation
// L-08 in the register.
// ─────────────────────────────────────────────────────────────────────────────

// Session background, indexed straight out of the GENERATED palette so the
// shading and the legend (fragment 70) are the same list. A hand-written ternary
// here was the previous approach; it meant the legend could describe a colour the
// chart never painted, and adding a session upstream could silently reuse another
// session's colour. An unmapped code still renders deliberately loud.
sessShadeIdx = sessIsFall ? array.size(SESSION_SHADE) - 1 : sessIdx
sessColor = sessShadeIdx >= 0 and sessShadeIdx < array.size(SESSION_SHADE)
     ? array.get(SESSION_SHADE, sessShadeIdx)
     : color.new(color.red, 60)

bgcolor(i_shadeSessions and CTX_OK ? sessColor : na, title = "Session")

// ── transition markers ───────────────────────────────────────────────────────
// Markers ARE bar-anchored: `label.new(bar_index, …)` uses xloc.bar_index, so
// they move with the bars. What is NOT unlimited is how many are RETAINED —
// beyond `i_maxObjects` the oldest is deleted, so far enough back in history
// there are none left. That horizon is tracked here and reported in the debug
// panel, because the first release silently dropped everything older than ~33
// days and the empty history read as "the labels aren't anchored".
var array<label> oracleLabels = array.new<label>()

// NOTE: this function must not touch any global. Pine forbids it outright —
// "Cannot modify global variable ... in function" (CE10088) — which an earlier
// version of this fragment tripped by keeping drop counters here. The retention
// telemetry is therefore DERIVED from the array itself in the debug fragment,
// where no mutation is needed: `array.size()` gives what is kept, and the first
// element's x gives the oldest retained bar. Nothing has to be counted.
f_pushLabel(label lbl) =>
    array.push(oracleLabels, lbl)
    if array.size(oracleLabels) > i_maxObjects
        label.delete(array.shift(oracleLabels))

// Same deterministic retention for lines (S4 broken-level marks). Pine's ceiling
// for lines is separate from labels, so it gets its own buffer rather than
// sharing a budget and starving one of them.
var array<line> oracleLines = array.new<line>()

f_pushLine(line ln) =>
    array.push(oracleLines, ln)
    if array.size(oracleLines) > i_maxObjects
        line.delete(array.shift(oracleLines))

if CTX_OK and barClosed
    if i_showOpens and isSessionOpen
        f_pushLabel(label.new(bar_index, low, "▲ " + sessLabel,
             style = label.style_label_up, size = size.tiny,
             color = color.new(color.teal, 20), textcolor = color.white,
             tooltip = "session_open · code " + str.tostring(sessCode) +
                       " · UTC " + str.tostring(utcHour, "00") + ":" +
                       str.tostring(utcMin, "00")))

    if i_showCloses and isSessionClose
        f_pushLabel(label.new(bar_index, high, "▼ " + dispPrevSessKey + " → " + sessLabel,
             style = label.style_label_down, size = size.tiny,
             color = color.new(color.maroon, 20), textcolor = color.white,
             tooltip = "session_close_to_fallback · code " + str.tostring(sessCode)))

    if i_showTransLbl and sessTransition and not isSessionOpen and not isSessionClose
        f_pushLabel(label.new(bar_index, high, sessTransitionReason,
             style = label.style_label_down, size = size.tiny,
             color = color.new(color.gray, 30), textcolor = color.white))

    if i_showDayRoll and dayTransition
        f_pushLabel(label.new(bar_index, low, "UTC " + str.tostring(dayKey),
             style = label.style_label_up, size = size.tiny,
             color = color.new(color.navy, 20), textcolor = color.white,
             tooltip = "UTC calendar-day rollover (production utc_date_key)"))

// Unsupported context: one persistent, unmissable label. Drawn even when the
// HUD is switched off — a cosmetic input must not be able to hide this.
var label ctxLabel = na
if barstate.islast and not CTX_OK
    label.delete(ctxLabel)
    ctxLabel := label.new(bar_index, high,
         "⛔ UNSUPPORTED DATA CONTEXT\n" + CTX_REASON +
         "\nParity claims suppressed — this build mirrors " + ORACLE_SYMBOL +
         " on " + ORACLE_TF_LABEL,
         style = label.style_label_left, size = size.normal,
         color = color.new(color.red, 10), textcolor = color.white)

// ─────────────────────────────────────────────────────────────────────────────
// 55 — STAGE S3: LIVE-PATH SWING LOOP
//
// Mirrors the loop INLINED inside strategy_core/order_blocks.py::detect_order_blocks
// (lines 144-171). It does NOT mirror strategy_core/swings.py::detect_swings,
// which is DEAD on the live path — the golden pipeline never calls it. The two
// differ in what they retain: detect_swings records every pivot into columns;
// the live loop keeps only the MOST RECENT UNCROSSED swing per side.
//
// Production, verbatim:
//     for index in range(swing_length, len(candles)):
//         pivot_index = index - swing_length
//         right_highs = candles.loc[pivot_index+1 : index, "high"]   # INCLUSIVE
//         new_leg_high = candles.at[pivot_index,"high"] > right_highs.max()
//         new_leg_low  = candles.at[pivot_index,"low"]  < right_lows.min()
//         next_leg = BEARISH_LEG if new_leg_high else (BULLISH_LEG if new_leg_low else current)
//         leg_change = next_leg - current_leg
//         if leg_change == 1:  swing_low  = {...}
//         elif leg_change == -1: swing_high = {...}
//
// Load-bearing details:
//   * RAW high/low. Never parsed prices — those are Stage S5.
//   * `.loc[a:b]` is INCLUSIVE of b, so the right window is exactly
//     `swing_length` bars: offsets 0 … swing_length-1 from the current bar. That
//     is precisely what `ta.highest(high, SWING_LENGTH)` covers.
//   * STRICT `>` and `<`. A pivot equal to anything in its right window is NOT a
//     swing — equal highs produce nothing.
//   * `elif`, not a second `if`: if both fire on one bar, the HIGH wins.
//   * a swing is recorded ONLY on a leg TRANSITION, never on a repeat.
//   * cold start: current_leg = 0, and BEARISH_LEG is also 0, so the first
//     `new_leg_high` yields leg_change == 0 and records NOTHING, while the first
//     `new_leg_low` yields +1 and records a swing low. That asymmetry is real.
//   * confirmation lag is exactly swing_length bars: the pivot sits that far back.
// ─────────────────────────────────────────────────────────────────────────────

s3_ready = bar_index >= SWING_LENGTH

// Right window: offsets 0 … SWING_LENGTH-1 (current bar included) — the exact
// span of production's inclusive .loc slice.
s3_max_right_high = s3_ready ? ta.highest(high, SWING_LENGTH) : na
s3_min_right_low  = s3_ready ? ta.lowest(low,  SWING_LENGTH)  : na

s3_pivot_high = s3_ready ? high[SWING_LENGTH] : na
s3_pivot_low  = s3_ready ? low[SWING_LENGTH]  : na

s3_new_leg_high = s3_ready and s3_pivot_high > s3_max_right_high
s3_new_leg_low  = s3_ready and s3_pivot_low  < s3_min_right_low

var int s3_current_leg = 0
s3_next_leg = s3_new_leg_high ? LEG_BEARISH : s3_new_leg_low ? LEG_BULLISH : s3_current_leg
s3_leg_change = s3_ready ? s3_next_leg - s3_current_leg : 0

// The single most-recent uncrossed swing per side — production keeps one dict
// each, not a list.
var float s3_swing_high_level = na
var int   s3_swing_high_bar   = na
var bool  s3_swing_high_crossed = false
var int   s3_swing_high_seq   = 0

var float s3_swing_low_level  = na
var int   s3_swing_low_bar    = na
var bool  s3_swing_low_crossed = false
var int   s3_swing_low_seq    = 0

s3_created = 0          // 0 none · 1 swing_high · 2 swing_low

if s3_ready
    if s3_leg_change == 1
        s3_swing_low_level   := low[SWING_LENGTH]
        s3_swing_low_bar     := bar_index - SWING_LENGTH
        s3_swing_low_crossed := false
        s3_swing_low_seq     := s3_swing_low_seq + 1
        s3_created := 2
    else if s3_leg_change == -1
        s3_swing_high_level   := high[SWING_LENGTH]
        s3_swing_high_bar     := bar_index - SWING_LENGTH
        s3_swing_high_crossed := false
        s3_swing_high_seq     := s3_swing_high_seq + 1
        s3_created := 1
    s3_current_leg := s3_next_leg

// ─────────────────────────────────────────────────────────────────────────────
// 58 — STAGE S4: BOS / CHoCH / STRUCTURAL BIAS
//
// Mirrors strategy_core/order_blocks.py::detect_order_blocks lines 173-220.
//
//     previous_close = close[index-1]
//     current_close  = close[index]
//     if swing_high.level is not None and not swing_high.crossed:
//         bull_break = previous_close <= level and current_close > level
//         tag = CHOCH if swing_trend_bias == BEARISH else BOS
//         swing_high.crossed = True ; swing_trend_bias = BULLISH
//     if swing_low.level is not None and not swing_low.crossed:
//         bear_break = previous_close >= level and current_close < level
//         tag = CHOCH if swing_trend_bias == BULLISH else BOS
//         swing_low.crossed = True ; swing_trend_bias = BEARISH
//
// Load-bearing details:
//   * RAW CLOSES, two-bar test. Not a wick break, not parsed prices.
//   * asymmetric operators on purpose: `prev <= level` with `cur > level` for
//     bulls, `prev >= level` with `cur < level` for bears. A previous close
//     exactly AT the level still permits a break.
//   * `crossed` LATCHES — a swing can be broken exactly once.
//   * the two blocks are independent `if`s, so BOTH can fire on one bar. BULL is
//     evaluated FIRST, and the bear tag is then computed from the bias the bull
//     break just set. That ordering is part of the behaviour.
//   * BOS when the bias is 0 (initial) or already the same side; CHoCH ONLY when
//     flipping from the opposite bias. The FIRST break of a run is therefore
//     always BOS, because the bias starts at 0 which equals neither side.
//
// LIMITATION L-04 — THE CORRECTNESS CLIFF
// `swing_trend_bias` is NEVER reset and is seeded by the first break in LOADED
// history. Python loads from 2015; a TradingView chart loads whatever the plan
// allows. If the first break in the chart's window has the opposite side to the
// first break in Python's, every subsequent BOS/CHoCH tag can be inverted — not
// approximately, permanently. The HUD warns while the loaded window is too
// shallow to have converged; it cannot detect the inversion itself, because Pine
// has no access to what Python saw.
// ─────────────────────────────────────────────────────────────────────────────

s4_prev_close = close[1]
s4_cur_close  = close

var int s4_bias = 0            // 0 neutral · BIAS_BULLISH · BIAS_BEARISH
var int s4_bias_before = 0
var int s4_event_code  = 0     // CODE_EV_* for THIS bar (0 = none)
var int s4_event_count = 0
var float s4_broken_level = na
var int s4_last_event_bar = na
var int s4_last_event_code = 0
// Exposed for S5 (fragment 65). A break is what CREATES an order-block
// candidate, and the per-side code is needed because when BOTH fire on one bar
// `s4_event_code` ends up holding the bear one — labelling the bullish box from
// it would report the wrong tag.
var bool s4_bull_break = false
var bool s4_bear_break = false
var int  s4_bull_code  = 0
var int  s4_bear_code_out = 0

s4_event_code  := 0
s4_event_count := 0
s4_bull_break  := false
s4_bear_break  := false
s4_bias_before := s4_bias
s4_broken_level := na

s4_can_bull = s3_ready and not na(s3_swing_high_level) and not s3_swing_high_crossed
s4_can_bear = s3_ready and not na(s3_swing_low_level)  and not s3_swing_low_crossed

// ── bullish break — evaluated FIRST ──────────────────────────────────────────
if s4_can_bull and s4_prev_close <= s3_swing_high_level and s4_cur_close > s3_swing_high_level
    s4_event_code := s4_bias == BIAS_BEARISH ? CODE_EV_CHOCH_BULL : CODE_EV_BOS_BULL
    s4_broken_level := s3_swing_high_level
    s3_swing_high_crossed := true
    s4_bias := BIAS_BULLISH
    s4_event_count := s4_event_count + 1
    s4_last_event_bar  := bar_index
    s4_last_event_code := s4_event_code
    s4_bull_break := true
    s4_bull_code  := s4_event_code

// ── bearish break — tag uses the bias the bull break may have JUST set ───────
if s4_can_bear and s4_prev_close >= s3_swing_low_level and s4_cur_close < s3_swing_low_level
    s4_bear_code = s4_bias == BIAS_BULLISH ? CODE_EV_CHOCH_BEAR : CODE_EV_BOS_BEAR
    s4_broken_level := s3_swing_low_level
    s3_swing_low_crossed := true
    s4_bias := BIAS_BEARISH
    s4_event_count := s4_event_count + 1
    s4_last_event_bar  := bar_index
    s4_last_event_code := s4_bear_code
    s4_bear_break := true
    s4_bear_code_out := s4_bear_code
    // When both fired, the LAST event on the bar is the bear one; the plotted
    // code reports it, and s4_event_count == 2 marks the double.
    s4_event_code := s4_bear_code

// `s4_trend` was removed here in Wave 2b-i. It was
//     s4_bias == BIAS_BULLISH ? 1 : s4_bias == BIAS_BEARISH ? -1 : 0
// which is the IDENTITY on s4_bias, because the contract pins BULLISH = 1 and
// BEARISH = -1 (contract._engine_constants). Python compared both `oracleBias`
// and `oracleTrend` against the same `swing_trend_bias`, so the second plot cost
// one of 64 plot slots and could not fail unless the first did.

// ── loaded-history sufficiency ───────────────────────────────────────────────
// Not proof of correctness — only that the window is deep enough for the seed to
// be plausible. `s4_bias_seeded_at_bar` is the bar the bias first left 0, which
// is the value an operator compares against the Python trace.
var int s4_bias_seeded_at_bar = na
if na(s4_bias_seeded_at_bar) and s4_bias != 0
    s4_bias_seeded_at_bar := bar_index

s4_history_ok = bar_index >= (SWING_LENGTH + ATR_PERIOD)
s4_history_warn = not s4_history_ok or na(s4_bias_seeded_at_bar)

// ─────────────────────────────────────────────────────────────────────────────
// 59 — S2/S3/S4 VISUALS
//
// Event-driven only. Nothing is drawn on every bar, and every drawing goes
// through the shared retention buffer so the object budget stays deterministic
// (limitation L-08). S2 intermediates are debug-only: they are inputs to Stage
// S5, not structure a reader needs on the default chart.
// ─────────────────────────────────────────────────────────────────────────────

// ── S2 (debug only) ──────────────────────────────────────────────────────────
// The parsed high/low CROSSES were removed when the script hit TradingView's
// 64-plot ceiling (RE10140 at 82 plots, raised at RUNTIME on a live chart).
// Nothing verifiable was lost: the values are still exported as
// `oracleParsedHigh` / `oracleParsedLow` and still shown in the debug table —
// only the on-chart marker is gone, and a marker is not evidence.
//
// A flipped bar is where parsed_high < parsed_low. It cannot produce a tradeable
// candidate (risk <= 0), so it is worth seeing while debugging S5 prerequisites.
plotchar(i_debug and s2_high_vol, "volFlip", "◆", location.belowbar,
     color = color.new(color.orange, 20), size = size.tiny)

// ── S3: active uncrossed swing levels ────────────────────────────────────────
// Only ever TWO lines — production retains one swing per side, so drawing more
// would misrepresent the state. These are LINE OBJECTS rather than plots: a plot
// costs one of the 64 slots on every bar, while two lines cost none and are
// bounded by construction (created once, moved thereafter).
var line s3_hiLine = na
var line s3_loLine = na
if barstate.islast
    bool showHi = i_showSwings and not na(s3_swing_high_level)
         and not s3_swing_high_crossed
    bool showLo = i_showSwings and not na(s3_swing_low_level)
         and not s3_swing_low_crossed
    line.delete(s3_hiLine)
    line.delete(s3_loLine)
    if showHi
        s3_hiLine := line.new(math.max(bar_index - 300, 0), s3_swing_high_level,
             bar_index, s3_swing_high_level, color = color.new(#EF476F, 25),
             width = 1)
    if showLo
        s3_loLine := line.new(math.max(bar_index - 300, 0), s3_swing_low_level,
             bar_index, s3_swing_low_level, color = color.new(#06D6A0, 25),
             width = 1)

// Swing confirmation markers, drawn AT THE PIVOT BAR (swing_length back), which
// is where production records them — not at the bar that confirmed them.
if CTX_OK and barClosed and i_showSwingMarks and s3_created != 0
    f_pushLabel(label.new(bar_index - SWING_LENGTH,
         s3_created == 1 ? s3_swing_high_level : s3_swing_low_level,
         s3_created == 1 ? "SH" : "SL",
         style = s3_created == 1 ? label.style_label_down : label.style_label_up,
         size = size.tiny, textcolor = color.white,
         color = s3_created == 1 ? color.new(#EF476F, 25) : color.new(#06D6A0, 25),
         tooltip = "confirmed " + (s3_created == 1 ? "swing high" : "swing low") +
                   " · pivot bar " + str.tostring(bar_index - SWING_LENGTH) +
                   " · confirmed " + str.tostring(SWING_LENGTH) + " bars later" +
                   " · seq " + str.tostring(s3_created == 1 ? s3_swing_high_seq
                                                            : s3_swing_low_seq)))

// ── S4: structure events ─────────────────────────────────────────────────────
f_eventText(int c) =>
    c == CODE_EV_BOS_BULL   ? "BOS"   :
     c == CODE_EV_CHOCH_BULL ? "CHoCH" :
     c == CODE_EV_BOS_BEAR   ? "BOS"   :
     c == CODE_EV_CHOCH_BEAR ? "CHoCH" : ""

f_eventIsBull(int c) =>
    c == CODE_EV_BOS_BULL or c == CODE_EV_CHOCH_BULL

if CTX_OK and barClosed and i_showStructure and s4_event_code != 0
    bull = f_eventIsBull(s4_event_code)
    isChoch = s4_event_code == CODE_EV_CHOCH_BULL or s4_event_code == CODE_EV_CHOCH_BEAR
    f_pushLabel(label.new(bar_index, bull ? high : low,
         f_eventText(s4_event_code) + (s4_event_count > 1 ? " ×2" : ""),
         style = bull ? label.style_label_down : label.style_label_up,
         size = size.small, textcolor = color.white,
         color = isChoch ? color.new(#7B2CBF, 10) : color.new(#26547C, 10),
         tooltip = "code " + str.tostring(s4_event_code) +
                   " · broke " + str.tostring(s4_broken_level, format.mintick) +
                   " · bias " + str.tostring(s4_bias_before) + " -> " +
                   str.tostring(s4_bias) +
                   (s4_event_count > 1 ? "\nTWO events on this bar (bull first)" : "")))

    if i_showStructLines
        f_pushLine(line.new(bar_index - 1, s4_broken_level, bar_index, s4_broken_level,
             color = isChoch ? color.new(#7B2CBF, 30) : color.new(#26547C, 30),
             style = line.style_dashed, width = 1,
             extend = extend.none))

// ─────────────────────────────────────────────────────────────────────────────
// 65 — S5 · ORDER-BLOCK CREATION
//
// Mirrors `_make_order_block`, `_ob_width_pips` and `_passes_size_filter` in
// strategy_core/order_blocks.py. CREATION ONLY — production assigns no lifecycle
// state at creation, so mitigation / invalidation / expiry are NOT here.
//
// THE FOUR THINGS A "REASONABLE" IMPLEMENTATION GETS WRONG
//   1. The box is built from PARSED prices, not raw candle extremes. On a
//      high-volatility bar the parsed high/low are SWAPPED, so `top` can be
//      BELOW `bottom`. That inverted box is production behaviour and must not be
//      normalised.
//   2. The origin bar is the extreme parsed price over [pivot, break-1] with the
//      EARLIEST bar winning a tie. `ta.lowest` cannot express it: the window
//      starts at a pivot an unbounded number of bars back, so it is accumulated.
//   3. The size gate uses STRICT comparisons, making it INCLUSIVE at both ends —
//      a width of exactly `OB_MAX_PIPS` PASSES.
//   4. `ob_id` is assigned only on APPEND. A rejected block consumes no id, and
//      the next accepted block reuses the integer. But the swing is still burned
//      and the bias still flipped (in fragment 58, before this runs), so a
//      rejection is not a no-op.
//
// LIMITATION L-05: this counter starts at the first bar of LOADED history, while
// production's starts in 2015. The ids will NOT match. Match an order block on
// (detection_time, direction, top, bottom) instead.
// ─────────────────────────────────────────────────────────────────────────────

// ── origin accumulators ─────────────────────────────────────────────────────
// One per side, anchored at that side's swing PIVOT and folded forward one bar
// at a time. `s5_bull_*` tracks the minimum parsed_low (a bullish OB comes from
// a swing-HIGH break); `s5_bear_*` the maximum parsed_high.
//
// The window a break at bar b needs is [pivot, b-1] — the current bar is NOT in
// it — so each bar folds in `[1]`, the PREVIOUS bar, never `[0]`.
var float s5_bull_min = na
var int   s5_bull_idx = na
var float s5_bear_max = na
var int   s5_bear_idx = na

// Seed on the bar a swing is created: the pivot is SWING_LENGTH bars back, so
// the window [pivot, bar-1] is offsets SWING_LENGTH..1. Walked OLDEST FIRST with
// a strict comparison, so the earliest extreme wins a tie exactly as
// `search[search == search.min()].index[0]` does in production.
if s3_created == 1
    float m = na
    int mi = na
    for k = SWING_LENGTH to 1
        v = s2_parsed_low[k]
        if na(m) or v < m
            m := v
            mi := bar_index - k
    s5_bull_min := m
    s5_bull_idx := mi
else if not na(s5_bull_min)
    if s2_parsed_low[1] < s5_bull_min
        s5_bull_min := s2_parsed_low[1]
        s5_bull_idx := bar_index - 1

if s3_created == 2
    float m2 = na
    int mi2 = na
    for k = SWING_LENGTH to 1
        v = s2_parsed_high[k]
        if na(m2) or v > m2
            m2 := v
            mi2 := bar_index - k
    s5_bear_max := m2
    s5_bear_idx := mi2
else if not na(s5_bear_max)
    if s2_parsed_high[1] > s5_bear_max
        s5_bear_max := s2_parsed_high[1]
        s5_bear_idx := bar_index - 1

// ── this bar's candidates ───────────────────────────────────────────────────
var int   s5_next_ob_id     = 1
var int   s5_created_count  = 0
var int   s5_candidate_count = 0
var int   s5_last_ob_id     = na
var float s5_last_top       = na
var float s5_last_bottom    = na
var float s5_last_width     = na
var int   s5_last_reject    = 0     // 0 none · 1 size_filter · 2 empty_window
var int   s5_active_count   = 0
var int   s5_last_side      = 0     // 0 none · 1 bullish · 2 bearish
var int   s5_last_tag       = 0     // 0 none · 1 BOS · 2 CHoCH
var int   s5_last_origin_back = na  // bars from the break bar back to the origin
var int   s5_last_pivot_back  = na  // …and back to the swing pivot
var float s5_last_break_level = na
// A bounded, exactly-reproducible summary of the whole accepted inventory.
// Comparing box drawings is not evidence; comparing a running total of every
// accepted bound is. Integers scaled by 1e5 stay exact in a float64 well past
// the ~2,000 blocks eleven years of history produces.
var float s5_checksum       = 0.0

s5_candidate_count := 0
s5_created_count   := 0
s5_last_reject     := 0
s5_last_side       := 0
s5_last_tag        := 0

// Boxes are retained under the same budget as every other drawing object; the
// oldest is deleted rather than letting Pine silently drop the newest.
var box[] s5_boxes = array.new_box()
var label[] s5_obLabels = array.new_label()

// ── bullish candidate (evaluated FIRST, as in production) ───────────────────
// `s4_bull_break` / `s4_bear_break` are set in fragment 58, which has already
// burned the swing and flipped the bias by the time this runs.
if s4_bull_break
    s5_candidate_count := s5_candidate_count + 1
    if na(s5_bull_idx)
        s5_last_reject := 2
    else
        float t = s2_parsed_high[bar_index - s5_bull_idx]
        float b = s2_parsed_low[bar_index - s5_bull_idx]
        float w = math.abs(t - b) / OB_PIP_SIZE
        s5_last_top := t
        s5_last_bottom := b
        s5_last_width := w
        s5_last_side := 1
        s5_last_tag := s4_bull_code == CODE_EV_CHOCH_BULL ? 2 : 1
        s5_last_origin_back := bar_index - s5_bull_idx
        s5_last_pivot_back := bar_index - s3_swing_high_bar
        s5_last_break_level := s3_swing_high_level
        // STRICT both ways: exactly OB_MAX_PIPS passes.
        if w < OB_MIN_PIPS or w > OB_MAX_PIPS
            s5_last_reject := 1
            if i_debug
                f_pushLabel(label.new(bar_index, high, "OB REJECT " +
                     str.tostring(w, "#.#") + "p", style = label.style_label_down,
                     size = size.tiny, color = color.new(#EF476F, 20),
                     textcolor = color.white))
        else
            s5_last_ob_id := s5_next_ob_id
            s5_next_ob_id := s5_next_ob_id + 1
            s5_created_count := s5_created_count + 1
            s5_active_count := s5_active_count + 1
            s5_checksum := s5_checksum + math.round(t * 100000) +
                 math.round(b * 100000)
            if i_showOrderBlocks
                array.push(s5_boxes, box.new(s5_bull_idx, t, bar_index, b,
                     border_color = COL_OB_BULL, border_width = 1,
                     bgcolor = color.new(COL_OB_BULL, 85),
                     extend = extend.none))
                array.push(s5_obLabels, label.new(s5_bull_idx,
                     math.max(t, b), "OB#" + str.tostring(s5_last_ob_id) + " " +
                     (s4_bull_code == CODE_EV_CHOCH_BULL ? "CHoCH" : "BOS"),
                     style = label.style_label_down, size = size.tiny,
                     color = color.new(COL_OB_BULL, 30), textcolor = color.white))

// ── bearish candidate (NOT `else` — both can fire on one bar) ───────────────
if s4_bear_break
    s5_candidate_count := s5_candidate_count + 1
    if na(s5_bear_idx)
        s5_last_reject := 2
    else
        float t2 = s2_parsed_high[bar_index - s5_bear_idx]
        float b2 = s2_parsed_low[bar_index - s5_bear_idx]
        float w2 = math.abs(t2 - b2) / OB_PIP_SIZE
        s5_last_top := t2
        s5_last_bottom := b2
        s5_last_width := w2
        s5_last_side := 2
        s5_last_tag := s4_bear_code_out == CODE_EV_CHOCH_BEAR ? 2 : 1
        s5_last_origin_back := bar_index - s5_bear_idx
        s5_last_pivot_back := bar_index - s3_swing_low_bar
        s5_last_break_level := s3_swing_low_level
        if w2 < OB_MIN_PIPS or w2 > OB_MAX_PIPS
            s5_last_reject := 1
            if i_debug
                f_pushLabel(label.new(bar_index, low, "OB REJECT " +
                     str.tostring(w2, "#.#") + "p", style = label.style_label_up,
                     size = size.tiny, color = color.new(#EF476F, 20),
                     textcolor = color.white))
        else
            s5_last_ob_id := s5_next_ob_id
            s5_next_ob_id := s5_next_ob_id + 1
            s5_created_count := s5_created_count + 1
            s5_active_count := s5_active_count + 1
            s5_checksum := s5_checksum + math.round(t2 * 100000) +
                 math.round(b2 * 100000)
            if i_showOrderBlocks
                array.push(s5_boxes, box.new(s5_bear_idx, t2, bar_index, b2,
                     border_color = COL_OB_BEAR, border_width = 1,
                     bgcolor = color.new(COL_OB_BEAR, 85),
                     extend = extend.none))
                array.push(s5_obLabels, label.new(s5_bear_idx,
                     math.min(t2, b2), "OB#" + str.tostring(s5_last_ob_id) + " " +
                     (s4_bear_code_out == CODE_EV_CHOCH_BEAR ? "CHoCH" : "BOS"),
                     style = label.style_label_up, size = size.tiny,
                     color = color.new(COL_OB_BEAR, 30), textcolor = color.white))

// Retention. Deleting the OLDEST keeps the most recent structure legible; the
// HUD reports the horizon so a reader knows the chart is not the whole history.
while array.size(s5_boxes) > i_maxObjects
    box.delete(array.shift(s5_boxes))
while array.size(s5_obLabels) > i_maxObjects
    label.delete(array.shift(s5_obLabels))

// ─────────────────────────────────────────────────────────────────────────────
// 66 — S6 · UTC DAILY REGIME AND MARKET STATE
//
// Mirrors `strategy_core/regime.py::daily_regime_panel` as it is actually
// reached in production: through `_portfolio_panel_index`
// (scripts/run_backtest.py:2413), NOT through the global regime gate.
// `regime_gate_enabled` is FALSE, so `regime_emit_for_run` returns None and the
// in-loop regime gate never blocks — but the panel is still built, and its
// consumers are the portfolio policy (mode `enforce`) and the state-target
// policy. Mirroring the disabled gate would reproduce dead code.
//
// FIVE THINGS A "REASONABLE" IMPLEMENTATION GETS WRONG
//   1. The daily bar is a UTC CALENDAR day built from the intraday bars on this
//      chart. NOT `request.security(..., "D", ...)`, which returns the
//      EXCHANGE session day and rolls at the broker's 22:00 — a different bar
//      with a different close (limitation L-06).
//   2. `ta.ema` seeds with an SMA of the first `length` values. Production's
//      `ewm(adjust=False)` seeds with the FIRST VALUE. The two never converge.
//   3. `ta.stdev` is a POPULATION deviation. Production uses pandas'
//      `rolling().std()` default — ddof=1, a SAMPLE deviation. At length 20 they
//      differ by sqrt(20/19) ≈ 2.6%, which is ~7000x the closest any real day
//      comes to the BBW threshold, so the substitution would move the state.
//   4. `ta.adx` smooths with an RMA seeded from a sum. Production reuses the
//      same first-value-seeded `ewm(adjust=False)` at alpha = 1/14.
//   5. The panel is SHIFTED ONE DAY: the state FOR day D is classified from the
//      features of day D-1. Using today's own close would be lookahead.
//
// STATE IS BOUNDED. The only collection is a 20-element ring of daily closes
// (the Bollinger window); everything else is scalar running state. Nothing here
// grows with chart length.
// ─────────────────────────────────────────────────────────────────────────────

// ── UTC day identity ────────────────────────────────────────────────────────
// Built from the bar's own UTC timestamp, exactly as fragment 30 builds dayKey.
s6_dayKey = dayKey
s6_newDay = na(s6_dayKey[1]) or s6_dayKey != s6_dayKey[1]

// ── in-progress daily aggregate ─────────────────────────────────────────────
var float s6_curOpen  = na
var float s6_curHigh  = na
var float s6_curLow   = na
var float s6_curClose = na
var int   s6_curBars  = 0
var int   s6_curKey   = na

// ── the COMPLETED daily series, as running state ────────────────────────────
// Only the previous completed day's OHLC is needed for Wilder's directional
// movement, so the daily series itself is never stored.
var float s6_pdHigh  = na
var float s6_pdLow   = na
var float s6_pdClose = na
var int   s6_dayCount = 0        // completed UTC days seen so far

// EMA(200) over daily closes — first-value seeded.
var float s6_ema = na
// Bollinger ring: exactly REGIME_BBW_LENGTH daily closes, oldest shifted out.
var float[] s6_closeRing = array.new_float()
// Wilder smoothing state (first-value seeded, alpha = 1/REGIME_ADX_LENGTH).
var float s6_atr = na
var float s6_psm = na
var float s6_msm = na
var float s6_adx = na

// Features of the LAST COMPLETED day — these are what the CURRENT day is
// classified from, which is the one-day shift.
var float s6_fEma      = na
var float s6_fPxVsEma  = na
var float s6_fBasis    = na
var float s6_fSd       = na
var float s6_fUpper    = na
var float s6_fLower    = na
var float s6_fBbw      = na
var float s6_fAdx      = na
var float s6_fPlusDi   = na
var float s6_fMinusDi  = na
var float s6_fDx       = na
var float s6_fTr       = na
var float s6_fPlusDm   = na
var float s6_fMinusDm  = na
var int   s6_srcKey    = na

// Classified state FOR the current day.
var int s6_stateCode    = 0
var int s6_prevStateCode = 0
var int s6_trendCode    = 0
var int s6_volCode      = 0
var int s6_chopCode     = 0
var int s6_validity     = 0      // CODE_REGIME_INVALID / WARMUP / VALID
var bool s6_transition  = false
var int s6_dayIndex     = 0      // 0-based index of the current day

// Daily OHLC of the last COMPLETED day, exported for verification.
var float s6_dOpen  = na
var float s6_dHigh  = na
var float s6_dLow   = na
var float s6_dClose = na
var int   s6_dBars  = 0

// `ewm(adjust=False)`. A non-finite input passes the PREVIOUS output through
// rather than reseeding, so a gap cannot restart the recurrence.
f_ewm(float prev, float value, float alpha) =>
    na(value) ? prev : na(prev) ? value : (1.0 - alpha) * prev + alpha * value

// ── finalise the day that just ended ────────────────────────────────────────
s6_transition := false
if s6_newDay and not na(s6_curKey)
    // 1. the completed daily bar
    s6_dOpen  := s6_curOpen
    s6_dHigh  := s6_curHigh
    s6_dLow   := s6_curLow
    s6_dClose := s6_curClose
    s6_dBars  := s6_curBars
    s6_srcKey := s6_curKey
    s6_dayCount := s6_dayCount + 1

    // 2. EMA(200) over daily closes
    s6_ema := f_ewm(s6_ema, s6_dClose, REGIME_EMA_ALPHA)
    s6_fEma := s6_ema
    s6_fPxVsEma := na(s6_ema) or s6_ema == 0 ? na :
         (s6_dClose - s6_ema) / s6_ema * 100.0

    // 3. Bollinger basis and SAMPLE deviation (ddof = 1) over the last N closes
    array.push(s6_closeRing, s6_dClose)
    if array.size(s6_closeRing) > REGIME_BBW_LENGTH
        array.shift(s6_closeRing)
    if array.size(s6_closeRing) == REGIME_BBW_LENGTH
        float sum = 0.0
        for k = 0 to REGIME_BBW_LENGTH - 1
            sum := sum + array.get(s6_closeRing, k)
        float mean = sum / REGIME_BBW_LENGTH
        float sq = 0.0
        for k = 0 to REGIME_BBW_LENGTH - 1
            float d = array.get(s6_closeRing, k) - mean
            sq := sq + d * d
        // ddof = 1 — divide by N-1, not N. `ta.stdev` divides by N.
        float sd = math.sqrt(sq / (REGIME_BBW_LENGTH - 1))
        s6_fBasis := mean
        s6_fSd    := sd
        s6_fUpper := mean + REGIME_BBW_STD * sd
        s6_fLower := mean - REGIME_BBW_STD * sd
        s6_fBbw   := mean == 0 ? na : (2.0 * REGIME_BBW_STD * sd) / mean * 100.0
    else
        s6_fBasis := na
        s6_fSd    := na
        s6_fUpper := na
        s6_fLower := na
        s6_fBbw   := na

    // 4. Wilder directional movement and ADX
    float tr = na(s6_pdClose) ? s6_dHigh - s6_dLow :
         math.max(s6_dHigh - s6_dLow,
              math.max(math.abs(s6_dHigh - s6_pdClose),
                       math.abs(s6_dLow - s6_pdClose)))
    float up = na(s6_pdHigh) ? 0.0 : s6_dHigh - s6_pdHigh
    float dn = na(s6_pdLow) ? 0.0 : -(s6_dLow - s6_pdLow)
    // STRICTLY greater and strictly positive: an equal move is NEITHER.
    float pdm = (up > dn and up > 0) ? up : 0.0
    float mdm = (dn > up and dn > 0) ? dn : 0.0
    s6_atr := f_ewm(s6_atr, tr,  REGIME_ADX_ALPHA)
    s6_psm := f_ewm(s6_psm, pdm, REGIME_ADX_ALPHA)
    s6_msm := f_ewm(s6_msm, mdm, REGIME_ADX_ALPHA)
    float pdi = na(s6_atr) or s6_atr == 0 ? na : 100.0 * s6_psm / s6_atr
    float mdi = na(s6_atr) or s6_atr == 0 ? na : 100.0 * s6_msm / s6_atr
    float den = na(pdi) or na(mdi) ? na : pdi + mdi
    float dx  = na(den) or den == 0 ? na : 100.0 * math.abs(pdi - mdi) / den
    s6_adx := f_ewm(s6_adx, dx, REGIME_ADX_ALPHA)
    s6_fTr := tr
    s6_fPlusDm := pdm
    s6_fMinusDm := mdm
    s6_fPlusDi := pdi
    s6_fMinusDi := mdi
    s6_fDx := dx
    s6_fAdx := s6_adx
    s6_pdHigh  := s6_dHigh
    s6_pdLow   := s6_dLow
    s6_pdClose := s6_dClose

    // 5. classify the NEW day from the day that just closed (the one-day shift)
    s6_prevStateCode := s6_stateCode
    s6_dayIndex := s6_dayCount
    bool inputsOk = not na(s6_fPxVsEma) and not na(s6_fBbw) and not na(s6_fAdx)
    if s6_dayCount < 2
        // No prior COMPLETED day existed when this one opened — production's
        // day-0 row is null, never a plausible-looking default.
        s6_stateCode := 0
        s6_trendCode := 0
        s6_volCode   := 0
        s6_chopCode  := 0
        s6_validity  := CODE_REGIME_WARMUP
    else if not inputsOk
        // Production returns None. A silent fallback to a generic range state is
        // exactly the failure this refuses to make.
        s6_stateCode := 0
        s6_trendCode := 0
        s6_volCode   := 0
        s6_chopCode  := 0
        s6_validity  := CODE_REGIME_WARMUP
    else
        // `> 0` — a price exactly ON the EMA is BEAR. Reachable: on the seed day
        // close == ema and pxVsEma is exactly zero.
        s6_trendCode := s6_fPxVsEma > 0 ? CODE_TREND_BULL : CODE_TREND_BEAR
        // `> threshold` — exactly at the threshold is COMPRESS.
        s6_volCode := s6_fBbw > REGIME_BBW_THRESHOLD ? CODE_VOL_EXPAND :
             CODE_VOL_COMPRESS
        // `< chop` — exactly at the chop level is TREND, not chop.
        s6_chopCode := s6_fAdx < REGIME_ADX_CHOP ? CODE_CHOP_CHOP : CODE_CHOP_TREND
        // Chop overrides the composite NAME but not the volatility field, so the
        // two disagree on purpose and both are exported.
        string nm = (s6_trendCode == CODE_TREND_BULL ? "Bull" : "Bear") + "/" +
             (s6_chopCode == CODE_CHOP_CHOP ? "Chop" :
                  s6_volCode == CODE_VOL_EXPAND ? "Expand" : "Compress")
        int found = 0
        for k = 0 to array.size(REGIME_STATE_NAME) - 1
            if array.get(REGIME_STATE_NAME, k) == nm
                found := array.get(REGIME_STATE_CODE, k)
        // An unmatched name is a GENERATION defect, not a market condition. It
        // is surfaced as invalid rather than mapped to something plausible.
        s6_stateCode := found
        s6_validity := found == 0 ? CODE_REGIME_INVALID : CODE_REGIME_VALID
    s6_transition := s6_stateCode != s6_prevStateCode

// ── accumulate the in-progress day ──────────────────────────────────────────
if s6_newDay
    s6_curOpen  := open
    s6_curHigh  := high
    s6_curLow   := low
    s6_curClose := close
    s6_curBars  := 1
    s6_curKey   := s6_dayKey
else
    s6_curHigh  := math.max(s6_curHigh, high)
    s6_curLow   := math.min(s6_curLow, low)
    s6_curClose := close
    s6_curBars  := s6_curBars + 1

// ── visuals ─────────────────────────────────────────────────────────────────
// Restrained by default: a background tint carrying the market state, and a
// marker where it changes. Numbers live in the debug table.
s6_stateColour = s6_stateCode == 0 ? na :
     s6_trendCode == CODE_TREND_BULL ?
          (s6_chopCode == CODE_CHOP_CHOP ? #2E86DE :
               s6_volCode == CODE_VOL_EXPAND ? #06D6A0 : #118AB2) :
          (s6_chopCode == CODE_CHOP_CHOP ? #8D99AE :
               s6_volCode == CODE_VOL_EXPAND ? #EF476F : #C1666B)
bgcolor(i_showRegime and s6_stateCode != 0 ?
     color.new(s6_stateColour, 92) : na, title = "S6 market state")

if i_showRegime and s6_transition and s6_stateCode != 0 and barstate.isconfirmed
    f_pushLabel(label.new(bar_index, low,
         array.get(REGIME_STATE_NAME, s6_stateCode - 1),
         style = label.style_label_up, size = size.tiny,
         color = color.new(s6_stateColour, 25), textcolor = color.white))

// ─────────────────────────────────────────────────────────────────────────────
// 60 — PARITY OUTPUT
//
// Pine cannot write files, so the only way to get per-bar values OUT of
// TradingView for comparison is to plot them. These plots are the machine-
// readable half of verification: every one has an exact counterpart field in the
// Python trace, and all are NUMERIC — comparing background colours by eye is not
// verification.
//
// `display.data_window` keeps them off the chart while still exposing them in
// the Data Window (and in exported chart data), so the oracle stays readable.
//
// PACKED TRANSPORT
// TradingView caps a script at 64 plots and raises RE10140 at RUNTIME on a live
// chart — the compiler does not catch it. Small-integer fields therefore travel
// several-to-a-plot. Every multiplier, width and offset below is GENERATED from
// tools/oracle/session_codes.py::PACKED_SPEC, which is also what the comparator
// decodes with; there is deliberately no hand-written radix arithmetic here.
// `f_packv` (fragment 10) applies the offset and clamps, so an overflow fails
// the comparison rather than corrupting a neighbouring field.
//
// HOW TO COMPARE  (see docs/tradingview_visual_oracle_maintenance.md §S1)
//   1. python -m tools.oracle.export_trace ... --output trace.json
//   2. open the same fixture window on TradingView at the same timeframe
//   3. export chart data, then run tools.oracle.compare_stages — it unpacks
//      through PACKED_SPEC and diffs field by field
// ─────────────────────────────────────────────────────────────────────────────

// ── S1 ───────────────────────────────────────────────────────────────────────
plot(utcEpochMs,           "oracleBarEpochMs",     display = display.data_window)
plot(dayKey,               "oracleDayKey",         display = display.data_window)
plot(barsSinceTransition,  "oracleBarsSinceTrans", display = display.data_window)
// PACKED: session · utcHour · transition · fallback · context.
plot(f_packv(sessCode,             PACK_S1_W0, PACK_S1_O0) * PACK_S1_0 +
     f_packv(utcHour,              PACK_S1_W1, PACK_S1_O1) * PACK_S1_1 +
     f_packv(sessTransitionCode,   PACK_S1_W2, PACK_S1_O2) * PACK_S1_2 +
     f_packv(sessIsFall ? 1 : 0,   PACK_S1_W3, PACK_S1_O3) * PACK_S1_3 +
     f_packv(CTX_CODE,             PACK_S1_W4, PACK_S1_O4) * PACK_S1_4,
     "oracleS1Codes", display = display.data_window)
plot(barClosed ? 1 : 0,    "oracleBarClosed",      display = display.data_window)
plot(ORACLE_BUILD_CODE,    "oracleBuildCode",      display = display.data_window)

// ── S2 ───────────────────────────────────────────────────────────────────────
// Prices are compared under a tolerance, not exactly: TradingView's CSV export
// rounds, and the feeds differ. The BRANCH flags are exact — those are decisions,
// not measurements — and travel packed.
plot(s2_tr,                "oracleTrueRange",      display = display.data_window)
plot(s2_atr,               "oracleAtr",            display = display.data_window)
plot(s2_atr_prev,          "oracleAtrPrev",        display = display.data_window)
plot(s2_measure,           "oracleVolMeasure",     display = display.data_window)
plot(s2_parsed_high,       "oracleParsedHigh",     display = display.data_window)
plot(s2_parsed_low,        "oracleParsedLow",      display = display.data_window)
// PACKED: volatility flip · ATR warm-up.
plot(f_packv(s2_high_vol  ? 1 : 0, PACK_S2_W0, PACK_S2_O0) * PACK_S2_0 +
     f_packv(s2_atr_warm  ? 1 : 0, PACK_S2_W1, PACK_S2_O1) * PACK_S2_1,
     "oracleS2Codes", display = display.data_window)

// ── S3 ───────────────────────────────────────────────────────────────────────
// PACKED: ready · newLegHigh · newLegLow · currentLeg · legChange · swingCreated ·
// hasSwingHigh · swingHighCrossed · hasSwingLow · swingLowCrossed.
// legChange is -1..+1 and is lifted by its GENERATED offset, not a literal +1.
plot(f_packv(s3_ready ? 1 : 0,                PACK_S3_W0, PACK_S3_O0) * PACK_S3_0 +
     f_packv(s3_new_leg_high ? 1 : 0,         PACK_S3_W1, PACK_S3_O1) * PACK_S3_1 +
     f_packv(s3_new_leg_low ? 1 : 0,          PACK_S3_W2, PACK_S3_O2) * PACK_S3_2 +
     f_packv(s3_current_leg,                  PACK_S3_W3, PACK_S3_O3) * PACK_S3_3 +
     f_packv(s3_leg_change,                   PACK_S3_W4, PACK_S3_O4) * PACK_S3_4 +
     f_packv(s3_created,                      PACK_S3_W5, PACK_S3_O5) * PACK_S3_5 +
     f_packv(na(s3_swing_high_level) ? 0 : 1, PACK_S3_W6, PACK_S3_O6) * PACK_S3_6 +
     f_packv(s3_swing_high_crossed ? 1 : 0,   PACK_S3_W7, PACK_S3_O7) * PACK_S3_7 +
     f_packv(na(s3_swing_low_level) ? 0 : 1,  PACK_S3_W8, PACK_S3_O8) * PACK_S3_8 +
     f_packv(s3_swing_low_crossed ? 1 : 0,    PACK_S3_W9, PACK_S3_O9) * PACK_S3_9,
     "oracleS3Codes", display = display.data_window)
plot(s3_swing_high_level,        "oracleSwingHigh",     display = display.data_window)
plot(s3_swing_high_seq,          "oracleSwingHighSeq",  display = display.data_window)
plot(s3_swing_low_level,         "oracleSwingLow",      display = display.data_window)
plot(s3_swing_low_seq,           "oracleSwingLowSeq",   display = display.data_window)

// ── S4 ───────────────────────────────────────────────────────────────────────
// PACKED: bias · structure event · event count.
// `oracleTrend` USED to be plotted here. It was a pure duplicate: Python read
// `swing_trend_bias` for both it and `oracleBias`, and
// `s4_trend = bias == BIAS_BULLISH ? 1 : bias == BIAS_BEARISH ? -1 : 0` is the
// identity map when the contract pins BULLISH = 1 and BEARISH = -1. It cost a
// plot and proved nothing `oracleBias` did not.
plot(f_packv(s4_bias,        PACK_S4_W0, PACK_S4_O0) * PACK_S4_0 +
     f_packv(s4_event_code,  PACK_S4_W1, PACK_S4_O1) * PACK_S4_1 +
     f_packv(s4_event_count, PACK_S4_W2, PACK_S4_O2) * PACK_S4_2,
     "oracleS4Codes", display = display.data_window)
plot(s4_broken_level,      "oracleBrokenLevel",    display = display.data_window)
plot(s4_history_warn ? 1 : 0, "oracleHistoryWarn", display = display.data_window)

// ── S5 ───────────────────────────────────────────────────────────────────────
// `oracleObId` is EXPECTED to differ from production's (limitation L-05): the
// counter starts at the first bar of loaded history, not in 2015. It is exported
// so the SEQUENCE can be checked — dense, gap-free, incremented only on append.
// PACKED (per-bar decisions, reset every bar): candidates · created · reject ·
// side · tag.
plot(f_packv(s5_candidate_count, PACK_S5A_W0, PACK_S5A_O0) * PACK_S5A_0 +
     f_packv(s5_created_count,   PACK_S5A_W1, PACK_S5A_O1) * PACK_S5A_1 +
     f_packv(s5_last_reject,     PACK_S5A_W2, PACK_S5A_O2) * PACK_S5A_2 +
     f_packv(s5_last_side,       PACK_S5A_W3, PACK_S5A_O3) * PACK_S5A_3 +
     f_packv(s5_last_tag,        PACK_S5A_W4, PACK_S5A_O4) * PACK_S5A_4,
     "oracleS5Codes", display = display.data_window)
// PACKED (latched identity, in bars back from the break bar): originBack ·
// pivotBack. `na` before the first candidate maps to code 0 via the generated
// offset — see f_packv.
plot(f_packv(s5_last_origin_back, PACK_S5B_W0, PACK_S5B_O0) * PACK_S5B_0 +
     f_packv(s5_last_pivot_back,  PACK_S5B_W1, PACK_S5B_O1) * PACK_S5B_1,
     "oracleS5Ids", display = display.data_window)
plot(s5_last_top,          "oracleObTop",         display = display.data_window)
plot(s5_last_bottom,       "oracleObBottom",      display = display.data_window)
plot(s5_last_width,        "oracleObWidthPips",   display = display.data_window)
plot(s5_last_ob_id,        "oracleObId",          display = display.data_window)
plot(s5_active_count,      "oracleObActive",      display = display.data_window)
plot(s5_last_break_level,  "oracleObBreakLevel",  display = display.data_window)
// Bounded summary of the ACCEPTED inventory. bar_index is feed-local (L-09) and
// ob_id is history-local (L-05), so neither can be compared directly — but a
// running total over every accepted bound can, and it fails loudly the moment a
// single box differs anywhere in the loaded window.
plot(s5_checksum,          "oracleObChecksum",    display = display.data_window)

// ── S6 ───────────────────────────────────────────────────────────────────────
// The DAILY values are those of the last COMPLETED UTC day — the one the current
// day's state was classified from. They are constant across every intraday bar
// of a day, which is what makes them comparable against a per-day Python panel.
plot(s6_srcKey,            "oracleRgSrcDay",      display = display.data_window)
plot(s6_dOpen,             "oracleRgDayOpen",     display = display.data_window)
plot(s6_dHigh,             "oracleRgDayHigh",     display = display.data_window)
plot(s6_dLow,              "oracleRgDayLow",      display = display.data_window)
plot(s6_dClose,            "oracleRgDayClose",    display = display.data_window)
plot(s6_dBars,             "oracleRgDayBars",     display = display.data_window)
plot(s6_fEma,              "oracleRgEma",         display = display.data_window)
plot(s6_fPxVsEma,          "oracleRgPxVsEma",     display = display.data_window)
plot(s6_fBasis,            "oracleRgBasis",       display = display.data_window)
plot(s6_fSd,               "oracleRgSd",          display = display.data_window)
plot(s6_fUpper,            "oracleRgUpper",       display = display.data_window)
plot(s6_fLower,            "oracleRgLower",       display = display.data_window)
plot(s6_fBbw,              "oracleRgBbw",         display = display.data_window)
plot(s6_fAdx,              "oracleRgAdx",         display = display.data_window)
// PACKED: trend · volatility · chop · state · prevState · validity.
plot(f_packv(s6_trendCode,     PACK_S6_W0, PACK_S6_O0) * PACK_S6_0 +
     f_packv(s6_volCode,       PACK_S6_W1, PACK_S6_O1) * PACK_S6_1 +
     f_packv(s6_chopCode,      PACK_S6_W2, PACK_S6_O2) * PACK_S6_2 +
     f_packv(s6_stateCode,     PACK_S6_W3, PACK_S6_O3) * PACK_S6_3 +
     f_packv(s6_prevStateCode, PACK_S6_W4, PACK_S6_O4) * PACK_S6_4 +
     f_packv(s6_validity,      PACK_S6_W5, PACK_S6_O5) * PACK_S6_5,
     "oracleRgCodes", display = display.data_window)
plot(s6_dayIndex,          "oracleRgDayIndex",    display = display.data_window)

// Alert payload — the bulk-export path when hovering bar by bar is impractical.
// One line per transition, in a fixed field order a script can split on "|".
alertcondition(sessTransition,
     title = "Oracle session transition",
     message = "ORACLE|{{time}}|sess={{plot('oracleS1Codes')}}" +
               "|day={{plot('oracleDayKey')}}|build={{plot('oracleBuildCode')}}")

// ─────────────────────────────────────────────────────────────────────────────
// 70 — SESSION LEGEND
//
// Replaces the per-transition labels as the default way of reading the shading.
// Those labels were correct but produced ~6 objects a day forever, which buried
// the price action and hit the retention cap; the colour mapping they conveyed is
// static, so a legend states it once instead of re-stating it on every bar.
//
// The swatch colours come from the SAME generated array the background shading
// indexes (fragment 05 SESSION_SHADE / SESSION_SWATCH, positional with
// SESSION_KEY). A legend that carried its own copy of the palette could claim a
// colour the chart does not paint — the one failure mode a legend must not have.
//
// The ACTIVE session is marked, so the legend doubles as a read-out of where the
// current bar sits without hovering anything.
// ─────────────────────────────────────────────────────────────────────────────

f_legendPosition() =>
    i_legendPos == "Bottom right" ? position.bottom_right :
     i_legendPos == "Top left"    ? position.top_left :
     i_legendPos == "Top right"   ? position.top_right :
     i_legendPos == "Middle left" ? position.middle_left :
     position.bottom_left

// rows = one header + one per scheduled session + the fallback
var table legend = table.new(position.bottom_left,
     3, array.size(SESSION_KEY) + 2,
     border_width = 1, border_color = color.new(color.gray, 40),
     frame_width  = 1, frame_color  = color.new(color.gray, 20))

f_legendRow(int r, color swatch, string name, string window, string code, bool active) =>
    table.cell(legend, 0, r, "", bgcolor = swatch, width = 1)
    table.cell(legend, 1, r, (active ? "▶ " : "  ") + name,
         text_size = f_textSize(), text_halign = text.align_left,
         text_color = active ? color.white : color.new(color.silver, 20),
         bgcolor = active ? color.new(#1A2340, 5) : BG_HUD)
    table.cell(legend, 2, r, window + "  " + code,
         text_size = f_textSize(), text_halign = text.align_left,
         text_color = active ? color.white : color.new(color.silver, 35),
         bgcolor = active ? color.new(#1A2340, 5) : BG_HUD)

if barstate.islast
    table.set_position(legend, f_legendPosition())

if barstate.islast and i_showLegend and CTX_OK
    table.clear(legend, 0, 0, 2, array.size(SESSION_KEY) + 1)

    table.cell(legend, 0, 0, "", bgcolor = color.new(#1A2340, 5))
    table.cell(legend, 1, 0, "SESSION", text_size = f_textSize(),
         text_halign = text.align_left, text_color = color.white,
         bgcolor = color.new(#1A2340, 5))
    table.cell(legend, 2, 0, "UTC  code", text_size = f_textSize(),
         text_halign = text.align_left, text_color = color.white,
         bgcolor = color.new(#1A2340, 5))

    for i = 0 to array.size(SESSION_KEY) - 1
        f_legendRow(i + 1,
             array.get(SESSION_SWATCH, i),
             array.get(SESSION_LABEL, i),
             str.tostring(array.get(SESSION_START_HOUR, i)) + "-" +
                 str.tostring(array.get(SESSION_END_HOUR, i)),
             str.tostring(array.get(SESSION_CODE, i)),
             sessCode == array.get(SESSION_CODE, i))

    // Fallback row — a real session key, not an absence of one.
    f_legendRow(array.size(SESSION_KEY) + 1,
         array.get(SESSION_SWATCH, array.size(SESSION_SWATCH) - 1),
         SESSION_FALLBACK_LABEL, "else", str.tostring(SESSION_FALLBACK_CODE),
         sessIsFall)

// ─────────────────────────────────────────────────────────────────────────────
// 90 — DEBUG PANEL
//
// Off by default. Shows the intermediate values a parity investigation needs:
// the raw and normalised timestamps, the exact comparison that selected the
// session, and the generated constants the decision came from.
//
// Deliberately a single table on the last bar — not per-bar labels — so enabling
// debug cannot exhaust the drawing budget (limitation L-08).
// ─────────────────────────────────────────────────────────────────────────────

// Same capacity discipline as the HUD. This table was declared with 18 rows
// while 21 f_dbg calls were reachable — a latent RE10040 that would have fired
// the first time anyone ticked "Debug mode". Found by the row-capacity lint rule
// added after the HUD overflow, not by hitting it.
DBG_ROWS = 48

var table dbg = table.new(position.bottom_left, 2, DBG_ROWS,
     border_width = 1, border_color = color.new(color.gray, 70),
     frame_width  = 1, frame_color  = color.new(color.gray, 50))

f_dbg(int r, string k, string v) =>
    if r < DBG_ROWS
        table.cell(dbg, 0, r, k, text_size = size.tiny,
             text_halign = text.align_left, text_color = color.new(color.silver, 20),
             bgcolor = color.new(color.black, 80))
        table.cell(dbg, 1, r, v, text_size = size.tiny,
             text_halign = text.align_left, text_color = color.white,
             bgcolor = color.new(color.black, 80))

if barstate.islast and i_debug
    table.clear(dbg, 0, 0, 1, DBG_ROWS - 1)
    int d = 0

    f_dbg(d, "DEBUG", "S1 · data/time/session")
    d := d + 1
    f_dbg(d, "time (epoch ms)", str.tostring(utcEpochMs, "#"))
    d := d + 1
    f_dbg(d, "UTC normalised", str.format_time(time, "yyyy-MM-dd HH:mm:ss", "UTC"))
    d := d + 1
    f_dbg(d, "chart tz render", str.format_time(time, "yyyy-MM-dd HH:mm:ss", syminfo.timezone))
    d := d + 1
    f_dbg(d, "utc y/m/d", str.tostring(utcYear) + "/" + str.tostring(utcMonth) +
                          "/" + str.tostring(utcDom))
    d := d + 1
    f_dbg(d, "utc hour:min", str.tostring(utcHour) + ":" + str.tostring(utcMin))
    d := d + 1
    f_dbg(d, "day key", str.tostring(dayKey) + (dayTransition ? "  (ROLLOVER)" : ""))
    d := d + 1
    f_dbg(d, "prev day key", na(dispPrevDayKey) ? "na" : str.tostring(dispPrevDayKey))
    d := d + 1

    // The exact comparison production performs, shown as it was evaluated.
    f_dbg(d, "window test", sessIsFall ?
         "no window matched -> fallback '" + SESSION_FALLBACK_KEY + "'" :
         str.tostring(sessStartH) + " <= " + str.tostring(utcHour) +
         " < " + str.tostring(sessEndH) + "  -> idx " + str.tostring(sessIdx))
    d := d + 1
    f_dbg(d, "session", sessKey + " / " + sessLabel + " / code " + str.tostring(sessCode))
    d := d + 1
    f_dbg(d, "prev session", na(dispPrevSessKey) ? "na" :
          dispPrevSessKey + " (code " + str.tostring(dispPrevSessCode) + ")")
    d := d + 1
    f_dbg(d, "transition", str.tostring(sessTransition) +
          (sessTransition ? "  reason=" + sessTransitionReason +
                            " code=" + str.tostring(sessTransitionCode) : ""))
    d := d + 1
    f_dbg(d, "bars since tr", str.tostring(barsSinceTransition))
    d := d + 1
    f_dbg(d, "bar closed", str.tostring(barClosed))
    d := d + 1
    f_dbg(d, "ctx", CTX_STATUS + " (code " + str.tostring(CTX_CODE) + ")")
    d := d + 1
    f_dbg(d, "ticker norm", CTX_TICKER_RAW + " -> " + CTX_TICKER_NORM)
    d := d + 1
    f_dbg(d, "tf seconds", str.tostring(timeframe.in_seconds()))
    d := d + 1
    // Marker retention horizon — makes limitation L-08 visible instead of
    // letting an empty history look like a broken anchor.
    //
    // DERIVED, not counted: no global counter is kept, because a Pine function
    // may not modify a global (CE10088). `array.size()` is what is retained, and
    // reaching the cap is itself the signal that older markers were dropped.
    f_dbg(d, "markers kept", str.tostring(array.size(oracleLabels)) + " / " +
          str.tostring(i_maxObjects) +
          (array.size(oracleLabels) >= i_maxObjects ? "  (CAP — older dropped)" : ""))
    d := d + 1
    f_dbg(d, "oldest marker", array.size(oracleLabels) == 0 ? "none" :
          "bar " + str.tostring(label.get_x(array.get(oracleLabels, 0))))
    d := d + 1
    f_dbg(d, "full build id", ORACLE_ENGINE_ID_SHORT)
    d := d + 1
    f_dbg(d, "source hash", ORACLE_SOURCE_HASH_SHORT)

    // ── S6 · UTC daily regime panel ─────────────────────────────────────────
    // The daily aggregate and every indicator intermediate, so a divergence can
    // be located at the step it began rather than after it has folded into ADX.
    f_dbg(d, "S6 day / src", str.tostring(s6_dayKey) + " <- " +
              str.tostring(s6_srcKey))
    d := d + 1
    f_dbg(d, "S6 daily OHLC", str.tostring(s6_dOpen, format.mintick) + " " +
              str.tostring(s6_dHigh, format.mintick) + " " +
              str.tostring(s6_dLow, format.mintick) + " " +
              str.tostring(s6_dClose, format.mintick) +
              "  (" + str.tostring(s6_dBars) + " bars)")
    d := d + 1
    f_dbg(d, "S6 day index", str.tostring(s6_dayIndex) + " of chart history")
    d := d + 1
    f_dbg(d, "S6 ema/px", str.tostring(s6_fEma, format.mintick) + "  px " +
              str.tostring(s6_fPxVsEma) + "%")
    d := d + 1
    f_dbg(d, "S6 bb basis/sd", str.tostring(s6_fBasis, format.mintick) + " / " +
              str.tostring(s6_fSd))
    d := d + 1
    f_dbg(d, "S6 bbw", str.tostring(s6_fBbw) + " vs " +
              str.tostring(REGIME_BBW_THRESHOLD) +
              (na(s6_fBbw) ? "" : s6_fBbw > REGIME_BBW_THRESHOLD ? "  EXPAND" :
                   "  COMPRESS"))
    d := d + 1
    f_dbg(d, "S6 dm/tr", "+" + str.tostring(s6_fPlusDm) + " -" +
              str.tostring(s6_fMinusDm) + " tr " + str.tostring(s6_fTr))
    d := d + 1
    f_dbg(d, "S6 di/dx", "+" + str.tostring(s6_fPlusDi) + " -" +
              str.tostring(s6_fMinusDi) + " dx " + str.tostring(s6_fDx))
    d := d + 1
    f_dbg(d, "S6 adx", str.tostring(s6_fAdx) + " vs " +
              str.tostring(REGIME_ADX_CHOP) +
              (na(s6_fAdx) ? "" : s6_fAdx < REGIME_ADX_CHOP ? "  CHOP" : "  TREND"))
    d := d + 1
    f_dbg(d, "S6 state", (s6_stateCode == 0 ? "none" :
              array.get(REGIME_STATE_NAME, s6_stateCode - 1)) +
              (s6_transition ? "  (changed)" : ""))
    d := d + 1
    f_dbg(d, "S6 validity", s6_validity == CODE_REGIME_VALID ? "valid" :
              s6_validity == CODE_REGIME_WARMUP ? "warmup" : "INVALID")


// ─────────────────────────────────────────────────────────────────────────────
// 99 — HUD
//
// The warning block is NOT suppressible by any input. Phase 0 established why:
// the chart can legitimately show a fill that never reached the broker, the node
// runs in dry-run, and news filtering cannot exist in Pine at all. A user who has
// switched the HUD off must still see those three facts.
//
// The build's identity is BAKED IN at generation. Pine cannot query the
// repository, so this HUD states what the build MIRRORS. Whether the deployed
// engine still matches is answered by `python -m tools.oracle.check_freshness`,
// never by the chart — see limitation L-19.
//
// LEGIBILITY (fixed after the first on-chart run):
//   * backgrounds are near-OPAQUE. They were 75% transparent, so candles bled
//     through and the text was unreadable over price.
//   * the identity row shows ORACLE_ENGINE_ID_COMPACT. The full 56-char
//     fingerprint forced the table wide enough to cover the price action; it now
//     lives in the debug panel.
//   * the warning is split across two rows so it no longer stretches column 0.
//
// A table is pinned to the PANE, not to bars — it deliberately does not scroll
// with the chart. `i_hudPos` moves it if it covers something.
// ─────────────────────────────────────────────────────────────────────────────

// Row capacity is a CONSTANT with headroom, not a number kept in sync by hand.
// v0.5.0 added nine rows to a table still declared with 24 and produced
// RE10040 "Row 24 is out of table bounds" on a live chart. Pine reports that at
// RUNTIME, not compile time, so neither the compiler nor static syntax checking
// caught it. tools/oracle/lint_pine.py now counts row-writing calls per table
// and fails when they exceed the declared capacity.
HUD_ROWS = 56

var table hud = table.new(position.top_right, 2, HUD_ROWS,
     border_width = 1, border_color = color.new(color.gray, 40),
     frame_width  = 1, frame_color  = color.new(color.gray, 20))

// BG_HUD / BG_WARN / BG_STAT / BG_HEAD are declared in fragment 10, because the
// legend (70) needs them too and Pine resolves top-to-bottom.

// Both helpers GUARD the row index. A table overflow is a RUNTIME error that
// kills the whole indicator — the chart goes blank and every stage stops
// rendering. Degrading to "this row is not drawn" keeps the oracle usable and
// still visible, which matters more than the missing line.
f_row(int r, string k, string v, color vc) =>
    if r < HUD_ROWS
        table.cell(hud, 0, r, k, text_size = f_textSize(),
             text_halign = text.align_left,
             text_color = color.new(color.silver, 10), bgcolor = BG_HUD)
        table.cell(hud, 1, r, v, text_size = f_textSize(),
             text_halign = text.align_left, text_color = vc, bgcolor = BG_HUD)

f_span(int r, string v, color vc, color bg) =>
    if r < HUD_ROWS
        table.cell(hud, 0, r, v, text_size = f_textSize(),
             text_halign = text.align_left, text_color = vc, bgcolor = bg)
        table.cell(hud, 1, r, "", bgcolor = bg)

// Colour for a LOGIC-parity value. A declared bootstrap is still a pass — the
// interval is bounded, recorded and proven to contain every divergence — so it
// is green, not amber. Amber is "nobody has checked", red is "checked and wrong".
f_logicColour(string s) =>
    s == "MATCHED" or s == "MATCHED+BOOT" ? color.lime :
         s == "FAILED" or s == "INCOMPATIBLE" ? #EF476F : color.orange

if barstate.islast
    table.set_position(hud, f_hudPosition())

if barstate.islast and i_showHud
    table.clear(hud, 0, 0, 1, HUD_ROWS - 1)
    int r = 0

    // ── identity (generated constants) ──────────────────────────────────────
    f_span(r, "TV VISUAL ORACLE " + ORACLE_BUILD_VERSION + "   S1", color.white, BG_HEAD)
    r := r + 1
    f_row(r, "build",    ORACLE_ENGINE_ID_COMPACT, color.aqua)
    r := r + 1
    f_row(r, "config",   ORACLE_CONFIG_HASH_SHORT, color.aqua)
    r := r + 1
    f_row(r, "schema",   "c" + ORACLE_CONTRACT_SCHEMA + " t" + ORACLE_TRACE_SCHEMA +
                         " g" + ORACLE_GENERATOR_VERSION, color.silver)
    r := r + 1

    // ── data context ────────────────────────────────────────────────────────
    f_row(r, "expects",  ORACLE_SYMBOL + " " + ORACLE_TF_LABEL, color.silver)
    r := r + 1
    f_row(r, "chart",    CTX_TICKER_RAW + " " + timeframe.period, color.silver)
    r := r + 1
    f_row(r, "context",  CTX_STATUS, CTX_OK ? color.lime : color.red)
    r := r + 1
    if not CTX_OK
        f_row(r, "reason", CTX_REASON, color.red)
        r := r + 1

    // ── live S1 state ───────────────────────────────────────────────────────
    f_row(r, "utc",      str.format_time(time, "yyyy-MM-dd HH:mm", "UTC"), color.white)
    r := r + 1
    f_row(r, "day key",  str.tostring(dayKey), color.white)
    r := r + 1
    f_row(r, "session",  sessLabel + " (" + str.tostring(sessCode) + ")", color.white)
    r := r + 1
    f_row(r, "window",   sessIsFall ? "fallback" :
                         str.tostring(sessStartH) + "-" + str.tostring(sessEndH) + " UTC",
          color.silver)
    r := r + 1
    f_row(r, "since tr", str.tostring(barsSinceTransition), color.silver)
    r := r + 1

    // ── S2 / S3 / S4 live state ─────────────────────────────────────────────
    f_row(r, "atr", (s2_atr_warm ? "WARM " : "") +
                    str.tostring(s2_atr, format.mintick) +
                    (s2_high_vol ? "  FLIP" : ""),
          s2_atr_warm ? color.orange : color.white)
    r := r + 1
    f_row(r, "swing hi", na(s3_swing_high_level) ? "none" :
                         str.tostring(s3_swing_high_level, format.mintick) +
                         (s3_swing_high_crossed ? "  crossed" : "  active"),
          s3_swing_high_crossed ? color.gray : color.white)
    r := r + 1
    f_row(r, "swing lo", na(s3_swing_low_level) ? "none" :
                         str.tostring(s3_swing_low_level, format.mintick) +
                         (s3_swing_low_crossed ? "  crossed" : "  active"),
          s3_swing_low_crossed ? color.gray : color.white)
    r := r + 1
    f_row(r, "bias", s4_bias == BIAS_BULLISH ? "BULLISH" :
                     s4_bias == BIAS_BEARISH ? "BEARISH" : "NEUTRAL (unseeded)",
          s4_bias == BIAS_BULLISH ? color.lime :
          s4_bias == BIAS_BEARISH ? color.red : color.orange)
    r := r + 1
    f_row(r, "last event", s4_last_event_code == 0 ? "none" :
                           f_eventText(s4_last_event_code) +
                           (f_eventIsBull(s4_last_event_code) ? " bull" : " bear") +
                           "  bar " + str.tostring(s4_last_event_bar),
          color.white)
    r := r + 1

    // Loaded-history warning — limitation L-04. Pine cannot detect an inverted
    // bias seed, only that the window is too shallow to have converged.
    if s4_history_warn
        f_span(r, "LOADED HISTORY SHALLOW - BIAS SEED MAY DIFFER (L-04)",
               color.white, BG_WARN)
        r := r + 1

    // ── S6 market state ─────────────────────────────────────────────────────
    f_row(r, "STATE", s6_stateCode == 0 ? "(warming up)" :
              array.get(REGIME_STATE_NAME, s6_stateCode - 1),
          s6_stateCode == 0 ? color.gray : color.white)
    r := r + 1
    f_row(r, "REGIME", (s6_trendCode == 0 ? "-" :
              s6_trendCode == CODE_TREND_BULL ? "Bull" : "Bear") + " / " +
              (s6_volCode == 0 ? "-" :
                   s6_volCode == CODE_VOL_EXPAND ? "Expand" : "Compress") +
              (s6_chopCode == CODE_CHOP_CHOP ? " / Chop" : ""),
          color.silver)
    r := r + 1
    f_row(r, "DAILY", str.tostring(s6_dayIndex) + " UTC days loaded" +
              (na(s6_fEma) ? " · EMA-" : " · EMA+") +
              (na(s6_fBbw) ? "BBW-" : "BBW+") +
              (na(s6_fAdx) ? "ADX-" : "ADX+"),
          color.silver)
    r := r + 1
    // NOT suppressible. A green S6 logic row means Pine reproduces Python on the
    // SAME daily history — it does NOT mean this chart reproduces production's
    // ten-year-seeded regime, and those are easy to conflate at a glance.
    f_span(r, "MARKET STATE SEEDED FROM CHART HISTORY ONLY", color.white, BG_WARN)
    r := r + 1
    f_span(r, "PRODUCTION EMA200 SEEDS IN 2015 - FULL REPLAY UNATTAINABLE",
           color.white, BG_WARN)
    r := r + 1

    // ── parity status ───────────────────────────────────────────────────────
    // THREE INDEPENDENT QUESTIONS, shown separately and never merged. A single
    // "MATCHED" once meant all three at once, which made the honest state of
    // this build — faithful port, wrong feed — impossible to express.
    f_span(r, "LOGIC PARITY (Pine vs Python, IDENTICAL bars)", color.silver,
           BG_HEAD)
    r := r + 1
    f_row(r, "S1", ORACLE_S1_LOGIC, f_logicColour(ORACLE_S1_LOGIC))
    r := r + 1
    f_row(r, "S2", ORACLE_S2_LOGIC, f_logicColour(ORACLE_S2_LOGIC))
    r := r + 1
    f_row(r, "S3", ORACLE_S3_LOGIC, f_logicColour(ORACLE_S3_LOGIC))
    r := r + 1
    f_row(r, "S4", ORACLE_S4_LOGIC, f_logicColour(ORACLE_S4_LOGIC))
    r := r + 1
    f_row(r, "S5", ORACLE_S5_LOGIC, f_logicColour(ORACLE_S5_LOGIC))
    r := r + 1
    f_row(r, "S6", ORACLE_S6_LOGIC, f_logicColour(ORACLE_S6_LOGIC))
    r := r + 1
    if ORACLE_LOGIC_BOOTSTRAP > 0
        f_span(r, "STRUCTURE BOOTSTRAP: " +
                  str.tostring(ORACLE_LOGIC_BOOTSTRAP) +
                  " BARS - EARLIER BARS NOT VERIFIED", color.white, BG_WARN)
        r := r + 1

    // The feed is NOT a Pine property. It is stated plainly so nobody reads the
    // green logic rows above as "this chart shows production's numbers".
    f_span(r, "FEED BASIS " + ORACLE_FEED_STATUS + ": PROD " +
              ORACLE_FEED_PROD_BASIS + " / CHART " + ORACLE_FEED_CHART_BASIS,
           color.white, ORACLE_FEED_STATUS == "MATCHED" ? BG_STAT : BG_WARN)
    r := r + 1
    f_span(r, "FULL-HISTORY PRODUCTION REPLAY: " + ORACLE_REPLAY_STATUS,
           color.white, ORACLE_REPLAY_STATUS == "MATCHED" ? BG_STAT : BG_WARN)
    r := r + 1
    f_span(r, "GLOBAL: " + ORACLE_GLOBAL_STATUS, color.white, BG_STAT)
    r := r + 1

    // ── non-suppressible warning (two rows so it does not widen the table) ──
    f_span(r, "SHADOW MODE · EXECUTION STATE UNKNOWN", color.white, BG_WARN)
    r := r + 1
    f_span(r, "NEWS UNAVAILABLE", color.white, BG_WARN)

// …and the SAME warning as a standalone label whenever the HUD is hidden, so no
// cosmetic setting can remove it from the chart entirely.
var label warnLabel = na
if barstate.islast and not i_showHud
    label.delete(warnLabel)
    warnLabel := label.new(bar_index, high,
         "SHADOW MODE · EXECUTION STATE UNKNOWN · NEWS UNAVAILABLE" +
         "\nGLOBAL: " + ORACLE_GLOBAL_STATUS +
         "\n" + ORACLE_ENGINE_ID_COMPACT,
         style = label.style_label_left, size = size.small,
         color = color.new(#B00020, 5), textcolor = color.white)
