// ─────────────────────────────────────────────────────────────────────────────
// 10 — INPUTS
//
// Cosmetic only. No input may change a computed value, and no input may hide a
// parity warning: the SHADOW MODE / EXECUTION STATE UNKNOWN / NEWS UNAVAILABLE
// banner and the data-context status are rendered unconditionally (fragment 99).
// ─────────────────────────────────────────────────────────────────────────────

grpDisplay = "Display"
grpDebug   = "Debug"

i_showHud       = input.bool(true,  "Show HUD",                     group = grpDisplay)
i_hudPos        = input.string("Top right", "HUD position",
     options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"],
     tooltip = "The HUD is a table, so it is pinned to the pane and does NOT scroll " +
               "with the bars — that is intentional. Move it if it covers price.",
     group = grpDisplay)
i_hudSize       = input.string("Tiny", "HUD text size",
     options = ["Tiny", "Small", "Normal"], group = grpDisplay)

i_shadeSessions = input.bool(true,  "Shade sessions",               group = grpDisplay)
i_shadeStrength = input.int(96, "Session shading transparency", minval = 80, maxval = 99,
     tooltip = "Higher is fainter. The first on-chart build baked in 90 and the " +
               "bands competed with the candles for attention.",
     group = grpDisplay)
// The risk/reward AREA fill, for both layers.
//
// It shipped fully opaque, then fully clear. Neither is right for everyone: the
// areas are the fastest way to read a ratio at a glance, and they are also the
// third translucent layer over the candles after the session shading and the
// market-state band. Which of those matters depends on how many setups are on
// screen and how dark your theme is, so it is a dial rather than a decision.
//
// 100 = clear (borders only, the default). Lower = more fill.
i_rrFill        = input.int(100, "Risk/reward area fill", minval = 60, maxval = 100,
     tooltip = "100 leaves the areas as outlines only. Around 88-92 gives the " +
               "filled look. Applies to BOTH the live setups and the replayed " +
               "production setups; the reward area is always kept two points " +
               "fainter than the risk area, because a 3R box is three times " +
               "the height and would otherwise dominate.",
     group = grpDisplay)
i_showLegend    = input.bool(true,  "Show session legend",
     tooltip = "Static colour key for the shading, with the CURRENT session marked. " +
               "This replaces the per-transition markers as the default way to read " +
               "the chart — the mapping is fixed, so stating it once beats restating " +
               "it on every transition.", group = grpDisplay)
i_legendPos     = input.string("Bottom left", "Legend position",
     options = ["Bottom left", "Bottom right", "Top left", "Top right", "Middle left"],
     group = grpDisplay)

// Per-transition markers are now OFF by default. They are correct and still
// available, but they produce ~6 objects per day forever: on a multi-month chart
// they bury the price action and hit the retention cap. The legend carries the
// same information statically.
i_showOpens     = input.bool(false, "Mark session opens",           group = grpDisplay)
i_showCloses    = input.bool(false, "Mark session closes",          group = grpDisplay)
i_showTransLbl  = input.bool(false, "Session transition labels",    group = grpDisplay)

// ── S3 / S4 structure display ────────────────────────────────────────────────
grpStruct = "Structure (S3/S4)"
i_showSwings      = input.bool(true,  "Active swing levels",
     tooltip = "Only ever TWO lines. Production retains one uncrossed swing per " +
               "side, so drawing more would misrepresent the state.",
     group = grpStruct)
i_showSwingMarks  = input.bool(true,  "Swing confirmation markers",
     tooltip = "Drawn at the PIVOT bar, which is swing_length bars before the bar " +
               "that confirmed it — that is where production records it.",
     group = grpStruct)
i_showStructure   = input.bool(true,  "BOS / CHoCH break lines",
     tooltip = "A line from the swing that was broken to the bar that broke it " +
               "— it shows WHICH level went, which a badge at the break bar " +
               "never did.", group = grpStruct)
i_showStructLabels = input.bool(true, "  with BOS / CH chips",
     tooltip = "Off = lines only. The lines alone are often enough once you " +
               "know the colour convention: teal broke a swing high, red broke " +
               "a swing low.", group = grpStruct)
i_showStructLines = input.bool(false, "Broken-level lines",         group = grpStruct)
i_showOrderBlocks = input.bool(true,  "Order-block boxes (S5)",     group = grpStruct)
i_showRegime      = input.bool(true,  "Market-state band (S6)",     group = grpStruct)

// ── setup replay (entry / stop / target / RR / status) ───────────────────────
grpReplay = "Setup replay"
i_showReplay      = input.bool(true,  "Show setups from the Python engine",
     tooltip = "Entry, stop, target, risk-reward, status, blocking reason and " +
               "outcome — as PRODUCTION decided them, not recomputed here. " +
               "Prices are production's feed (bid); this chart is mid, so a " +
               "level can sit a fraction of a pip off the candle that caused it.",
     group = grpReplay)
i_replayCount     = input.string("50", "Setups to draw (most recent)",
     options = ["25", "50", "100", "200"],
     tooltip = "Older setups are never CREATED, so the object budget is bounded " +
               "before Pine sees it. The recording itself may hold more — the " +
               "HUD says how many.",
     group = grpReplay)
i_showPending     = input.bool(false, "Include setups that never triggered",
     tooltip = "Off by default: they are the majority and they never became a " +
               "trade, so they bury the ones that did.",
     group = grpReplay)
i_replayTailBars  = input.int(6, "Tail beyond the terminal event (bars)",
     minval = 0, maxval = 40,
     tooltip = "How far an order block extends PAST the event that ended it, so " +
               "the box does not stop dead on the candle and you can see where " +
               "it finished.",
     group = grpReplay)
i_obMaxBars       = input.int(120, "Order-block box length (bars)",
     minval = 20, maxval = 2000,
     tooltip = "How far a recorded block's BOX is drawn. It is a drawing " +
               "limit, not a claim: a block that outlived the cap still shows " +
               "its dotted terminal tick at the instant it really ended, so " +
               "nothing is truncated silently. Measured on the current " +
               "recording, 44% of blocks last more than 200 bars and the " +
               "longest is 4,052 — at full length fifty of those overlap into " +
               "a solid band.",
     group = grpReplay)
i_obSource        = input.string("Both", "Order-block boxes",
     options = ["Both", "Production lifecycle", "Chart-derived"],
     tooltip = "Which HISTORICAL boxes are drawn. BOTH (default) and " +
               "PRODUCTION LIFECYCLE draw the recorded setups coloured by what " +
               "became of them. CHART-DERIVED suppresses those and draws the " +
               "indicator's own static detection instead — the cross-check, not " +
               "the outcome. The LIVE layer below has its own switch and is " +
               "unaffected, so no choice here can leave the chart empty.",
     group = grpReplay)

// ── live setups (chart-derived, production target table) ────────────────────
grpLive = "Live setups"
i_showLive        = input.bool(true, "Show live setups from chart structure",
     tooltip = "Entry, stop, target and risk-reward for order blocks THIS CHART " +
               "derives, using the target production would select for the same " +
               "cohort. Independent of the Python replay — stale replay data " +
               "never suppresses these.",
     group = grpLive)
i_showArm         = input.bool(true, "  arm / trigger level",
     tooltip = "The dotted line at " +
               "triggered_edge_trigger_thresholds% INTO the block. This is the " +
               "penetration that ARMS the order — it is NOT the entry, which " +
               "sits on the block EDGE (triggered_edge_entry_level_pct = 0). " +
               "Off if you only want the edge.",
     group = grpLive)
i_showLiveRr      = input.bool(true, "  risk-reward tool",
     tooltip = "Anchored to the RIGHT EDGE of its order block, so it travels " +
               "with the block while it is live and freezes when the block is " +
               "mitigated — next to the interaction that matters, rather than " +
               "stranded at the origin.",
     group = grpLive)
i_rrWidthBars     = input.int(40, "  risk-reward width (bars)",
     minval = 5, maxval = 200, group = grpLive)
i_liveTailBars    = input.int(4, "  tail past mitigation (bars)",
     minval = 0, maxval = 40,
     tooltip = "How far a block extends PAST the bar that mitigated or " +
               "invalidated it, so it does not end exactly on the candle and " +
               "you can see where price met it.",
     group = grpLive)
i_liveMaxObs      = input.int(40, "  max tracked order blocks",
     minval = 5, maxval = 50,
     tooltip = "Oldest retired first. Each tracked block holds 3 boxes, 4 lines " +
               "and 1 label, so 60 is 240 lines — and Pine's ceiling is 500 per " +
               "type for the WHOLE script, shared with the replay layer and the " +
               "structure markers (limitation L-08).",
     group = grpLive)

// ── target overrides ────────────────────────────────────────────────────────
// WHY THIS IS NOT 144 INPUT BOXES.
//
// The production table is 24 base cells x 6 market states = 144 addressable
// targets. Pine's settings UI has no dynamic list, no table editor and no way to
// persist a variable-length map: the only primitive is a fixed input declared at
// compile time. 144 `input.float` calls would compile, but they would produce an
// unusable settings page AND fix the count into the source, so a scenario change
// would silently leave stale boxes behind.
//
// So overrides are TIERED instead. Each tier is one number plus a selector, and
// the most specific tier that matches wins. That covers "try London BOS Long at
// 2.5R" and "try everything at 3R" without pretending to be a spreadsheet.
// 0 means "no override at this tier" — never a target of zero.
grpOv = "Target overrides"
i_ovMode        = input.string("Production defaults", "Target mode",
     options = ["Production defaults", "Local overrides"],
     tooltip = "Local overrides change ONLY what this chart draws. They cannot " +
               "reach production, and the tooltip always shows the production " +
               "value alongside the effective one.",
     group = grpOv)
i_ovGlobal      = input.float(0, "Global target (R)", minval = 0, step = 0.05,
     tooltip = "0 = off. Applies to every setup unless a more specific tier wins.",
     group = grpOv)
i_ovSessionName = input.string("london", "  session to override",
     options = ["asia", "london", "lull", "newYork", "ny_pm", "outside"],
     group = grpOv)
i_ovSession     = input.float(0, "  session target (R)", minval = 0, step = 0.05,
     group = grpOv)
i_ovStateName   = input.string("Bull/Expand", "  market state to override",
     options = ["Bull/Expand", "Bull/Compress", "Bull/Chop",
                "Bear/Expand", "Bear/Compress", "Bear/Chop"],
     group = grpOv)
i_ovState       = input.float(0, "  state target (R)", minval = 0, step = 0.05,
     group = grpOv)
i_ovCellSession = input.string("london", "  cell: session",
     options = ["asia", "london", "lull", "newYork", "ny_pm", "outside"],
     group = grpOv)
i_ovCellStruct  = input.string("BOS", "  cell: structure",
     options = ["BOS", "CHoCH"], group = grpOv)
i_ovCellDir     = input.string("Long", "  cell: direction",
     options = ["Long", "Short"], group = grpOv)
i_ovCell        = input.float(0, "  cell target (R)", minval = 0, step = 0.05,
     tooltip = "The most specific tier — it outranks every other override.",
     group = grpOv)

i_debug         = input.bool(false, "Debug mode",                   group = grpDebug)
// `i_showParsed` was removed here. It controlled parsed-price CROSSES that were
// deleted when the script hit TradingView's 64-plot ceiling (RE10140), so it had
// been a switch wired to nothing. The values are still exported as
// `oracleParsedHigh` / `oracleParsedLow` and still shown in the debug table.
i_showDayRoll   = input.bool(false, "Mark UTC day rollover",        group = grpDebug)

// RETENTION, and why the default is high.
//
// Pine hard-limits labels to `max_labels_count` (500, set in the indicator
// declaration). Beyond that the ENGINE evicts them, unpredictably. This script
// therefore evicts its own oldest label once the cap is reached, so the eviction
// is deterministic and ours.
//
// The first release defaulted this to 200. At roughly six session transitions a
// day that retained only ~33 days, so panning back through history showed NO
// markers at all — which reads as "the labels aren't anchored to the bars". They
// always were (`label.new(bar_index, …)`); there simply weren't any left to see.
// The default is now close to Pine's ceiling, and the debug panel reports how
// many are retained and the timestamp of the oldest, so the horizon is visible
// rather than surprising.
i_maxObjects    = input.int(100,    "Max retained markers", minval = 10, maxval = 120,
     tooltip = "Oldest markers are dropped beyond this. Pine's ceiling is 500 per " +
               "OBJECT TYPE for the WHOLE script — not per layer — and this buffer " +
               "shares it with the replay layer and the live setups. It defaulted " +
               "to 450, which starved them: the engine then evicted whichever " +
               "objects it liked, silently. Markers beyond this are GONE, not " +
               "misplaced — see limitation L-08.",
     group = grpDebug)

// ── shared chrome palette ────────────────────────────────────────────────────
// Defined HERE, in the first hand-written fragment, because both the legend (70)
// and the HUD (99) use it and Pine resolves top-to-bottom — declaring it in 99
// would be a forward reference from 70 and would not compile.
//
// Near-opaque on purpose: the first on-chart build used 75% TRANSPARENT panels,
// so candles bled through and the text was unreadable over price.
BG_HUD  = color.new(#0E1117, 8)
BG_WARN = color.new(#B00020, 5)
BG_STAT = color.new(#E08000, 10)
BG_HEAD = color.new(#1A2340, 5)

f_textSize() =>
    i_hudSize == "Normal" ? size.normal : i_hudSize == "Small" ? size.small : size.tiny

f_hudPosition() =>
    i_hudPos == "Top left"      ? position.top_left :
     i_hudPos == "Bottom right" ? position.bottom_right :
     i_hudPos == "Bottom left"  ? position.bottom_left :
     i_hudPos == "Middle right" ? position.middle_right :
     position.top_right

// Whether fragment 65's STATIC order-block boxes are drawn.
//
// They span origin to break bar and never move. The LIVE layer (fragment 68)
// draws the same blocks but extends them to the trigger and hangs the
// risk-reward tool off the end, so while it is on these would be a second box
// at the same levels — which is what made the first version unreadable.
//
// `i_obSource` USED TO BE IGNORED HERE, which made "Chart-derived" a setting
// that turned boxes OFF: it suppressed the replay layer's lifecycle boxes
// (fragment 67 honours it) and fragment 65 stayed hidden anyway because live
// setups were on. Selecting a source must never leave the chart with fewer
// boxes than "Both".
f_drawChartObs() =>
    i_obSource == "Chart-derived" or not i_showLive

// ── packed-transport helper ─────────────────────────────────────────────────
// One field of a packed plot: apply the generated OFFSET, then CLAMP into the
// generated WIDTH.
//
// The clamp is the safety property. Pine has no range check, so a field that
// overflowed its radix would silently carry into its neighbour and BOTH sides
// would decode plausible-looking wrong values — the one failure mode a packed
// transport must not have. Clamping instead produces a packed integer that
// cannot equal Python's (whose `pack` raises outright on the same input), so the
// comparator reports a mismatch on that bar. A wrong number that is loudly wrong
// beats a wrong number that reads as agreement.
//
// `na` maps to 0 BEFORE the offset, which is why every optional field is
// specified with offset 1 — its absence gets code 0 and its smallest real value
// gets 1, rather than a blank cell whose meaning depends on the reader.
f_packv(float v, int width, int offset) =>
    x = (na(v) ? -offset : v) + offset
    x < 0 ? 0 : x > width - 1 ? width - 1 : x

// ── S5 order-block palette ──────────────────────────────────────────────────
// Deliberately distinct from the session palette: an order block is a level, not
// a time window, and the two must not be confusable at a glance.
COL_OB_BULL = #2E86DE
COL_OB_BEAR = #E67E22

// ─────────────────────────────────────────────────────────────────────────────
// 20 — DATA CONTEXT GUARD
//
// The oracle is generated for ONE symbol and a fixed set of timeframes. On any
// other chart it must say so loudly rather than reinterpret the data.
//
// Timeframe rule, and why it is not arbitrary: production assigns a session from
// the UTC HOUR of the bar-open timestamp over windows [start, end). A bar may
// therefore only be assigned one session if it cannot span an hour boundary —
// i.e. only when the timeframe divides 60. Measured against the production
// schedule: M1/M5/M15/H1 never straddle; H4 straddles 4 bars a day. So H4+ is
// refused even though the engine would happily accept the candles.
//
// Symbol matching is by NORMALISED ticker: feeds decorate the same instrument
// (EURUSD, EURUSD.a, FX:EURUSD, EURUSD_OTC …), and refusing all of them would
// make the oracle unusable on the very feed it is meant to be checked against.
// The accepted alias list is GENERATED from the contract, never hand-typed here.
// ─────────────────────────────────────────────────────────────────────────────

// Normalise: uppercase, strip the exchange prefix, drop separators/suffix noise.
f_normTicker(string raw) =>
    string s = str.upper(raw)
    int    c = str.pos(s, ":")
    s := na(c) ? s : str.substring(s, c + 1)
    s := str.replace_all(s, ".", "")
    s := str.replace_all(s, "_", "")
    s := str.replace_all(s, "-", "")
    s

var string CTX_TICKER_RAW  = syminfo.ticker
var string CTX_TICKER_NORM = f_normTicker(syminfo.ticker)

f_symbolSupported() =>
    bool ok = false
    for i = 0 to array.size(ORACLE_SYMBOL_ALIASES) - 1
        if CTX_TICKER_NORM == array.get(ORACLE_SYMBOL_ALIASES, i)
            ok := true
    ok

f_timeframeSupported() =>
    int secs = timeframe.in_seconds()
    bool ok = false
    for i = 0 to array.size(ORACLE_TF_SECONDS) - 1
        if secs == array.get(ORACLE_TF_SECONDS, i)
            ok := true
    ok

var bool   CTX_SYMBOL_OK = f_symbolSupported()
var bool   CTX_TF_OK     = f_timeframeSupported()
var bool   CTX_OK        = CTX_SYMBOL_OK and CTX_TF_OK

// Ordered reasons — same ordering discipline as the Python trace's
// data_context.reasons, so the two can be compared position by position.
var string CTX_REASON =
     CTX_OK ? "" :
     (not CTX_SYMBOL_OK ? "symbol " + CTX_TICKER_RAW + " != " + ORACLE_SYMBOL : "") +
     (not CTX_SYMBOL_OK and not CTX_TF_OK ? " | " : "") +
     (not CTX_TF_OK ? "timeframe " + timeframe.period + " (" +
                      str.tostring(timeframe.in_seconds()) + "s) unsupported" : "")

var string CTX_STATUS = CTX_OK ? "SUPPORTED" : "UNSUPPORTED_DATA_CONTEXT"
var int    CTX_CODE   = CTX_OK ? CODE_CTX_SUPPORTED : CODE_CTX_UNSUPPORTED

// ─────────────────────────────────────────────────────────────────────────────
// 30 — CANONICAL TIME AND UTC DAY SEMANTICS
//
// Production timestamps are UTC end to end above the MT5 gateway
// (live/config.py TIME_BASE = "utc-v2"), stored as
// datetime64[us, UTC] after strategy_core.execution.prepare_candles_for_simulation,
// and every bar label is the bar OPEN (pandas resample is left-labelled,
// left-closed — verified by execution).
//
// Pine's `time` is likewise the bar-OPEN in UTC epoch milliseconds, so the two
// agree WITHOUT conversion. Everything below therefore passes "UTC" explicitly
// to the calendar functions; the chart's display timezone is irrelevant to the
// computation and must not leak into it.
//
// UTC DAY: production uses strategy_core.regime.utc_date_key — the UTC CALENDAR
// day. It does NOT use an exchange session day. This is limitation L-06, and it
// is why `timeframe.change("D")` and `request.security(..., "D", ...)` are
// forbidden here: on FX those follow a 17:00 New York session boundary and would
// roll the day at the wrong instant.
// ─────────────────────────────────────────────────────────────────────────────

// Bar-open, UTC. Identical quantity to the trace's `bar_epoch_ms`.
utcEpochMs = time

utcYear  = year(time,        "UTC")
utcMonth = month(time,       "UTC")
utcDom   = dayofmonth(time,  "UTC")
utcHour  = hour(time,        "UTC")
utcMin   = minute(time,      "UTC")

// ── LONDON WALL-CLOCK HOUR — the session classifier's input ──────────────────
//
// NOT the same quantity as `utcHour`, and the difference is the whole of
// M-SESSION-DST-1. `strategy_core/sessions.py::_london_hour` converts the UTC
// instant through `ZoneInfo("Europe/London")` and classifies on the LOCAL hour,
// so every session boundary sits one hour earlier in UTC during BST than during
// GMT. The schedule numbers (0/7/10/12/15/17) are London local and never move.
//
// Pine's `hour(time, timezone)` takes an IANA identifier and applies the same
// tz database, so this is a genuine conversion — not a month test, not a
// hard-coded +1, and not a separate summer table. Those approximations all fail
// in the ~3 weeks each spring and autumn when the UK and US clocks disagree,
// and they fail differently every year because the transition instants move.
//
// `utcHour` is deliberately kept: it is what the S1 packed export carries and
// what the trace compares, and conflating the two would make a passing
// comparison meaningless.
londonHour = hour(time, "Europe/London")

// The offset is DERIVED, never assumed — the HUD shows it so an operator can
// see GMT/BST at a glance, and a wrong timezone database would be visible
// rather than silent. Modulo 24 so the day wrap at 23:00 UTC reads as +1.
londonOffsetH = (londonHour - utcHour + 24) % 24

// Canonical day key, integer form: 2026-03-08 -> 20260308.
// Mirrors tools/oracle/session_codes.day_key_to_int so the Data Window value is
// directly comparable to the trace's day_key without arithmetic.
dayKey = utcYear * 10000 + utcMonth * 100 + utcDom

var int prevDayKey = na
dayTransition = na(prevDayKey) or dayKey != prevDayKey

// Bar completeness. Production only ever admits CLOSED bars — the bridge pulls
// closed M1 bars only (live/mt5_bridge.py). A forming bar has no production
// counterpart, so the oracle marks it and the comparator ignores it.
barClosed = barstate.isconfirmed

// ─────────────────────────────────────────────────────────────────────────────
// 40 — SESSION ASSIGNMENT
//
// Mirrors strategy_core/sessions.py EXACTLY:
//
//     _LONDON = ZoneInfo("Europe/London")
//     hour = ts.tz_convert(_LONDON).hour          # _london_hour
//     for start, end, label, key in _SESSION_SCHEDULE:
//         if start <= hour < end:
//             return label, key
//     return _SESSION_OUTSIDE
//
// Load-bearing properties, all verified by execution against the pinned engine:
//   * THE INPUT IS THE LONDON WALL-CLOCK HOUR, not the UTC hour. This changed in
//     M-SESSION-DST-1 (e76fa92, branch golden-run-001-engine) and this fragment
//     classified on `utcHour` until M-TV-FILL-TIME-SEMANTICS-1. The schedule
//     numbers are London local; their UTC projection moves with the UK clock, so
//     during BST every boundary fires an hour earlier in UTC. Classifying on UTC
//     put roughly seven months a year into the wrong cohort — silently, because
//     both answers are valid session keys.
//   * the window test is  start <= hour  AND  hour < end   — inclusive start,
//     EXCLUSIVE end. 07:00 London is London; 06:59 London is Asia; 17:00 is
//     Outside.
//   * FIRST match wins. The production windows do not overlap, but the
//     first-match rule is what the code does, so it is what is reproduced.
//   * anything unmatched falls back to Outside — a real session key, not "none".
//   * the labels are phases of a LONDON trading day. `newYork` and `ny_pm` are
//     NOT America/New_York — production says so explicitly, and reinterpreting
//     them against their nominal zones would be a different strategy.
//
// The schedule arrays are GENERATED from the contract (fragment 05). Editing
// them here would be a second authority, which the design forbids.
// ─────────────────────────────────────────────────────────────────────────────

// Index into the generated schedule, or -1 meaning "fallback".
f_sessionIndexForHour(int h) =>
    int found = -1
    for i = 0 to array.size(SESSION_START_HOUR) - 1
        if found == -1
            int s = array.get(SESSION_START_HOUR, i)
            int e = array.get(SESSION_END_HOUR, i)
            if s <= h and h < e          // [start, end) — exactly production
                found := i
    found

// LONDON hour, not UTC. See the header — this one argument is the DST fix.
sessIdx = f_sessionIndexForHour(londonHour)

sessKey    = sessIdx == -1 ? SESSION_FALLBACK_KEY   : array.get(SESSION_KEY,   sessIdx)
sessLabel  = sessIdx == -1 ? SESSION_FALLBACK_LABEL : array.get(SESSION_LABEL, sessIdx)
sessCode   = sessIdx == -1 ? SESSION_FALLBACK_CODE  : array.get(SESSION_CODE,  sessIdx)
sessIsFall = sessIdx == -1
sessStartH = sessIdx == -1 ? na : array.get(SESSION_START_HOUR, sessIdx)
sessEndH   = sessIdx == -1 ? na : array.get(SESSION_END_HOUR,   sessIdx)

// ── transition detection ─────────────────────────────────────────────────────
// Mirrors the trace's session.transition / transition_reason. `gap_resync` marks
// a change across a data gap: the previous bar was more than one timeframe step
// earlier, so unobserved sessions may sit between the two — the change is real
// but the oracle cannot claim it saw the open.
var int    prevSessCode = na
var string prevSessKey  = na
var int    prevBarTime  = na
var int    barsSinceTransition = 0

tfMs      = timeframe.in_seconds() * 1000
isGap     = not na(prevBarTime) and (time - prevBarTime) > tfMs
isFirst   = na(prevSessCode)
changed   = not isFirst and sessCode != prevSessCode

sessTransition = isFirst or changed

sessTransitionReason =
     isFirst   ? "first_bar" :
     not changed ? "" :
     isGap     ? "gap_resync" :
     sessCode == SESSION_FALLBACK_CODE ? "session_close_to_fallback" :
     prevSessCode == SESSION_FALLBACK_CODE ? "fallback_to_session" :
     "session_open"

sessTransitionCode =
     sessTransitionReason == "session_open"              ? CODE_TR_SESSION_OPEN :
     sessTransitionReason == "session_close_to_fallback" ? CODE_TR_CLOSE_TO_FALLBACK :
     sessTransitionReason == "fallback_to_session"       ? CODE_TR_FALLBACK_TO_SESSION :
     sessTransitionReason == "first_bar"                 ? CODE_TR_FIRST_BAR :
     sessTransitionReason == "gap_resync"                ? CODE_TR_GAP_RESYNC :
     CODE_NONE

barsSinceTransition := sessTransition ? 0 : barsSinceTransition + 1

// A session OPEN is a transition into a real session; a session CLOSE is a
// transition out of one. Production has no explicit close event — the close of
// London IS the open of Lull — so "close" here means only the fall to Outside.
isSessionOpen  = sessTransition and not isFirst and not sessIsFall
isSessionClose = sessTransition and not isFirst and sessIsFall

// SNAPSHOT the previous-bar values BEFORE the state carry below overwrites them.
// Later fragments (visuals, HUD, parity plots) run after this one, so reading
// `prevSessKey` directly there would return the CURRENT bar's key — the values
// would look self-consistent and be silently wrong.
dispPrevSessKey  = prevSessKey
dispPrevSessCode = prevSessCode
dispPrevDayKey   = prevDayKey

// State carry — last thing this fragment does, so every read above and every
// snapshot here sees the PREVIOUS bar's value, matching the trace's prev_key
// semantics.
if barClosed or barstate.islast
    prevSessCode := sessCode
    prevSessKey  := sessKey
    prevBarTime  := time
    prevDayKey   := dayKey

// ─────────────────────────────────────────────────────────────────────────────
// 45 — STAGE S2: TRUE RANGE, SEEDED RMA, PARSED PRICES
//
// Mirrors strategy_core/order_blocks.py::_true_range, ::_pine_rma and
// ::_add_parsed_prices.
//
// `ta.atr` AND `ta.rma` ARE FORBIDDEN HERE, and this is measured, not stylistic.
// Production seeds its RMA with the FIRST value; Pine's builtins seed with an SMA
// of the first `length` values. Over the F-S2-RMASEED fixture (1818 comparable
// 15m bars) the two agree on ZERO bars, peak at 27.4% relative difference, and
// are still not equal at the final bar. Since the parsed-price flip is decided by
// `(H-L) >= 2*measure`, any bar near that threshold can flip the other way and
// move an order block. tools/oracle/lint_pine.py rejects the builtins outright.
//
// WHAT THIS FEEDS: parsed_high/parsed_low are consumed ONLY by
// `_make_order_block` — they set the order-block BOX (Stage S5). They do NOT feed
// the swing loop or the break test, both of which read RAW prices. So an S2
// divergence cannot move a swing or a BOS; it can only move an order block.
// ─────────────────────────────────────────────────────────────────────────────

// ── true range ───────────────────────────────────────────────────────────────
// Bar 0 has no previous close. Production builds three columns and takes a
// row-wise max; pandas SKIPS NaN, so bar 0 resolves to high-low rather than NaN.
s2_hl = high - low
s2_hc = barstate.isfirst ? na : math.abs(high - close[1])
s2_lc = barstate.isfirst ? na : math.abs(low  - close[1])
s2_tr = barstate.isfirst ? s2_hl : math.max(s2_hl, s2_hc, s2_lc)

// ── first-value-seeded RMA (NOT ta.rma) ──────────────────────────────────────
// previous = value            on the first bar
// previous = (previous*(n-1) + value) / n   thereafter
var float s2_atr      = na
var float s2_atr_prev = na
s2_atr_prev := s2_atr
s2_atr := na(s2_atr) ? s2_tr : (s2_atr * (ATR_PERIOD - 1) + s2_tr) / ATR_PERIOD

// ── cumulative mean range (the ob_filter != "Atr" branch) ────────────────────
// Divisor is max(index, 1), so index 0 AND index 1 both divide by 1 — a genuine
// production quirk, reproduced rather than tidied.
var float s2_tr_sum = 0.0
s2_tr_sum := s2_tr_sum + s2_tr
s2_cmr = s2_tr_sum / math.max(bar_index, 1)

s2_measure   = OB_FILTER == "Atr" ? s2_atr : s2_cmr
s2_threshold = VOL_MULTIPLE * s2_measure
s2_range     = high - low

// ── parsed prices ────────────────────────────────────────────────────────────
// `>=`, not `>`. On a high-volatility bar the high and low are SWAPPED, so
// parsed_high < parsed_low and the resulting OB box has negative depth. That is
// production behaviour; do not "correct" it.
s2_high_vol    = s2_range >= s2_threshold
s2_parsed_high = s2_high_vol ? low  : high
s2_parsed_low  = s2_high_vol ? high : low

// True until 200 bars have been seen. The seed only fully decays after that, and
// the whole series depends on where the loaded chart BEGINS (limitation L-03).
s2_atr_warm = bar_index + 1 < ATR_PERIOD

// ─────────────────────────────────────────────────────────────────────────────
// 50 — CHART VISUALS
//
// Shading is an OUTPUT of the canonical session calculation, never an input.
// Nothing here reads a TradingView session string; every colour is selected from
// `sessCode`, which came from the production algorithm in fragment 40.
//
// Object budget: Pine hard-limits boxes/labels/lines to 500 each. Markers are
// created only on TRANSITION bars (≤ 6 per UTC day), and `i_maxObjects` trims the
// oldest deterministically so eviction is ours, not the engine's — limitation
// L-08 in the register.
// ─────────────────────────────────────────────────────────────────────────────

// Session background, indexed straight out of the GENERATED palette so the
// shading and the legend (fragment 70) are the same list. A hand-written ternary
// here was the previous approach; it meant the legend could describe a colour the
// chart never painted, and adding a session upstream could silently reuse another
// session's colour. An unmapped code still renders deliberately loud.
sessShadeIdx = sessIsFall ? array.size(SESSION_SHADE) - 1 : sessIdx
// Built from the OPAQUE swatch with the user's transparency applied, rather than
// the pre-shaded array: `color.new` REPLACES transparency, so shading the shaded
// copy would have compounded two values and ignored the input.
sessColor = sessShadeIdx >= 0 and sessShadeIdx < array.size(SESSION_SWATCH)
     ? color.new(array.get(SESSION_SWATCH, sessShadeIdx), i_shadeStrength)
     : color.new(color.red, 60)

bgcolor(i_shadeSessions and CTX_OK ? sessColor : na, title = "Session")

// ── transition markers ───────────────────────────────────────────────────────
// Markers ARE bar-anchored: `label.new(bar_index, …)` uses xloc.bar_index, so
// they move with the bars. What is NOT unlimited is how many are RETAINED —
// beyond `i_maxObjects` the oldest is deleted, so far enough back in history
// there are none left. That horizon is tracked here and reported in the debug
// panel, because the first release silently dropped everything older than ~33
// days and the empty history read as "the labels aren't anchored".
var array<label> oracleLabels = array.new<label>()

// NOTE: this function must not touch any global. Pine forbids it outright —
// "Cannot modify global variable ... in function" (CE10088) — which an earlier
// version of this fragment tripped by keeping drop counters here. The retention
// telemetry is therefore DERIVED from the array itself in the debug fragment,
// where no mutation is needed: `array.size()` gives what is kept, and the first
// element's x gives the oldest retained bar. Nothing has to be counted.
f_pushLabel(label lbl) =>
    array.push(oracleLabels, lbl)
    if array.size(oracleLabels) > i_maxObjects
        label.delete(array.shift(oracleLabels))

// Same deterministic retention for lines (S4 broken-level marks). Pine's ceiling
// for lines is separate from labels, so it gets its own buffer rather than
// sharing a budget and starving one of them.
var array<line> oracleLines = array.new<line>()

f_pushLine(line ln) =>
    array.push(oracleLines, ln)
    if array.size(oracleLines) > i_maxObjects
        line.delete(array.shift(oracleLines))

if CTX_OK and barClosed
    if i_showOpens and isSessionOpen
        f_pushLabel(label.new(bar_index, low, "▲ " + sessLabel,
             style = label.style_label_up, size = size.tiny,
             color = color.new(color.teal, 20), textcolor = color.black,
             tooltip = "session_open · code " + str.tostring(sessCode) +
                       " · UTC " + str.tostring(utcHour, "00") + ":" +
                       str.tostring(utcMin, "00")))

    if i_showCloses and isSessionClose
        f_pushLabel(label.new(bar_index, high, "▼ " + dispPrevSessKey + " → " + sessLabel,
             style = label.style_label_down, size = size.tiny,
             color = color.new(color.maroon, 35), textcolor = color.black,
             tooltip = "session_close_to_fallback · code " + str.tostring(sessCode)))

    if i_showTransLbl and sessTransition and not isSessionOpen and not isSessionClose
        f_pushLabel(label.new(bar_index, high, sessTransitionReason,
             style = label.style_label_down, size = size.tiny,
             color = color.new(color.gray, 30), textcolor = color.black))

    if i_showDayRoll and dayTransition
        f_pushLabel(label.new(bar_index, low, "UTC " + str.tostring(dayKey),
             style = label.style_label_up, size = size.tiny,
             color = color.new(color.navy, 46), textcolor = color.black,
             tooltip = "UTC calendar-day rollover (production utc_date_key)"))

// Unsupported context: one persistent, unmissable label. Drawn even when the
// HUD is switched off — a cosmetic input must not be able to hide this.
var label ctxLabel = na
if barstate.islast and not CTX_OK
    label.delete(ctxLabel)
    ctxLabel := label.new(bar_index, high,
         "⛔ UNSUPPORTED DATA CONTEXT\n" + CTX_REASON +
         "\nParity claims suppressed — this build mirrors " + ORACLE_SYMBOL +
         " on " + ORACLE_TF_LABEL,
         style = label.style_label_left, size = size.normal,
         color = color.new(color.red, 10), textcolor = color.black)

// ─────────────────────────────────────────────────────────────────────────────
// 55 — STAGE S3: LIVE-PATH SWING LOOP
//
// Mirrors the loop INLINED inside strategy_core/order_blocks.py::detect_order_blocks
// (lines 144-171). It does NOT mirror strategy_core/swings.py::detect_swings,
// which is DEAD on the live path — the golden pipeline never calls it. The two
// differ in what they retain: detect_swings records every pivot into columns;
// the live loop keeps only the MOST RECENT UNCROSSED swing per side.
//
// Production, verbatim:
//     for index in range(swing_length, len(candles)):
//         pivot_index = index - swing_length
//         right_highs = candles.loc[pivot_index+1 : index, "high"]   # INCLUSIVE
//         new_leg_high = candles.at[pivot_index,"high"] > right_highs.max()
//         new_leg_low  = candles.at[pivot_index,"low"]  < right_lows.min()
//         next_leg = BEARISH_LEG if new_leg_high else (BULLISH_LEG if new_leg_low else current)
//         leg_change = next_leg - current_leg
//         if leg_change == 1:  swing_low  = {...}
//         elif leg_change == -1: swing_high = {...}
//
// Load-bearing details:
//   * RAW high/low. Never parsed prices — those are Stage S5.
//   * `.loc[a:b]` is INCLUSIVE of b, so the right window is exactly
//     `swing_length` bars: offsets 0 … swing_length-1 from the current bar. That
//     is precisely what `ta.highest(high, SWING_LENGTH)` covers.
//   * STRICT `>` and `<`. A pivot equal to anything in its right window is NOT a
//     swing — equal highs produce nothing.
//   * `elif`, not a second `if`: if both fire on one bar, the HIGH wins.
//   * a swing is recorded ONLY on a leg TRANSITION, never on a repeat.
//   * cold start: current_leg = 0, and BEARISH_LEG is also 0, so the first
//     `new_leg_high` yields leg_change == 0 and records NOTHING, while the first
//     `new_leg_low` yields +1 and records a swing low. That asymmetry is real.
//   * confirmation lag is exactly swing_length bars: the pivot sits that far back.
// ─────────────────────────────────────────────────────────────────────────────

s3_ready = bar_index >= SWING_LENGTH

// Right window: offsets 0 … SWING_LENGTH-1 (current bar included) — the exact
// span of production's inclusive .loc slice.
s3_max_right_high = s3_ready ? ta.highest(high, SWING_LENGTH) : na
s3_min_right_low  = s3_ready ? ta.lowest(low,  SWING_LENGTH)  : na

s3_pivot_high = s3_ready ? high[SWING_LENGTH] : na
s3_pivot_low  = s3_ready ? low[SWING_LENGTH]  : na

s3_new_leg_high = s3_ready and s3_pivot_high > s3_max_right_high
s3_new_leg_low  = s3_ready and s3_pivot_low  < s3_min_right_low

var int s3_current_leg = 0
s3_next_leg = s3_new_leg_high ? LEG_BEARISH : s3_new_leg_low ? LEG_BULLISH : s3_current_leg
s3_leg_change = s3_ready ? s3_next_leg - s3_current_leg : 0

// The single most-recent uncrossed swing per side — production keeps one dict
// each, not a list.
var float s3_swing_high_level = na
var int   s3_swing_high_bar   = na
var bool  s3_swing_high_crossed = false
var int   s3_swing_high_seq   = 0

var float s3_swing_low_level  = na
var int   s3_swing_low_bar    = na
var bool  s3_swing_low_crossed = false
var int   s3_swing_low_seq    = 0

s3_created = 0          // 0 none · 1 swing_high · 2 swing_low

if s3_ready
    if s3_leg_change == 1
        s3_swing_low_level   := low[SWING_LENGTH]
        s3_swing_low_bar     := bar_index - SWING_LENGTH
        s3_swing_low_crossed := false
        s3_swing_low_seq     := s3_swing_low_seq + 1
        s3_created := 2
    else if s3_leg_change == -1
        s3_swing_high_level   := high[SWING_LENGTH]
        s3_swing_high_bar     := bar_index - SWING_LENGTH
        s3_swing_high_crossed := false
        s3_swing_high_seq     := s3_swing_high_seq + 1
        s3_created := 1
    s3_current_leg := s3_next_leg

// ─────────────────────────────────────────────────────────────────────────────
// 58 — STAGE S4: BOS / CHoCH / STRUCTURAL BIAS
//
// Mirrors strategy_core/order_blocks.py::detect_order_blocks lines 173-220.
//
//     previous_close = close[index-1]
//     current_close  = close[index]
//     if swing_high.level is not None and not swing_high.crossed:
//         bull_break = previous_close <= level and current_close > level
//         tag = CHOCH if swing_trend_bias == BEARISH else BOS
//         swing_high.crossed = True ; swing_trend_bias = BULLISH
//     if swing_low.level is not None and not swing_low.crossed:
//         bear_break = previous_close >= level and current_close < level
//         tag = CHOCH if swing_trend_bias == BULLISH else BOS
//         swing_low.crossed = True ; swing_trend_bias = BEARISH
//
// Load-bearing details:
//   * RAW CLOSES, two-bar test. Not a wick break, not parsed prices.
//   * asymmetric operators on purpose: `prev <= level` with `cur > level` for
//     bulls, `prev >= level` with `cur < level` for bears. A previous close
//     exactly AT the level still permits a break.
//   * `crossed` LATCHES — a swing can be broken exactly once.
//   * the two blocks are independent `if`s, so BOTH can fire on one bar. BULL is
//     evaluated FIRST, and the bear tag is then computed from the bias the bull
//     break just set. That ordering is part of the behaviour.
//   * BOS when the bias is 0 (initial) or already the same side; CHoCH ONLY when
//     flipping from the opposite bias. The FIRST break of a run is therefore
//     always BOS, because the bias starts at 0 which equals neither side.
//
// LIMITATION L-04 — THE CORRECTNESS CLIFF
// `swing_trend_bias` is NEVER reset and is seeded by the first break in LOADED
// history. Python loads from 2015; a TradingView chart loads whatever the plan
// allows. If the first break in the chart's window has the opposite side to the
// first break in Python's, every subsequent BOS/CHoCH tag can be inverted — not
// approximately, permanently. The HUD warns while the loaded window is too
// shallow to have converged; it cannot detect the inversion itself, because Pine
// has no access to what Python saw.
// ─────────────────────────────────────────────────────────────────────────────

s4_prev_close = close[1]
s4_cur_close  = close

var int s4_bias = 0            // 0 neutral · BIAS_BULLISH · BIAS_BEARISH
var int s4_bias_before = 0
var int s4_event_code  = 0     // CODE_EV_* for THIS bar (0 = none)
var int s4_event_count = 0
var float s4_broken_level = na
// The PIVOT BAR of the swing that was broken. The structure visual draws a line
// from there to the break, which is what answers "which level went" — a badge at
// the break bar never did.
var int s4_broken_bar = na
var int s4_last_event_bar = na
var int s4_last_event_code = 0
// Exposed for S5 (fragment 65). A break is what CREATES an order-block
// candidate, and the per-side code is needed because when BOTH fire on one bar
// `s4_event_code` ends up holding the bear one — labelling the bullish box from
// it would report the wrong tag.
var bool s4_bull_break = false
var bool s4_bear_break = false
var int  s4_bull_code  = 0
var int  s4_bear_code_out = 0

s4_event_code  := 0
s4_event_count := 0
s4_bull_break  := false
s4_bear_break  := false
s4_bias_before := s4_bias
s4_broken_level := na
s4_broken_bar := na

s4_can_bull = s3_ready and not na(s3_swing_high_level) and not s3_swing_high_crossed
s4_can_bear = s3_ready and not na(s3_swing_low_level)  and not s3_swing_low_crossed

// ── bullish break — evaluated FIRST ──────────────────────────────────────────
if s4_can_bull and s4_prev_close <= s3_swing_high_level and s4_cur_close > s3_swing_high_level
    s4_event_code := s4_bias == BIAS_BEARISH ? CODE_EV_CHOCH_BULL : CODE_EV_BOS_BULL
    s4_broken_level := s3_swing_high_level
    s4_broken_bar := s3_swing_high_bar
    s3_swing_high_crossed := true
    s4_bias := BIAS_BULLISH
    s4_event_count := s4_event_count + 1
    s4_last_event_bar  := bar_index
    s4_last_event_code := s4_event_code
    s4_bull_break := true
    s4_bull_code  := s4_event_code

// ── bearish break — tag uses the bias the bull break may have JUST set ───────
if s4_can_bear and s4_prev_close >= s3_swing_low_level and s4_cur_close < s3_swing_low_level
    s4_bear_code = s4_bias == BIAS_BULLISH ? CODE_EV_CHOCH_BEAR : CODE_EV_BOS_BEAR
    s4_broken_level := s3_swing_low_level
    s4_broken_bar := s3_swing_low_bar
    s3_swing_low_crossed := true
    s4_bias := BIAS_BEARISH
    s4_event_count := s4_event_count + 1
    s4_last_event_bar  := bar_index
    s4_last_event_code := s4_bear_code
    s4_bear_break := true
    s4_bear_code_out := s4_bear_code
    // When both fired, the LAST event on the bar is the bear one; the plotted
    // code reports it, and s4_event_count == 2 marks the double.
    s4_event_code := s4_bear_code

// `s4_trend` was removed here in Wave 2b-i. It was
//     s4_bias == BIAS_BULLISH ? 1 : s4_bias == BIAS_BEARISH ? -1 : 0
// which is the IDENTITY on s4_bias, because the contract pins BULLISH = 1 and
// BEARISH = -1 (contract._engine_constants). Python compared both `oracleBias`
// and `oracleTrend` against the same `swing_trend_bias`, so the second plot cost
// one of 64 plot slots and could not fail unless the first did.

// ── loaded-history sufficiency ───────────────────────────────────────────────
// Not proof of correctness — only that the window is deep enough for the seed to
// be plausible. `s4_bias_seeded_at_bar` is the bar the bias first left 0, which
// is the value an operator compares against the Python trace.
var int s4_bias_seeded_at_bar = na
if na(s4_bias_seeded_at_bar) and s4_bias != 0
    s4_bias_seeded_at_bar := bar_index

s4_history_ok = bar_index >= (SWING_LENGTH + ATR_PERIOD)
s4_history_warn = not s4_history_ok or na(s4_bias_seeded_at_bar)

// ─────────────────────────────────────────────────────────────────────────────
// 59 — S2/S3/S4 VISUALS
//
// Event-driven only. Nothing is drawn on every bar, and every drawing goes
// through the shared retention buffer so the object budget stays deterministic
// (limitation L-08). S2 intermediates are debug-only: they are inputs to Stage
// S5, not structure a reader needs on the default chart.
// ─────────────────────────────────────────────────────────────────────────────

// ── S2 (debug only) ──────────────────────────────────────────────────────────
// The parsed high/low CROSSES were removed when the script hit TradingView's
// 64-plot ceiling (RE10140 at 82 plots, raised at RUNTIME on a live chart).
// Nothing verifiable was lost: the values are still exported as
// `oracleParsedHigh` / `oracleParsedLow` and still shown in the debug table —
// only the on-chart marker is gone, and a marker is not evidence.
//
// A flipped bar is where parsed_high < parsed_low. It cannot produce a tradeable
// candidate (risk <= 0), so it is worth seeing while debugging S5 prerequisites.
plotchar(i_debug and s2_high_vol, "volFlip", "◆", location.belowbar,
     color = color.new(color.orange, 20), size = size.tiny)

// ── S3: active uncrossed swing levels ────────────────────────────────────────
// Only ever TWO lines — production retains one swing per side, so drawing more
// would misrepresent the state. These are LINE OBJECTS rather than plots: a plot
// costs one of the 64 slots on every bar, while two lines cost none and are
// bounded by construction (created once, moved thereafter).
var line s3_hiLine = na
var line s3_loLine = na
if barstate.islast
    bool showHi = i_showSwings and not na(s3_swing_high_level)
         and not s3_swing_high_crossed
    bool showLo = i_showSwings and not na(s3_swing_low_level)
         and not s3_swing_low_crossed
    line.delete(s3_hiLine)
    line.delete(s3_loLine)
    if showHi
        s3_hiLine := line.new(math.max(bar_index - 300, 0), s3_swing_high_level,
             bar_index, s3_swing_high_level, color = color.new(#EF476F, 25),
             width = 1)
    if showLo
        s3_loLine := line.new(math.max(bar_index - 300, 0), s3_swing_low_level,
             bar_index, s3_swing_low_level, color = color.new(#06D6A0, 25),
             width = 1)

// Swing confirmation markers, drawn AT THE PIVOT BAR (swing_length back), which
// is where production records them — not at the bar that confirmed them.
if CTX_OK and barClosed and i_showSwingMarks and s3_created != 0
    f_pushLabel(label.new(bar_index - SWING_LENGTH,
         s3_created == 1 ? s3_swing_high_level : s3_swing_low_level,
         s3_created == 1 ? "SH" : "SL",
         style = s3_created == 1 ? label.style_label_down : label.style_label_up,
         size = size.tiny, textcolor = color.black,
         color = s3_created == 1 ? color.new(#EF476F, 25) : color.new(#06D6A0, 25),
         tooltip = "confirmed " + (s3_created == 1 ? "swing high" : "swing low") +
                   " · pivot bar " + str.tostring(bar_index - SWING_LENGTH) +
                   " · confirmed " + str.tostring(SWING_LENGTH) + " bars later" +
                   " · seq " + str.tostring(s3_created == 1 ? s3_swing_high_seq
                                                            : s3_swing_low_seq)))

// ── S4: structure events ─────────────────────────────────────────────────────
f_eventText(int c) =>
    c == CODE_EV_BOS_BULL   ? "BOS"   :
     c == CODE_EV_CHOCH_BULL ? "CHoCH" :
     c == CODE_EV_BOS_BEAR   ? "BOS"   :
     c == CODE_EV_CHOCH_BEAR ? "CHoCH" : ""

f_eventIsBull(int c) =>
    c == CODE_EV_BOS_BULL or c == CODE_EV_CHOCH_BULL

// A BREAK IS A LEVEL BEING CROSSED, so the drawing is a LEVEL, not a badge.
//
// The previous version stamped a `BOS`/`CHoCH` label at the break bar. It said an
// event happened but not WHAT WAS BROKEN, and at one label per event it buried
// the price action. Now: a line runs from the swing that was broken to the bar
// that broke it, with a compact `BOS` / `CH` chip at its midpoint. The line IS
// the answer to "which level went".
//
// The left edge is the pivot bar of the broken swing. `s4_broken_bar` is tracked
// in fragment 58; where it is unavailable the line falls back to a short stub so
// the event is still visible rather than silently skipped.
if CTX_OK and barClosed and i_showStructure and s4_event_code != 0
    bull = f_eventIsBull(s4_event_code)
    isChoch = s4_event_code == CODE_EV_CHOCH_BULL or s4_event_code == CODE_EV_CHOCH_BEAR
    // Bull breaks take out a swing HIGH, bear breaks a swing LOW — colour by
    // direction so the chart reads without decoding the tag.
    col = bull ? #26A69A : #EF5350
    x0 = na(s4_broken_bar) or s4_broken_bar <= 0 ? bar_index - 1 : s4_broken_bar
    mid = x0 + math.max(1, math.round((bar_index - x0) / 2))

    f_pushLine(line.new(x0, s4_broken_level, bar_index, s4_broken_level,
         color = color.new(col, 20), width = 1,
         style = isChoch ? line.style_dashed : line.style_solid))

    // Compact chip at the middle of the line. `CH` rather than `CHoCH`: at
    // size.tiny the longer word is what made the old chart unreadable. Optional
    // — the line alone carries the level, which is the part that matters.
    if i_showStructLabels
        f_pushLabel(label.new(mid, s4_broken_level,
         (isChoch ? "CH" : "BOS") + (s4_event_count > 1 ? "×2" : ""),
         style = label.style_label_center, size = size.tiny,
         textcolor = color.black, color = color.new(col, 15),
         tooltip = (isChoch ? "CHoCH" : "BOS") + " " +
                   (bull ? "bullish" : "bearish") +
                   "\nbroke " + str.tostring(s4_broken_level, format.mintick) +
                   "\nbias " + str.tostring(s4_bias_before) + " -> " +
                   str.tostring(s4_bias) +
                   (s4_event_count > 1 ? "\nTWO events on this bar (bull first)"
                                       : "")))

    // The old standalone marker, kept behind the structure-line toggle for
    // anyone who wants the break bar itself flagged at the candle.
    if i_showStructLines
        f_pushLabel(label.new(bar_index, bull ? high : low,
             f_eventText(s4_event_code),
             style = bull ? label.style_label_down : label.style_label_up,
             size = size.tiny, textcolor = color.black,
             color = color.new(col, 25)))

// ─────────────────────────────────────────────────────────────────────────────
// 65 — S5 · ORDER-BLOCK CREATION
//
// Mirrors `_make_order_block`, `_ob_width_pips` and `_passes_size_filter` in
// strategy_core/order_blocks.py. CREATION ONLY — production assigns no lifecycle
// state at creation, so mitigation / invalidation / expiry are NOT here.
//
// THE FOUR THINGS A "REASONABLE" IMPLEMENTATION GETS WRONG
//   1. The box is built from PARSED prices, not raw candle extremes. On a
//      high-volatility bar the parsed high/low are SWAPPED, so `top` can be
//      BELOW `bottom`. That inverted box is production behaviour and must not be
//      normalised.
//   2. The origin bar is the extreme parsed price over [pivot, break-1] with the
//      EARLIEST bar winning a tie. `ta.lowest` cannot express it: the window
//      starts at a pivot an unbounded number of bars back, so it is accumulated.
//   3. The size gate uses STRICT comparisons, making it INCLUSIVE at both ends —
//      a width of exactly `OB_MAX_PIPS` PASSES.
//   4. `ob_id` is assigned only on APPEND. A rejected block consumes no id, and
//      the next accepted block reuses the integer. But the swing is still burned
//      and the bias still flipped (in fragment 58, before this runs), so a
//      rejection is not a no-op.
//
// LIMITATION L-05: this counter starts at the first bar of LOADED history, while
// production's starts in 2015. The ids will NOT match. Match an order block on
// (detection_time, direction, top, bottom) instead.
// ─────────────────────────────────────────────────────────────────────────────

// ── origin accumulators ─────────────────────────────────────────────────────
// One per side, anchored at that side's swing PIVOT and folded forward one bar
// at a time. `s5_bull_*` tracks the minimum parsed_low (a bullish OB comes from
// a swing-HIGH break); `s5_bear_*` the maximum parsed_high.
//
// The window a break at bar b needs is [pivot, b-1] — the current bar is NOT in
// it — so each bar folds in `[1]`, the PREVIOUS bar, never `[0]`.
var float s5_bull_min = na
var int   s5_bull_idx = na
var float s5_bear_max = na
var int   s5_bear_idx = na

// Seed on the bar a swing is created: the pivot is SWING_LENGTH bars back, so
// the window [pivot, bar-1] is offsets SWING_LENGTH..1. Walked OLDEST FIRST with
// a strict comparison, so the earliest extreme wins a tie exactly as
// `search[search == search.min()].index[0]` does in production.
if s3_created == 1
    float m = na
    int mi = na
    for k = SWING_LENGTH to 1
        v = s2_parsed_low[k]
        if na(m) or v < m
            m := v
            mi := bar_index - k
    s5_bull_min := m
    s5_bull_idx := mi
else if not na(s5_bull_min)
    if s2_parsed_low[1] < s5_bull_min
        s5_bull_min := s2_parsed_low[1]
        s5_bull_idx := bar_index - 1

if s3_created == 2
    float m2 = na
    int mi2 = na
    for k = SWING_LENGTH to 1
        v = s2_parsed_high[k]
        if na(m2) or v > m2
            m2 := v
            mi2 := bar_index - k
    s5_bear_max := m2
    s5_bear_idx := mi2
else if not na(s5_bear_max)
    if s2_parsed_high[1] > s5_bear_max
        s5_bear_max := s2_parsed_high[1]
        s5_bear_idx := bar_index - 1

// ── this bar's candidates ───────────────────────────────────────────────────
var int   s5_next_ob_id     = 1
var int   s5_created_count  = 0
var int   s5_candidate_count = 0
var int   s5_last_ob_id     = na
var float s5_last_top       = na
var float s5_last_bottom    = na
var float s5_last_width     = na
var int   s5_last_reject    = 0     // 0 none · 1 size_filter · 2 empty_window
var int   s5_active_count   = 0
var int   s5_last_side      = 0     // 0 none · 1 bullish · 2 bearish
var int   s5_last_tag       = 0     // 0 none · 1 BOS · 2 CHoCH
var int   s5_last_origin_back = na  // bars from the break bar back to the origin
var int   s5_last_pivot_back  = na  // …and back to the swing pivot
var float s5_last_break_level = na
// A bounded, exactly-reproducible summary of the whole accepted inventory.
// Comparing box drawings is not evidence; comparing a running total of every
// accepted bound is. Integers scaled by 1e5 stay exact in a float64 well past
// the ~2,000 blocks eleven years of history produces.
var float s5_checksum       = 0.0

s5_candidate_count := 0
s5_created_count   := 0
s5_last_reject     := 0
s5_last_side       := 0
s5_last_tag        := 0

// Boxes are retained under the same budget as every other drawing object; the
// oldest is deleted rather than letting Pine silently drop the newest.
var box[] s5_boxes = array.new_box()
var label[] s5_obLabels = array.new_label()

// ── bullish candidate (evaluated FIRST, as in production) ───────────────────
// `s4_bull_break` / `s4_bear_break` are set in fragment 58, which has already
// burned the swing and flipped the bias by the time this runs.
if s4_bull_break
    s5_candidate_count := s5_candidate_count + 1
    if na(s5_bull_idx)
        s5_last_reject := 2
    else
        float t = s2_parsed_high[bar_index - s5_bull_idx]
        float b = s2_parsed_low[bar_index - s5_bull_idx]
        float w = math.abs(t - b) / OB_PIP_SIZE
        s5_last_top := t
        s5_last_bottom := b
        s5_last_width := w
        s5_last_side := 1
        s5_last_tag := s4_bull_code == CODE_EV_CHOCH_BULL ? 2 : 1
        s5_last_origin_back := bar_index - s5_bull_idx
        s5_last_pivot_back := bar_index - s3_swing_high_bar
        s5_last_break_level := s3_swing_high_level
        // STRICT both ways: exactly OB_MAX_PIPS passes.
        if w < OB_MIN_PIPS or w > OB_MAX_PIPS
            s5_last_reject := 1
            if i_debug
                f_pushLabel(label.new(bar_index, high, "OB REJECT " +
                     str.tostring(w, "#.#") + "p", style = label.style_label_down,
                     size = size.tiny, color = color.new(#EF476F, 20),
                     textcolor = color.black))
        else
            s5_last_ob_id := s5_next_ob_id
            s5_next_ob_id := s5_next_ob_id + 1
            s5_created_count := s5_created_count + 1
            s5_active_count := s5_active_count + 1
            s5_checksum := s5_checksum + math.round(t * 100000) +
                 math.round(b * 100000)
            if i_showOrderBlocks and f_drawChartObs()
                array.push(s5_boxes, box.new(s5_bull_idx, t, bar_index, b,
                     border_color = COL_OB_BULL, border_width = 1,
                     bgcolor = color.new(COL_OB_BULL, 85),
                     extend = extend.none))
                array.push(s5_obLabels, label.new(s5_bull_idx,
                     math.max(t, b), "OB#" + str.tostring(s5_last_ob_id) + " " +
                     (s4_bull_code == CODE_EV_CHOCH_BULL ? "CHoCH" : "BOS"),
                     style = label.style_label_down, size = size.tiny,
                     color = color.new(COL_OB_BULL, 30), textcolor = color.black))

// ── bearish candidate (NOT `else` — both can fire on one bar) ───────────────
if s4_bear_break
    s5_candidate_count := s5_candidate_count + 1
    if na(s5_bear_idx)
        s5_last_reject := 2
    else
        float t2 = s2_parsed_high[bar_index - s5_bear_idx]
        float b2 = s2_parsed_low[bar_index - s5_bear_idx]
        float w2 = math.abs(t2 - b2) / OB_PIP_SIZE
        s5_last_top := t2
        s5_last_bottom := b2
        s5_last_width := w2
        s5_last_side := 2
        s5_last_tag := s4_bear_code_out == CODE_EV_CHOCH_BEAR ? 2 : 1
        s5_last_origin_back := bar_index - s5_bear_idx
        s5_last_pivot_back := bar_index - s3_swing_low_bar
        s5_last_break_level := s3_swing_low_level
        if w2 < OB_MIN_PIPS or w2 > OB_MAX_PIPS
            s5_last_reject := 1
            if i_debug
                f_pushLabel(label.new(bar_index, low, "OB REJECT " +
                     str.tostring(w2, "#.#") + "p", style = label.style_label_up,
                     size = size.tiny, color = color.new(#EF476F, 20),
                     textcolor = color.black))
        else
            s5_last_ob_id := s5_next_ob_id
            s5_next_ob_id := s5_next_ob_id + 1
            s5_created_count := s5_created_count + 1
            s5_active_count := s5_active_count + 1
            s5_checksum := s5_checksum + math.round(t2 * 100000) +
                 math.round(b2 * 100000)
            if i_showOrderBlocks and f_drawChartObs()
                array.push(s5_boxes, box.new(s5_bear_idx, t2, bar_index, b2,
                     border_color = COL_OB_BEAR, border_width = 1,
                     bgcolor = color.new(COL_OB_BEAR, 85),
                     extend = extend.none))
                array.push(s5_obLabels, label.new(s5_bear_idx,
                     math.min(t2, b2), "OB#" + str.tostring(s5_last_ob_id) + " " +
                     (s4_bear_code_out == CODE_EV_CHOCH_BEAR ? "CHoCH" : "BOS"),
                     style = label.style_label_up, size = size.tiny,
                     color = color.new(COL_OB_BEAR, 30), textcolor = color.black))

// Retention. Deleting the OLDEST keeps the most recent structure legible; the
// HUD reports the horizon so a reader knows the chart is not the whole history.
while array.size(s5_boxes) > i_maxObjects
    box.delete(array.shift(s5_boxes))
while array.size(s5_obLabels) > i_maxObjects
    label.delete(array.shift(s5_obLabels))

// ─────────────────────────────────────────────────────────────────────────────
// 66 — S6 · UTC DAILY REGIME AND MARKET STATE
//
// Mirrors `strategy_core/regime.py::daily_regime_panel` as it is actually
// reached in production: through `_portfolio_panel_index`
// (scripts/run_backtest.py:2413), NOT through the global regime gate.
// `regime_gate_enabled` is FALSE, so `regime_emit_for_run` returns None and the
// in-loop regime gate never blocks — but the panel is still built, and its
// consumers are the portfolio policy (mode `enforce`) and the state-target
// policy. Mirroring the disabled gate would reproduce dead code.
//
// FIVE THINGS A "REASONABLE" IMPLEMENTATION GETS WRONG
//   1. The daily bar is a UTC CALENDAR day built from the intraday bars on this
//      chart. NOT `request.security(..., "D", ...)`, which returns the
//      EXCHANGE session day and rolls at the broker's 22:00 — a different bar
//      with a different close (limitation L-06).
//   2. `ta.ema` seeds with an SMA of the first `length` values. Production's
//      `ewm(adjust=False)` seeds with the FIRST VALUE. The two never converge.
//   3. `ta.stdev` is a POPULATION deviation. Production uses pandas'
//      `rolling().std()` default — ddof=1, a SAMPLE deviation. At length 20 they
//      differ by sqrt(20/19) ≈ 2.6%, which is ~7000x the closest any real day
//      comes to the BBW threshold, so the substitution would move the state.
//   4. `ta.adx` smooths with an RMA seeded from a sum. Production reuses the
//      same first-value-seeded `ewm(adjust=False)` at alpha = 1/14.
//   5. The panel is SHIFTED ONE DAY: the state FOR day D is classified from the
//      features of day D-1. Using today's own close would be lookahead.
//
// STATE IS BOUNDED. The only collection is a 20-element ring of daily closes
// (the Bollinger window); everything else is scalar running state. Nothing here
// grows with chart length.
// ─────────────────────────────────────────────────────────────────────────────

// ── UTC day identity ────────────────────────────────────────────────────────
// Built from the bar's own UTC timestamp, exactly as fragment 30 builds dayKey.
s6_dayKey = dayKey
s6_newDay = na(s6_dayKey[1]) or s6_dayKey != s6_dayKey[1]

// ── in-progress daily aggregate ─────────────────────────────────────────────
var float s6_curOpen  = na
var float s6_curHigh  = na
var float s6_curLow   = na
var float s6_curClose = na
var int   s6_curBars  = 0
var int   s6_curKey   = na

// ── the COMPLETED daily series, as running state ────────────────────────────
// Only the previous completed day's OHLC is needed for Wilder's directional
// movement, so the daily series itself is never stored.
var float s6_pdHigh  = na
var float s6_pdLow   = na
var float s6_pdClose = na
var int   s6_dayCount = 0        // completed UTC days seen so far

// EMA(200) over daily closes — first-value seeded.
var float s6_ema = na
// Bollinger ring: exactly REGIME_BBW_LENGTH daily closes, oldest shifted out.
var float[] s6_closeRing = array.new_float()
// Wilder smoothing state (first-value seeded, alpha = 1/REGIME_ADX_LENGTH).
var float s6_atr = na
var float s6_psm = na
var float s6_msm = na
var float s6_adx = na

// Features of the LAST COMPLETED day — these are what the CURRENT day is
// classified from, which is the one-day shift.
var float s6_fEma      = na
var float s6_fPxVsEma  = na
var float s6_fBasis    = na
var float s6_fSd       = na
var float s6_fUpper    = na
var float s6_fLower    = na
var float s6_fBbw      = na
var float s6_fAdx      = na
var float s6_fPlusDi   = na
var float s6_fMinusDi  = na
var float s6_fDx       = na
var float s6_fTr       = na
var float s6_fPlusDm   = na
var float s6_fMinusDm  = na
var int   s6_srcKey    = na

// Classified state FOR the current day.
var int s6_stateCode    = 0
var int s6_prevStateCode = 0
var int s6_trendCode    = 0
var int s6_volCode      = 0
var int s6_chopCode     = 0
var int s6_validity     = 0      // CODE_REGIME_INVALID / WARMUP / VALID
var bool s6_transition  = false
var int s6_dayIndex     = 0      // 0-based index of the current day

// Daily OHLC of the last COMPLETED day, exported for verification.
var float s6_dOpen  = na
var float s6_dHigh  = na
var float s6_dLow   = na
var float s6_dClose = na
var int   s6_dBars  = 0

// `ewm(adjust=False)`. A non-finite input passes the PREVIOUS output through
// rather than reseeding, so a gap cannot restart the recurrence.
f_ewm(float prev, float value, float alpha) =>
    na(value) ? prev : na(prev) ? value : (1.0 - alpha) * prev + alpha * value

// ── finalise the day that just ended ────────────────────────────────────────
s6_transition := false
if s6_newDay and not na(s6_curKey)
    // 1. the completed daily bar
    s6_dOpen  := s6_curOpen
    s6_dHigh  := s6_curHigh
    s6_dLow   := s6_curLow
    s6_dClose := s6_curClose
    s6_dBars  := s6_curBars
    s6_srcKey := s6_curKey
    s6_dayCount := s6_dayCount + 1

    // 2. EMA(200) over daily closes
    s6_ema := f_ewm(s6_ema, s6_dClose, REGIME_EMA_ALPHA)
    s6_fEma := s6_ema
    s6_fPxVsEma := na(s6_ema) or s6_ema == 0 ? na :
         (s6_dClose - s6_ema) / s6_ema * 100.0

    // 3. Bollinger basis and SAMPLE deviation (ddof = 1) over the last N closes
    array.push(s6_closeRing, s6_dClose)
    if array.size(s6_closeRing) > REGIME_BBW_LENGTH
        array.shift(s6_closeRing)
    if array.size(s6_closeRing) == REGIME_BBW_LENGTH
        float sum = 0.0
        for k = 0 to REGIME_BBW_LENGTH - 1
            sum := sum + array.get(s6_closeRing, k)
        float mean = sum / REGIME_BBW_LENGTH
        float sq = 0.0
        for k = 0 to REGIME_BBW_LENGTH - 1
            float d = array.get(s6_closeRing, k) - mean
            sq := sq + d * d
        // ddof = 1 — divide by N-1, not N. `ta.stdev` divides by N.
        float sd = math.sqrt(sq / (REGIME_BBW_LENGTH - 1))
        s6_fBasis := mean
        s6_fSd    := sd
        s6_fUpper := mean + REGIME_BBW_STD * sd
        s6_fLower := mean - REGIME_BBW_STD * sd
        s6_fBbw   := mean == 0 ? na : (2.0 * REGIME_BBW_STD * sd) / mean * 100.0
    else
        s6_fBasis := na
        s6_fSd    := na
        s6_fUpper := na
        s6_fLower := na
        s6_fBbw   := na

    // 4. Wilder directional movement and ADX
    float tr = na(s6_pdClose) ? s6_dHigh - s6_dLow :
         math.max(s6_dHigh - s6_dLow,
              math.max(math.abs(s6_dHigh - s6_pdClose),
                       math.abs(s6_dLow - s6_pdClose)))
    float up = na(s6_pdHigh) ? 0.0 : s6_dHigh - s6_pdHigh
    float dn = na(s6_pdLow) ? 0.0 : -(s6_dLow - s6_pdLow)
    // STRICTLY greater and strictly positive: an equal move is NEITHER.
    float pdm = (up > dn and up > 0) ? up : 0.0
    float mdm = (dn > up and dn > 0) ? dn : 0.0
    s6_atr := f_ewm(s6_atr, tr,  REGIME_ADX_ALPHA)
    s6_psm := f_ewm(s6_psm, pdm, REGIME_ADX_ALPHA)
    s6_msm := f_ewm(s6_msm, mdm, REGIME_ADX_ALPHA)
    float pdi = na(s6_atr) or s6_atr == 0 ? na : 100.0 * s6_psm / s6_atr
    float mdi = na(s6_atr) or s6_atr == 0 ? na : 100.0 * s6_msm / s6_atr
    float den = na(pdi) or na(mdi) ? na : pdi + mdi
    float dx  = na(den) or den == 0 ? na : 100.0 * math.abs(pdi - mdi) / den
    s6_adx := f_ewm(s6_adx, dx, REGIME_ADX_ALPHA)
    s6_fTr := tr
    s6_fPlusDm := pdm
    s6_fMinusDm := mdm
    s6_fPlusDi := pdi
    s6_fMinusDi := mdi
    s6_fDx := dx
    s6_fAdx := s6_adx
    s6_pdHigh  := s6_dHigh
    s6_pdLow   := s6_dLow
    s6_pdClose := s6_dClose

    // 5. classify the NEW day from the day that just closed (the one-day shift)
    s6_prevStateCode := s6_stateCode
    s6_dayIndex := s6_dayCount
    bool inputsOk = not na(s6_fPxVsEma) and not na(s6_fBbw) and not na(s6_fAdx)
    if s6_dayCount < 2
        // No prior COMPLETED day existed when this one opened — production's
        // day-0 row is null, never a plausible-looking default.
        s6_stateCode := 0
        s6_trendCode := 0
        s6_volCode   := 0
        s6_chopCode  := 0
        s6_validity  := CODE_REGIME_WARMUP
    else if not inputsOk
        // Production returns None. A silent fallback to a generic range state is
        // exactly the failure this refuses to make.
        s6_stateCode := 0
        s6_trendCode := 0
        s6_volCode   := 0
        s6_chopCode  := 0
        s6_validity  := CODE_REGIME_WARMUP
    else
        // `> 0` — a price exactly ON the EMA is BEAR. Reachable: on the seed day
        // close == ema and pxVsEma is exactly zero.
        s6_trendCode := s6_fPxVsEma > 0 ? CODE_TREND_BULL : CODE_TREND_BEAR
        // `> threshold` — exactly at the threshold is COMPRESS.
        s6_volCode := s6_fBbw > REGIME_BBW_THRESHOLD ? CODE_VOL_EXPAND :
             CODE_VOL_COMPRESS
        // `< chop` — exactly at the chop level is TREND, not chop.
        s6_chopCode := s6_fAdx < REGIME_ADX_CHOP ? CODE_CHOP_CHOP : CODE_CHOP_TREND
        // Chop overrides the composite NAME but not the volatility field, so the
        // two disagree on purpose and both are exported.
        string nm = (s6_trendCode == CODE_TREND_BULL ? "Bull" : "Bear") + "/" +
             (s6_chopCode == CODE_CHOP_CHOP ? "Chop" :
                  s6_volCode == CODE_VOL_EXPAND ? "Expand" : "Compress")
        int found = 0
        for k = 0 to array.size(REGIME_STATE_NAME) - 1
            if array.get(REGIME_STATE_NAME, k) == nm
                found := array.get(REGIME_STATE_CODE, k)
        // An unmatched name is a GENERATION defect, not a market condition. It
        // is surfaced as invalid rather than mapped to something plausible.
        s6_stateCode := found
        s6_validity := found == 0 ? CODE_REGIME_INVALID : CODE_REGIME_VALID
    s6_transition := s6_stateCode != s6_prevStateCode

// ── accumulate the in-progress day ──────────────────────────────────────────
if s6_newDay
    s6_curOpen  := open
    s6_curHigh  := high
    s6_curLow   := low
    s6_curClose := close
    s6_curBars  := 1
    s6_curKey   := s6_dayKey
else
    s6_curHigh  := math.max(s6_curHigh, high)
    s6_curLow   := math.min(s6_curLow, low)
    s6_curClose := close
    s6_curBars  := s6_curBars + 1

// ── visuals ─────────────────────────────────────────────────────────────────
// Restrained by default: a background tint carrying the market state, and a
// marker where it changes. Numbers live in the debug table.
s6_stateColour = s6_stateCode == 0 ? na :
     s6_trendCode == CODE_TREND_BULL ?
          (s6_chopCode == CODE_CHOP_CHOP ? #2E86DE :
               s6_volCode == CODE_VOL_EXPAND ? #06D6A0 : #118AB2) :
          (s6_chopCode == CODE_CHOP_CHOP ? #8D99AE :
               s6_volCode == CODE_VOL_EXPAND ? #EF476F : #C1666B)
bgcolor(i_showRegime and s6_stateCode != 0 ?
     color.new(s6_stateColour, 92) : na, title = "S6 market state")

if i_showRegime and s6_transition and s6_stateCode != 0 and barstate.isconfirmed
    f_pushLabel(label.new(bar_index, low,
         array.get(REGIME_STATE_NAME, s6_stateCode - 1),
         style = label.style_label_up, size = size.tiny,
         color = color.new(s6_stateColour, 25), textcolor = color.black))

// ── confirmed? ───────────────────────────────────────────────────────────────
// Production's target lookup only honours a CONFIRMED market state: an
// unconfirmed or warming-up one keeps the cohort's base target and never blocks.
// Pine's nearest equivalent is a classification produced from a COMPLETED UTC
// day by a warmed-up panel, which is exactly CODE_REGIME_VALID. Warm-up and
// classifier refusal are both "not confirmed" — deliberately, because both mean
// the state cannot be relied on to select a rule.
s6_confirmed = s6_validity == CODE_REGIME_VALID

// ─────────────────────────────────────────────────────────────────────────────
// 67 — SETUP REPLAY: ORDER-BLOCK LIFECYCLE, ENTRY/STOP/TARGET, RR, OUTCOME
//
// Everything here is PRODUCTION'S OWN DECISION, embedded by the generator
// (fragment 06). Re-deriving it would mean porting the fill gate, the four-check
// policy chain, break-even, protection and the exit precedence — and then
// arguing about which side is right when they disagree. This draws the answer.
//
// WHY THE ORDER BLOCKS ARE DRAWN HERE AND NOT IN FRAGMENT 65
// Fragment 65 draws the boxes the CHART derived. Those are the right thing to
// verify detection against, but they cannot be coloured by outcome: Pine's
// `ob_id` counts from the first loaded bar and production's counts from 2015
// (limitation L-05), so the two cannot be joined by id. The replay carries
// production's OWN bounds and id, so the lifecycle box is drawn from that — no
// join, no inference.
//
// EVERYTHING IS KEYED BY TIME, NEVER BY BAR INDEX
// `xloc.bar_time` throughout, so a feed that disagrees about which bars exist
// (L-02/L-09) cannot shift a drawing.
// ─────────────────────────────────────────────────────────────────────────────

// ── lifecycle palette ────────────────────────────────────────────────────────
// BLUE   live and untouched      ORANGE in progress
// GREEN  completed win           RED    completed loss
// PURPLE invalidated before the entry could fill
// GREY   ended without a trade (blocked, never triggered)
COL_LC_LIVE    = #2E86DE
COL_LC_ACTIVE  = #E67E22
COL_LC_WIN     = #2ECC71
COL_LC_LOSS    = #E74C3C
COL_LC_NONE    = #7F8C8D
// PURPLE — price went clean through the far edge before the entry could fill.
// Its own colour rather than another shade of grey because it is production's
// single most common non-outcome (`invalidated_before_edge_entry`, 39 of the
// 109 recorded setups), and "the block was never viable" is a different thing
// to know from "the policy said no".
COL_LC_INVALID = #9B59B6
// CYAN — the setup ARMED and the chart cannot prove, from 15-minute bars alone,
// whether production's fill was legal inside the bar. Production fills on the
// first 1-minute candle at or after `arm + triggered_edge_candle_delays` whose
// range straddles the entry; a 15-minute bar that both arms and straddles hides
// the ordering of its own minutes. That is not a verdict, so it does not get a
// verdict colour.
COL_LC_UNDECIDED = #00BCD4

// MID-TONE ON PURPOSE. This was #E8E8E8 — luminance 232, chosen to read as
// neutral-bright on a dark chart and effectively INVISIBLE on a white one. The
// entry is the single most important level here (it is where production
// actually fills), so it cannot be a colour that disappears on half of all
// chart themes. #546E7A sits at luminance 104: dark enough to read on white,
// light enough to read on black, and neutral so it is never confused with the
// red stop or the green target.
COL_ENTRY   = #546E7A
COL_STOP    = #E74C3C
COL_TARGET  = #2ECC71
// The ARM / TRIGGER level is a DIFFERENT thing from the entry and gets its own
// colour so the two can never be read as one. Entry is where production fills;
// arm is only how far price must penetrate before the order becomes fillable.
// DARKENED for the same reason as COL_ENTRY. #F1C40F measured 1.7:1 against a
// white chart — a dotted line at that contrast is not a line, it is a rumour.
// #A67C00 is 3.8:1 on white and 5.5:1 on black: the worst case across both
// themes is better than the old colour's best case on either.
COL_ARM     = #A67C00

// The REASON is a parameter because the biggest bucket in the recording is a
// cancellation reason, not a status: 39 of 109 setups end
// `invalidated_before_edge_entry`. Folding those into the same grey as a
// policy block threw away the distinction that matters most on the chart.
f_lcColor(int st, int outc, string reason) =>
    reason == "invalidated_before_edge_entry" ? COL_LC_INVALID :
     st == RP_ST_COMPLETED ? (outc == RP_OUT_LOSS ? COL_LC_LOSS :
                             outc == RP_OUT_WIN  ? COL_LC_WIN : COL_LC_ACTIVE) :
     st == RP_ST_FILLED    ? COL_LC_ACTIVE :
     st == RP_ST_ALLOWED   ? COL_LC_ACTIVE :
     st == RP_ST_PENDING   ? COL_LC_LIVE :
     COL_LC_NONE

// Compact by design. The detail lives in the tooltip — a chart covered in
// sentences is how the previous version became unreadable.
f_statusChip(int st, int outc, string reason) =>
    reason == "invalidated_before_edge_entry" ? "INVALIDATED" :
     st == RP_ST_COMPLETED ? (outc == RP_OUT_WIN ? "WIN" :
                             outc == RP_OUT_LOSS ? "LOSS" : "BE") :
     st == RP_ST_BLOCKED   ? "BLOCKED" :
     st == RP_ST_CANCELLED ? "CANCELLED" :
     st == RP_ST_FILLED    ? "OPEN" :
     st == RP_ST_ALLOWED   ? "NO FILL" :
     st == RP_ST_PENDING   ? "PENDING" : "—"

f_statusLong(int st) =>
    st == RP_ST_PENDING   ? "PENDING · never triggered" :
     st == RP_ST_ALLOWED  ? "ALLOWED · armed, never filled" :
     st == RP_ST_BLOCKED  ? "BLOCKED by policy" :
     st == RP_ST_FILLED   ? "FILLED · still open" :
     st == RP_ST_CANCELLED ? "CANCELLED before fill" :
     st == RP_ST_COMPLETED ? "COMPLETED" : "unknown"

// ── bounded object retention ────────────────────────────────────────────────
// Pine hard-limits boxes, lines and labels to 500 EACH and evicts beyond that
// UNPREDICTABLY. Everything created here is tracked so the eviction is
// deterministic and ours (limitation L-08).
var array<line>  rp_lines  = array.new<line>()
var array<box>   rp_boxes  = array.new<box>()
var array<label> rp_labels = array.new<label>()

f_keepLine(line l) =>
    array.push(rp_lines, l)
    if array.size(rp_lines) > RP_MAX_LINES
        line.delete(array.shift(rp_lines))

f_keepBox(box b) =>
    array.push(rp_boxes, b)
    if array.size(rp_boxes) > RP_MAX_BOXES
        box.delete(array.shift(rp_boxes))

f_keepLabel(label l) =>
    array.push(rp_labels, l)
    if array.size(rp_labels) > RP_MAX_LABELS
        label.delete(array.shift(rp_labels))

// ── how many of the recording to draw ────────────────────────────────────────
// The recording holds up to RP_COUNT setups; the input picks how many of the
// MOST RECENT to draw. Skipping the older ones costs nothing — they are simply
// never created, so the object budget is bounded before Pine ever sees it.
rp_wanted = str.tonumber(i_replayCount)
rp_first  = math.max(0, RP_COUNT - int(na(rp_wanted) ? 50 : rp_wanted))

// ── the cursor ───────────────────────────────────────────────────────────────
// The generated arrays are sorted by detection time, so one forward-only cursor
// draws each setup exactly once, on the bar its order block was detected.
var int rp_cursor = 0

if CTX_OK and barstate.isconfirmed and i_showReplay and RP_COUNT > 0
    while rp_cursor < RP_COUNT and array.get(RP_DETECTED, rp_cursor) <= time
        i = rp_cursor
        rp_cursor += 1

        if i >= rp_first
            t0     = array.get(RP_DETECTED, i)
            status = array.get(RP_STATUS, i)
            outc   = array.get(RP_OUTCOME, i)
            entry  = array.get(RP_ENTRY, i)
            stop   = array.get(RP_STOP, i)
            target = array.get(RP_TARGET, i)
            fill   = array.get(RP_FILL, i)
            exitT  = array.get(RP_EXIT, i)
            obTop  = array.get(RP_OBTOP, i)
            obBot  = array.get(RP_OBBOT, i)
            bull   = array.get(RP_DIRECTION, i) == 1
            reason = array.get(RP_REASON, i)
            col    = f_lcColor(status, outc, reason)

            // WHERE THE SETUP ENDED — for the trade — and separately WHERE
            // THE BLOCK WAS CONSUMED, which is not the same instant.
            //
            // A block is a level that lasts until price comes back to it. The
            // FILL is where price came back; everything after that belongs to
            // the trade, not to the block. Running the block box to the EXIT
            // drew a level that had already been spent — median 3 bars of it,
            // up to 58 — and it disagreed with the live layer, which correctly
            // stops its box at the trigger.
            tEnd = exitT > 0 ? exitT : fill > 0 ? fill : t0 + RP_IDLE_MS
            tBlockEnd = fill > 0 ? fill : tEnd
            // …plus a short tail, so the box does not stop dead on the candle
            // that ended it and the terminal event stays readable.
            tTail = tEnd + i_replayTailBars * RP_BAR_MS

            drawn = status != RP_ST_PENDING or i_showPending

            if drawn
                // ── the order block, coloured by what became of it ──────────
                if obTop > 0 and i_obSource != "Chart-derived"
                    // A BLOCK CAN OUTLIVE ITS OWN LEGIBILITY. Measured on the
                    // current recording: 44% of blocks last more than 200 bars
                    // and the longest is 4,052 — six weeks of a 9-pip level,
                    // which renders as a hairline across the whole screen.
                    // Fifty of those stacked is not a chart.
                    //
                    // So the BOX is capped. The cap is a drawing limit, never a
                    // claim about the block: the dotted terminal tick below is
                    // still drawn at the TRUE end, so a capped box always shows
                    // where it really finished. Truncating without that mark
                    // would be the silent kind, which is not allowed here.
                    blockEnd = tBlockEnd + i_replayTailBars * RP_BAR_MS
                    capEnd = t0 + i_obMaxBars * RP_BAR_MS
                    boxEnd = math.min(blockEnd, capEnd)
                    f_keepBox(box.new(t0, obTop, boxEnd, obBot,
                         xloc = xloc.bar_time,
                         border_color = color.new(col, 25), border_width = 1,
                         bgcolor = color.new(col, 88)))
                    // Terminal tick: where the BLOCK finished, at its true
                    // instant even when the box stopped short of it.
                    f_keepLine(line.new(tBlockEnd, obTop, tBlockEnd, obBot,
                         xloc = xloc.bar_time, color = color.new(col, 30),
                         width = 1, style = line.style_dotted))

                if entry > 0
                    // ── risk and reward as AREAS, SPANNING THE TRADE ────────
                    //
                    // THE AREA IS THE TRADE. It starts at the FILL, not at
                    // detection, and it is only drawn when a fill happened.
                    //
                    // Anchoring it at `t0` was the same detection-time mistake
                    // this whole milestone is about, in its most visible form.
                    // Measured over the current recording: detection-to-exit is
                    // a MEDIAN OF 313 BARS and reaches 9,935, while the trade
                    // itself lasts a median of THREE. So the areas were
                    // translucent slabs a hundred times wider than the thing
                    // they described, laid over price action during which no
                    // position existed. And 71 of the 109 setups never filled
                    // at all, so theirs described a trade that never happened —
                    // exactly the invented outcome this layer must not draw.
                    //
                    // The entry/stop/target LINES still span the full life
                    // below: they are the PLAN, they are thin, and seeing where
                    // an unfilled candidate's levels sat is the point of
                    // scrolling back. Only the AREAS are the trade.
                    rrEnd = exitT > 0 ? exitT : tTail
                    if fill > 0
                        if stop > 0
                            f_keepBox(box.new(fill, math.max(entry, stop), rrEnd,
                                 math.min(entry, stop), xloc = xloc.bar_time,
                                 bgcolor = color.new(COL_STOP, i_rrFill),
                                 border_width = 1,
                                 border_color = color.new(COL_STOP, 60)))
                        if target > 0
                            f_keepBox(box.new(fill, math.max(entry, target),
                                 rrEnd, math.min(entry, target),
                                 xloc = xloc.bar_time,
                                 bgcolor = color.new(COL_TARGET,
                                      math.min(100, i_rrFill + 2)),
                                 border_width = 1,
                                 border_color = color.new(COL_TARGET, 60)))

                    f_keepLine(line.new(t0, entry, tEnd, entry,
                         xloc = xloc.bar_time, color = color.new(COL_ENTRY, 25)))
                    if stop > 0
                        // SOLID. Broken edges read as uncertainty about the
                        // level, which is the opposite of what these are.
                        f_keepLine(line.new(t0, stop, tEnd, stop,
                             xloc = xloc.bar_time,
                             color = color.new(COL_STOP, 30)))
                    if target > 0
                        f_keepLine(line.new(t0, target, tEnd, target,
                             xloc = xloc.bar_time,
                             color = color.new(COL_TARGET, 30)))

                    // Fill and terminal markers. On a 15-minute chart the exact
                    // minute is not resolvable (L-21), so these mark the BAR.
                    if fill > 0
                        f_keepLabel(label.new(fill, entry, "",
                             xloc = xloc.bar_time, yloc = yloc.price,
                             style = label.style_triangleup,
                             color = color.new(COL_ENTRY, 30), size = size.tiny))
                    if exitT > 0
                        f_keepLabel(label.new(exitT,
                             outc == RP_OUT_WIN ? target : stop, "",
                             xloc = xloc.bar_time, yloc = yloc.price,
                             style = label.style_xcross,
                             color = color.new(col, 20), size = size.tiny))

                // ── the compact marker, with everything in the tooltip ──────
                // Pine has no click handler on a box, so the tooltip IS the
                // detail view. The visible text stays at "OB 34 · WIN".
                f_keepLabel(label.new(t0, bull ? math.max(obTop, entry)
                                              : math.min(obBot, entry),
                     "OB " + str.tostring(array.get(RP_OBID, i)) + " · " +
                         f_statusChip(status, outc, reason),
                     xloc = xloc.bar_time, yloc = yloc.price,
                     style = bull ? label.style_label_down : label.style_label_up,
                     color = color.new(col, 20), textcolor = color.black,
                     size = size.tiny,
                     tooltip =
                         "source: REPLAY · M1 authority\n\n" +
                         "OB " + str.tostring(array.get(RP_OBID, i)) + "  " +
                         (bull ? "bullish" : "bearish") + "  " +
                         array.get(RP_STRUCT, i) +
                         "\ndetected  " + str.format_time(t0,
                             "yyyy-MM-dd HH:mm", "UTC") +
                         "\nstate     " + array.get(RP_STATE, i) +
                         "\nsession   " + array.get(RP_SESSION, i) +
                         "\ncohort    " + array.get(RP_COHORT, i) +
                         "\n\nentry     " + str.tostring(entry) +
                         "\nstop      " + str.tostring(stop) +
                         "\ntarget    " + str.tostring(target) +
                         "\nplanned   " + str.tostring(array.get(RP_RR, i)) + "R" +
                         "\n\nstatus    " + f_statusLong(status) +
                         (reason != "" ? "\nreason    " + reason : "") +
                         "\narmed     " + (array.get(RP_ARMED, i) > 0 ?
                             str.format_time(array.get(RP_ARMED, i),
                                 "yyyy-MM-dd HH:mm", "UTC") : "—") +
                         "\nfilled    " + (fill > 0 ? str.format_time(fill,
                             "yyyy-MM-dd HH:mm", "UTC") : "—") +
                         "\nexited    " + (exitT > 0 ? str.format_time(exitT,
                             "yyyy-MM-dd HH:mm", "UTC") : "—") +
                         "\ngross R   " + str.tostring(array.get(RP_GROSSR, i),
                             "0.0000") +
                         "\nnet R     " + str.tostring(array.get(RP_NETR, i),
                             "0.0000") +
                         "\n\nPRODUCTION's decision, replayed. Prices are " +
                         "production's feed (bid); this chart is mid, so a " +
                         "level can sit a fraction of a pip off."))

// ─────────────────────────────────────────────────────────────────────────────
// 68 — LIVE SETUPS: a resting order block is an OPPORTUNITY, not a trade
//
// THE SEMANTIC THIS FRAGMENT EXISTS TO GET RIGHT
//
// Production does NOT decide a trade when it detects an order block. It records
// a candidate and waits. There is no broker order resting anywhere. When price
// eventually comes back, production evaluates the FILL candle — and every
// execution input is read AT THAT MOMENT:
//
//     strategy_core/execution.py:2882  fill_session = _candle_session(candle)
//     strategy_core/execution.py:2950  _cohort_index.get((_cohort_session_key(candle), …))
//     strategy_core/execution.py:2965  _regime_state_for_candle(candle, state_policy_emit)
//     strategy_core/execution.py:3008  plan["tp"] / plan["rr_multiple"] REWRITTEN
//
// A block detected in London on Monday can trigger in New York on Thursday, by
// which time the session cohort AND the market state have both moved and the
// effective target may be a different number — or the cell may say BLOCK and no
// trade happens at all.
//
// The previous version resolved the cell ONCE, at creation, and then kept that
// answer on the label while the block rested. That label read as
//
//     "THIS ORDER BLOCK WILL TRADE AT 3R"
//
// when the only defensible statement was
//
//     "IF PRICE TRIGGERED THIS BLOCK UNDER TODAY'S CONTEXT, IT WOULD TRADE AT 3R"
//
// Those are different claims, and the first one is false. So a resting block now
// carries a PROVISIONAL preview that is recomputed every bar from the CURRENT
// session and CURRENT confirmed market state, labelled NOW and provisional. When
// the block actually resolves, the context is frozen and relabelled FINAL.
//
// TWO INDEPENDENT DIMENSIONS, TWO INDEPENDENT VISUAL CHANNELS
//
//   BOX COLOUR  = structural / trade lifecycle
//                 BLUE resting · ORANGE trade active · GREEN won · RED lost ·
//                 PURPLE invalidated before the entry could fill ·
//                 GREY terminal without a trade
//   LABEL       = execution eligibility right now
//                 NOW TRADE 2.25R · NOW BLOCK · NEWS UNKNOWN
//
// Overloading the box with both is what produced a chart of grey and orange
// rectangles: grey meant "news unknown" and orange meant "bearish", so BLUE —
// which is supposed to mean "resting opportunity" — was unreachable in practice.
//
// NEWS UNKNOWN NEVER DECIDES THE LIFECYCLE EITHER. Past the embedded schedule
// the chart cannot evaluate that gate, and an unevaluable gate is a missing
// input, not a verdict. It qualifies the label ("unconfirmed") and mutes the
// geometry; it does not turn a block terminal-grey. The first version did, and
// every block resolving after the calendar's end went grey on that rule alone.
//
// A BLOCK IS NOT DELETED WHEN THE CELL SAYS BLOCK. Structural existence and
// execution eligibility are different things; the block stays, blue, and the
// label says NOW: BLOCK. If the session or state later moves to an allowed cell
// the same block becomes tradeable again, without a new block being created.
//
// NEWS is applied from production's own embedded schedule (fragment 08) but only
// inside the range that schedule covers. Past its last window the answer is
// UNKNOWN — never ALLOWED. An UNKNOWN does NOT erase the geometry, because this
// chart is a debugging instrument and the calculated entry/stop/target is the
// thing being debugged; it is drawn MUTED and labelled "unconfirmed".
// ─────────────────────────────────────────────────────────────────────────────

// ── cohort session ───────────────────────────────────────────────────────────
// `_cohort_session_key` is `_session_for_hour(_london_hour(t))[1]`, defined
// separately from the S1 session keys. They overlap; they are not the same list,
// and using the S1 index here would mis-key every lookup. Matching by NAME
// against the generated cohort vocabulary is what keeps them tied together.
//
// `sessKey` is now the LONDON wall-clock classification (fragment 40), so this
// tracks the UK clock exactly as production does.
f_cohortSessionIdx() =>
    int found = -1
    for i = 0 to TGT_SESSION_N - 1
        if array.get(TGT_SESSION_NAME, i) == sessKey
            found := i
    found

// ── the resolution ───────────────────────────────────────────────────────────
// Returns [rr, source, allowed, reasonCode]. `source` distinguishes a base
// target from a state override so the tooltip can say which rule fired.
LS_SRC_NONE   = 0
LS_SRC_BASE   = 1
LS_SRC_STATE  = 2
LS_SRC_GLOBAL = 3

f_resolveCell(int sessIdx, bool isChoch, bool isLong) =>
    float rr = na
    int src = LS_SRC_NONE
    bool ok = true
    string why = ""
    if not TGT_PRESENT or sessIdx < 0
        why := TGT_PRESENT ? "session not in table" : "NO TABLE"
    else
        base = (sessIdx * 2 + (isChoch ? 1 : 0)) * 2 + (isLong ? 0 : 1)
        if base < 0 or base >= TGT_BASE_N
            why := "NO CELL"
        else if array.get(TGT_BASE_PRESENT, base) == 0
            // Production has no cohort rule for this key, so it skips the gate
            // and uses the global multiple. Reported as its own source, never
            // silently blended with a real cell.
            rr := TGT_GLOBAL_RR
            src := LS_SRC_GLOBAL
        else
            rr := array.get(TGT_BASE_RR, base)
            src := LS_SRC_BASE
            ok := array.get(TGT_BASE_ON, base) == 1
            if not ok
                why := "cohort_disabled"
            // Only a CONFIRMED state may move eligibility or the target.
            if s6_stateCode > 0 and s6_confirmed
                st = s6_stateCode - 1
                if st >= 0 and st < TGT_STATE_N
                    slot = base * TGT_STATE_N + st
                    elig = array.get(TGT_STATE_ELIG, slot)
                    if elig == 1
                        ok := true
                        why := ""
                    else if elig == 2
                        ok := false
                        why := "state_target_block"
                    ov = array.get(TGT_STATE_RR, slot)
                    if ov >= 0
                        rr := ov
                        src := LS_SRC_STATE
    [rr, src, ok, why]

// ── local overrides ──────────────────────────────────────────────────────────
// PRECEDENCE, highest first:
//     exact cell  >  market state  >  session  >  global  >  production
//
// Pine cannot give an ergonomic editor for 144 individual cells — see the note
// in fragment 10 — so the exact-cell tier is ONE cell, selected by dropdowns.
LS_OV_PROD    = 0
LS_OV_GLOBAL  = 1
LS_OV_SESSION = 2
LS_OV_STATE   = 3
LS_OV_CELL    = 4

f_applyOverrides(float prodRr, int sessIdx, bool isChoch, bool isLong) =>
    float rr = prodRr
    int src = LS_OV_PROD
    if i_ovMode == "Local overrides"
        if i_ovGlobal > 0
            rr := i_ovGlobal
            src := LS_OV_GLOBAL
        if i_ovSession > 0 and sessIdx >= 0
             and array.get(TGT_SESSION_NAME, sessIdx) == i_ovSessionName
            rr := i_ovSession
            src := LS_OV_SESSION
        if i_ovState > 0 and s6_stateCode > 0
             and array.get(TGT_STATE_NAME, s6_stateCode - 1) == i_ovStateName
            rr := i_ovState
            src := LS_OV_STATE
        // The exact cell wins outright — it is the most specific thing the user
        // can say, so nothing above may quietly outrank it.
        if i_ovCell > 0 and sessIdx >= 0
             and array.get(TGT_SESSION_NAME, sessIdx) == i_ovCellSession
             and (isChoch ? "CHoCH" : "BOS") == i_ovCellStruct
             and (isLong ? "Long" : "Short") == i_ovCellDir
            rr := i_ovCell
            src := LS_OV_CELL
    [rr, src]

f_ovName(int s) =>
    s == LS_OV_CELL ? "CELL OVERRIDE" : s == LS_OV_STATE ? "STATE OVERRIDE" :
     s == LS_OV_SESSION ? "SESSION OVERRIDE" :
     s == LS_OV_GLOBAL ? "GLOBAL OVERRIDE" : "PROD"

f_srcName(int s) =>
    s == LS_SRC_STATE ? "state override" : s == LS_SRC_BASE ? "cohort base" :
     s == LS_SRC_GLOBAL ? "global rr (no cohort rule)" : "none"

f_stateName() =>
    s6_stateCode == 0 ? "(warming up)" :
     array.get(REGIME_STATE_NAME, s6_stateCode - 1) +
         (s6_confirmed ? "" : " (unconfirmed)")

// ── news ─────────────────────────────────────────────────────────────────────
//
// Production pauses pending orders, cancels a touched order and BLOCKS NEW FILLS
// inside a blackout window. The chart carries production's own windows
// (fragment 08), generated through production's own loader and filter.
//
// THE THIRD STATE IS THE POINT. Beyond the end of the embedded schedule the
// chart does not know — and an exhausted calendar looks exactly like a quiet one
// from inside Pine. Only one of those is permission to trade, so past
// NEWS_LAST_MS the answer is UNKNOWN, never ALLOWED.
//
// A 15-minute bar spans fifteen 1-MINUTE candles and production decides per
// minute (L-21), matching `window_start <= candle_time <= window_end`
// INCLUSIVE on both ends (`strategy_core/news.py::_news_blackout_match`).
//
// So the test is NOT "does the window overlap the bar". A window that starts
// 30 seconds after a bar's final minute overlaps the bar but contains none of
// its minutes, and production's first blocked candle is in the NEXT bar. This
// walks the same minute grid production walks: the bar is blocked iff at least
// one whole minute inside it lands in a window.
LS_NEWS_OK      = 0
LS_NEWS_BLOCKED = 1
LS_NEWS_UNKNOWN = 2

LS_MIN_MS = 60000

f_newsState(int barStart, int barEnd) =>
    int st = LS_NEWS_UNKNOWN
    if not NEWS_PRESENT
        st := LS_NEWS_UNKNOWN
    else if not NEWS_ENABLED
        // Production applies no blackout at all, so there is nothing to not
        // know. This is a real permit, not a default.
        st := LS_NEWS_OK
    else
        // Minute k of this bar is at barStart + k*60000, for k in [0, lastK].
        lastK = math.floor((barEnd - barStart) / LS_MIN_MS) - 1
        int hit = 0
        for i = 0 to NEWS_COUNT - 1
            if hit == 0
                ws = array.get(NEWS_START, i)
                we = array.get(NEWS_END, i)
                kLo = math.max(0, math.ceil((ws - barStart) / LS_MIN_MS))
                kHi = math.min(lastK, math.floor((we - barStart) / LS_MIN_MS))
                if kLo <= kHi
                    hit := 1
        // A hit is knowledge. Absence of a hit is only knowledge if the WHOLE
        // bar lies inside the embedded schedule's range — outside it, "no
        // window matched" means "no window was loaded", which is not permission.
        st := hit == 1 ? LS_NEWS_BLOCKED :
             barStart < NEWS_FIRST_MS or barEnd > NEWS_LAST_MS
                 ? LS_NEWS_UNKNOWN : LS_NEWS_OK
    st

f_newsName(int s) =>
    s == LS_NEWS_BLOCKED ? "NEWS BLOCKED" :
     s == LS_NEWS_UNKNOWN ? "NEWS UNKNOWN" : "news permits"

// ── the ARM level ────────────────────────────────────────────────────────────
// NOT the entry. Production's `triggered_edge_trigger_thresholds` is the
// penetration that ARMS the order; the fill is still at the block edge
// (`triggered_edge_entry_level_pct`, which is 0). Drawing one and calling it the
// other would put the entry a quarter of the way into the block, which is not
// where production fills.
f_armLevel(bool isLong, float obTop, float obBottom) =>
    depth = obTop - obBottom
    need = depth * (TGT_TRIGGER_PCT / 100.0)
    isLong ? obTop - need : obBottom + need

f_entryLevel(bool isLong, float obTop, float obBottom) =>
    depth = obTop - obBottom
    isLong ? obTop - depth * (TGT_ENTRY_PCT / 100.0)
           : obBottom + depth * (TGT_ENTRY_PCT / 100.0)

// ── BAR-SCOPED CONTEXT, resolved ONCE ────────────────────────────────────────
//
// This is what makes the per-bar "IF TRIGGERED NOW" refresh cheap. Session,
// market state and news are properties of THE BAR, not of an individual block,
// so they are computed once here and every resting block reads them. The news
// scan in particular walks NEWS_COUNT windows; doing it per block would be that
// loop times the number of resting blocks, for an answer that cannot differ.
//
// What remains per block is four array reads in `f_resolveCell` — the cell
// depends on the bar's session and state plus the block's own structure tag and
// direction, and there are only four of those combinations.
ls_nowSessIdx = f_cohortSessionIdx()
ls_nowNews    = CTX_OK ? f_newsState(time, time_close) : LS_NEWS_UNKNOWN

// ── WHO OWNS THIS SETUP'S LIFECYCLE ──────────────────────────────────────────
//
// There are two authorities on this chart and they must never both render the
// same order block.
//
//   REPLAY  production's own recorded decision, resolved on 1-MINUTE data.
//           It knows the fill minute, the exit and the realised R.
//   LIVE    this layer, inferring from 15-minute bars. It cannot order the
//           minutes inside a bar, so some lifecycles are simply not provable
//           from what it can see.
//
// Where the recording covers a setup, production's answer is strictly better
// and the live layer stands down. Where it does not, the live layer is all
// there is.
//
// THREE CLAUSES, ALL REQUIRED — and the third is the one that is easy to miss.
// The recording may CONTAIN a setup that the chart is not currently DRAWING:
// `i_replayCount` shows the most recent N, and PENDING setups are hidden unless
// asked for. Ceding ownership on coverage alone would make those blocks vanish
// from both layers, which is a worse failure than drawing one twice.
//
// A STALE recording draws nothing (the generator empties it), so ownership
// falls back to LIVE automatically — but the clause is written explicitly
// because the fallback is the safety property, not an accident of the encoding.
f_replayOwns(int detMs) =>
    bool owns = false
    if RP_COUNT > 0 and not RP_STALE and i_showReplay
         and rp_first <= RP_COUNT - 1
        // Pine iterates DOWNWARD when `from > to`, so the bound above is a
        // guard, not decoration.
        for i = rp_first to RP_COUNT - 1
            if not owns
                st = array.get(RP_STATUS, i)
                shown = st != RP_ST_PENDING or i_showPending
                // One bar of tolerance: the chart and production can disagree
                // by a bar about which candle a block was detected on (L-02),
                // and an exact match would hand ownership to nobody.
                near = math.abs(array.get(RP_DETECTED, i) - detMs) <= RP_BAR_MS
                if shown and near
                    owns := true
    owns

// ── lifecycle phases ─────────────────────────────────────────────────────────
// BOX COLOUR IS THIS AND NOTHING ELSE. Eligibility lives on the label.
LS_PH_RESTING = 0   // BLUE   structural opportunity, no trade exists
LS_PH_ARMED   = 1   // BLUE   penetrated 25% — production's ORDER IS ARMED, but
                    //        no fill has been proven yet. Still an opportunity,
                    //        so still blue; the label says ARMED.
LS_PH_TRADE   = 2   // ORANGE a fill was proven and the fill-bar gates passed
LS_PH_NOTRADE = 3   // GREY   policy said no AT THE FILL, or it never armed
LS_PH_WIN     = 4   // GREEN  target reached first
LS_PH_LOSS    = 5   // RED    stop reached first
LS_PH_INVALID = 6   // PURPLE price went through the far edge before the entry
                    //        could fill — the block was never viable, which is
                    //        a different thing to know from "policy said no"
LS_PH_UNDECID = 7   // CYAN   armed, but 15-minute bars cannot prove WHICH bar
                    //        filled, and the candidate bars disagree about the
                    //        cell. Reported, never guessed.

f_phColor(int ph) =>
    ph == LS_PH_TRADE   ? COL_LC_ACTIVE :
     ph == LS_PH_WIN    ? COL_LC_WIN :
     ph == LS_PH_LOSS   ? COL_LC_LOSS :
     ph == LS_PH_INVALID ? COL_LC_INVALID :
     ph == LS_PH_UNDECID ? COL_LC_UNDECIDED :
     ph == LS_PH_NOTRADE ? COL_LC_NONE : COL_LC_LIVE

f_phLive(int ph) =>
    ph == LS_PH_RESTING or ph == LS_PH_ARMED

// ── what the HUD reads ───────────────────────────────────────────────────────
// Assigned at the CALL SITE below, never inside a function (CE10088). Declared
// here, before the first assignment, because Pine resolves top-to-bottom and an
// assignment to an undeclared name is CE10272.
var float  ls_lastRr    = na
var int    ls_lastOvSrc = LS_OV_PROD
var int    ls_lastSrc   = LS_SRC_NONE
var string ls_lastKey   = ""
var bool   ls_lastOk    = true
var string ls_lastWhy   = ""
var int    ls_lastNews  = LS_NEWS_UNKNOWN

type LiveOb
    box   obBox
    box   riskBox
    box   rewardBox
    line  entryLine
    line  stopLine
    line  targetLine
    line  armLine
    label tag
    float top
    float bottom
    float entry
    float arm
    float stop
    float target
    bool  isLong
    bool  isChoch
    int   obId
    int   phase
    int   bornBar
    int   armedBar
    int   resolvedBar
    bool  armBarStraddled
    // The ARM BAR's cell, held so it can be compared against the proven fill
    // bar's. When the two agree the answer is decidable even though the exact
    // fill BAR is not; when they disagree the setup is UNDECIDABLE.
    string armSess
    string armState
    float  armRr
    bool   armOk
    bool  rrBuilt
    // FROZEN AT RESOLUTION — the authoritative execution context, captured on
    // the bar production would have evaluated. Empty while the block rests.
    string finalSess
    string finalState
    float  finalRr
    bool   finalOk
    string finalWhy
    int    finalNews

var array<LiveOb> lo_all = array.new<LiveOb>()

// Each entry holds 3 boxes, 4 lines and 1 label. With the default cap of 40
// that is 120 boxes, 160 lines and 40 labels against Pine's 500-per-type
// ceiling, which is shared with the replay layer and the structure markers
// (limitation L-08).
f_loRetire(LiveOb o) =>
    box.delete(o.obBox)
    box.delete(o.riskBox)
    box.delete(o.rewardBox)
    line.delete(o.entryLine)
    line.delete(o.stopLine)
    line.delete(o.targetLine)
    line.delete(o.armLine)
    label.delete(o.tag)

// ── the risk-reward tool ─────────────────────────────────────────────────────
//
// CREATED ONCE per block, then MOVED. The previous version deleted and rebuilt
// three boxes and three lines on every bar of every live block; with a per-bar
// provisional refresh that would be six object churns per block per bar. Pine
// can move a box or a line in place, so it does.
//
// Visibility is carried by TRANSPARENCY, not by deletion, for the same reason:
// a block that flips between NOW TRADE and NOW BLOCK as the session rolls would
// otherwise create and destroy its geometry repeatedly.
LS_HIDDEN = 100

f_rrBuild(LiveOb o) =>
    x0 = box.get_right(o.obBox)
    x1 = x0 + i_rrWidthBars
    o.riskBox   := box.new(x0, o.entry, x1, o.stop, bgcolor = na,
         border_color = na, border_width = 1)
    o.rewardBox := box.new(x0, o.entry, x1, o.entry, bgcolor = na,
         border_color = na, border_width = 1)
    o.entryLine  := line.new(x0, o.entry,  x1, o.entry,  color = na)
    o.stopLine   := line.new(x0, o.stop,   x1, o.stop,   color = na)
    o.targetLine := line.new(x0, o.entry,  x1, o.entry,  color = na)
    o.rrBuilt := true
    // A bare expression as the last line, not the assignment above it: a Pine
    // function's return is its last EXPRESSION, and leaving an assignment there
    // is the shape that produced CE10172 the last time (tuple arity), so the
    // fragment states the return explicitly everywhere.
    o.rrBuilt

// `provisional` picks the whole visual register: dashed lines and fainter areas
// for a preview that may still change, solid and stronger once the decision is
// production's actual one. `muted` is the NEWS UNKNOWN register — visible,
// because the levels are what the operator came to inspect, but unmistakably
// not a confirmation.
f_rrPaint(LiveOb o, bool visible, bool provisional, bool muted) =>
    if o.rrBuilt
        x0 = box.get_right(o.obBox)
        x1 = x0 + i_rrWidthBars
        tgt = na(o.target) ? o.entry : o.target
        box.set_lefttop(o.riskBox, x0, math.max(o.entry, o.stop))
        box.set_rightbottom(o.riskBox, x1, math.min(o.entry, o.stop))
        box.set_lefttop(o.rewardBox, x0, math.max(o.entry, tgt))
        box.set_rightbottom(o.rewardBox, x1, math.min(o.entry, tgt))
        line.set_xy1(o.entryLine, x0, o.entry)
        line.set_xy2(o.entryLine, x1, o.entry)
        line.set_xy1(o.stopLine, x0, o.stop)
        line.set_xy2(o.stopLine, x1, o.stop)
        line.set_xy1(o.targetLine, x0, tgt)
        line.set_xy2(o.targetLine, x1, tgt)

        showTarget = visible and not na(o.target)
        // THE AREAS ARE THE TRADE, the lines are the plan. A block that ended
        // without one — invalidated, or refused by the policy — never had a
        // risk or a reward, so it keeps its levels and loses its areas. While
        // the block RESTS the areas are the point of the preview, so they stay.
        showArea = f_phLive(o.phase) or o.phase == LS_PH_TRADE
             or o.phase == LS_PH_WIN or o.phase == LS_PH_LOSS
        // THE FILL IS ADJUSTABLE, and clear by default. Filled areas are the
        // fastest way to read a ratio, and they are also the third translucent
        // layer over the candles after the session shading and the market-state
        // band. Which of those matters depends on the chart, so `i_rrFill` is a
        // dial; the BORDERS are always drawn, so the geometry reads at 100.
        //
        // SOLID LINES, ALWAYS. A broken edge reads as uncertainty about the
        // LEVEL, and the level is never what is uncertain — it is arithmetic.
        // Provisional-vs-final and confirmed-vs-not are carried by
        // TRANSPARENCY, so nothing is lost by making every line solid.
        fade = muted ? 30 : provisional ? 18 : 0
        // The fill is the operator's dial (fragment 10). It still respects the
        // fade, so a provisional preview stays fainter than a frozen decision
        // at every setting, and a hidden tool is hidden at every setting.
        rf = math.min(100, i_rrFill + fade)
        box.set_bgcolor(o.riskBox, visible and showArea
             ? color.new(COL_STOP, rf) : color.new(COL_STOP, LS_HIDDEN))
        box.set_bgcolor(o.rewardBox, showTarget and showArea
             ? color.new(COL_TARGET, math.min(100, rf + 2))
             : color.new(COL_TARGET, LS_HIDDEN))
        box.set_border_color(o.riskBox, visible and showArea
             ? color.new(COL_STOP, 55 + fade) : color.new(COL_STOP, LS_HIDDEN))
        box.set_border_color(o.rewardBox, showTarget and showArea
             ? color.new(COL_TARGET, 55 + fade) : color.new(COL_TARGET, LS_HIDDEN))
        line.set_color(o.entryLine, visible
             ? color.new(COL_ENTRY, 20 + fade) : color.new(COL_ENTRY, LS_HIDDEN))
        line.set_color(o.stopLine, visible
             ? color.new(COL_STOP, 25 + fade) : color.new(COL_STOP, LS_HIDDEN))
        line.set_color(o.targetLine, showTarget
             ? color.new(COL_TARGET, 25 + fade) : color.new(COL_TARGET, LS_HIDDEN))
        line.set_style(o.entryLine, line.style_solid)
        line.set_style(o.stopLine, line.style_solid)
        line.set_style(o.targetLine, line.style_solid)

// ── the label ────────────────────────────────────────────────────────────────
//
// TWO LINES, deliberately. The first says WHEN the statement applies (NOW or
// FINAL) and the context it applies under; the second says the decision. A
// single-line label cannot distinguish "would trade" from "did trade", and that
// distinction is the entire point of this fragment.
f_liveText(LiveOb o, float rr, bool ok, int news, string sess, string state) =>
    string head = ""
    string body = ""
    if f_phLive(o.phase)
        // ARMED is still a preview, not a decision: production has an armed
        // order and has not filled it, so session/state/RR are still whatever
        // the CURRENT bar says and can still move before the fill.
        head := (o.phase == LS_PH_ARMED ? "ARMED · " : "NOW · ")
             + sess + " · " + state
        tail = o.phase == LS_PH_ARMED ? " · awaiting fill" : " · provisional"
        body := not TGT_PRESENT ? "NO TABLE" :
             news == LS_NEWS_BLOCKED ? "NEWS BLOCKED" + tail :
             not ok ? "BLOCK" + tail :
             na(rr) ? "NO TARGET" + tail :
             str.tostring(rr, "0.00") + "R" +
                 (news == LS_NEWS_UNKNOWN ? " · NEWS UNKNOWN, not confirmed"
                                          : tail)
    else
        head := "FINAL · " + sess + " · " + state
        // The news qualification is a SUFFIX, never the verdict. It says the
        // chart could not check that gate — not what production did.
        string q = o.finalNews == LS_NEWS_UNKNOWN ? " · unconfirmed" : ""
        body := o.phase == LS_PH_UNDECID ? "UNDECIDABLE · " + o.finalWhy :
             o.phase == LS_PH_WIN ? "WIN (chart) +" +
                     str.tostring(o.finalRr, "0.00") + "R" + q :
             o.phase == LS_PH_LOSS ? "LOSS (chart) -1.00R" + q :
             o.phase == LS_PH_TRADE ? "TRADE " +
                     str.tostring(o.finalRr, "0.00") + "R · open" + q :
             o.finalWhy == "invalidated" ? "INVALIDATED · no trade" :
             o.finalWhy == "never armed" ? "NEVER ARMED · no trade" :
             o.finalNews == LS_NEWS_BLOCKED ? "NEWS BLOCKED · no trade" :
             "BLOCK · no trade"
    head + "\n" + body

f_liveTip(LiveOb o, float prodRr, float rr, int src, int ovSrc, bool ok,
     string why, int news, string sess, string state, string cellKey) =>
    resting = f_phLive(o.phase)
    // PROVENANCE FIRST. Nothing below is production's answer — it is this
    // layer's reading of 15-minute bars, and the reader is told so before they
    // read any of it.
    // The provenance sits ON the opening line of the return expression, not
    // above it. Pine ends a statement where the next line is indented the SAME
    // amount, so a trailing `+` followed by a same-indent line is CE10156 —
    // "end of line without line continuation". It reads as two statements.
    "source: LIVE · M15 inference\n\n" + (o.phase == LS_PH_ARMED
         ? "ARMED, NOT FILLED. Production's order is armed — price penetrated " +
           str.tostring(TGT_TRIGGER_PCT, "0.#") + "% into the block — but no " +
           "fill has been proven yet. Production fills on the first 1-minute " +
           "candle at least " + str.tostring(TGT_DELAY_CANDLES) + " candles " +
           "after the arm whose range STRADDLES the entry, and that may be " +
           "hours away. Everything below is still the CURRENT bar's context " +
           "and can still change before the fill.\n"
     : resting
         ? "PROVISIONAL — what production WOULD do if this block triggered on " +
           "THIS bar. It is not a prediction and not a resting broker order: " +
           "production holds the candidate internally and evaluates session, " +
           "market state and target only at the FILL candle, which may be days " +
           "away and in a different session and state.\n"
     : o.phase == LS_PH_UNDECID
         ? "UNDECIDABLE — " + o.finalWhy + ".\n\n" +
           (o.finalWhy == "M15 cannot order fill vs invalidation"
                ? "This bar's range BOTH contains the entry and breaches the " +
                  "far edge, so it holds production's fill and production's " +
                  "INVALIDATED_BEFORE_EDGE_ENTRY at once. Which came first is " +
                  "a property of the minutes inside it."
                : "The bar that armed this setup could itself have contained " +
                  "the fill, and it disagrees with the first provable fill bar " +
                  "about the session, the state or the target — so the chart " +
                  "cannot say which cell production used.") +
           " 15-minute bars cannot order their own minutes (L-21) and nothing " +
           "here will guess.\n"
         : "FINAL — the context read at the bar the fill was PROVEN, which is " +
           "what production reads at the fill candle.\n") +
     "\nOB " + str.tostring(o.obId) + "  " +
         (o.isLong ? "bullish Long" : "bearish Short") + "  " +
         (o.isChoch ? "CHoCH" : "BOS") +
     "\nsession   " + sess + (resting ? "  (now)" : "  (at trigger)") +
     "\nstate     " + state +
     "\nconfig    " + cellKey +
     "\ncfg hash  " + TGT_CONFIG_HASH +
     "\n\nproduction target  " +
         (na(prodRr) ? "none" : str.tostring(prodRr, "0.00") + "R") +
         "  (" + f_srcName(src) + ")" +
     "\neffective target   " +
         (na(rr) ? "none" : str.tostring(rr, "0.00") + "R") +
     "\noverride source    " + f_ovName(ovSrc) +
     // TWO LEVELS, NEVER ONE. Production arms at 25% penetration and then fills
     // back at the edge, so the tooltip names both and says which is which.
     "\n\narm  (" + str.tostring(TGT_TRIGGER_PCT, "0.#") + "% into block)  " +
         str.tostring(o.arm, format.mintick) +
     "\nentry / fill level      " + str.tostring(o.entry, format.mintick) +
         (TGT_ENTRY_PCT == 0 ? "   (block edge)" :
             "   (" + str.tostring(TGT_ENTRY_PCT, "0.#") + "% into block)") +
     "\nstop      " + str.tostring(o.stop, format.mintick) +
     "\ntarget    " + (na(o.target) ? "-" :
         str.tostring(o.target, format.mintick)) +
     "\nrisk      " + str.tostring(math.abs(o.entry - o.stop) / OB_PIP_SIZE,
         "0.0") + " pips" +
     "\n\ncohort/state  " + (ok ? "allowed" : "BLOCKED") +
         (why != "" ? " (" + why + ")" : "") +
     "\nnews          " + f_newsName(news) +
         (news == LS_NEWS_UNKNOWN and NEWS_PRESENT
              ? "  (beyond the embedded schedule, " + NEWS_LAST_TXT + ")" : "") +
     "\nverdict       " + (ok and news == LS_NEWS_OK ? "ALLOWED"
                                : "not allowed / not known") +
     (o.phase == LS_PH_WIN or o.phase == LS_PH_LOSS
          ? "\n\nOUTCOME IS THE CHART'S OWN first-touch verdict — target hit " +
            "before stop, or stop before target — NOT production's exit chain. " +
            "Break-even, protection and news flatten are not modelled here. " +
            "For production's real outcome use the replay layer."
          : "") +
     "\n\nLIMITS  production decides per MINUTE (L-21); this bar is 15, so the " +
     "trigger bar is the earliest bar production could have filled, not the " +
     "minute it did. Chart feed is mid; production is bid."

// ── create, on the bar the chart derives a block ─────────────────────────────
//
// Creation records STRUCTURE ONLY — bounds, side, tag, entry, arm, stop. No
// target, no session, no state, no eligibility: none of those are decided yet,
// and writing them here is what produced the label that lied.
f_liveCreate(bool isLong, bool isChoch, float obTop, float obBottom,
     int obIdx, int obId) =>
    entry = f_entryLevel(isLong, obTop, obBottom)
    arm   = f_armLevel(isLong, obTop, obBottom)
    stop  = isLong ? obBottom - TGT_STOP_BUFFER : obTop + TGT_STOP_BUFFER

    LiveOb o = LiveOb.new(
         obBox = box.new(obIdx, obTop, bar_index + i_liveTailBars, obBottom,
              border_color = color.new(COL_LC_LIVE, 25), border_width = 1,
              bgcolor = color.new(COL_LC_LIVE, 90)),
         riskBox = na, rewardBox = na,
         entryLine = na, stopLine = na, targetLine = na,
         // The arm level spans the block from the origin bar, dotted and in its
         // own colour so it can never be read as the entry.
         armLine = line.new(obIdx, arm, bar_index + i_liveTailBars, arm,
              color = i_showArm ? color.new(COL_ARM, 30)
                                : color.new(COL_ARM, LS_HIDDEN),
              style = line.style_dotted),
         tag = label.new(obIdx, isLong ? obBottom : obTop, "",
              style = isLong ? label.style_label_up : label.style_label_down,
              color = color.new(COL_LC_LIVE, 20), textcolor = color.black,
              size = size.tiny),
         top = obTop, bottom = obBottom, entry = entry, arm = arm, stop = stop,
         target = na, isLong = isLong, isChoch = isChoch, obId = obId,
         phase = LS_PH_RESTING, bornBar = bar_index, armedBar = na,
         resolvedBar = na, armBarStraddled = false,
         armSess = "", armState = "", armRr = na, armOk = true,
         rrBuilt = false,
         finalSess = "", finalState = "", finalRr = na, finalOk = true,
         finalWhy = "", finalNews = LS_NEWS_UNKNOWN)
    array.push(lo_all, o)
    if array.size(lo_all) > i_liveMaxObs
        f_loRetire(array.shift(lo_all))
    o

// The block's origin bar. `s5_last_origin_back` is `na` until the first
// candidate exists, and `bar_index - na` is `na` — which Pine would happily pass
// to `box.new` and draw nothing.
f_lsOriginBar() =>
    na(s5_last_origin_back) ? bar_index : bar_index - s5_last_origin_back

if CTX_OK and barClosed and i_showLive and s5_created_count > 0
     and (s5_last_side == 1 or s5_last_side == 2)
    // Nothing is created at all when the replay owns this setup. Suppressing
    // later would leave an orphan box to clean up and a window in which both
    // layers had drawn; not creating it is the only form with no such window.
    if not f_replayOwns(time)
        f_liveCreate(s5_last_side == 1, s5_last_tag == 2, s5_last_top,
             s5_last_bottom, f_lsOriginBar(), s5_last_ob_id)

// ── the per-bar pass: refresh previews, resolve triggers, settle outcomes ────
//
// WHERE THE WORK IS SPENT, AND WHY IT IS BOUNDED
//
// Every bar, every tracked block does a handful of float comparisons and two
// setter calls — that is the lifecycle, and it has to run on every bar or the
// box would not grow and a trigger would be missed.
//
// The EXPENSIVE part — resolving the cell, building a two-line label and a
// forty-line tooltip — runs only where its answer can be read:
//
//   * on the bar a block RESOLVES, once, and then never again;
//   * on a phase change to WIN/LOSS, once;
//   * for a RESTING block, only within one bar of the right-hand edge, because
//     "IF TRIGGERED NOW" is a statement about the current bar and means nothing
//     rendered onto a bar from March.
//
// Without that gate a per-bar provisional refresh is ~40 blocks x ~40 string
// concatenations x every bar on the chart, which is how a Pine script hits its
// execution-time limit.
lsAtRight = bar_index >= last_bar_index - 1

if CTX_OK and barClosed and i_showLive and array.size(lo_all) > 0
    nowSess  = sessKey
    nowState = f_stateName()

    for i = 0 to array.size(lo_all) - 1
        LiveOb o = array.get(lo_all, i)

        // ── 1. LIFECYCLE ────────────────────────────────────────────────────
        //
        // PRODUCTION'S ORDER OF EVENTS, which this now follows instead of
        // collapsing:
        //
        //     resting -> ARM (25% penetration) -> wait `delay` candles
        //             -> a candle STRADDLES the entry -> FILL
        //             -> and only THEN resolve session, state, cohort, RR
        //
        // The previous version treated the ARM bar as the fill and froze the
        // execution cell there. Measured across every filled trade production
        // has on record (659): the arm and the fill land on a DIFFERENT 15m bar
        // 49.2% of the time, in a different session 8.2% of the time, on a
        // different UTC day 3.0% of the time — so 8.6% would have selected a
        // different matrix cell. That is a parity defect, not a presentation
        // one.
        //
        // WHAT 15-MINUTE BARS CAN AND CANNOT PROVE. Production fills on the
        // first 1-minute candle at index >= arm + `triggered_edge_candle_delays`
        // whose range straddles the entry. A 15-minute bar that BOTH arms and
        // straddles hides the ordering of its own minutes, so a fill inside it
        // can be neither proved nor excluded. A LATER straddling bar is proof:
        // one bar is 15 minutes and the delay is 3, so the delay is certainly
        // satisfied. Nothing here fabricates the minute (L-21).
        //
        //   INVALIDATED  price through the FAR edge — production's
        //                INVALIDATED_BEFORE_EDGE_ENTRY, checked while resting
        //                AND while armed.
        //
        // A finished block is never re-tested. The first version guarded the
        // extension with `bar_index <= box.get_right(...)`, which never stops:
        // the right edge is always `bar_index + tail`.
        wasLive = f_phLive(o.phase)
        justArmed = false
        justFilled = false
        justAmbiguous = false
        justResolved = false
        if wasLive
            if bar_index > o.bornBar
                armed = o.isLong ? low <= o.arm : high >= o.arm
                through = o.isLong ? low < o.bottom : high > o.top
                // The fill test IS production's: the candle's range must contain
                // the entry level, not merely touch the block.
                straddle = low <= o.entry and high >= o.entry
                if through
                    justResolved := true
                    o.resolvedBar := bar_index
                    // THE SAME BAR CANNOT BE BOTH, AND CANNOT BE ORDERED.
                    //
                    // A bar whose range contains the entry AND breaches the far
                    // edge holds both of production's outcomes: the fill that
                    // makes it a trade, and the INVALIDATED_BEFORE_EDGE_ENTRY
                    // that makes it a non-trade. Which happened first is a
                    // property of the MINUTES inside the bar, and OHLC does not
                    // carry it.
                    //
                    // Measured on 2026-07-02 08:00 (Long CHoCH): the 13:00 bar
                    // holds both, and the 1-minute detail shows the fill at
                    // 13:06 and the breach at 13:11 — production took the LOSS.
                    // Preferring `through` called that INVALIDATED, which is the
                    // chart claiming an ordering it cannot see.
                    //
                    // Same principle as the arm-bar case: when 15-minute bars
                    // cannot prove the 1-minute order, say so.
                    if straddle
                        justAmbiguous := true
                        o.phase := LS_PH_UNDECID
                        o.finalWhy := "M15 cannot order fill vs invalidation"
                    else
                        // No fill was possible in this bar — the range never
                        // reached the entry — so the breach is the only thing
                        // that happened and it is provable.
                        o.phase := LS_PH_INVALID
                        o.finalWhy := "invalidated"
                else if o.phase == LS_PH_RESTING
                    if armed
                        justArmed := true
                        o.phase := LS_PH_ARMED
                        o.armedBar := bar_index
                        // Almost always true — the approach that penetrates 25%
                        // has crossed the edge on the way in — which is exactly
                        // why the arm bar cannot be assumed to be the fill.
                        o.armBarStraddled := straddle
                else if straddle
                    // PROVEN. This bar is at least one full bar after the arm,
                    // so the delay is satisfied and the range contains the
                    // entry. This is the earliest fill the chart can prove.
                    justFilled := true
                    justResolved := true
                    o.resolvedBar := bar_index
            box.set_right(o.obBox, bar_index + i_liveTailBars)
            line.set_x2(o.armLine, bar_index + i_liveTailBars)
            // Honoured on every bar, not only at creation, so toggling the
            // setting takes effect without reloading the script.
            line.set_color(o.armLine, i_showArm ? color.new(COL_ARM, 30)
                 : color.new(COL_ARM, LS_HIDDEN))

        // ── 2. THE CELL, resolved against the RIGHT bar ─────────────────────
        //
        // While resting this is the CURRENT bar's context, recomputed every bar
        // — that is the "if triggered now" preview. On the trigger bar it is
        // computed once more and then FROZEN, because that is the bar production
        // would have evaluated and nothing after it may change the answer.
        float useRr = na
        bool useOk = true
        string useWhy = ""
        int useNews = LS_NEWS_UNKNOWN
        string useSess = ""
        string useState = ""
        float prodRr = na
        int cellSrc = LS_SRC_NONE
        int ovSrc = LS_OV_PROD

        // Only where the answer can be read — see the note above the loop.
        bool doPaint = justResolved or justArmed or (wasLive and lsAtRight)

        if wasLive and doPaint
            [pRr, cSrc, cOk, cWhy] = f_resolveCell(ls_nowSessIdx, o.isChoch,
                 o.isLong)
            [eRr, oSrc] = f_applyOverrides(pRr, ls_nowSessIdx, o.isChoch,
                 o.isLong)
            prodRr := pRr
            cellSrc := cSrc
            ovSrc := oSrc
            useRr := eRr
            useOk := cOk
            useWhy := cWhy
            useNews := ls_nowNews
            useSess := nowSess
            useState := nowState
            risk = math.abs(o.entry - o.stop)
            o.target := na(eRr) or risk <= 0 ? na
                 : (o.isLong ? o.entry + risk * eRr : o.entry - risk * eRr)

            // ARMING RESOLVES NOTHING. It only records the cell as it stood
            // on the arm bar, so that when a fill is finally proven the two can
            // be compared and the chart can say whether the answer depended on
            // which of them filled.
            if justArmed
                o.armSess := nowSess
                o.armState := nowState
                o.armRr := eRr
                o.armOk := cOk

            if justAmbiguous
                // No verdict, but the context is still worth carrying: it is
                // the bar the setup ended on, and the tooltip names it.
                o.finalSess := nowSess
                o.finalState := nowState
                o.finalRr := eRr
                o.finalNews := ls_nowNews
                o.finalOk := cOk

            if justFilled
                // THE FILL BAR IS THE AUTHORITY. Session, market state, cohort
                // eligibility and the target are all read HERE, which is what
                // execution.py:2882/2950/2965/3008 do at the fill candle.
                o.finalSess := nowSess
                o.finalState := nowState
                o.finalRr := eRr
                o.finalNews := ls_nowNews
                o.finalOk := cOk
                o.finalWhy := cWhy
                // WHAT COUNTS AS A TRADE, AND WHAT UNKNOWN NEWS DOES.
                //
                // A KNOWN blackout is knowledge: production would have refused,
                // so no order exists and the block ends grey. Cohort or state
                // BLOCK is knowledge too, and ends the same way.
                //
                // NEWS UNKNOWN IS NOT KNOWLEDGE. Past the embedded schedule the
                // chart cannot evaluate that gate at all, and forcing it to a
                // terminal "no trade" is the box claiming something it does not
                // know. So an unevaluable gate does not decide the lifecycle;
                // the label carries "unconfirmed" instead. It never says
                // ALLOWED.
                tradeable = cOk and ls_nowNews != LS_NEWS_BLOCKED
                     and not na(eRr)
                // UNDECIDABLE, AND ONLY WHEN IT MATTERS. If the arm bar could
                // itself have filled, there are two candidate fill bars. When
                // they agree on session, state, eligibility and target the
                // answer is the same either way and the setup resolves; when
                // they disagree the chart cannot say which cell production
                // used, and says so rather than picking one.
                sameCell = not o.armBarStraddled
                     or (o.armSess == nowSess and o.armState == nowState
                         and o.armOk == cOk
                         and (na(o.armRr) ? na(eRr) : o.armRr == eRr))
                o.phase := not sameCell ? LS_PH_UNDECID :
                     tradeable ? LS_PH_TRADE : LS_PH_NOTRADE
                if not sameCell
                    o.finalWhy := "M15 cannot prove which bar filled"
        else if not wasLive
            useRr := o.finalRr
            useOk := o.finalOk
            useWhy := o.finalWhy
            useNews := o.finalNews
            useSess := o.finalSess
            useState := o.finalState
            prodRr := o.finalRr
            cellSrc := LS_SRC_BASE

        // ── 3. OUTCOME, for a trade that is actually open ────────────────────
        //
        // Evaluated from the bar AFTER the trigger: on the trigger bar itself
        // the fill and any same-bar exit cannot be ordered on a 15-minute chart.
        // LOSS wins a tie for the same reason — it is the conservative reading.
        //
        // This is the CHART's first-touch verdict, not production's exit chain
        // (break-even, protection, news flatten, time stops are not modelled),
        // and the label and tooltip both say so. Production's real outcomes are
        // the replay layer's job.
        if o.phase == LS_PH_TRADE and not justFilled
             and bar_index > o.resolvedBar
             and not na(o.target)
            hitStop = o.isLong ? low <= o.stop : high >= o.stop
            hitTgt  = o.isLong ? high >= o.target : low <= o.target
            if hitStop or hitTgt
                o.phase := hitStop ? LS_PH_LOSS : LS_PH_WIN
                doPaint := true
                useRr := o.finalRr
                useOk := o.finalOk
                useWhy := o.finalWhy
                useNews := o.finalNews
                useSess := o.finalSess
                useState := o.finalState
                prodRr := o.finalRr
                cellSrc := LS_SRC_BASE

        // ── 4. PAINT ────────────────────────────────────────────────────────
        if doPaint
            col = f_phColor(o.phase)
            box.set_bgcolor(o.obBox, color.new(col, 90))
            box.set_border_color(o.obBox, color.new(col, 25))
            label.set_color(o.tag, color.new(col, 20))

            cellKey = (ls_nowSessIdx >= 0
                 ? array.get(TGT_SESSION_NAME, ls_nowSessIdx) : "?") +
                 " | " + (o.isChoch ? "CHoCH" : "BOS") + " " +
                 (o.isLong ? "Long" : "Short")
            label.set_text(o.tag, f_liveText(o, useRr, useOk, useNews, useSess,
                 useState))
            label.set_tooltip(o.tag, f_liveTip(o, prodRr, useRr, cellSrc, ovSrc,
                 useOk, useWhy, useNews, useSess, useState, cellKey))
            if i == array.size(lo_all) - 1
                ls_lastRr := useRr
                ls_lastOvSrc := ovSrc
                ls_lastSrc := cellSrc
                ls_lastOk := useOk
                ls_lastWhy := useWhy
                ls_lastKey := cellKey
                ls_lastNews := useNews

        // ── 5. THE RISK-REWARD TOOL ─────────────────────────────────────────
        //
        // Shown when there is a target to show. A NOW: BLOCK preview has no
        // executable target, so its geometry is hidden and the label says why —
        // but THE BLOCK ITSELF STAYS, blue and structurally alive, because
        // eligibility and existence are different things.
        //
        // NEWS UNKNOWN does NOT hide it. The calculated entry/stop/target is
        // what an operator opens this chart to inspect, so it is drawn muted and
        // dashed and labelled NOT CONFIRMED rather than removed.
        if i_showLiveRr and doPaint
            if not o.rrBuilt and not na(o.target)
                f_rrBuild(o)
            resting = f_phLive(o.phase)
            // While the block rests the tool travels with its right edge; once
            // the block resolves both freeze together, which parks the geometry
            // at the interaction that produced it — and leaves it there, so a
            // completed trade can still be inspected weeks later.
            visible = not na(o.target) and (useOk or not resting)
                 and useNews != LS_NEWS_BLOCKED
            f_rrPaint(o, visible, resting, useNews == LS_NEWS_UNKNOWN)

// ─────────────────────────────────────────────────────────────────────────────
// 60 — PARITY OUTPUT
//
// Pine cannot write files, so the only way to get per-bar values OUT of
// TradingView for comparison is to plot them. These plots are the machine-
// readable half of verification: every one has an exact counterpart field in the
// Python trace, and all are NUMERIC — comparing background colours by eye is not
// verification.
//
// `display.data_window` keeps them off the chart while still exposing them in
// the Data Window (and in exported chart data), so the oracle stays readable.
//
// PACKED TRANSPORT
// TradingView caps a script at 64 plots and raises RE10140 at RUNTIME on a live
// chart — the compiler does not catch it. Small-integer fields therefore travel
// several-to-a-plot. Every multiplier, width and offset below is GENERATED from
// tools/oracle/session_codes.py::PACKED_SPEC, which is also what the comparator
// decodes with; there is deliberately no hand-written radix arithmetic here.
// `f_packv` (fragment 10) applies the offset and clamps, so an overflow fails
// the comparison rather than corrupting a neighbouring field.
//
// HOW TO COMPARE  (see docs/tradingview_visual_oracle_maintenance.md §S1)
//   1. python -m tools.oracle.export_trace ... --output trace.json
//   2. open the same fixture window on TradingView at the same timeframe
//   3. export chart data, then run tools.oracle.compare_stages — it unpacks
//      through PACKED_SPEC and diffs field by field
// ─────────────────────────────────────────────────────────────────────────────

// ── S1 ───────────────────────────────────────────────────────────────────────
plot(utcEpochMs,           "oracleBarEpochMs",     display = display.data_window)
plot(dayKey,               "oracleDayKey",         display = display.data_window)
plot(barsSinceTransition,  "oracleBarsSinceTrans", display = display.data_window)
// PACKED: session · utcHour · transition · fallback · context.
plot(f_packv(sessCode,             PACK_S1_W0, PACK_S1_O0) * PACK_S1_0 +
     f_packv(utcHour,              PACK_S1_W1, PACK_S1_O1) * PACK_S1_1 +
     f_packv(sessTransitionCode,   PACK_S1_W2, PACK_S1_O2) * PACK_S1_2 +
     f_packv(sessIsFall ? 1 : 0,   PACK_S1_W3, PACK_S1_O3) * PACK_S1_3 +
     f_packv(CTX_CODE,             PACK_S1_W4, PACK_S1_O4) * PACK_S1_4,
     "oracleS1Codes", display = display.data_window)
plot(barClosed ? 1 : 0,    "oracleBarClosed",      display = display.data_window)
plot(ORACLE_BUILD_CODE,    "oracleBuildCode",      display = display.data_window)

// ── S2 ───────────────────────────────────────────────────────────────────────
// Prices are compared under a tolerance, not exactly: TradingView's CSV export
// rounds, and the feeds differ. The BRANCH flags are exact — those are decisions,
// not measurements — and travel packed.
plot(s2_tr,                "oracleTrueRange",      display = display.data_window)
plot(s2_atr,               "oracleAtr",            display = display.data_window)
plot(s2_atr_prev,          "oracleAtrPrev",        display = display.data_window)
plot(s2_measure,           "oracleVolMeasure",     display = display.data_window)
plot(s2_parsed_high,       "oracleParsedHigh",     display = display.data_window)
plot(s2_parsed_low,        "oracleParsedLow",      display = display.data_window)
// PACKED: volatility flip · ATR warm-up.
plot(f_packv(s2_high_vol  ? 1 : 0, PACK_S2_W0, PACK_S2_O0) * PACK_S2_0 +
     f_packv(s2_atr_warm  ? 1 : 0, PACK_S2_W1, PACK_S2_O1) * PACK_S2_1,
     "oracleS2Codes", display = display.data_window)

// ── S3 ───────────────────────────────────────────────────────────────────────
// PACKED: ready · newLegHigh · newLegLow · currentLeg · legChange · swingCreated ·
// hasSwingHigh · swingHighCrossed · hasSwingLow · swingLowCrossed.
// legChange is -1..+1 and is lifted by its GENERATED offset, not a literal +1.
plot(f_packv(s3_ready ? 1 : 0,                PACK_S3_W0, PACK_S3_O0) * PACK_S3_0 +
     f_packv(s3_new_leg_high ? 1 : 0,         PACK_S3_W1, PACK_S3_O1) * PACK_S3_1 +
     f_packv(s3_new_leg_low ? 1 : 0,          PACK_S3_W2, PACK_S3_O2) * PACK_S3_2 +
     f_packv(s3_current_leg,                  PACK_S3_W3, PACK_S3_O3) * PACK_S3_3 +
     f_packv(s3_leg_change,                   PACK_S3_W4, PACK_S3_O4) * PACK_S3_4 +
     f_packv(s3_created,                      PACK_S3_W5, PACK_S3_O5) * PACK_S3_5 +
     f_packv(na(s3_swing_high_level) ? 0 : 1, PACK_S3_W6, PACK_S3_O6) * PACK_S3_6 +
     f_packv(s3_swing_high_crossed ? 1 : 0,   PACK_S3_W7, PACK_S3_O7) * PACK_S3_7 +
     f_packv(na(s3_swing_low_level) ? 0 : 1,  PACK_S3_W8, PACK_S3_O8) * PACK_S3_8 +
     f_packv(s3_swing_low_crossed ? 1 : 0,    PACK_S3_W9, PACK_S3_O9) * PACK_S3_9,
     "oracleS3Codes", display = display.data_window)
plot(s3_swing_high_level,        "oracleSwingHigh",     display = display.data_window)
plot(s3_swing_high_seq,          "oracleSwingHighSeq",  display = display.data_window)
plot(s3_swing_low_level,         "oracleSwingLow",      display = display.data_window)
plot(s3_swing_low_seq,           "oracleSwingLowSeq",   display = display.data_window)

// ── S4 ───────────────────────────────────────────────────────────────────────
// PACKED: bias · structure event · event count.
// `oracleTrend` USED to be plotted here. It was a pure duplicate: Python read
// `swing_trend_bias` for both it and `oracleBias`, and
// `s4_trend = bias == BIAS_BULLISH ? 1 : bias == BIAS_BEARISH ? -1 : 0` is the
// identity map when the contract pins BULLISH = 1 and BEARISH = -1. It cost a
// plot and proved nothing `oracleBias` did not.
plot(f_packv(s4_bias,        PACK_S4_W0, PACK_S4_O0) * PACK_S4_0 +
     f_packv(s4_event_code,  PACK_S4_W1, PACK_S4_O1) * PACK_S4_1 +
     f_packv(s4_event_count, PACK_S4_W2, PACK_S4_O2) * PACK_S4_2,
     "oracleS4Codes", display = display.data_window)
plot(s4_broken_level,      "oracleBrokenLevel",    display = display.data_window)
plot(s4_history_warn ? 1 : 0, "oracleHistoryWarn", display = display.data_window)

// ── S5 ───────────────────────────────────────────────────────────────────────
// `oracleObId` is EXPECTED to differ from production's (limitation L-05): the
// counter starts at the first bar of loaded history, not in 2015. It is exported
// so the SEQUENCE can be checked — dense, gap-free, incremented only on append.
// PACKED (per-bar decisions, reset every bar): candidates · created · reject ·
// side · tag.
plot(f_packv(s5_candidate_count, PACK_S5A_W0, PACK_S5A_O0) * PACK_S5A_0 +
     f_packv(s5_created_count,   PACK_S5A_W1, PACK_S5A_O1) * PACK_S5A_1 +
     f_packv(s5_last_reject,     PACK_S5A_W2, PACK_S5A_O2) * PACK_S5A_2 +
     f_packv(s5_last_side,       PACK_S5A_W3, PACK_S5A_O3) * PACK_S5A_3 +
     f_packv(s5_last_tag,        PACK_S5A_W4, PACK_S5A_O4) * PACK_S5A_4,
     "oracleS5Codes", display = display.data_window)
// PACKED (latched identity, in bars back from the break bar): originBack ·
// pivotBack. `na` before the first candidate maps to code 0 via the generated
// offset — see f_packv.
plot(f_packv(s5_last_origin_back, PACK_S5B_W0, PACK_S5B_O0) * PACK_S5B_0 +
     f_packv(s5_last_pivot_back,  PACK_S5B_W1, PACK_S5B_O1) * PACK_S5B_1,
     "oracleS5Ids", display = display.data_window)
plot(s5_last_top,          "oracleObTop",         display = display.data_window)
plot(s5_last_bottom,       "oracleObBottom",      display = display.data_window)
plot(s5_last_width,        "oracleObWidthPips",   display = display.data_window)
plot(s5_last_ob_id,        "oracleObId",          display = display.data_window)
plot(s5_active_count,      "oracleObActive",      display = display.data_window)
plot(s5_last_break_level,  "oracleObBreakLevel",  display = display.data_window)
// Bounded summary of the ACCEPTED inventory. bar_index is feed-local (L-09) and
// ob_id is history-local (L-05), so neither can be compared directly — but a
// running total over every accepted bound can, and it fails loudly the moment a
// single box differs anywhere in the loaded window.
plot(s5_checksum,          "oracleObChecksum",    display = display.data_window)

// ── S6 ───────────────────────────────────────────────────────────────────────
// The DAILY values are those of the last COMPLETED UTC day — the one the current
// day's state was classified from. They are constant across every intraday bar
// of a day, which is what makes them comparable against a per-day Python panel.
plot(s6_srcKey,            "oracleRgSrcDay",      display = display.data_window)
plot(s6_dOpen,             "oracleRgDayOpen",     display = display.data_window)
plot(s6_dHigh,             "oracleRgDayHigh",     display = display.data_window)
plot(s6_dLow,              "oracleRgDayLow",      display = display.data_window)
plot(s6_dClose,            "oracleRgDayClose",    display = display.data_window)
plot(s6_dBars,             "oracleRgDayBars",     display = display.data_window)
plot(s6_fEma,              "oracleRgEma",         display = display.data_window)
plot(s6_fPxVsEma,          "oracleRgPxVsEma",     display = display.data_window)
plot(s6_fBasis,            "oracleRgBasis",       display = display.data_window)
plot(s6_fSd,               "oracleRgSd",          display = display.data_window)
plot(s6_fUpper,            "oracleRgUpper",       display = display.data_window)
plot(s6_fLower,            "oracleRgLower",       display = display.data_window)
plot(s6_fBbw,              "oracleRgBbw",         display = display.data_window)
plot(s6_fAdx,              "oracleRgAdx",         display = display.data_window)
// PACKED: trend · volatility · chop · state · prevState · validity.
plot(f_packv(s6_trendCode,     PACK_S6_W0, PACK_S6_O0) * PACK_S6_0 +
     f_packv(s6_volCode,       PACK_S6_W1, PACK_S6_O1) * PACK_S6_1 +
     f_packv(s6_chopCode,      PACK_S6_W2, PACK_S6_O2) * PACK_S6_2 +
     f_packv(s6_stateCode,     PACK_S6_W3, PACK_S6_O3) * PACK_S6_3 +
     f_packv(s6_prevStateCode, PACK_S6_W4, PACK_S6_O4) * PACK_S6_4 +
     f_packv(s6_validity,      PACK_S6_W5, PACK_S6_O5) * PACK_S6_5,
     "oracleRgCodes", display = display.data_window)
plot(s6_dayIndex,          "oracleRgDayIndex",    display = display.data_window)

// Alert payload — the bulk-export path when hovering bar by bar is impractical.
// One line per transition, in a fixed field order a script can split on "|".
alertcondition(sessTransition,
     title = "Oracle session transition",
     message = "ORACLE|{{time}}|sess={{plot('oracleS1Codes')}}" +
               "|day={{plot('oracleDayKey')}}|build={{plot('oracleBuildCode')}}")

// ─────────────────────────────────────────────────────────────────────────────
// 70 — SESSION LEGEND
//
// Replaces the per-transition labels as the default way of reading the shading.
// Those labels were correct but produced ~6 objects a day forever, which buried
// the price action and hit the retention cap; the colour mapping they conveyed is
// static, so a legend states it once instead of re-stating it on every bar.
//
// The swatch colours come from the SAME generated array the background shading
// indexes (fragment 05 SESSION_SHADE / SESSION_SWATCH, positional with
// SESSION_KEY). A legend that carried its own copy of the palette could claim a
// colour the chart does not paint — the one failure mode a legend must not have.
//
// The ACTIVE session is marked, so the legend doubles as a read-out of where the
// current bar sits without hovering anything.
// ─────────────────────────────────────────────────────────────────────────────

f_legendPosition() =>
    i_legendPos == "Bottom right" ? position.bottom_right :
     i_legendPos == "Top left"    ? position.top_left :
     i_legendPos == "Top right"   ? position.top_right :
     i_legendPos == "Middle left" ? position.middle_left :
     position.bottom_left

// WHY THIS IS BUILT THE WAY IT IS
//
// The previous version gated EVERY cell write behind `CTX_OK`, and created the
// table with a row count derived from `array.size(SESSION_KEY)`. Two ways for a
// legend that is switched ON in the settings to render nothing at all:
//
//   * on an unsupported chart (wrong symbol or timeframe) `CTX_OK` is false, so
//     not one cell was ever written and the table stayed empty — indistinguishable
//     from "the toggle is broken";
//   * `table.clear()` ran before the writes on every last-bar pass, so any early
//     return between the two left an emptied table on screen.
//
// So: fixed row count, no `clear`, cells written whenever the legend is enabled,
// and the context problem stated IN the legend rather than by erasing it.

// LEGEND_ROWS is GENERATED (fragment 05) from the session schedule — one header,
// one row per scheduled session, one fallback. A literal here would silently
// truncate the legend the day production adds a session.
var table legend = table.new(position.bottom_left, 3, LEGEND_ROWS,
     border_width = 1, border_color = color.new(color.gray, 40),
     frame_width  = 1, frame_color  = color.new(color.gray, 20))

f_legendRow(int r, color swatch, string name, string window, string code, bool active) =>
    // The swatch is a solid block of the session's own colour, and two of the
    // six sit above luminance 200 — on a WHITE chart those read as an empty
    // cell on their own. They stay legible because the table above already
    // draws a 1px grey frame on every cell, so the block has an outline
    // whatever colour fills it. The session palette itself is left alone: it is
    // generated from the contract and shared with the background shading.
    table.cell(legend, 0, r, "", bgcolor = swatch, width = 1)
    table.cell(legend, 1, r, (active ? "▶ " : "  ") + name,
         text_size = size.tiny, text_halign = text.align_left,
         text_color = active ? color.white : color.new(color.silver, 20),
         bgcolor = active ? color.new(#1A2340, 5) : BG_HUD)
    table.cell(legend, 2, r, window + "  " + code,
         text_size = size.tiny, text_halign = text.align_left,
         text_color = active ? color.white : color.new(color.silver, 35),
         bgcolor = active ? color.new(#1A2340, 5) : BG_HUD)

if barstate.islast and i_showLegend
    table.set_position(legend, f_legendPosition())

    table.cell(legend, 0, 0, "", bgcolor = color.new(#1A2340, 5))
    table.cell(legend, 1, 0, "SESSION", text_size = size.tiny,
         text_halign = text.align_left, text_color = color.white,
         bgcolor = color.new(#1A2340, 5))
    table.cell(legend, 2, 0, CTX_OK ? "UTC  code" : "UNSUPPORTED CHART",
         text_size = size.tiny, text_halign = text.align_left,
         text_color = CTX_OK ? color.white : color.orange,
         bgcolor = color.new(#1A2340, 5))

    _n = math.min(array.size(SESSION_KEY), LEGEND_ROWS - 2)
    for i = 0 to _n - 1
        f_legendRow(i + 1,
             array.get(SESSION_SWATCH, i),
             array.get(SESSION_LABEL, i),
             str.tostring(array.get(SESSION_START_HOUR, i)) + "-" +
                 str.tostring(array.get(SESSION_END_HOUR, i)),
             str.tostring(array.get(SESSION_CODE, i)),
             CTX_OK and sessCode == array.get(SESSION_CODE, i))

    // Fallback row — a real session key, not an absence of one.
    f_legendRow(_n + 1,
         array.get(SESSION_SWATCH, array.size(SESSION_SWATCH) - 1),
         SESSION_FALLBACK_LABEL, "else", str.tostring(SESSION_FALLBACK_CODE),
         CTX_OK and sessIsFall)

// ─────────────────────────────────────────────────────────────────────────────
// 90 — DEBUG PANEL
//
// Off by default. Shows the intermediate values a parity investigation needs:
// the raw and normalised timestamps, the exact comparison that selected the
// session, and the generated constants the decision came from.
//
// Deliberately a single table on the last bar — not per-bar labels — so enabling
// debug cannot exhaust the drawing budget (limitation L-08).
// ─────────────────────────────────────────────────────────────────────────────

// Same capacity discipline as the HUD. This table was declared with 18 rows
// while 21 f_dbg calls were reachable — a latent RE10040 that would have fired
// the first time anyone ticked "Debug mode". Found by the row-capacity lint rule
// added after the HUD overflow, not by hitting it.
DBG_ROWS = 48

var table dbg = table.new(position.bottom_left, 2, DBG_ROWS,
     border_width = 1, border_color = color.new(color.gray, 70),
     frame_width  = 1, frame_color  = color.new(color.gray, 50))

f_dbg(int r, string k, string v) =>
    if r < DBG_ROWS
        table.cell(dbg, 0, r, k, text_size = size.tiny,
             text_halign = text.align_left, text_color = color.new(color.silver, 20),
             bgcolor = color.new(color.black, 80))
        table.cell(dbg, 1, r, v, text_size = size.tiny,
             text_halign = text.align_left, text_color = color.white,
             bgcolor = color.new(color.black, 80))

if barstate.islast and i_debug
    table.clear(dbg, 0, 0, 1, DBG_ROWS - 1)
    int d = 0

    f_dbg(d, "DEBUG", "S1 · data/time/session")
    d := d + 1
    f_dbg(d, "time (epoch ms)", str.tostring(utcEpochMs, "#"))
    d := d + 1
    f_dbg(d, "UTC normalised", str.format_time(time, "yyyy-MM-dd HH:mm:ss", "UTC"))
    d := d + 1
    f_dbg(d, "chart tz render", str.format_time(time, "yyyy-MM-dd HH:mm:ss", syminfo.timezone))
    d := d + 1
    f_dbg(d, "utc y/m/d", str.tostring(utcYear) + "/" + str.tostring(utcMonth) +
                          "/" + str.tostring(utcDom))
    d := d + 1
    f_dbg(d, "utc hour:min", str.tostring(utcHour) + ":" + str.tostring(utcMin))
    d := d + 1
    f_dbg(d, "day key", str.tostring(dayKey) + (dayTransition ? "  (ROLLOVER)" : ""))
    d := d + 1
    f_dbg(d, "prev day key", na(dispPrevDayKey) ? "na" : str.tostring(dispPrevDayKey))
    d := d + 1

    // The exact comparison production performs, shown as it was evaluated.
    f_dbg(d, "window test", sessIsFall ?
         "no window matched -> fallback '" + SESSION_FALLBACK_KEY + "'" :
         str.tostring(sessStartH) + " <= " + str.tostring(utcHour) +
         " < " + str.tostring(sessEndH) + "  -> idx " + str.tostring(sessIdx))
    d := d + 1
    f_dbg(d, "session", sessKey + " / " + sessLabel + " / code " + str.tostring(sessCode))
    d := d + 1
    f_dbg(d, "prev session", na(dispPrevSessKey) ? "na" :
          dispPrevSessKey + " (code " + str.tostring(dispPrevSessCode) + ")")
    d := d + 1
    f_dbg(d, "transition", str.tostring(sessTransition) +
          (sessTransition ? "  reason=" + sessTransitionReason +
                            " code=" + str.tostring(sessTransitionCode) : ""))
    d := d + 1
    f_dbg(d, "bars since tr", str.tostring(barsSinceTransition))
    d := d + 1
    f_dbg(d, "bar closed", str.tostring(barClosed))
    d := d + 1
    f_dbg(d, "ctx", CTX_STATUS + " (code " + str.tostring(CTX_CODE) + ")")
    d := d + 1
    f_dbg(d, "ticker norm", CTX_TICKER_RAW + " -> " + CTX_TICKER_NORM)
    d := d + 1
    f_dbg(d, "tf seconds", str.tostring(timeframe.in_seconds()))
    d := d + 1
    // Marker retention horizon — makes limitation L-08 visible instead of
    // letting an empty history look like a broken anchor.
    //
    // DERIVED, not counted: no global counter is kept, because a Pine function
    // may not modify a global (CE10088). `array.size()` is what is retained, and
    // reaching the cap is itself the signal that older markers were dropped.
    f_dbg(d, "markers kept", str.tostring(array.size(oracleLabels)) + " / " +
          str.tostring(i_maxObjects) +
          (array.size(oracleLabels) >= i_maxObjects ? "  (CAP — older dropped)" : ""))
    d := d + 1
    f_dbg(d, "oldest marker", array.size(oracleLabels) == 0 ? "none" :
          "bar " + str.tostring(label.get_x(array.get(oracleLabels, 0))))
    d := d + 1
    f_dbg(d, "full build id", ORACLE_ENGINE_ID_SHORT)
    d := d + 1
    f_dbg(d, "source hash", ORACLE_SOURCE_HASH_SHORT)

    // ── S6 · UTC daily regime panel ─────────────────────────────────────────
    // The daily aggregate and every indicator intermediate, so a divergence can
    // be located at the step it began rather than after it has folded into ADX.
    f_dbg(d, "S6 day / src", str.tostring(s6_dayKey) + " <- " +
              str.tostring(s6_srcKey))
    d := d + 1
    f_dbg(d, "S6 daily OHLC", str.tostring(s6_dOpen, format.mintick) + " " +
              str.tostring(s6_dHigh, format.mintick) + " " +
              str.tostring(s6_dLow, format.mintick) + " " +
              str.tostring(s6_dClose, format.mintick) +
              "  (" + str.tostring(s6_dBars) + " bars)")
    d := d + 1
    f_dbg(d, "S6 day index", str.tostring(s6_dayIndex) + " of chart history")
    d := d + 1
    f_dbg(d, "S6 ema/px", str.tostring(s6_fEma, format.mintick) + "  px " +
              str.tostring(s6_fPxVsEma) + "%")
    d := d + 1
    f_dbg(d, "S6 bb basis/sd", str.tostring(s6_fBasis, format.mintick) + " / " +
              str.tostring(s6_fSd))
    d := d + 1
    f_dbg(d, "S6 bbw", str.tostring(s6_fBbw) + " vs " +
              str.tostring(REGIME_BBW_THRESHOLD) +
              (na(s6_fBbw) ? "" : s6_fBbw > REGIME_BBW_THRESHOLD ? "  EXPAND" :
                   "  COMPRESS"))
    d := d + 1
    f_dbg(d, "S6 dm/tr", "+" + str.tostring(s6_fPlusDm) + " -" +
              str.tostring(s6_fMinusDm) + " tr " + str.tostring(s6_fTr))
    d := d + 1
    f_dbg(d, "S6 di/dx", "+" + str.tostring(s6_fPlusDi) + " -" +
              str.tostring(s6_fMinusDi) + " dx " + str.tostring(s6_fDx))
    d := d + 1
    f_dbg(d, "S6 adx", str.tostring(s6_fAdx) + " vs " +
              str.tostring(REGIME_ADX_CHOP) +
              (na(s6_fAdx) ? "" : s6_fAdx < REGIME_ADX_CHOP ? "  CHOP" : "  TREND"))
    d := d + 1
    f_dbg(d, "S6 state", (s6_stateCode == 0 ? "none" :
              array.get(REGIME_STATE_NAME, s6_stateCode - 1)) +
              (s6_transition ? "  (changed)" : ""))
    d := d + 1
    f_dbg(d, "S6 validity", s6_validity == CODE_REGIME_VALID ? "valid" :
              s6_validity == CODE_REGIME_WARMUP ? "warmup" : "INVALID")


// ─────────────────────────────────────────────────────────────────────────────
// 99 — HUD
//
// The warning block is NOT suppressible by any input. Phase 0 established why:
// the chart can legitimately show a fill that never reached the broker, the node
// runs in dry-run, and news filtering cannot exist in Pine at all. A user who has
// switched the HUD off must still see those three facts.
//
// The build's identity is BAKED IN at generation. Pine cannot query the
// repository, so this HUD states what the build MIRRORS. Whether the deployed
// engine still matches is answered by `python -m tools.oracle.check_freshness`,
// never by the chart — see limitation L-19.
//
// LEGIBILITY (fixed after the first on-chart run):
//   * backgrounds are near-OPAQUE. They were 75% transparent, so candles bled
//     through and the text was unreadable over price.
//   * the identity row shows ORACLE_ENGINE_ID_COMPACT. The full 56-char
//     fingerprint forced the table wide enough to cover the price action; it now
//     lives in the debug panel.
//   * the warning is split across two rows so it no longer stretches column 0.
//
// A table is pinned to the PANE, not to bars — it deliberately does not scroll
// with the chart. `i_hudPos` moves it if it covers something.
// ─────────────────────────────────────────────────────────────────────────────

// Row capacity is a CONSTANT with headroom, not a number kept in sync by hand.
// v0.5.0 added nine rows to a table still declared with 24 and produced
// RE10040 "Row 24 is out of table bounds" on a live chart. Pine reports that at
// RUNTIME, not compile time, so neither the compiler nor static syntax checking
// caught it. tools/oracle/lint_pine.py now counts row-writing calls per table
// and fails when they exceed the declared capacity.
HUD_ROWS = 56

var table hud = table.new(position.top_right, 2, HUD_ROWS,
     border_width = 1, border_color = color.new(color.gray, 40),
     frame_width  = 1, frame_color  = color.new(color.gray, 20))

// BG_HUD / BG_WARN / BG_STAT / BG_HEAD are declared in fragment 10, because the
// legend (70) needs them too and Pine resolves top-to-bottom.

// Both helpers GUARD the row index. A table overflow is a RUNTIME error that
// kills the whole indicator — the chart goes blank and every stage stops
// rendering. Degrading to "this row is not drawn" keeps the oracle usable and
// still visible, which matters more than the missing line.
f_row(int r, string k, string v, color vc) =>
    if r < HUD_ROWS
        table.cell(hud, 0, r, k, text_size = f_textSize(),
             text_halign = text.align_left,
             text_color = color.new(color.silver, 10), bgcolor = BG_HUD)
        table.cell(hud, 1, r, v, text_size = f_textSize(),
             text_halign = text.align_left, text_color = vc, bgcolor = BG_HUD)

f_span(int r, string v, color vc, color bg) =>
    if r < HUD_ROWS
        table.cell(hud, 0, r, v, text_size = f_textSize(),
             text_halign = text.align_left, text_color = vc, bgcolor = bg)
        table.cell(hud, 1, r, "", bgcolor = bg)

// Colour for a LOGIC-parity value. A declared bootstrap is still a pass — the
// interval is bounded, recorded and proven to contain every divergence — so it
// is green, not amber. Amber is "nobody has checked", red is "checked and wrong".
f_logicColour(string s) =>
    s == "MATCHED" or s == "MATCHED+BOOT" ? color.lime :
         s == "FAILED" or s == "INCOMPATIBLE" ? #EF476F : color.orange

if barstate.islast
    table.set_position(hud, f_hudPosition())

// NORMAL vs DEBUG.
//
// The first on-chart build rendered ~30 rows unconditionally and took up half the
// pane — build hashes, schema versions and six per-stage parity lines, all of
// which matter when verifying a build and none of which matter when reading a
// chart. Engineering metadata now lives behind `i_debug`.
//
// What stays in NORMAL mode: where we are (session), what the market is doing
// (state / regime / bias), what the engine last did (order block, structure),
// where the setups came from, and the limitations a reader would be misled
// without. The unsuppressible warning is last, as before.
if barstate.islast and i_showHud
    table.clear(hud, 0, 0, 1, HUD_ROWS - 1)
    int r = 0

    f_span(r, "TV ORACLE " + ORACLE_BUILD_VERSION +
              (i_debug ? "   DEBUG" : ""), color.white, BG_HEAD)
    r := r + 1

    // ── identity and schema — DEBUG ONLY ────────────────────────────────────
    if i_debug
        f_row(r, "build",   ORACLE_ENGINE_ID_COMPACT, color.aqua)
        r := r + 1
        f_row(r, "config",  ORACLE_CONFIG_HASH_SHORT, color.aqua)
        r := r + 1
        f_row(r, "schema",  "c" + ORACLE_CONTRACT_SCHEMA + " t" + ORACLE_TRACE_SCHEMA +
                            " g" + ORACLE_GENERATOR_VERSION, color.silver)
        r := r + 1
        f_row(r, "expects", ORACLE_SYMBOL + " " + ORACLE_TF_LABEL, color.silver)
        r := r + 1
        f_row(r, "chart",   CTX_TICKER_RAW + " " + timeframe.period, color.silver)
        r := r + 1

    // A BROKEN context is never hidden — the whole chart is meaningless without
    // it — but a working one needs no row in normal mode.
    if not CTX_OK
        f_row(r, "context", CTX_STATUS, color.red)
        r := r + 1
        f_row(r, "reason",  CTX_REASON, color.red)
        r := r + 1
    else if i_debug
        f_row(r, "context", CTX_STATUS, color.lime)
        r := r + 1

    // ── where we are ────────────────────────────────────────────────────────
    // The window hours are LONDON LOCAL, not UTC (M-SESSION-DST-1), so the row
    // shows the London clock and the derived offset. Labelling these "z" was
    // wrong for the seven months a year the UK is on BST, and wrong silently.
    f_row(r, "session", sessLabel + (sessIsFall ? "" :
              "  " + str.tostring(sessStartH) + "-" + str.tostring(sessEndH) +
              " London") + "   (" + str.tostring(londonHour, "00") + ":" +
              str.tostring(utcMin, "00") + " London / " +
              str.tostring(utcHour, "00") + ":" + str.tostring(utcMin, "00") +
              " UTC, " + (londonOffsetH == 0 ? "GMT" :
                  "UTC+" + str.tostring(londonOffsetH)) + ")",
          color.white)
    r := r + 1
    if i_debug
        f_row(r, "utc",      str.format_time(time, "yyyy-MM-dd HH:mm", "UTC"), color.white)
        r := r + 1
        f_row(r, "day key",  str.tostring(dayKey), color.white)
        r := r + 1
        f_row(r, "since tr", str.tostring(barsSinceTransition), color.silver)
        r := r + 1

    // ── what the market is doing ────────────────────────────────────────────
    f_row(r, "state", s6_stateCode == 0 ? "(warming up)" :
              array.get(REGIME_STATE_NAME, s6_stateCode - 1),
          s6_stateCode == 0 ? color.orange : color.white)
    r := r + 1
    f_row(r, "regime", (s6_trendCode == 0 ? "-" :
              s6_trendCode == CODE_TREND_BULL ? "Bull" : "Bear") + " / " +
              (s6_volCode == 0 ? "-" :
                   s6_volCode == CODE_VOL_EXPAND ? "Expand" : "Compress") +
              (s6_chopCode == CODE_CHOP_CHOP ? " / Chop" : ""),
          s6_trendCode == 0 ? color.orange : color.silver)
    r := r + 1
    f_row(r, "bias", s4_bias == BIAS_BULLISH ? "BULLISH" :
                     s4_bias == BIAS_BEARISH ? "BEARISH" : "NEUTRAL (unseeded)",
          s4_bias == BIAS_BULLISH ? color.lime :
          s4_bias == BIAS_BEARISH ? color.red : color.orange)
    r := r + 1

    // ── what the engine last did ────────────────────────────────────────────
    f_row(r, "last OB", na(s5_last_ob_id) ? "none yet" :
              "OB#" + str.tostring(s5_last_ob_id) + "  " +
              (s5_last_side == 1 ? "bull" : s5_last_side == 2 ? "bear" : "-") +
              (s5_last_tag == 2 ? " CHoCH" : s5_last_tag == 1 ? " BOS" : "") +
              "  " + str.tostring(s5_active_count) + " created",
          na(s5_last_ob_id) ? color.gray : color.white)
    r := r + 1
    f_row(r, "structure", s4_last_event_code == 0 ? "none" :
                          f_eventText(s4_last_event_code) +
                          (f_eventIsBull(s4_last_event_code) ? " bull" : " bear"),
          color.silver)
    r := r + 1

    // ── the target production would use, for the last live setup ────────────
    // Which cell fired, what it resolved to, and whether a LOCAL override is
    // changing what is drawn. Without the override line a chart in experiment
    // mode looks exactly like a chart showing production's own numbers.
    f_row(r, "cfg cell", not TGT_PRESENT ? "NO TABLE - run update_detection_visual" :
              ls_lastKey == "" ? "(no setup yet)  " + TGT_CONFIG_HASH :
              ls_lastKey,
          not TGT_PRESENT ? color.red : color.silver)
    r := r + 1
    // "IF TRIGGERED NOW", not "will trade at". Production resolves the cell at
    // the FILL candle, which may be days away in a different session and state,
    // so this row is a preview of the CURRENT context and says so.
    f_row(r, "if now", not TGT_PRESENT ? "-" :
              not ls_lastOk ? "BLOCK" + (ls_lastWhy != "" ? " (" + ls_lastWhy + ")" : "") :
              na(ls_lastRr) ? "none resolved" :
              "TRADE " + str.tostring(ls_lastRr, "0.00") + "R  " +
              (ls_lastOvSrc == LS_OV_PROD ? "(" + f_srcName(ls_lastSrc) + ")"
                                          : f_ovName(ls_lastOvSrc)),
          ls_lastOvSrc != LS_OV_PROD ? color.yellow :
              not ls_lastOk ? color.orange : color.lime)
    r := r + 1
    // ── news, for THIS bar ──────────────────────────────────────────────────
    // The other half of production's gate. This row reports the bar under the
    // cursor, not the last setup, because "would production be allowed to fill
    // right now" is the question a live reader is asking.
    int hudNews = f_newsState(time, time_close)
    f_row(r, "news", not NEWS_PRESENT ? "NO SCHEDULE - run export_news" :
              not NEWS_ENABLED ? "blackout disabled in production" :
              hudNews == LS_NEWS_BLOCKED ? "BLOCKED - production halts fills" :
              hudNews == LS_NEWS_UNKNOWN ? "UNKNOWN - past " + NEWS_LAST_TXT :
              "permits (" + str.tostring(NEWS_COUNT) + " windows loaded)",
          not NEWS_PRESENT ? color.red :
              hudNews == LS_NEWS_OK ? color.lime : color.orange)
    r := r + 1
    if i_ovMode == "Local overrides"
        f_span(r, "LOCAL OVERRIDES ACTIVE - targets are NOT production's",
               color.white, BG_STAT)
        r := r + 1

    // ── where the setups came from ──────────────────────────────────────────
    // PRODUCTION's decisions, recorded at build time — not computed from the
    // bars on screen — and that distinction belongs on the chart.
    f_row(r, "setups", RP_STALE ? "DROPPED - another engine" :
                       RP_COUNT == 0 ? "none (run export_replay)" :
                       i_replayCount + " of " + str.tostring(RP_COUNT) +
                       " from Python",
          RP_STALE ? color.red : RP_COUNT == 0 ? color.orange : color.lime)
    r := r + 1
    // WHERE the recording ends. Without this row an empty chart is ambiguous —
    // production had no setups here, or the view is simply past the end of the
    // recorded data? The first on-chart build showed nothing at all for exactly
    // that reason: the newest setup was six weeks behind the visible bars.
    // WHICH LAYER OWNS WHAT. Two authorities on one chart is a defect unless
    // the split is stated, so it is stated. Ceding happens per SETUP, not per
    // date — the recording can cover a setup the chart is not drawing.
    f_row(r, "authority", not i_showReplay ? "LIVE · M15 inference (replay off)" :
              RP_STALE ? "LIVE · M15 inference (recording STALE)" :
              RP_COUNT == 0 ? "LIVE · M15 inference (no recording)" :
              "REPLAY · M1 authority where drawn, else LIVE · M15",
          not i_showReplay or RP_STALE or RP_COUNT == 0
              ? color.orange : color.silver)
    r := r + 1

    // THE RECORDING IS NOT ONE FEED once it passes the frozen file's end. Rows
    // after the seam were simulated on the live MT5 1-minute segment, so a
    // setup drawn from them carries that provenance and the chart states it.
    if RP_COUNT > 0 and not RP_STALE and RP_SEAM_MS > 0
        f_row(r, "feed seam", "frozen to " + RP_SEAM_TXT +
                  ", live MT5 after", color.orange)
        r := r + 1
    if RP_COUNT > 0 and not RP_STALE
        f_row(r, "recorded to", str.format_time(RP_LAST_MS, "yyyy-MM-dd", "UTC") +
                  (time > RP_LAST_MS + RP_BAR_MS ?
                       "   ← VIEW IS PAST THIS" : ""),
              time > RP_LAST_MS + RP_BAR_MS ? color.orange : color.silver)
        r := r + 1

    // ── deep state — DEBUG ONLY ─────────────────────────────────────────────
    if i_debug
        f_row(r, "atr", (s2_atr_warm ? "WARM " : "") +
                        str.tostring(s2_atr, format.mintick) +
                        (s2_high_vol ? "  FLIP" : ""),
              s2_atr_warm ? color.orange : color.white)
        r := r + 1
        f_row(r, "swing hi", na(s3_swing_high_level) ? "none" :
                             str.tostring(s3_swing_high_level, format.mintick) +
                             (s3_swing_high_crossed ? "  crossed" : "  active"),
              s3_swing_high_crossed ? color.gray : color.white)
        r := r + 1
        f_row(r, "swing lo", na(s3_swing_low_level) ? "none" :
                             str.tostring(s3_swing_low_level, format.mintick) +
                             (s3_swing_low_crossed ? "  crossed" : "  active"),
              s3_swing_low_crossed ? color.gray : color.white)
        r := r + 1
        f_row(r, "daily", str.tostring(s6_dayIndex) + " UTC days" +
                  (na(s6_fEma) ? " EMA-" : " EMA+") +
                  (na(s6_fBbw) ? " BBW-" : " BBW+") +
                  (na(s6_fAdx) ? " ADX-" : " ADX+"), color.silver)
        r := r + 1
        if s4_history_warn
            f_span(r, "LOADED HISTORY SHALLOW - BIAS SEED MAY DIFFER (L-04)",
                   color.white, BG_WARN)
            r := r + 1

        f_span(r, "LOGIC PARITY (Pine vs Python, IDENTICAL bars)", color.silver,
               BG_HEAD)
        r := r + 1
        f_row(r, "S1", ORACLE_S1_LOGIC, f_logicColour(ORACLE_S1_LOGIC))
        r := r + 1
        f_row(r, "S2", ORACLE_S2_LOGIC, f_logicColour(ORACLE_S2_LOGIC))
        r := r + 1
        f_row(r, "S3", ORACLE_S3_LOGIC, f_logicColour(ORACLE_S3_LOGIC))
        r := r + 1
        f_row(r, "S4", ORACLE_S4_LOGIC, f_logicColour(ORACLE_S4_LOGIC))
        r := r + 1
        f_row(r, "S5", ORACLE_S5_LOGIC, f_logicColour(ORACLE_S5_LOGIC))
        r := r + 1
        f_row(r, "S6", ORACLE_S6_LOGIC, f_logicColour(ORACLE_S6_LOGIC))
        r := r + 1
        if ORACLE_LOGIC_BOOTSTRAP > 0
            f_span(r, "STRUCTURE BOOTSTRAP: " +
                      str.tostring(ORACLE_LOGIC_BOOTSTRAP) +
                      " BARS - EARLIER BARS NOT VERIFIED", color.white, BG_WARN)
            r := r + 1
        f_span(r, "FEED BASIS " + ORACLE_FEED_STATUS + ": PROD " +
                  ORACLE_FEED_PROD_BASIS + " / CHART " + ORACLE_FEED_CHART_BASIS,
               color.white, ORACLE_FEED_STATUS == "MATCHED" ? BG_STAT : BG_WARN)
        r := r + 1
        f_span(r, "FULL-HISTORY PRODUCTION REPLAY: " + ORACLE_REPLAY_STATUS,
               color.white, ORACLE_REPLAY_STATUS == "MATCHED" ? BG_STAT : BG_WARN)
        r := r + 1
        f_span(r, "GLOBAL: " + ORACLE_GLOBAL_STATUS, color.white, BG_STAT)
        r := r + 1

    // ── the news coverage edge, never suppressible ──────────────────────────
    // Past the last embedded window the chart's news answer is UNKNOWN, and an
    // exhausted calendar reads exactly like a quiet one. This row names the
    // date so the reader knows the schedule ran out rather than assuming a
    // clear diary.
    if NEWS_PRESENT and NEWS_ENABLED and time > NEWS_LAST_MS
        f_span(r, "NEWS UNKNOWN - DATA ENDS " + NEWS_LAST_TXT,
               color.white, BG_WARN)
        r := r + 1

    // ── COMPACT limitations, never suppressible ─────────────────────────────
    // Two facts a reader would be misled without: the market state is seeded
    // from chart history only, and the feed is not production's. News is no
    // longer on this list — it has its own row above, from production's own
    // schedule — but it is decided per MINUTE and this bar is fifteen (L-21).
    f_span(r, "state seeded from chart history - feed " + ORACLE_FEED_STATUS +
              " - news verdict is per-bar, production is per-minute",
           color.white, BG_STAT)
    r := r + 1
    f_span(r, "SHADOW MODE - EXECUTION STATE UNKNOWN", color.white, BG_WARN)

// …and the SAME warning as a standalone label whenever the HUD is hidden, so no
// cosmetic setting can remove it from the chart entirely.
var label warnLabel = na
if barstate.islast and not i_showHud
    label.delete(warnLabel)
    warnLabel := label.new(bar_index, high,
         "SHADOW MODE · EXECUTION STATE UNKNOWN · NEWS UNAVAILABLE" +
         "\nGLOBAL: " + ORACLE_GLOBAL_STATUS +
         "\n" + ORACLE_ENGINE_ID_COMPACT,
         style = label.style_label_left, size = size.small,
         color = color.new(#B00020, 32), textcolor = color.black)
