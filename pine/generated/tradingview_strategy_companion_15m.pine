//@version=6
strategy("TVO Strategy Companion — EURUSD", "TVO-SC",
     overlay = true,
     // Production's rail is `max_open_positions = 6`
     // (live/config.py). The historical maximum actually observed
     // is 2 — that is evidence about a quiet sample, not the
     // strategy's authority, and sizing the cap to it would
     // silently forbid a seventh trade production permits.
     pyramiding = 6,
     initial_capital = 100000,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     // See the cost model note in generate_pine.py's build target.
     slippage = 0,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 0.00003,
     // FALSE, deliberately. An order submitted at a bar's close is
     // then active from the NEXT bar, so the 3-minute delay is
     // satisfied with 12 minutes to spare and can never be
     // violated. True would fill at the close of the bar the arm
     // was detected on — the arm==fill defect, rebuilt.
     process_orders_on_close = false,
     calc_on_order_fills = false,
     max_labels_count = 500, max_boxes_count = 500,
     max_lines_count = 500)

