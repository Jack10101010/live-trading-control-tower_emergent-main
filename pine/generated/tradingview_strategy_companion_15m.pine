// ─────────────────────────────────────────────────────────────────────────────
// s10 — STRATEGY COMPANION INPUTS
//
// This build is a `strategy()`, not an indicator. It exists so TradingView's
// Strategy Tester has something to run; the Visual Oracle remains the parity
// and visual tool and is untouched.
//
// It reuses the ORACLE'S OWN detection stack — swings, structure, order blocks,
// sessions, market state — fragment for fragment, so there is exactly one
// implementation of each and no second opinion to drift. What it adds is the
// order lifecycle and the diagnostics.
//
// Everything visual is off. The compute fragments reference a handful of
// display symbols, so they are declared here as constants and the two retention
// helpers are stubs that are never reached (both call sites are guarded by the
// flags below). Carrying the oracle's furniture across would imply this script
// draws things it does not.
// ─────────────────────────────────────────────────────────────────────────────

grpMode  = "Mode"
grpExec  = "Execution"
grpDebug = "Diagnostics"

// ── THE MODE SELECTOR ────────────────────────────────────────────────────────
//
// Two honest answers to one impossible question. Production executes on
// 1-MINUTE candles; this chart is 15-minute, so part of production's lifecycle
// is not reconstructable here. The modes differ in exactly one decision.
//
// STRICT / PROVABLE  —  A DIAGNOSTIC, NOT A BACKTEST.
//   It answers one question: what can a 15-minute chart prove without inventing
//   the order of minutes inside a bar? A setup whose ARM BAR had already reached
//   the entry edge could have filled inside that bar in production — 28 of 46
//   recorded fills (61%) did — and a bar that has closed cannot be traded here.
//   STRICT will not call a later fill at the same price production's trade, so
//   it declines and counts it.
//
//   ON THE MEASURED WINDOW THAT LEAVES ZERO TRADES, and that is the result, not
//   a fault: 22 of 22 armed setups had an arm bar containing the entry edge,
//   which is structural — the edge is the block boundary and the arm level is
//   25% inside it, so price crosses the edge on its way to arming. Read STRICT
//   as a measurement of how much temporal information M15 lacks. It is
//   deliberately NOT tuned to produce trades; a heuristic that made it more
//   active would make it a worse instrument, not a better one.
//
// PRACTICAL / TV EMULATOR  —  THE MODE TO ACTUALLY BACKTEST WITH.
//   Same lifecycle, but it takes those setups and lets TradingView's broker
//   emulator resolve what the chart cannot. This is the mode for the equity
//   curve, win rate, profit factor, drawdown, trade list and parameter work.
//   Its headline metrics are APPROXIMATE and the panel says so in red, on every
//   path. Every result that leaned on an emulator assumption is counted, so a
//   reader can see how much of the number belongs to TradingView.
//
// NEITHER IS CALLED PARITY. M15 cannot reproduce all M1 timing, and a mode name
// implying otherwise would be the one claim this whole project exists to avoid.
i_mode = input.string("STRICT / PROVABLE", "Mode",
     options = ["STRICT / PROVABLE", "PRACTICAL / TV EMULATOR"],
     tooltip = "STRICT never claims a trade it cannot prove and will take " +
               "FEWER trades than production. PRACTICAL lets TradingView's " +
               "emulator resolve intrabar ordering and produces APPROXIMATE " +
               "metrics — useful for equity/PF/drawdown, not for parity.",
     group = grpMode)

f_strict() => i_mode == "STRICT / PROVABLE"

// ── execution ────────────────────────────────────────────────────────────────
//
// RISK-BASED SIZING, and it is what makes the cost model reconcile. Production
// books cost as a fraction of R against a unit risk; TradingView charges cash
// against quantity. Those agree only when quantity is derived from the stop
// distance, which is what `f_qty` below does.
i_riskPerTrade = input.float(1000, "Risk per trade (account currency)",
     minval = 1,
     tooltip = "Position size is derived from this and the stop distance, so " +
               "every trade risks the same amount. Production sizes at 1R with " +
               "`risk_amount = 1.0`; the absolute number here only scales the " +
               "equity curve, never the R multiples.",
     group = grpExec)

// The order is cancelled and re-placed as the gates move, so it can never fill
// while the policy says BLOCK. This bounds how long a single armed order may
// wait for price to come back, matching the block's own life.
i_maxWaitBars = input.int(120, "Cancel an armed order after (bars)",
     minval = 4, maxval = 2000,
     tooltip = "An armed order waits for price to revisit the entry edge. This " +
               "is how long it may wait before the setup is abandoned. It does " +
               "not change any production rule; it bounds a working order.",
     group = grpExec)

// ── the backtest window ──────────────────────────────────────────────────────
//
// The Strategy Tester reports whatever the chart happens to have loaded, which
// is not a question anybody asked. This bounds ORDER PLACEMENT to an explicit
// window so a reported trade count means something specific.
//
// It bounds PLACEMENT ONLY. Detection, swings, structure and the daily market
// state keep running over the whole history — they have a warm-up measured in
// hundreds of bars, and starting them at the window edge would report a market
// state that had never been computed. A trade whose order was placed inside the
// window and whose exit falls outside it still resolves, because abandoning it
// would invent an outcome production never had.
i_useWindow  = input.bool(false, "Limit orders to a date window",
     tooltip = "Detection always runs over the full history; only order " +
               "PLACEMENT is bounded. Trades opened inside the window are " +
               "allowed to finish outside it.",
     group = grpExec)
// THE ISO FORM IS NOT A STYLE CHOICE. `input.time` requires a CONST int, and
// only `timestamp("<iso>")` folds to one — `timestamp("UTC", 2026, 6, 23, 0, 0)`
// is a SIMPLE int and TradingView rejects it outright with CE10123. Writing it
// the other way to keep a text-level lint rule quiet cost a compile; the rule
// was scoped instead, and it still catches a wall-clock stamp anywhere else.
i_windowFrom = input.time(timestamp("2026-06-23T00:00:00+0000"), "  from",
     group = grpExec)
i_windowTo   = input.time(timestamp("2026-08-01T00:00:00+0000"), "  to",
     group = grpExec)

i_showMarkers = input.bool(true, "Mark entries on the chart", group = grpDebug)
i_showPanel   = input.bool(true, "Diagnostics panel",         group = grpDebug)

// ── WHERE THE PANEL GOES, and why it is not top-right ────────────────────────
//
// The Visual Oracle's HUD is at `position.top_right` (99_hud.pinefrag). This
// panel was too. Two tables in one chart cell do not tile — one covers the
// other, silently, with no runtime error and no clue in either script. The
// companion appeared to have lost its diagnostics while cheerfully continuing
// to trade.
//
// The default moves rather than the oracle's, because this is the newer script
// and the oracle is the one whose layout people already know. Middle-right
// because top-left carries TradingView's own script labels and the bottom is
// where the Strategy Tester pane opens.
//
// It is an input as well as a default: the next script added to this chart will
// have the same problem, and a fixed default cannot solve a class of collisions
// — it can only move which pair collides.
i_panelPos = input.string("Middle right", "Diagnostics position",
     options = ["Middle right", "Top right", "Bottom right",
                "Middle left", "Top left", "Bottom left"],
     tooltip = "Move the panel if another script occupies the same corner. " +
               "The Visual Oracle's HUD sits at TOP RIGHT, so this defaults " +
               "to MIDDLE RIGHT; two tables in one cell hide each other with " +
               "no error of any kind.",
     group = grpDebug)

f_panelPos() =>
    string p = position.middle_right
    if i_panelPos == "Middle right"
        p := position.middle_right
    else if i_panelPos == "Top right"
        p := position.top_right
    else if i_panelPos == "Bottom right"
        p := position.bottom_right
    else if i_panelPos == "Middle left"
        p := position.middle_left
    else if i_panelPos == "Top left"
        p := position.top_left
    else if i_panelPos == "Bottom left"
        p := position.bottom_left
    p

// ── symbols the shared compute fragments reference ───────────────────────────
// Declared, never used to draw. Both guarded call sites are switched off, so
// the two helpers below are unreachable — they exist so the fragments compile
// unchanged rather than being forked for this build.
i_debug           = false
i_showOrderBlocks = false
i_showRegime      = false
i_maxObjects      = 10

f_drawChartObs() => false
f_pushLabel(label lbl) => lbl
f_pushLine(line ln) => ln

// The order-block palette. Unreachable here — every use is inside
// `if i_showOrderBlocks and f_drawChartObs()`, both false — but Pine resolves
// identifiers at COMPILE time, not at run time, so an unreachable reference to
// an undeclared constant is still CE10272 "Undeclared identifier". Values are
// the oracle's, so the two scripts cannot drift into different blues.
COL_OB_BULL = #2E86DE
COL_OB_BEAR = #E67E22
// The OB CREATION MARKER. A vertical line spanning the block at the bar its
// structure break confirmed it. Two of the three renderers anchor the box at the
// ORIGIN candle, so without this a wide box cannot say where the strategy
// actually found the block — only where it sits.
COL_OB_MARK = color.new(color.black, 0)

// ── palette, for the diagnostics panel only ──────────────────────────────────
BG_HUD  = color.new(#0E1117, 8)
BG_WARN = color.new(#B00020, 5)
BG_STAT = color.new(#E08000, 10)
BG_HEAD = color.new(#1A2340, 5)

// ─────────────────────────────────────────────────────────────────────────────
// 20 — DATA CONTEXT GUARD
//
// The oracle is generated for ONE symbol and a fixed set of timeframes. On any
// other chart it must say so loudly rather than reinterpret the data.
//
// Timeframe rule, and why it is not arbitrary: production assigns a session from
// the UTC HOUR of the bar-open timestamp over windows [start, end). A bar may
// therefore only be assigned one session if it cannot span an hour boundary —
// i.e. only when the timeframe divides 60. Measured against the production
// schedule: M1/M5/M15/H1 never straddle; H4 straddles 4 bars a day. So H4+ is
// refused even though the engine would happily accept the candles.
//
// Symbol matching is by NORMALISED ticker: feeds decorate the same instrument
// (EURUSD, EURUSD.a, FX:EURUSD, EURUSD_OTC …), and refusing all of them would
// make the oracle unusable on the very feed it is meant to be checked against.
// The accepted alias list is GENERATED from the contract, never hand-typed here.
// ─────────────────────────────────────────────────────────────────────────────

// Normalise: uppercase, strip the exchange prefix, drop separators/suffix noise.
f_normTicker(string raw) =>
    string s = str.upper(raw)
    int    c = str.pos(s, ":")
    s := na(c) ? s : str.substring(s, c + 1)
    s := str.replace_all(s, ".", "")
    s := str.replace_all(s, "_", "")
    s := str.replace_all(s, "-", "")
    s

var string CTX_TICKER_RAW  = syminfo.ticker
var string CTX_TICKER_NORM = f_normTicker(syminfo.ticker)

f_symbolSupported() =>
    bool ok = false
    for i = 0 to array.size(ORACLE_SYMBOL_ALIASES) - 1
        if CTX_TICKER_NORM == array.get(ORACLE_SYMBOL_ALIASES, i)
            ok := true
    ok

f_timeframeSupported() =>
    int secs = timeframe.in_seconds()
    bool ok = false
    for i = 0 to array.size(ORACLE_TF_SECONDS) - 1
        if secs == array.get(ORACLE_TF_SECONDS, i)
            ok := true
    ok

var bool   CTX_SYMBOL_OK = f_symbolSupported()
var bool   CTX_TF_OK     = f_timeframeSupported()
var bool   CTX_OK        = CTX_SYMBOL_OK and CTX_TF_OK

// Ordered reasons — same ordering discipline as the Python trace's
// data_context.reasons, so the two can be compared position by position.
var string CTX_REASON =
     CTX_OK ? "" :
     (not CTX_SYMBOL_OK ? "symbol " + CTX_TICKER_RAW + " != " + ORACLE_SYMBOL : "") +
     (not CTX_SYMBOL_OK and not CTX_TF_OK ? " | " : "") +
     (not CTX_TF_OK ? "timeframe " + timeframe.period + " (" +
                      str.tostring(timeframe.in_seconds()) + "s) unsupported" : "")

var string CTX_STATUS = CTX_OK ? "SUPPORTED" : "UNSUPPORTED_DATA_CONTEXT"
var int    CTX_CODE   = CTX_OK ? CODE_CTX_SUPPORTED : CODE_CTX_UNSUPPORTED

// ─────────────────────────────────────────────────────────────────────────────
// 30 — CANONICAL TIME AND UTC DAY SEMANTICS
//
// Production timestamps are UTC end to end above the MT5 gateway
// (live/config.py TIME_BASE = "utc-v2"), stored as
// datetime64[us, UTC] after strategy_core.execution.prepare_candles_for_simulation,
// and every bar label is the bar OPEN (pandas resample is left-labelled,
// left-closed — verified by execution).
//
// Pine's `time` is likewise the bar-OPEN in UTC epoch milliseconds, so the two
// agree WITHOUT conversion. Everything below therefore passes "UTC" explicitly
// to the calendar functions; the chart's display timezone is irrelevant to the
// computation and must not leak into it.
//
// UTC DAY: production uses strategy_core.regime.utc_date_key — the UTC CALENDAR
// day. It does NOT use an exchange session day. This is limitation L-06, and it
// is why `timeframe.change("D")` and `request.security(..., "D", ...)` are
// forbidden here: on FX those follow a 17:00 New York session boundary and would
// roll the day at the wrong instant.
// ─────────────────────────────────────────────────────────────────────────────

// Bar-open, UTC. Identical quantity to the trace's `bar_epoch_ms`.
utcEpochMs = time

utcYear  = year(time,        "UTC")
utcMonth = month(time,       "UTC")
utcDom   = dayofmonth(time,  "UTC")
utcHour  = hour(time,        "UTC")
utcMin   = minute(time,      "UTC")

// ── LONDON WALL-CLOCK HOUR — the session classifier's input ──────────────────
//
// NOT the same quantity as `utcHour`, and the difference is the whole of
// M-SESSION-DST-1. `strategy_core/sessions.py::_london_hour` converts the UTC
// instant through `ZoneInfo("Europe/London")` and classifies on the LOCAL hour,
// so every session boundary sits one hour earlier in UTC during BST than during
// GMT. The schedule numbers (0/7/10/12/15/17) are London local and never move.
//
// Pine's `hour(time, timezone)` takes an IANA identifier and applies the same
// tz database, so this is a genuine conversion — not a month test, not a
// hard-coded +1, and not a separate summer table. Those approximations all fail
// in the ~3 weeks each spring and autumn when the UK and US clocks disagree,
// and they fail differently every year because the transition instants move.
//
// `utcHour` is deliberately kept: it is what the S1 packed export carries and
// what the trace compares, and conflating the two would make a passing
// comparison meaningless.
londonHour = hour(time, "Europe/London")

// The offset is DERIVED, never assumed — the HUD shows it so an operator can
// see GMT/BST at a glance, and a wrong timezone database would be visible
// rather than silent. Modulo 24 so the day wrap at 23:00 UTC reads as +1.
londonOffsetH = (londonHour - utcHour + 24) % 24

// Canonical day key, integer form: 2026-03-08 -> 20260308.
// Mirrors tools/oracle/session_codes.day_key_to_int so the Data Window value is
// directly comparable to the trace's day_key without arithmetic.
dayKey = utcYear * 10000 + utcMonth * 100 + utcDom

var int prevDayKey = na
dayTransition = na(prevDayKey) or dayKey != prevDayKey

// Bar completeness. Production only ever admits CLOSED bars — the bridge pulls
// closed M1 bars only (live/mt5_bridge.py). A forming bar has no production
// counterpart, so the oracle marks it and the comparator ignores it.
barClosed = barstate.isconfirmed

// ─────────────────────────────────────────────────────────────────────────────
// 40 — SESSION ASSIGNMENT
//
// Mirrors strategy_core/sessions.py EXACTLY:
//
//     _LONDON = ZoneInfo("Europe/London")
//     hour = ts.tz_convert(_LONDON).hour          # _london_hour
//     for start, end, label, key in _SESSION_SCHEDULE:
//         if start <= hour < end:
//             return label, key
//     return _SESSION_OUTSIDE
//
// Load-bearing properties, all verified by execution against the pinned engine:
//   * THE INPUT IS THE LONDON WALL-CLOCK HOUR, not the UTC hour. This changed in
//     M-SESSION-DST-1 (e76fa92, branch golden-run-001-engine) and this fragment
//     classified on `utcHour` until M-TV-FILL-TIME-SEMANTICS-1. The schedule
//     numbers are London local; their UTC projection moves with the UK clock, so
//     during BST every boundary fires an hour earlier in UTC. Classifying on UTC
//     put roughly seven months a year into the wrong cohort — silently, because
//     both answers are valid session keys.
//   * the window test is  start <= hour  AND  hour < end   — inclusive start,
//     EXCLUSIVE end. 07:00 London is London; 06:59 London is Asia; 17:00 is
//     Outside.
//   * FIRST match wins. The production windows do not overlap, but the
//     first-match rule is what the code does, so it is what is reproduced.
//   * anything unmatched falls back to Outside — a real session key, not "none".
//   * the labels are phases of a LONDON trading day. `newYork` and `ny_pm` are
//     NOT America/New_York — production says so explicitly, and reinterpreting
//     them against their nominal zones would be a different strategy.
//
// The schedule arrays are GENERATED from the contract (fragment 05). Editing
// them here would be a second authority, which the design forbids.
// ─────────────────────────────────────────────────────────────────────────────

// Index into the generated schedule, or -1 meaning "fallback".
f_sessionIndexForHour(int h) =>
    int found = -1
    for i = 0 to array.size(SESSION_START_HOUR) - 1
        if found == -1
            int s = array.get(SESSION_START_HOUR, i)
            int e = array.get(SESSION_END_HOUR, i)
            if s <= h and h < e          // [start, end) — exactly production
                found := i
    found

// LONDON hour, not UTC. See the header — this one argument is the DST fix.
sessIdx = f_sessionIndexForHour(londonHour)

sessKey    = sessIdx == -1 ? SESSION_FALLBACK_KEY   : array.get(SESSION_KEY,   sessIdx)
sessLabel  = sessIdx == -1 ? SESSION_FALLBACK_LABEL : array.get(SESSION_LABEL, sessIdx)
sessCode   = sessIdx == -1 ? SESSION_FALLBACK_CODE  : array.get(SESSION_CODE,  sessIdx)
sessIsFall = sessIdx == -1
sessStartH = sessIdx == -1 ? na : array.get(SESSION_START_HOUR, sessIdx)
sessEndH   = sessIdx == -1 ? na : array.get(SESSION_END_HOUR,   sessIdx)

// ── transition detection ─────────────────────────────────────────────────────
// Mirrors the trace's session.transition / transition_reason. `gap_resync` marks
// a change across a data gap: the previous bar was more than one timeframe step
// earlier, so unobserved sessions may sit between the two — the change is real
// but the oracle cannot claim it saw the open.
var int    prevSessCode = na
var string prevSessKey  = na
var int    prevBarTime  = na
var int    barsSinceTransition = 0

tfMs      = timeframe.in_seconds() * 1000
isGap     = not na(prevBarTime) and (time - prevBarTime) > tfMs
isFirst   = na(prevSessCode)
changed   = not isFirst and sessCode != prevSessCode

sessTransition = isFirst or changed

sessTransitionReason =
     isFirst   ? "first_bar" :
     not changed ? "" :
     isGap     ? "gap_resync" :
     sessCode == SESSION_FALLBACK_CODE ? "session_close_to_fallback" :
     prevSessCode == SESSION_FALLBACK_CODE ? "fallback_to_session" :
     "session_open"

sessTransitionCode =
     sessTransitionReason == "session_open"              ? CODE_TR_SESSION_OPEN :
     sessTransitionReason == "session_close_to_fallback" ? CODE_TR_CLOSE_TO_FALLBACK :
     sessTransitionReason == "fallback_to_session"       ? CODE_TR_FALLBACK_TO_SESSION :
     sessTransitionReason == "first_bar"                 ? CODE_TR_FIRST_BAR :
     sessTransitionReason == "gap_resync"                ? CODE_TR_GAP_RESYNC :
     CODE_NONE

barsSinceTransition := sessTransition ? 0 : barsSinceTransition + 1

// A session OPEN is a transition into a real session; a session CLOSE is a
// transition out of one. Production has no explicit close event — the close of
// London IS the open of Lull — so "close" here means only the fall to Outside.
isSessionOpen  = sessTransition and not isFirst and not sessIsFall
isSessionClose = sessTransition and not isFirst and sessIsFall

// SNAPSHOT the previous-bar values BEFORE the state carry below overwrites them.
// Later fragments (visuals, HUD, parity plots) run after this one, so reading
// `prevSessKey` directly there would return the CURRENT bar's key — the values
// would look self-consistent and be silently wrong.
dispPrevSessKey  = prevSessKey
dispPrevSessCode = prevSessCode
dispPrevDayKey   = prevDayKey

// State carry — last thing this fragment does, so every read above and every
// snapshot here sees the PREVIOUS bar's value, matching the trace's prev_key
// semantics.
if barClosed or barstate.islast
    prevSessCode := sessCode
    prevSessKey  := sessKey
    prevBarTime  := time
    prevDayKey   := dayKey

// ─────────────────────────────────────────────────────────────────────────────
// 45 — STAGE S2: TRUE RANGE, SEEDED RMA, PARSED PRICES
//
// Mirrors strategy_core/order_blocks.py::_true_range, ::_pine_rma and
// ::_add_parsed_prices.
//
// `ta.atr` AND `ta.rma` ARE FORBIDDEN HERE, and this is measured, not stylistic.
// Production seeds its RMA with the FIRST value; Pine's builtins seed with an SMA
// of the first `length` values. Over the F-S2-RMASEED fixture (1818 comparable
// 15m bars) the two agree on ZERO bars, peak at 27.4% relative difference, and
// are still not equal at the final bar. Since the parsed-price flip is decided by
// `(H-L) >= 2*measure`, any bar near that threshold can flip the other way and
// move an order block. tools/oracle/lint_pine.py rejects the builtins outright.
//
// WHAT THIS FEEDS: parsed_high/parsed_low are consumed ONLY by
// `_make_order_block` — they set the order-block BOX (Stage S5). They do NOT feed
// the swing loop or the break test, both of which read RAW prices. So an S2
// divergence cannot move a swing or a BOS; it can only move an order block.
// ─────────────────────────────────────────────────────────────────────────────

// ── true range ───────────────────────────────────────────────────────────────
// Bar 0 has no previous close. Production builds three columns and takes a
// row-wise max; pandas SKIPS NaN, so bar 0 resolves to high-low rather than NaN.
s2_hl = high - low
s2_hc = barstate.isfirst ? na : math.abs(high - close[1])
s2_lc = barstate.isfirst ? na : math.abs(low  - close[1])
s2_tr = barstate.isfirst ? s2_hl : math.max(s2_hl, s2_hc, s2_lc)

// ── first-value-seeded RMA (NOT ta.rma) ──────────────────────────────────────
// previous = value            on the first bar
// previous = (previous*(n-1) + value) / n   thereafter
var float s2_atr      = na
var float s2_atr_prev = na
s2_atr_prev := s2_atr
s2_atr := na(s2_atr) ? s2_tr : (s2_atr * (ATR_PERIOD - 1) + s2_tr) / ATR_PERIOD

// ── cumulative mean range (the ob_filter != "Atr" branch) ────────────────────
// Divisor is max(index, 1), so index 0 AND index 1 both divide by 1 — a genuine
// production quirk, reproduced rather than tidied.
var float s2_tr_sum = 0.0
s2_tr_sum := s2_tr_sum + s2_tr
s2_cmr = s2_tr_sum / math.max(bar_index, 1)

s2_measure   = OB_FILTER == "Atr" ? s2_atr : s2_cmr
s2_threshold = VOL_MULTIPLE * s2_measure
s2_range     = high - low

// ── parsed prices ────────────────────────────────────────────────────────────
// `>=`, not `>`. On a high-volatility bar the high and low are SWAPPED, so
// parsed_high < parsed_low and the resulting OB box has negative depth. That is
// production behaviour; do not "correct" it.
s2_high_vol    = s2_range >= s2_threshold
s2_parsed_high = s2_high_vol ? low  : high
s2_parsed_low  = s2_high_vol ? high : low

// True until 200 bars have been seen. The seed only fully decays after that, and
// the whole series depends on where the loaded chart BEGINS (limitation L-03).
s2_atr_warm = bar_index + 1 < ATR_PERIOD

// ─────────────────────────────────────────────────────────────────────────────
// 55 — STAGE S3: LIVE-PATH SWING LOOP
//
// Mirrors the loop INLINED inside strategy_core/order_blocks.py::detect_order_blocks
// (lines 144-171). It does NOT mirror strategy_core/swings.py::detect_swings,
// which is DEAD on the live path — the golden pipeline never calls it. The two
// differ in what they retain: detect_swings records every pivot into columns;
// the live loop keeps only the MOST RECENT UNCROSSED swing per side.
//
// Production, verbatim:
//     for index in range(swing_length, len(candles)):
//         pivot_index = index - swing_length
//         right_highs = candles.loc[pivot_index+1 : index, "high"]   # INCLUSIVE
//         new_leg_high = candles.at[pivot_index,"high"] > right_highs.max()
//         new_leg_low  = candles.at[pivot_index,"low"]  < right_lows.min()
//         next_leg = BEARISH_LEG if new_leg_high else (BULLISH_LEG if new_leg_low else current)
//         leg_change = next_leg - current_leg
//         if leg_change == 1:  swing_low  = {...}
//         elif leg_change == -1: swing_high = {...}
//
// Load-bearing details:
//   * RAW high/low. Never parsed prices — those are Stage S5.
//   * `.loc[a:b]` is INCLUSIVE of b, so the right window is exactly
//     `swing_length` bars: offsets 0 … swing_length-1 from the current bar. That
//     is precisely what `ta.highest(high, SWING_LENGTH)` covers.
//   * STRICT `>` and `<`. A pivot equal to anything in its right window is NOT a
//     swing — equal highs produce nothing.
//   * `elif`, not a second `if`: if both fire on one bar, the HIGH wins.
//   * a swing is recorded ONLY on a leg TRANSITION, never on a repeat.
//   * cold start: current_leg = 0, and BEARISH_LEG is also 0, so the first
//     `new_leg_high` yields leg_change == 0 and records NOTHING, while the first
//     `new_leg_low` yields +1 and records a swing low. That asymmetry is real.
//   * confirmation lag is exactly swing_length bars: the pivot sits that far back.
// ─────────────────────────────────────────────────────────────────────────────

s3_ready = bar_index >= SWING_LENGTH

// Right window: offsets 0 … SWING_LENGTH-1 (current bar included) — the exact
// span of production's inclusive .loc slice.
s3_max_right_high = s3_ready ? ta.highest(high, SWING_LENGTH) : na
s3_min_right_low  = s3_ready ? ta.lowest(low,  SWING_LENGTH)  : na

s3_pivot_high = s3_ready ? high[SWING_LENGTH] : na
s3_pivot_low  = s3_ready ? low[SWING_LENGTH]  : na

s3_new_leg_high = s3_ready and s3_pivot_high > s3_max_right_high
s3_new_leg_low  = s3_ready and s3_pivot_low  < s3_min_right_low

var int s3_current_leg = 0
s3_next_leg = s3_new_leg_high ? LEG_BEARISH : s3_new_leg_low ? LEG_BULLISH : s3_current_leg
s3_leg_change = s3_ready ? s3_next_leg - s3_current_leg : 0

// The single most-recent uncrossed swing per side — production keeps one dict
// each, not a list.
var float s3_swing_high_level = na
var int   s3_swing_high_bar   = na
var bool  s3_swing_high_crossed = false
var int   s3_swing_high_seq   = 0

var float s3_swing_low_level  = na
var int   s3_swing_low_bar    = na
var bool  s3_swing_low_crossed = false
var int   s3_swing_low_seq    = 0

s3_created = 0          // 0 none · 1 swing_high · 2 swing_low

if s3_ready
    if s3_leg_change == 1
        s3_swing_low_level   := low[SWING_LENGTH]
        s3_swing_low_bar     := bar_index - SWING_LENGTH
        s3_swing_low_crossed := false
        s3_swing_low_seq     := s3_swing_low_seq + 1
        s3_created := 2
    else if s3_leg_change == -1
        s3_swing_high_level   := high[SWING_LENGTH]
        s3_swing_high_bar     := bar_index - SWING_LENGTH
        s3_swing_high_crossed := false
        s3_swing_high_seq     := s3_swing_high_seq + 1
        s3_created := 1
    s3_current_leg := s3_next_leg

// ─────────────────────────────────────────────────────────────────────────────
// 58 — STAGE S4: BOS / CHoCH / STRUCTURAL BIAS
//
// Mirrors strategy_core/order_blocks.py::detect_order_blocks lines 173-220.
//
//     previous_close = close[index-1]
//     current_close  = close[index]
//     if swing_high.level is not None and not swing_high.crossed:
//         bull_break = previous_close <= level and current_close > level
//         tag = CHOCH if swing_trend_bias == BEARISH else BOS
//         swing_high.crossed = True ; swing_trend_bias = BULLISH
//     if swing_low.level is not None and not swing_low.crossed:
//         bear_break = previous_close >= level and current_close < level
//         tag = CHOCH if swing_trend_bias == BULLISH else BOS
//         swing_low.crossed = True ; swing_trend_bias = BEARISH
//
// Load-bearing details:
//   * RAW CLOSES, two-bar test. Not a wick break, not parsed prices.
//   * asymmetric operators on purpose: `prev <= level` with `cur > level` for
//     bulls, `prev >= level` with `cur < level` for bears. A previous close
//     exactly AT the level still permits a break.
//   * `crossed` LATCHES — a swing can be broken exactly once.
//   * the two blocks are independent `if`s, so BOTH can fire on one bar. BULL is
//     evaluated FIRST, and the bear tag is then computed from the bias the bull
//     break just set. That ordering is part of the behaviour.
//   * BOS when the bias is 0 (initial) or already the same side; CHoCH ONLY when
//     flipping from the opposite bias. The FIRST break of a run is therefore
//     always BOS, because the bias starts at 0 which equals neither side.
//
// LIMITATION L-04 — THE CORRECTNESS CLIFF
// `swing_trend_bias` is NEVER reset and is seeded by the first break in LOADED
// history. Python loads from 2015; a TradingView chart loads whatever the plan
// allows. If the first break in the chart's window has the opposite side to the
// first break in Python's, every subsequent BOS/CHoCH tag can be inverted — not
// approximately, permanently. The HUD warns while the loaded window is too
// shallow to have converged; it cannot detect the inversion itself, because Pine
// has no access to what Python saw.
// ─────────────────────────────────────────────────────────────────────────────

s4_prev_close = close[1]
s4_cur_close  = close

var int s4_bias = 0            // 0 neutral · BIAS_BULLISH · BIAS_BEARISH
var int s4_bias_before = 0
var int s4_event_code  = 0     // CODE_EV_* for THIS bar (0 = none)
var int s4_event_count = 0
var float s4_broken_level = na
// The PIVOT BAR of the swing that was broken. The structure visual draws a line
// from there to the break, which is what answers "which level went" — a badge at
// the break bar never did.
var int s4_broken_bar = na
var int s4_last_event_bar = na
var int s4_last_event_code = 0
// Exposed for S5 (fragment 65). A break is what CREATES an order-block
// candidate, and the per-side code is needed because when BOTH fire on one bar
// `s4_event_code` ends up holding the bear one — labelling the bullish box from
// it would report the wrong tag.
var bool s4_bull_break = false
var bool s4_bear_break = false
var int  s4_bull_code  = 0
var int  s4_bear_code_out = 0

s4_event_code  := 0
s4_event_count := 0
s4_bull_break  := false
s4_bear_break  := false
s4_bias_before := s4_bias
s4_broken_level := na
s4_broken_bar := na

s4_can_bull = s3_ready and not na(s3_swing_high_level) and not s3_swing_high_crossed
s4_can_bear = s3_ready and not na(s3_swing_low_level)  and not s3_swing_low_crossed

// ── bullish break — evaluated FIRST ──────────────────────────────────────────
if s4_can_bull and s4_prev_close <= s3_swing_high_level and s4_cur_close > s3_swing_high_level
    s4_event_code := s4_bias == BIAS_BEARISH ? CODE_EV_CHOCH_BULL : CODE_EV_BOS_BULL
    s4_broken_level := s3_swing_high_level
    s4_broken_bar := s3_swing_high_bar
    s3_swing_high_crossed := true
    s4_bias := BIAS_BULLISH
    s4_event_count := s4_event_count + 1
    s4_last_event_bar  := bar_index
    s4_last_event_code := s4_event_code
    s4_bull_break := true
    s4_bull_code  := s4_event_code

// ── bearish break — tag uses the bias the bull break may have JUST set ───────
if s4_can_bear and s4_prev_close >= s3_swing_low_level and s4_cur_close < s3_swing_low_level
    s4_bear_code = s4_bias == BIAS_BULLISH ? CODE_EV_CHOCH_BEAR : CODE_EV_BOS_BEAR
    s4_broken_level := s3_swing_low_level
    s4_broken_bar := s3_swing_low_bar
    s3_swing_low_crossed := true
    s4_bias := BIAS_BEARISH
    s4_event_count := s4_event_count + 1
    s4_last_event_bar  := bar_index
    s4_last_event_code := s4_bear_code
    s4_bear_break := true
    s4_bear_code_out := s4_bear_code
    // When both fired, the LAST event on the bar is the bear one; the plotted
    // code reports it, and s4_event_count == 2 marks the double.
    s4_event_code := s4_bear_code

// `s4_trend` was removed here in Wave 2b-i. It was
//     s4_bias == BIAS_BULLISH ? 1 : s4_bias == BIAS_BEARISH ? -1 : 0
// which is the IDENTITY on s4_bias, because the contract pins BULLISH = 1 and
// BEARISH = -1 (contract._engine_constants). Python compared both `oracleBias`
// and `oracleTrend` against the same `swing_trend_bias`, so the second plot cost
// one of 64 plot slots and could not fail unless the first did.

// ── loaded-history sufficiency ───────────────────────────────────────────────
// Not proof of correctness — only that the window is deep enough for the seed to
// be plausible. `s4_bias_seeded_at_bar` is the bar the bias first left 0, which
// is the value an operator compares against the Python trace.
var int s4_bias_seeded_at_bar = na
if na(s4_bias_seeded_at_bar) and s4_bias != 0
    s4_bias_seeded_at_bar := bar_index

s4_history_ok = bar_index >= (SWING_LENGTH + ATR_PERIOD)
s4_history_warn = not s4_history_ok or na(s4_bias_seeded_at_bar)

// ─────────────────────────────────────────────────────────────────────────────
// 65 — S5 · ORDER-BLOCK CREATION
//
// Mirrors `_make_order_block`, `_ob_width_pips` and `_passes_size_filter` in
// strategy_core/order_blocks.py. CREATION ONLY — production assigns no lifecycle
// state at creation, so mitigation / invalidation / expiry are NOT here.
//
// THE FOUR THINGS A "REASONABLE" IMPLEMENTATION GETS WRONG
//   1. The box is built from PARSED prices, not raw candle extremes. On a
//      high-volatility bar the parsed high/low are SWAPPED, so `top` can be
//      BELOW `bottom`. That inverted box is production behaviour and must not be
//      normalised.
//   2. The origin bar is the extreme parsed price over [pivot, break-1] with the
//      EARLIEST bar winning a tie. `ta.lowest` cannot express it: the window
//      starts at a pivot an unbounded number of bars back, so it is accumulated.
//   3. The size gate uses STRICT comparisons, making it INCLUSIVE at both ends —
//      a width of exactly `OB_MAX_PIPS` PASSES.
//   4. `ob_id` is assigned only on APPEND. A rejected block consumes no id, and
//      the next accepted block reuses the integer. But the swing is still burned
//      and the bias still flipped (in fragment 58, before this runs), so a
//      rejection is not a no-op.
//
// LIMITATION L-05: this counter starts at the first bar of LOADED history, while
// production's starts in 2015. The ids will NOT match. Match an order block on
// (detection_time, direction, top, bottom) instead.
// ─────────────────────────────────────────────────────────────────────────────

// ── origin accumulators ─────────────────────────────────────────────────────
// One per side, anchored at that side's swing PIVOT and folded forward one bar
// at a time. `s5_bull_*` tracks the minimum parsed_low (a bullish OB comes from
// a swing-HIGH break); `s5_bear_*` the maximum parsed_high.
//
// The window a break at bar b needs is [pivot, b-1] — the current bar is NOT in
// it — so each bar folds in `[1]`, the PREVIOUS bar, never `[0]`.
var float s5_bull_min = na
var int   s5_bull_idx = na
var float s5_bear_max = na
var int   s5_bear_idx = na

// Seed on the bar a swing is created: the pivot is SWING_LENGTH bars back, so
// the window [pivot, bar-1] is offsets SWING_LENGTH..1. Walked OLDEST FIRST with
// a strict comparison, so the earliest extreme wins a tie exactly as
// `search[search == search.min()].index[0]` does in production.
if s3_created == 1
    float m = na
    int mi = na
    for k = SWING_LENGTH to 1
        v = s2_parsed_low[k]
        if na(m) or v < m
            m := v
            mi := bar_index - k
    s5_bull_min := m
    s5_bull_idx := mi
else if not na(s5_bull_min)
    if s2_parsed_low[1] < s5_bull_min
        s5_bull_min := s2_parsed_low[1]
        s5_bull_idx := bar_index - 1

if s3_created == 2
    float m2 = na
    int mi2 = na
    for k = SWING_LENGTH to 1
        v = s2_parsed_high[k]
        if na(m2) or v > m2
            m2 := v
            mi2 := bar_index - k
    s5_bear_max := m2
    s5_bear_idx := mi2
else if not na(s5_bear_max)
    if s2_parsed_high[1] > s5_bear_max
        s5_bear_max := s2_parsed_high[1]
        s5_bear_idx := bar_index - 1

// ── this bar's candidates ───────────────────────────────────────────────────
var int   s5_next_ob_id     = 1
var int   s5_created_count  = 0
var int   s5_candidate_count = 0
var int   s5_last_ob_id     = na
var float s5_last_top       = na
var float s5_last_bottom    = na
var float s5_last_width     = na
var int   s5_last_reject    = 0     // 0 none · 1 size_filter · 2 empty_window
var int   s5_active_count   = 0
var int   s5_last_side      = 0     // 0 none · 1 bullish · 2 bearish
var int   s5_last_tag       = 0     // 0 none · 1 BOS · 2 CHoCH
var int   s5_last_origin_back = na  // bars from the break bar back to the origin
var int   s5_last_pivot_back  = na  // …and back to the swing pivot
var float s5_last_break_level = na
// A bounded, exactly-reproducible summary of the whole accepted inventory.
// Comparing box drawings is not evidence; comparing a running total of every
// accepted bound is. Integers scaled by 1e5 stay exact in a float64 well past
// the ~2,000 blocks eleven years of history produces.
var float s5_checksum       = 0.0

s5_candidate_count := 0
s5_created_count   := 0
s5_last_reject     := 0
s5_last_side       := 0
s5_last_tag        := 0

// Boxes are retained under the same budget as every other drawing object; the
// oldest is deleted rather than letting Pine silently drop the newest.
var box[] s5_boxes = array.new_box()
var label[] s5_obLabels = array.new_label()

// ── bullish candidate (evaluated FIRST, as in production) ───────────────────
// `s4_bull_break` / `s4_bear_break` are set in fragment 58, which has already
// burned the swing and flipped the bias by the time this runs.
if s4_bull_break
    s5_candidate_count := s5_candidate_count + 1
    if na(s5_bull_idx)
        s5_last_reject := 2
    else
        float t = s2_parsed_high[bar_index - s5_bull_idx]
        float b = s2_parsed_low[bar_index - s5_bull_idx]
        float w = math.abs(t - b) / OB_PIP_SIZE
        s5_last_top := t
        s5_last_bottom := b
        s5_last_width := w
        s5_last_side := 1
        s5_last_tag := s4_bull_code == CODE_EV_CHOCH_BULL ? 2 : 1
        s5_last_origin_back := bar_index - s5_bull_idx
        s5_last_pivot_back := bar_index - s3_swing_high_bar
        s5_last_break_level := s3_swing_high_level
        // STRICT both ways: exactly OB_MAX_PIPS passes.
        if w < OB_MIN_PIPS or w > OB_MAX_PIPS
            s5_last_reject := 1
            if i_debug
                f_pushLabel(label.new(bar_index, high, "OB REJECT " +
                     str.tostring(w, "#.#") + "p", style = label.style_label_down,
                     size = size.tiny, color = color.new(#EF476F, 20),
                     textcolor = color.black))
        else
            s5_last_ob_id := s5_next_ob_id
            s5_next_ob_id := s5_next_ob_id + 1
            s5_created_count := s5_created_count + 1
            s5_active_count := s5_active_count + 1
            s5_checksum := s5_checksum + math.round(t * 100000) +
                 math.round(b * 100000)
            if i_showOrderBlocks and f_drawChartObs()
                array.push(s5_boxes, box.new(s5_bull_idx, t, bar_index, b,
                     border_color = COL_OB_BULL, border_width = 1,
                     bgcolor = color.new(COL_OB_BULL, 85),
                     extend = extend.none))
                array.push(s5_obLabels, label.new(s5_bull_idx,
                     math.max(t, b), "OB#" + str.tostring(s5_last_ob_id) + " " +
                     (s4_bull_code == CODE_EV_CHOCH_BULL ? "CHoCH" : "BOS"),
                     style = label.style_label_down, size = size.tiny,
                     color = color.new(COL_OB_BULL, 30), textcolor = color.black))

// ── bearish candidate (NOT `else` — both can fire on one bar) ───────────────
if s4_bear_break
    s5_candidate_count := s5_candidate_count + 1
    if na(s5_bear_idx)
        s5_last_reject := 2
    else
        float t2 = s2_parsed_high[bar_index - s5_bear_idx]
        float b2 = s2_parsed_low[bar_index - s5_bear_idx]
        float w2 = math.abs(t2 - b2) / OB_PIP_SIZE
        s5_last_top := t2
        s5_last_bottom := b2
        s5_last_width := w2
        s5_last_side := 2
        s5_last_tag := s4_bear_code_out == CODE_EV_CHOCH_BEAR ? 2 : 1
        s5_last_origin_back := bar_index - s5_bear_idx
        s5_last_pivot_back := bar_index - s3_swing_low_bar
        s5_last_break_level := s3_swing_low_level
        if w2 < OB_MIN_PIPS or w2 > OB_MAX_PIPS
            s5_last_reject := 1
            if i_debug
                f_pushLabel(label.new(bar_index, low, "OB REJECT " +
                     str.tostring(w2, "#.#") + "p", style = label.style_label_up,
                     size = size.tiny, color = color.new(#EF476F, 20),
                     textcolor = color.black))
        else
            s5_last_ob_id := s5_next_ob_id
            s5_next_ob_id := s5_next_ob_id + 1
            s5_created_count := s5_created_count + 1
            s5_active_count := s5_active_count + 1
            s5_checksum := s5_checksum + math.round(t2 * 100000) +
                 math.round(b2 * 100000)
            if i_showOrderBlocks and f_drawChartObs()
                array.push(s5_boxes, box.new(s5_bear_idx, t2, bar_index, b2,
                     border_color = COL_OB_BEAR, border_width = 1,
                     bgcolor = color.new(COL_OB_BEAR, 85),
                     extend = extend.none))
                array.push(s5_obLabels, label.new(s5_bear_idx,
                     math.min(t2, b2), "OB#" + str.tostring(s5_last_ob_id) + " " +
                     (s4_bear_code_out == CODE_EV_CHOCH_BEAR ? "CHoCH" : "BOS"),
                     style = label.style_label_up, size = size.tiny,
                     color = color.new(COL_OB_BEAR, 30), textcolor = color.black))

// Retention. Deleting the OLDEST keeps the most recent structure legible; the
// HUD reports the horizon so a reader knows the chart is not the whole history.
while array.size(s5_boxes) > i_maxObjects
    box.delete(array.shift(s5_boxes))
while array.size(s5_obLabels) > i_maxObjects
    label.delete(array.shift(s5_obLabels))

// ─────────────────────────────────────────────────────────────────────────────
// 66 — S6 · UTC DAILY REGIME AND MARKET STATE
//
// Mirrors `strategy_core/regime.py::daily_regime_panel` as it is actually
// reached in production: through `_portfolio_panel_index`
// (scripts/run_backtest.py:2413), NOT through the global regime gate.
// `regime_gate_enabled` is FALSE, so `regime_emit_for_run` returns None and the
// in-loop regime gate never blocks — but the panel is still built, and its
// consumers are the portfolio policy (mode `enforce`) and the state-target
// policy. Mirroring the disabled gate would reproduce dead code.
//
// FIVE THINGS A "REASONABLE" IMPLEMENTATION GETS WRONG
//   1. The daily bar is a UTC CALENDAR day built from the intraday bars on this
//      chart. NOT `request.security(..., "D", ...)`, which returns the
//      EXCHANGE session day and rolls at the broker's 22:00 — a different bar
//      with a different close (limitation L-06).
//   2. `ta.ema` seeds with an SMA of the first `length` values. Production's
//      `ewm(adjust=False)` seeds with the FIRST VALUE. The two never converge.
//   3. `ta.stdev` is a POPULATION deviation. Production uses pandas'
//      `rolling().std()` default — ddof=1, a SAMPLE deviation. At length 20 they
//      differ by sqrt(20/19) ≈ 2.6%, which is ~7000x the closest any real day
//      comes to the BBW threshold, so the substitution would move the state.
//   4. `ta.adx` smooths with an RMA seeded from a sum. Production reuses the
//      same first-value-seeded `ewm(adjust=False)` at alpha = 1/14.
//   5. The panel is SHIFTED ONE DAY: the state FOR day D is classified from the
//      features of day D-1. Using today's own close would be lookahead.
//
// STATE IS BOUNDED. The only collection is a 20-element ring of daily closes
// (the Bollinger window); everything else is scalar running state. Nothing here
// grows with chart length.
// ─────────────────────────────────────────────────────────────────────────────

// ── UTC day identity ────────────────────────────────────────────────────────
// Built from the bar's own UTC timestamp, exactly as fragment 30 builds dayKey.
s6_dayKey = dayKey
s6_newDay = na(s6_dayKey[1]) or s6_dayKey != s6_dayKey[1]

// ── in-progress daily aggregate ─────────────────────────────────────────────
var float s6_curOpen  = na
var float s6_curHigh  = na
var float s6_curLow   = na
var float s6_curClose = na
var int   s6_curBars  = 0
var int   s6_curKey   = na

// ── the COMPLETED daily series, as running state ────────────────────────────
// Only the previous completed day's OHLC is needed for Wilder's directional
// movement, so the daily series itself is never stored.
var float s6_pdHigh  = na
var float s6_pdLow   = na
var float s6_pdClose = na
var int   s6_dayCount = 0        // completed UTC days seen so far

// EMA(200) over daily closes — first-value seeded.
var float s6_ema = na
// Bollinger ring: exactly REGIME_BBW_LENGTH daily closes, oldest shifted out.
var float[] s6_closeRing = array.new_float()
// Wilder smoothing state (first-value seeded, alpha = 1/REGIME_ADX_LENGTH).
var float s6_atr = na
var float s6_psm = na
var float s6_msm = na
var float s6_adx = na

// Features of the LAST COMPLETED day — these are what the CURRENT day is
// classified from, which is the one-day shift.
var float s6_fEma      = na
var float s6_fPxVsEma  = na
var float s6_fBasis    = na
var float s6_fSd       = na
var float s6_fUpper    = na
var float s6_fLower    = na
var float s6_fBbw      = na
var float s6_fAdx      = na
var float s6_fPlusDi   = na
var float s6_fMinusDi  = na
var float s6_fDx       = na
var float s6_fTr       = na
var float s6_fPlusDm   = na
var float s6_fMinusDm  = na
var int   s6_srcKey    = na

// Classified state FOR the current day.
var int s6_stateCode    = 0
var int s6_prevStateCode = 0
var int s6_trendCode    = 0
var int s6_volCode      = 0
var int s6_chopCode     = 0
var int s6_validity     = 0      // CODE_REGIME_INVALID / WARMUP / VALID
var bool s6_transition  = false
var int s6_dayIndex     = 0      // 0-based index of the current day

// Daily OHLC of the last COMPLETED day, exported for verification.
var float s6_dOpen  = na
var float s6_dHigh  = na
var float s6_dLow   = na
var float s6_dClose = na
var int   s6_dBars  = 0

// `ewm(adjust=False)`. A non-finite input passes the PREVIOUS output through
// rather than reseeding, so a gap cannot restart the recurrence.
f_ewm(float prev, float value, float alpha) =>
    na(value) ? prev : na(prev) ? value : (1.0 - alpha) * prev + alpha * value

// ── finalise the day that just ended ────────────────────────────────────────
s6_transition := false
if s6_newDay and not na(s6_curKey)
    // 1. the completed daily bar
    s6_dOpen  := s6_curOpen
    s6_dHigh  := s6_curHigh
    s6_dLow   := s6_curLow
    s6_dClose := s6_curClose
    s6_dBars  := s6_curBars
    s6_srcKey := s6_curKey
    s6_dayCount := s6_dayCount + 1

    // 2. EMA(200) over daily closes
    s6_ema := f_ewm(s6_ema, s6_dClose, REGIME_EMA_ALPHA)
    s6_fEma := s6_ema
    s6_fPxVsEma := na(s6_ema) or s6_ema == 0 ? na :
         (s6_dClose - s6_ema) / s6_ema * 100.0

    // 3. Bollinger basis and SAMPLE deviation (ddof = 1) over the last N closes
    array.push(s6_closeRing, s6_dClose)
    if array.size(s6_closeRing) > REGIME_BBW_LENGTH
        array.shift(s6_closeRing)
    if array.size(s6_closeRing) == REGIME_BBW_LENGTH
        float sum = 0.0
        for k = 0 to REGIME_BBW_LENGTH - 1
            sum := sum + array.get(s6_closeRing, k)
        float mean = sum / REGIME_BBW_LENGTH
        float sq = 0.0
        for k = 0 to REGIME_BBW_LENGTH - 1
            float d = array.get(s6_closeRing, k) - mean
            sq := sq + d * d
        // ddof = 1 — divide by N-1, not N. `ta.stdev` divides by N.
        float sd = math.sqrt(sq / (REGIME_BBW_LENGTH - 1))
        s6_fBasis := mean
        s6_fSd    := sd
        s6_fUpper := mean + REGIME_BBW_STD * sd
        s6_fLower := mean - REGIME_BBW_STD * sd
        s6_fBbw   := mean == 0 ? na : (2.0 * REGIME_BBW_STD * sd) / mean * 100.0
    else
        s6_fBasis := na
        s6_fSd    := na
        s6_fUpper := na
        s6_fLower := na
        s6_fBbw   := na

    // 4. Wilder directional movement and ADX
    float tr = na(s6_pdClose) ? s6_dHigh - s6_dLow :
         math.max(s6_dHigh - s6_dLow,
              math.max(math.abs(s6_dHigh - s6_pdClose),
                       math.abs(s6_dLow - s6_pdClose)))
    float up = na(s6_pdHigh) ? 0.0 : s6_dHigh - s6_pdHigh
    float dn = na(s6_pdLow) ? 0.0 : -(s6_dLow - s6_pdLow)
    // STRICTLY greater and strictly positive: an equal move is NEITHER.
    float pdm = (up > dn and up > 0) ? up : 0.0
    float mdm = (dn > up and dn > 0) ? dn : 0.0
    s6_atr := f_ewm(s6_atr, tr,  REGIME_ADX_ALPHA)
    s6_psm := f_ewm(s6_psm, pdm, REGIME_ADX_ALPHA)
    s6_msm := f_ewm(s6_msm, mdm, REGIME_ADX_ALPHA)
    float pdi = na(s6_atr) or s6_atr == 0 ? na : 100.0 * s6_psm / s6_atr
    float mdi = na(s6_atr) or s6_atr == 0 ? na : 100.0 * s6_msm / s6_atr
    float den = na(pdi) or na(mdi) ? na : pdi + mdi
    float dx  = na(den) or den == 0 ? na : 100.0 * math.abs(pdi - mdi) / den
    s6_adx := f_ewm(s6_adx, dx, REGIME_ADX_ALPHA)
    s6_fTr := tr
    s6_fPlusDm := pdm
    s6_fMinusDm := mdm
    s6_fPlusDi := pdi
    s6_fMinusDi := mdi
    s6_fDx := dx
    s6_fAdx := s6_adx
    s6_pdHigh  := s6_dHigh
    s6_pdLow   := s6_dLow
    s6_pdClose := s6_dClose

    // 5. classify the NEW day from the day that just closed (the one-day shift)
    s6_prevStateCode := s6_stateCode
    s6_dayIndex := s6_dayCount
    bool inputsOk = not na(s6_fPxVsEma) and not na(s6_fBbw) and not na(s6_fAdx)
    if s6_dayCount < 2
        // No prior COMPLETED day existed when this one opened — production's
        // day-0 row is null, never a plausible-looking default.
        s6_stateCode := 0
        s6_trendCode := 0
        s6_volCode   := 0
        s6_chopCode  := 0
        s6_validity  := CODE_REGIME_WARMUP
    else if not inputsOk
        // Production returns None. A silent fallback to a generic range state is
        // exactly the failure this refuses to make.
        s6_stateCode := 0
        s6_trendCode := 0
        s6_volCode   := 0
        s6_chopCode  := 0
        s6_validity  := CODE_REGIME_WARMUP
    else
        // `> 0` — a price exactly ON the EMA is BEAR. Reachable: on the seed day
        // close == ema and pxVsEma is exactly zero.
        s6_trendCode := s6_fPxVsEma > 0 ? CODE_TREND_BULL : CODE_TREND_BEAR
        // `> threshold` — exactly at the threshold is COMPRESS.
        s6_volCode := s6_fBbw > REGIME_BBW_THRESHOLD ? CODE_VOL_EXPAND :
             CODE_VOL_COMPRESS
        // `< chop` — exactly at the chop level is TREND, not chop.
        s6_chopCode := s6_fAdx < REGIME_ADX_CHOP ? CODE_CHOP_CHOP : CODE_CHOP_TREND
        // Chop overrides the composite NAME but not the volatility field, so the
        // two disagree on purpose and both are exported.
        string nm = (s6_trendCode == CODE_TREND_BULL ? "Bull" : "Bear") + "/" +
             (s6_chopCode == CODE_CHOP_CHOP ? "Chop" :
                  s6_volCode == CODE_VOL_EXPAND ? "Expand" : "Compress")
        int found = 0
        for k = 0 to array.size(REGIME_STATE_NAME) - 1
            if array.get(REGIME_STATE_NAME, k) == nm
                found := array.get(REGIME_STATE_CODE, k)
        // An unmatched name is a GENERATION defect, not a market condition. It
        // is surfaced as invalid rather than mapped to something plausible.
        s6_stateCode := found
        s6_validity := found == 0 ? CODE_REGIME_INVALID : CODE_REGIME_VALID
    s6_transition := s6_stateCode != s6_prevStateCode

// ── accumulate the in-progress day ──────────────────────────────────────────
if s6_newDay
    s6_curOpen  := open
    s6_curHigh  := high
    s6_curLow   := low
    s6_curClose := close
    s6_curBars  := 1
    s6_curKey   := s6_dayKey
else
    s6_curHigh  := math.max(s6_curHigh, high)
    s6_curLow   := math.min(s6_curLow, low)
    s6_curClose := close
    s6_curBars  := s6_curBars + 1

// ── visuals ─────────────────────────────────────────────────────────────────
// Restrained by default: a background tint carrying the market state, and a
// marker where it changes. Numbers live in the debug table.
s6_stateColour = s6_stateCode == 0 ? na :
     s6_trendCode == CODE_TREND_BULL ?
          (s6_chopCode == CODE_CHOP_CHOP ? #2E86DE :
               s6_volCode == CODE_VOL_EXPAND ? #06D6A0 : #118AB2) :
          (s6_chopCode == CODE_CHOP_CHOP ? #8D99AE :
               s6_volCode == CODE_VOL_EXPAND ? #EF476F : #C1666B)
bgcolor(i_showRegime and s6_stateCode != 0 ?
     color.new(s6_stateColour, 92) : na, title = "S6 market state")

if i_showRegime and s6_transition and s6_stateCode != 0 and barstate.isconfirmed
    f_pushLabel(label.new(bar_index, low,
         array.get(REGIME_STATE_NAME, s6_stateCode - 1),
         style = label.style_label_up, size = size.tiny,
         color = color.new(s6_stateColour, 25), textcolor = color.black))

// ── confirmed? ───────────────────────────────────────────────────────────────
// Production's target lookup only honours a CONFIRMED market state: an
// unconfirmed or warming-up one keeps the cohort's base target and never blocks.
// Pine's nearest equivalent is a classification produced from a COMPLETED UTC
// day by a warmed-up panel, which is exactly CODE_REGIME_VALID. Warm-up and
// classifier refusal are both "not confirmed" — deliberately, because both mean
// the state cannot be relied on to select a rule.
s6_confirmed = s6_validity == CODE_REGIME_VALID

// ─────────────────────────────────────────────────────────────────────────────
// s90 — THE ORDER LIFECYCLE
//
// PRODUCTION'S SEQUENCE, which this follows and does not shortcut:
//
//     RESTING
//       -> ARM            price penetrates TGT_TRIGGER_PCT into the block, at
//                         some MINUTE m of the arm bar
//       -> DELAY          earliest legal fill is m + TGT_DELAY_CANDLES MINUTES.
//                         The delay is counted in EXECUTION candles and
//                         production's execution frame is 1-minute, so three
//                         candles is THREE MINUTES — not three bars of this
//                         chart, and not zero.
//       -> FILL           first candle at or after that whose range STRADDLES
//                         the entry edge
//       -> resolve session / market state / cohort / TRADE-BLOCK / RR / TP
//                         AT THE FILL, never at creation and never at the arm
//       -> position
//
// WHY THIS IS AN ORDER AND NOT A CALCULATION. Production fills at the block
// EDGE. Measured against the recording, entering at the next bar's open instead
// lands a median of 0.49R away from that price, 17R at the 90th percentile and
// 41R at worst — a different strategy wearing the same name. Only a resting
// order AT the edge reproduces the price.
//
// WHICH KIND of resting order is decided per bar, not once. Production's fill
// test is a TOUCH — `low <= entry <= high`, indifferent to the direction of
// approach — and TradingView has no touch order. A buy limit is valid only
// below the market and a buy stop only above it, so a fixed choice is right
// about half the time and wrong expensively: submit a limit while the market is
// already through it and the emulator fills at the next bar's OPEN. Measured at
// the moment this code places the order, 60 of 89 resolvable setups had the
// market on the STOP side, a median 0.44R from the edge and up to 4.46R.
//
// It is not a broker order left working while the policy says no: it is
// cancelled and re-placed every bar against the CURRENT gates, so it cannot
// fill during a blackout or a blocked cohort.
//
// THE ONE THING THIS CHART CANNOT SEE is the minute. On M15 the arm minute m is
// unknown, so whether m + 3 falls inside the arm bar is unknown too — and a bar
// that has already closed cannot be traded in any case. That single fact is
// where the two modes differ, and nowhere else.
// ─────────────────────────────────────────────────────────────────────────────

// ── cohort resolution, identical to the oracle's ─────────────────────────────
f_cohortIdx() =>
    int found = -1
    for i = 0 to TGT_SESSION_N - 1
        if array.get(TGT_SESSION_NAME, i) == sessKey
            found := i
    found

f_cell(int sessIdx, bool isChoch, bool isLong) =>
    float rr = na
    bool ok = true
    if TGT_PRESENT and sessIdx >= 0
        base = (sessIdx * 2 + (isChoch ? 1 : 0)) * 2 + (isLong ? 0 : 1)
        if base >= 0 and base < TGT_BASE_N
            if array.get(TGT_BASE_PRESENT, base) == 0
                rr := TGT_GLOBAL_RR
            else
                rr := array.get(TGT_BASE_RR, base)
                ok := array.get(TGT_BASE_ON, base) == 1
                if s6_stateCode > 0 and s6_confirmed
                    st = f_tgtStateCol(s6_stateCode)
                    if st >= 0 and st < TGT_STATE_N
                        slot = base * TGT_STATE_N + st
                        elig = array.get(TGT_STATE_ELIG, slot)
                        if elig == 1
                            ok := true
                        else if elig == 2
                            ok := false
                        ov = array.get(TGT_STATE_RR, slot)
                        if ov >= 0
                            rr := ov
    [rr, ok]

// ── news, identical to the oracle's minute-grid test ─────────────────────────
SC_NEWS_OK      = 0
SC_NEWS_BLOCKED = 1
SC_NEWS_UNKNOWN = 2
SC_MIN_MS = 60000

f_news(int barStart, int barEnd) =>
    int st = SC_NEWS_UNKNOWN
    if not NEWS_PRESENT
        st := SC_NEWS_UNKNOWN
    else if not NEWS_ENABLED
        st := SC_NEWS_OK
    else
        lastK = math.floor((barEnd - barStart) / SC_MIN_MS) - 1
        int hit = 0
        for i = 0 to NEWS_COUNT - 1
            if hit == 0
                ws = array.get(NEWS_START, i)
                we = array.get(NEWS_END, i)
                kLo = math.max(0, math.ceil((ws - barStart) / SC_MIN_MS))
                kHi = math.min(lastK, math.floor((we - barStart) / SC_MIN_MS))
                if kLo <= kHi
                    hit := 1
        st := hit == 1 ? SC_NEWS_BLOCKED :
             barStart < NEWS_FIRST_MS or barEnd > NEWS_LAST_MS
                 ? SC_NEWS_UNKNOWN : SC_NEWS_OK
    st

// A KNOWN blackout is knowledge and blocks the fill. UNKNOWN is a missing
// input, not a refusal — it never blocks, and it is counted instead.
sc_news = CTX_OK ? f_news(time, time_close) : SC_NEWS_UNKNOWN
sc_sessIdx = f_cohortIdx()

// ── diagnostics ──────────────────────────────────────────────────────────────
var int n_detected    = 0    // order blocks the chart derived
var int n_armed       = 0    // reached 25% penetration
var int n_invalidated = 0    // through the far edge, no fill possible
var int n_undecidable = 0    // M15 cannot order the minutes
var int n_blocked     = 0    // cohort or state said no at the fill bar
var int n_newsBlocked = 0    // a known blackout at the fill bar
var int n_orders      = 0    // orders actually placed
var int n_filled      = 0    // orders that became positions
var int n_expired     = 0    // armed, never revisited, abandoned
var int n_delayed     = 0    // the arm bar already reached the entry edge
var int n_omitted     = 0    // STRICT: declined because of that
var int n_emulator    = 0    // PRACTICAL: taken anyway, emulator-dependent
var int n_emuFilled   = 0    // ...and of those, how many actually filled
var int n_fillThenBroke = 0  // filled on a bar that also broke the far edge
var int n_newsUnknown = 0    // filled with news unevaluable
var int n_opposite    = 0    // production could hold both sides; TV cannot
var int n_emuExit     = 0    // stop AND target inside one bar: TV chose

// ── open trades, so their EXIT can be judged as well as their entry ──────────
//
// `strategy.exit` hands the stop and the target to the broker, and the broker
// reports which one paid — never whether the other was also reachable in the
// same bar. A bar containing both is decided by TradingView's documented
// four-price assumption (up bar: open, low, high, close) and by nothing that
// happened in the market. Those trades are counted, because a win produced that
// way is a coin the emulator flipped.
type ScTrade
    string id
    float  stop
    float  target
    bool   counted

var array<ScTrade> sc_open = array.new<ScTrade>()

// ── the tracked setup ────────────────────────────────────────────────────────
type ScOb
    float top
    float bottom
    float entry
    float arm
    float stop
    bool  isLong
    bool  isChoch
    int   armedBar
    bool  armBarStraddled
    bool  working        // an order is live
    bool  oppCounted     // its clash with an open opposite position is counted
    bool  emuDependent   // its fill time is the emulator's, not production's
    float lastRr         // the RR the gates resolved on the bar it was placed
    string id
    int    bornBar

var array<ScOb> sc_all = array.new<ScOb>()
var int sc_seq = 0

// ── has this setup's order actually filled? ──────────────────────────────────
//
// IT MATTERS BECAUSE THE ORDER IS RE-PLACED EVERY BAR. `strategy.entry` with an
// id that is still PENDING replaces the pending order, which is the intent:
// the gates are re-read and a stale order cannot outlive the policy that
// allowed it. But an id that has already FILLED is not replaced — it opens a
// SECOND position, and with `pyramiding = 6` it does so silently, five more
// times. One order block would become six trades.
//
// So a filled setup stops being managed. Both trade lists are scanned: an entry
// that opened and closed inside a single bar never appears in `opentrades` at a
// bar boundary, so `opentrades` alone would miss exactly the fast trades.
f_isFilled(string eid) =>
    bool found = false
    if strategy.opentrades > 0
        for k = 0 to strategy.opentrades - 1
            if not found and strategy.opentrades.entry_id(k) == eid
                found := true
    if not found and strategy.closedtrades > 0
        // Newest first, and stop at the first miss going backwards is NOT safe
        // (ids close out of order), so this walks the recent tail in full.
        earliest = math.max(0, strategy.closedtrades - 40)
        for k = strategy.closedtrades - 1 to earliest
            if not found and strategy.closedtrades.entry_id(k) == eid
                found := true
    found

f_isOpen(string eid) =>
    bool found = false
    if strategy.opentrades > 0
        for k = 0 to strategy.opentrades - 1
            if not found and strategy.opentrades.entry_id(k) == eid
                found := true
    found

// The state name, as an if/else rather than a ternary. `array.get(…,
// s6_stateCode - 1)` inside a `?:` computes index -1 whenever the state is
// unresolved, and Pine does not reliably decline to evaluate the untaken
// branch. Line 1483 of the generated build already uses this shape; the panel
// now matches it rather than relying on the operator to be merciful.
f_stateName() =>
    string s = "(warming up)"
    if s6_stateCode > 0
        s := array.get(REGIME_STATE_NAME, s6_stateCode - 1)
    s

f_qty(float stopDist) =>
    // Risk-based: every trade risks i_riskPerTrade, so the cash commission
    // below deducts the same FRACTION OF R that production books.
    stopDist <= 0 ? 0.0 : i_riskPerTrade / (stopDist / syminfo.mintick *
         syminfo.pointvalue * syminfo.mintick)

// ── create on the bar the chart derives a block ──────────────────────────────
if CTX_OK and barstate.isconfirmed and s5_created_count > 0
     and (s5_last_side == 1 or s5_last_side == 2)
    isLong = s5_last_side == 1
    depth = s5_last_top - s5_last_bottom
    entry = isLong ? s5_last_top : s5_last_bottom
    arm = isLong ? s5_last_top - depth * (TGT_TRIGGER_PCT / 100.0)
                 : s5_last_bottom + depth * (TGT_TRIGGER_PCT / 100.0)
    sc_seq += 1
    n_detected += 1
    array.push(sc_all, ScOb.new(
         top = s5_last_top, bottom = s5_last_bottom, entry = entry, arm = arm,
         stop = isLong ? s5_last_bottom - TGT_STOP_BUFFER
                       : s5_last_top + TGT_STOP_BUFFER,
         isLong = isLong, isChoch = s5_last_tag == 2, armedBar = na,
         armBarStraddled = false, working = false, oppCounted = false,
         emuDependent = false, lastRr = na,
         id = "OB" + str.tostring(sc_seq), bornBar = bar_index))
    if array.size(sc_all) > 60
        ScOb gone = array.shift(sc_all)
        if gone.working
            strategy.cancel(gone.id)

// ── the per-bar pass ─────────────────────────────────────────────────────────
if CTX_OK and barstate.isconfirmed and array.size(sc_all) > 0
    for i = array.size(sc_all) - 1 to 0
        ScOb o = array.get(sc_all, i)
        // Computed BEFORE step 0 because step 0 needs `through`: a fill whose
        // own bar also broke the far edge is the one this chart cannot justify.
        armed = not na(o.armedBar)
        hitArm = o.isLong ? low <= o.arm : high >= o.arm
        through = o.isLong ? low < o.bottom : high > o.top
        straddle = low <= o.entry and high >= o.entry

        // ── 0. ALREADY FILLED? Then stop managing it. ────────────────────────
        // Before anything else, because every branch below either re-places or
        // cancels an order, and both are wrong once the order has become a
        // position: re-placing opens a second one, cancelling does nothing and
        // then the next bar re-places anyway.
        if o.working and f_isFilled(o.id)
            n_filled += 1
            // A TRADE, not just a setup. The setup counter says how many
            // setups PRACTICAL was willing to take on the emulator's word;
            // this says how many of them actually became a line in the
            // Strategy Tester, which is the number a reader would otherwise
            // assume was production's.
            if o.emuDependent
                n_emuFilled += 1
            array.push(sc_open, ScTrade.new(id = o.id, stop = o.stop,
                 target = o.isLong
                      ? o.entry + math.abs(o.entry - o.stop) * o.lastRr
                      : o.entry - math.abs(o.entry - o.stop) * o.lastRr,
                 counted = false))
            // THE UNPROVABLE FILL. This bar both delivered the entry and broke
            // the far edge. Production, on 1-minute candles, may well have seen
            // the break first and cancelled — that is exactly what it did to the
            // one divergent trade in the validation window. The order was the
            // broker's to match, so this is counted, never suppressed.
            if through
                n_fillThenBroke += 1
            array.remove(sc_all, i)
            continue

        // ── 1. ARM ───────────────────────────────────────────────────────────
        if not armed and bar_index > o.bornBar and hitArm and not through
            o.armedBar := bar_index
            o.armBarStraddled := straddle
            n_armed += 1
            armed := true
            // THE DELAY.
            //
            // The arm happened at some minute m of THIS bar. The earliest legal
            // fill is m + TGT_DELAY_CANDLES MINUTES. If m is early in the bar
            // that instant is still inside it; if m is late it is in the next.
            // M15 does not carry m, so the question is unanswerable here.
            //
            // IT IS ALSO MOOT, and that is worth stating plainly rather than
            // dressing a limitation up as a mode. A historical bar is evaluated
            // ONCE, at its close: by the time this code can see the arm, the arm
            // bar is over. An order placed now becomes active on the NEXT bar in
            // both modes. There is no setting that buys back the inside of a bar
            // that has already closed.
            //
            // So the delay is never violated — the wait is 15 minutes where
            // production waited 3. What IS lost is the arm bar itself, and that
            // is where the two modes part company.
            //
            // If the arm bar ALSO touched the entry edge, production may well
            // have filled inside it: measured on the recording, 28 of 46 fills
            // (61%) landed in the same 15-minute bar as their arm. This build
            // cannot. The order it would place instead waits for some LATER bar
            // to revisit the edge — same price, different hour, therefore a
            // different session, a different market state and possibly a
            // different cell of the matrix. That is not production's trade
            // arriving late; it is a different trade wearing its name.
            //
            //   STRICT declines it. The lifecycle cannot be established without
            //     guessing which minute came first, so no order is placed and
            //     the setup is counted as omitted.
            //   PRACTICAL takes it, because the price IS the block edge and the
            //     equity curve is the point, and counts it as emulator-
            //     dependent so the headline can never be read as parity.
            //
            // If the arm bar did NOT reach the entry, production could not have
            // filled inside it either, and the fill lies in a later bar for both
            // of them. Those setups are not affected by any of this.
            if o.armBarStraddled
                n_delayed += 1
                if f_strict()
                    n_omitted += 1
                else
                    n_emulator += 1
                    o.emuDependent := true

        // ── 2. INVALIDATION ──────────────────────────────────────────────────
        // Price through the far edge with no fill possible in this bar is
        // production's INVALIDATED_BEFORE_EDGE_ENTRY, and it is provable.
        if through and not straddle
            if o.working
                strategy.cancel(o.id)
            n_invalidated += 1
            array.remove(sc_all, i)
            continue

        // ── 3. THE UNPROVABLE BAR ────────────────────────────────────────────
        // A bar whose range BOTH contains the entry and breaches the far edge
        // holds production's fill and production's invalidation at once, and
        // OHLC cannot order the minutes between them.
        //
        // NEITHER MODE CAN DECLINE THIS ONCE AN ORDER IS WORKING, and saying so
        // is more useful than a mode name that implies otherwise. TradingView
        // matches orders against the bar BEFORE the script is evaluated at that
        // bar's close, so by the time this line runs the fill has either
        // happened or not — step 0 above has already removed it if it did.
        // Reaching here with a working order means the order survived the bar;
        // the block is broken either way, so it is withdrawn.
        //
        // What both modes CAN do is refuse to start. A setup that reaches its
        // unprovable bar before ever arming produces no order at all.
        if through and straddle
            n_undecidable += 1
            if o.working
                strategy.cancel(o.id)
            array.remove(sc_all, i)
            continue

        // STRICT's one refusal. It happens HERE rather than in the arm branch
        // so that the arm itself is still counted: the setup did arm, and
        // saying "never armed" would understate what production had.
        if f_strict() and o.armBarStraddled
            if o.working
                strategy.cancel(o.id)
            array.remove(sc_all, i)
            continue

        // ── 4. THE GATES, read at THIS bar ───────────────────────────────────
        [rr, cellOk] = f_cell(sc_sessIdx, o.isChoch, o.isLong)
        newsOk = sc_news != SC_NEWS_BLOCKED
        eligible = cellOk and newsOk and not na(rr)

        // ── 5. THE ORDER ─────────────────────────────────────────────────────
        // Placed once armed. `process_orders_on_close` is FALSE, so an order
        // submitted during this bar's close is active from the NEXT bar — the
        // 3-minute delay is satisfied with 12 minutes to spare, never violated.
        inWindow = not i_useWindow or (time >= i_windowFrom and time < i_windowTo)
        canFill = armed and inWindow
        expired = armed and bar_index - o.armedBar > i_maxWaitBars

        if expired
            if o.working
                strategy.cancel(o.id)
            n_expired += 1
            array.remove(sc_all, i)
            continue

        if canFill and eligible
            stopDist = math.abs(o.entry - o.stop)
            target = o.isLong ? o.entry + stopDist * rr : o.entry - stopDist * rr
            // ── WHICH ORDER TYPE ─────────────────────────────────────────────
            //
            // Production's fill test is `low <= entry <= high`: a TOUCH, and it
            // does not care which side price came from. TradingView has no touch
            // order. A buy LIMIT is only valid below the market and a buy STOP
            // only above it, so a single fixed type is right only half the time
            // — and wrong in a specific, expensive way: submit a buy limit while
            // the market is already below it and the emulator fills at the NEXT
            // BAR'S OPEN, not at the edge.
            //
            // Measured on the recording, at the moment this code would place
            // the order, 60 of 89 resolvable setups had the market on the STOP
            // side. A plain limit would have filled those a median of 0.44R from
            // the block edge, 1.86R at the 90th percentile and 4.46R at worst —
            // the same class of defect as entering at the next bar's open, which
            // was rejected for exactly this reason.
            //
            // So the side is chosen per bar from where price actually is. Both
            // forms fill AT the entry price; only their validity differs.
            useStop = o.isLong ? close < o.entry : close > o.entry
            // Re-placed every bar so the gates above are re-read every bar. A
            // working order can therefore never outlive the policy that allowed
            // it — which is what "resolve at the fill" means at bar resolution.
            strategy.entry(o.id, o.isLong ? strategy.long : strategy.short,
                 qty = f_qty(stopDist),
                 limit = useStop ? na : o.entry,
                 stop  = useStop ? o.entry : na)
            strategy.exit("x" + o.id, o.id, stop = o.stop, limit = target)
            o.lastRr := rr
            if not o.working
                n_orders += 1
                if sc_news == SC_NEWS_UNKNOWN
                    n_newsUnknown += 1
            o.working := true
        else if o.working
            // The policy moved against it. Pull the order rather than let it
            // fill on a rule that no longer holds.
            strategy.cancel(o.id)
            o.working := false
            if not cellOk
                n_blocked += 1
            if not newsOk
                n_newsBlocked += 1

// ── were the stop and the target both reachable in one bar? ─────────────────
if array.size(sc_open) > 0
    for i = array.size(sc_open) - 1 to 0
        ScTrade t = array.get(sc_open, i)
        if not t.counted and not na(t.target)
             and low <= t.stop and high >= t.stop
             and low <= t.target and high >= t.target
            t.counted := true
            n_emuExit += 1
        // Removed when it stops being OPEN. `f_isFilled` is the wrong test
        // here — it also matches closed trades, so it would never let go.
        if not f_isOpen(t.id)
            array.remove(sc_open, i)

// TradingView holds ONE NET POSITION. Production may hold a long and a short at
// the same time (measured: one such overlapping pair in the recorded history),
// and an opposite entry here REVERSES the position instead of coexisting with
// it. That is a structural limitation of the platform, not of this script, and
// the only honest response is to count it where it bites.
//
// Counted ONCE PER SETUP, not once per bar: a per-bar counter would report an
// order that sat opposite an open position for forty bars as forty
// incompatibilities, which reads as a catastrophe and is one.
if strategy.position_size != 0 and array.size(sc_all) > 0
    for i = 0 to array.size(sc_all) - 1
        ScOb o = array.get(sc_all, i)
        if o.working and not o.oppCounted
             and ((strategy.position_size > 0 and not o.isLong)
             or (strategy.position_size < 0 and o.isLong))
            o.oppCounted := true
            n_opposite += 1

plotshape(i_showMarkers and strategy.position_size != 0
     and strategy.position_size[1] == 0, "entry", shape.triangleup,
     location.belowbar, color.new(#2E86DE, 20), size = size.tiny)

// ── the diagnostics panel ────────────────────────────────────────────────────
//
// The Strategy Tester gives trades, win rate, PF and drawdown. It cannot give
// what was NOT traded and why, and on this script that is half the story: a
// setup skipped as unprovable is a deliberate result, not a gap.
// FOUR COLUMNS, not two. A 24-row panel is taller than a chart pane with the
// Strategy Tester open, and TradingView clips a table rather than scrolling it
// — the reported symptom was three visible rows and the rest below the edge.
// Two label/value pairs per row halves the height without dropping a counter.
var table sc_panel = table.new(f_panelPos(), 4, 13, border_width = 1,
     border_color = color.new(color.gray, 40))

// `c` is the LEFT column of the pair: 0 for the full-history half, 2 for the
// order-window half.
f_scCell(int r, int c, string k, string v, color col) =>
    table.cell(sc_panel, c, r, k, text_size = size.tiny,
         text_halign = text.align_left, text_color = color.silver,
         bgcolor = BG_HUD)
    table.cell(sc_panel, c + 1, r, v, text_size = size.tiny,
         text_halign = text.align_left, text_color = col, bgcolor = BG_HUD)

if barstate.islast and i_showPanel
    // FIXED LAYOUT. Every row index below is a literal, so the highest row this
    // block can reach is readable rather than inferred — by a person and by
    // `lint_pine`'s overflow check. A row rendered only in one mode would shift
    // every index beneath it and make that impossible, which is why the metrics
    // banner is drawn in BOTH modes and only its wording and colour change.

    // ── row 0 — what this is ─────────────────────────────────────────────
    table.cell(sc_panel, 0, 0, "TVO STRATEGY", text_size = size.tiny,
         text_color = color.white, bgcolor = BG_HEAD)
    table.cell(sc_panel, 1, 0, f_strict() ? "STRICT / PROVABLE"
         : "PRACTICAL / TV EMULATOR", text_size = size.tiny,
         text_color = color.white, bgcolor = f_strict() ? BG_HEAD : BG_STAT)
    table.cell(sc_panel, 2, 0, "PURPOSE", text_size = size.tiny,
         text_color = color.white, bgcolor = BG_HEAD)
    table.cell(sc_panel, 3, 0, f_strict()
         ? "diagnostic — what M15 can prove"
         : "backtest — equity, PF, drawdown", text_size = size.tiny,
         text_color = color.white, bgcolor = BG_HEAD)

    // ── row 1 — the caveat, on the same surface as the numbers ───────────
    table.cell(sc_panel, 0, 1, "METRICS", text_size = size.tiny,
         text_color = color.white,
         bgcolor = f_strict() ? BG_HEAD : BG_WARN)
    table.cell(sc_panel, 1, 1, f_strict() ? "PROVABLE SUBSET ONLY"
         : "APPROXIMATE · TV EMULATOR", text_size = size.tiny,
         text_color = color.white,
         bgcolor = f_strict() ? BG_HEAD : BG_WARN)
    table.cell(sc_panel, 2, 1, "M1", text_size = size.tiny,
         text_color = color.white, bgcolor = BG_STAT)
    table.cell(sc_panel, 3, 1, "production executes on 1m; this is 15m",
         text_size = size.tiny, text_color = color.white, bgcolor = BG_STAT)

    // ── row 2 — THE TWO POPULATIONS, and they are not the same one ───────
    //
    // Everything on the LEFT is counted over every bar TradingView has loaded:
    // detection, arming and invalidation all run upstream of the order branch
    // and no window gates them. Everything on the RIGHT is counted only inside
    // the configured window, gated by `canFill` or by a setup already having a
    // working order. Running the two together in one list is how `detected`
    // came to read 137 beside an `orders placed` of 12 with nothing saying why.
    table.cell(sc_panel, 0, 2, "FULL HISTORY", text_size = size.tiny,
         text_color = color.white, bgcolor = BG_HEAD)
    table.cell(sc_panel, 1, 2, str.tostring(bar_index + 1) + " bars loaded",
         text_size = size.tiny, text_color = color.silver, bgcolor = BG_HEAD)
    table.cell(sc_panel, 2, 2, "ORDER WINDOW", text_size = size.tiny,
         text_color = color.white, bgcolor = BG_HEAD)
    table.cell(sc_panel, 3, 2, i_useWindow
         ? str.format_time(i_windowFrom, "yyyy-MM-dd", "UTC") + " .. " +
           str.format_time(i_windowTo, "yyyy-MM-dd", "UTC")
         : "full chart history", text_size = size.tiny,
         text_color = i_useWindow ? color.new(#00BCD4, 0) : color.silver,
         bgcolor = BG_HEAD)

    // ── rows 3-12 — left: FULL HISTORY ───────────────────────────────────
    f_scCell(3, 0, "detected", str.tostring(n_detected), color.white)
    f_scCell(4, 0, "armed", str.tostring(n_armed), color.white)
    f_scCell(5, 0, "invalidated", str.tostring(n_invalidated),
         color.new(#9B59B6, 0))
    f_scCell(6, 0, "undecidable", str.tostring(n_undecidable) + "  (no order)",
         n_undecidable > 0 ? color.new(#00BCD4, 0) : color.silver)
    f_scCell(7, 0, "expired unfilled", str.tostring(n_expired), color.silver)
    f_scCell(8, 0, "delayed_because_M15", str.tostring(n_delayed),
         n_delayed > 0 ? color.new(#00BCD4, 0) : color.silver)
    f_scCell(9, 0, "omitted_because_unprovable", str.tostring(n_omitted),
         n_omitted > 0 ? color.orange : color.silver)
    f_scCell(10, 0, "session", sessLabel + "  " +
         str.tostring(londonHour, "00") + ":00 London", color.silver)
    f_scCell(11, 0, "state", f_stateName(), color.silver)
    f_scCell(12, 0, "parity claimed", "none, in either mode", color.silver)

    // ── rows 3-12 — right: ORDER WINDOW ──────────────────────────────────
    f_scCell(3, 2, "orders placed", str.tostring(n_orders), color.lime)
    f_scCell(4, 2, "orders filled", str.tostring(n_filled), color.lime)
    f_scCell(5, 2, "closed trades", str.tostring(strategy.closedtrades),
         color.lime)
    f_scCell(6, 2, "cohort blocked", str.tostring(n_blocked), color.orange)
    f_scCell(7, 2, "news blocked", str.tostring(n_newsBlocked), color.orange)
    f_scCell(8, 2, "news_unknown", str.tostring(n_newsUnknown) + " fills",
         n_newsUnknown > 0 ? color.orange : color.silver)
    f_scCell(9, 2, "emulator_dependent", str.tostring(n_emuFilled) + " of " +
         str.tostring(n_filled) + " fills",
         n_emuFilled > 0 ? color.new(#00BCD4, 0) : color.silver)
    f_scCell(10, 2, "fill_bar_also_broke_block", str.tostring(n_fillThenBroke),
         n_fillThenBroke > 0 ? color.orange : color.silver)
    f_scCell(11, 2, "emulator_ordered_exit", str.tostring(n_emuExit),
         n_emuExit > 0 ? color.orange : color.silver)
    f_scCell(12, 2, "opposite_direction_overlap", str.tostring(n_opposite),
         n_opposite > 0 ? color.orange : color.silver)
