var array<color> SESSION_SWATCH = array.from(color.new(#26547C, 0), color.new(#EF476F, 0), color.new(#FFD166, 0), color.new(#06D6A0, 0), color.new(#7B2CBF, 0), color.new(#8D99AE, 0))

