// ─────────────────────────────────────────────────────────────────────────────
// x10 — INPUTS (execution oracle)
//
// Cosmetic only, exactly as in the detection build: no input may change a
// computed value, and no input may hide a parity warning. The data-context
// banner and the S7-unimplemented notice are rendered unconditionally.
//
// This build deliberately does NOT inherit the detection oracle's display
// controls. It has no swings, no structure labels and no session shading to
// toggle — carrying that furniture across would imply it draws things it does
// not.
// ─────────────────────────────────────────────────────────────────────────────

grpDisplay = "Display"
grpDebug   = "Debug"

i_showHud    = input.bool(true, "Show HUD", group = grpDisplay)
i_hudPos     = input.string("Top right", "HUD position",
     options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"],
     group = grpDisplay)
i_hudSize    = input.string("Tiny", "HUD text size",
     options = ["Tiny", "Small", "Normal"], group = grpDisplay)
i_showFrame  = input.bool(true, "Mark derived 15m detection bars",
     tooltip = "One marker on the first 1-minute bar after each 15-minute " +
               "bucket closes. That is the instant the bucket becomes readable " +
               "— it is what proves the frame is causal rather than a claim.",
     group = grpDisplay)
i_debug      = input.bool(false, "Debug mode", group = grpDebug)

// ── shared chrome palette ────────────────────────────────────────────────────
BG_HUD  = color.new(#0E1117, 8)
BG_WARN = color.new(#B00020, 5)
BG_STAT = color.new(#E08000, 10)
BG_HEAD = color.new(#1A2340, 5)

f_textSize() =>
    i_hudSize == "Normal" ? size.normal : i_hudSize == "Small" ? size.small : size.tiny

f_hudPosition() =>
    i_hudPos == "Top left"      ? position.top_left :
     i_hudPos == "Bottom right" ? position.bottom_right :
     i_hudPos == "Bottom left"  ? position.bottom_left :
     i_hudPos == "Middle right" ? position.middle_right :
     position.top_right

// ── packed-transport helper ─────────────────────────────────────────────────
// Identical semantics to the detection build's `f_packv` (pine/src/10_inputs).
// Duplicated rather than shared because the two builds are separate scripts and
// Pine has no include; the behaviour is pinned by the same tests.
f_packv(float v, int width, int offset) =>
    x = (na(v) ? -offset : v) + offset
    x < 0 ? 0 : x > width - 1 ? width - 1 : x

// ─────────────────────────────────────────────────────────────────────────────
// x20 — DATA CONTEXT (execution oracle)
//
// This build owns the 1-MINUTE domain and is refused anywhere else. That is not
// caution: the detection oracle's parameters (ATR over 200 bars, a 50-bar swing
// window, a 20-day regime panel) were measured at 15 minutes, and running either
// build on the other's timeframe would render numbers whose meaning nobody has
// checked.
//
// The check is UNSUPPRESSIBLE. There is no input that hides it.
// ─────────────────────────────────────────────────────────────────────────────

f_normTicker(string raw) =>
    s = str.upper(raw)
    s := str.replace_all(s, ":", "")
    s := str.replace_all(s, "/", "")
    s := str.replace_all(s, "_", "")
    s := str.replace_all(s, "-", "")
    s := str.replace_all(s, ".", "")
    s

xc_ticker = f_normTicker(syminfo.ticker)
xc_symbolOk = false
for i = 0 to array.size(ORACLE_SYMBOL_ALIASES) - 1
    if xc_ticker == f_normTicker(array.get(ORACLE_SYMBOL_ALIASES, i))
        xc_symbolOk := true

// The chart's timeframe in seconds, against THIS TARGET's accepted list. The
// detection build accepts 900 and this one accepts 60; neither accepts both.
xc_tfSeconds = timeframe.in_seconds(timeframe.period)
xc_tfOk = false
for i = 0 to array.size(ORACLE_TF_SECONDS) - 1
    if xc_tfSeconds == array.get(ORACLE_TF_SECONDS, i)
        xc_tfOk := true

CTX_OK   = xc_symbolOk and xc_tfOk
CTX_CODE = CTX_OK ? CODE_CTX_SUPPORTED : CODE_CTX_UNSUPPORTED

xc_ctxReason = not xc_symbolOk ? "symbol " + syminfo.ticker + " is not " + ORACLE_SYMBOL :
     not xc_tfOk ? "timeframe " + timeframe.period + " is not " + ORACLE_TF_LABEL :
     ""

// ── history sufficiency ──────────────────────────────────────────────────────
// A 1-minute chart loads far fewer calendar days than a 15-minute one for the
// same bar budget, and the detection frame this build derives needs 15x as many
// 1-minute bars as it produces 15-minute ones. Reporting the actual loaded depth
// is the only way an operator can tell whether a quiet chart is quiet because
// nothing happened or because the history ran out.
xc_barsLoaded = bar_index + 1
xc_firstBarTime = ta.valuewhen(bar_index == 0, time, 0)
xc_daysLoaded = (time - xc_firstBarTime) / 86400000.0

// ─────────────────────────────────────────────────────────────────────────────
// x30 — DETECTION FRAME, DERIVED FROM 1-MINUTE BARS
//
// WHY NOT request.security(syminfo.tickerid, "15", …)
//
// Because production does not ask anyone for 15-minute bars. `run_backtest`
// builds them itself:
//
//     detection_candles = resample_candles(candles, "15min")
//     # src/resample.py: pandas .resample("15min").agg(first/max/min/last/sum)
//     #                  then .dropna(subset=[open, high, low, close])
//
// pandas' defaults here are LEFT-labelled and LEFT-closed, so the bar labelled
// 10:30 covers [10:30, 10:45), and `dropna` DELETES buckets with no 1-minute
// bars in them. Over the chart window that is 7,260 of 25,192 slots — 28.8%,
// almost all weekend.
//
// `request.security("15")` would hand this script TradingView's OWN aggregation
// of its own feed: a second authority, with its own session model and its own
// view of which 15-minute bars exist. Deriving the frame here from the very
// 1-minute bars the chart is already drawing uses production's rule on the
// chart's data, which is the only arrangement in which a divergence can be
// attributed to one of them rather than argued about.
//
// NO LOOKAHEAD, BY CONSTRUCTION
// A bucket is finalised on the FIRST 1-minute bar of the NEXT bucket. Nothing
// downstream ever reads a bucket that is still open, so there is no value that
// could change after the fact — the property `request.security` needs
// `lookahead_off` and a `[1]` offset to approximate.
//
// THE ONE DECLARED DIVERGENCE (limitation L-23)
// Production admits an order block to the pending walk when
// `detection_time <= candle.time`, and `detection_time` is the bucket's LEFT
// edge. So production starts tracking a block at 10:30:00 using a bar that only
// completes at 10:45:00 — up to fourteen minutes of lookahead in its own
// backtest. This script cannot and must not reproduce that. Measured over the
// chart window: of 97 armed setups, ONE had any decisive event inside that
// window and NONE resolved inside it (minimum admission-to-outcome gap: 94
// minutes). The divergence is therefore bounded, measured and declared — never
// silently absorbed.
// ─────────────────────────────────────────────────────────────────────────────

// ── bucket identity ──────────────────────────────────────────────────────────
// The UTC 15-minute bucket a 1-minute bar belongs to, as an epoch in ms. Derived
// from the bar's OPEN time, which is what pandas indexes on. Integer division
// floors toward zero, and `time` is non-negative for every bar this oracle
// supports, so this is exactly `floor(t / 900000) * 900000`.
DETECTION_BUCKET_MS = ORACLE_DETECTION_TF_SECONDS * 1000
xf_bucket = math.floor(time / DETECTION_BUCKET_MS) * DETECTION_BUCKET_MS

var int   xf_curBucket = na
var float xf_curOpen   = na
var float xf_curHigh   = na
var float xf_curLow    = na
var float xf_curClose  = na
var int   xf_curBars   = 0

// ── the CONFIRMED bucket: what downstream stages may read ────────────────────
// Written only at a bucket boundary, so on any given 1-minute bar these describe
// a 15-minute bar that has fully closed.
var int   xf_detBucket = na      // label (left edge), epoch ms
var float xf_detOpen   = na
var float xf_detHigh   = na
var float xf_detLow    = na
var float xf_detClose  = na
var int   xf_detBars   = 0       // 1-minute bars that composed it
var int   xf_detCount  = 0       // confirmed detection bars seen so far
var int   xf_detGaps   = 0       // dropped (empty) buckets skipped over

// True on the ONE 1-minute bar where a new confirmed detection bar appears.
xf_newDetectionBar = false

if barstate.isconfirmed
    if na(xf_curBucket)
        xf_curBucket := xf_bucket
        xf_curOpen   := open
        xf_curHigh   := high
        xf_curLow    := low
        xf_curClose  := close
        xf_curBars   := 1
    else if xf_bucket == xf_curBucket
        // still inside the same 15-minute window: aggregate exactly as
        // first / max / min / last.
        xf_curHigh  := math.max(xf_curHigh, high)
        xf_curLow   := math.min(xf_curLow, low)
        xf_curClose := close
        xf_curBars  := xf_curBars + 1
    else
        // BOUNDARY. The bucket that just ended is now complete and immutable.
        xf_detBucket := xf_curBucket
        xf_detOpen   := xf_curOpen
        xf_detHigh   := xf_curHigh
        xf_detLow    := xf_curLow
        xf_detClose  := xf_curClose
        xf_detBars   := xf_curBars
        xf_detCount  := xf_detCount + 1
        xf_newDetectionBar := true
        // EMPTY BUCKETS ARE DROPPED, not filled. pandas' `dropna` removes them,
        // so production's detection frame simply has no bar there — and neither
        // does this one. Counting them is the diagnostic that proves the two
        // frames agree about which bars EXIST, which is a precondition for
        // agreeing about their values.
        _skipped = math.round((xf_bucket - xf_curBucket) / DETECTION_BUCKET_MS) - 1
        xf_detGaps := xf_detGaps + math.max(0, _skipped)
        // …and open the new one.
        xf_curBucket := xf_bucket
        xf_curOpen   := open
        xf_curHigh   := high
        xf_curLow    := low
        xf_curClose  := close
        xf_curBars   := 1

// ── warm-up ──────────────────────────────────────────────────────────────────
// The detection stack this frame feeds needs history before ANY of it means
// anything: ATR over 200 detection bars (S2), a 50-bar swing window (S3), and
// the daily regime panel (S6). Those are declared bootstraps on the detection
// oracle and they become 1-minute bar counts here.
XF_MIN_DETECTION_BARS = ATR_PERIOD + SWING_LENGTH
xf_frameWarm = xf_detCount < XF_MIN_DETECTION_BARS

// ─────────────────────────────────────────────────────────────────────────────
// x60 — PARITY OUTPUT (execution oracle)
//
// The execution build starts its plot budget from zero and spends it only on
// what can be PROVED today: the derived detection frame. S7's own fields are
// not plotted, because S7 is not implemented and a column of zeros that looks
// like evidence is worse than no column.
//
// What these five prove is the cross-timeframe handoff — that this script's
// derived 15-minute frame is the same frame `resample_candles` produces:
//
//   oracleXfBucket   the confirmed bucket LABEL (epoch ms, left edge). Joining
//                    on this against the detection oracle's own bars is what
//                    shows the two agree about WHICH bars exist — the 28.8% of
//                    empty buckets production drops are absent from both or the
//                    join fails loudly.
//   oracleXfOpen/High/Low/Close   first / max / min / last over the bucket.
//   oracleXfCodes    packed: bar count, new-bar flag, context, warm-up.
//
// `oracleXfBucket` is a TIMESTAMP, not a bar index, and is therefore comparable
// across feeds — unlike `bar_index` (L-09).
// ─────────────────────────────────────────────────────────────────────────────

plot(xf_detBucket,      "oracleXfBucket",  display = display.data_window)
plot(xf_detOpen,        "oracleXfOpen",    display = display.data_window)
plot(xf_detHigh,        "oracleXfHigh",    display = display.data_window)
plot(xf_detLow,         "oracleXfLow",     display = display.data_window)
plot(xf_detClose,       "oracleXfClose",   display = display.data_window)

// PACKED: 1-minute bars in the bucket · new-bar flag · data context · warm-up.
// A 15-minute bucket holds at most 15 one-minute bars, so width 16 is exact
// rather than generous; a value of 16 would mean the bucket arithmetic is wrong,
// and `f_packv` clamps it into a value the comparator cannot match.
plot(f_packv(xf_detBars,               PACK_X1_W0, PACK_X1_O0) * PACK_X1_0 +
     f_packv(xf_newDetectionBar ? 1 : 0, PACK_X1_W1, PACK_X1_O1) * PACK_X1_1 +
     f_packv(CTX_CODE,                 PACK_X1_W2, PACK_X1_O2) * PACK_X1_2 +
     f_packv(xf_frameWarm ? 1 : 0,     PACK_X1_W3, PACK_X1_O3) * PACK_X1_3,
     "oracleXfCodes", display = display.data_window)

// Running totals. Confirmed detection bars and dropped empty buckets together
// account for every 15-minute slot the loaded window spans, so a disagreement in
// either is visible without hunting for the bar it started on.
plot(xf_detCount,       "oracleXfBarCount", display = display.data_window)
plot(xf_detGaps,        "oracleXfGapCount", display = display.data_window)

// The boundary marker. Drawn on the FIRST 1-minute bar after a bucket closes,
// which is the instant the bucket becomes readable — the visible form of the
// causality claim in fragment x30.
plotchar(i_showFrame and xf_newDetectionBar, "detectionBar", "▏",
     location.bottom, color = color.new(#2E86DE, 40), size = size.tiny)

// ─────────────────────────────────────────────────────────────────────────────
// x99 — HUD (execution oracle)
//
// The single most important thing this panel does is refuse to look finished.
// S7 is NOT implemented in this build, and a clean-looking chart with a derived
// 15-minute frame drawn on it could easily read as "the execution oracle works".
// The S7 row is therefore rendered unconditionally, in warning colours, and
// there is no input that turns it off.
// ─────────────────────────────────────────────────────────────────────────────

// ── the banner NO INPUT CAN HIDE ─────────────────────────────────────────────
// Its own table, rendered unconditionally. The first version of this fragment
// put every row inside `if barstate.islast and i_showHud`, which meant turning
// the HUD off hid the "S7 NOT IMPLEMENTED" notice and left a chart that looked
// like a working execution oracle. The lint rule caught it.
var table xwarn = table.new(position.bottom_right, 1, 3,
     border_width = 1, border_color = color.new(color.black, 60))

if barstate.islast
    table.cell(xwarn, 0, 0,
         "SHADOW MODE · EXECUTION STATE UNKNOWN · NEWS UNAVAILABLE",
         text_size = size.tiny, text_color = color.white, bgcolor = BG_WARN)
    table.cell(xwarn, 0, 1,
         "S7 NOT IMPLEMENTED — this build claims NO parity",
         text_size = size.tiny, text_color = color.white, bgcolor = BG_WARN)
    table.cell(xwarn, 0, 2,
         CTX_OK ? "context SUPPORTED · " + ORACLE_BUILD_TARGET
                : "UNSUPPORTED CONTEXT — " + xc_ctxReason,
         text_size = size.tiny, text_color = CTX_OK ? color.silver : color.white,
         bgcolor = CTX_OK ? BG_HUD : BG_WARN)

// Capacity is the number of rows REACHABLE, not the number usually written.
// Pine raises RE10040 at RUNTIME when a write lands past the declared bound and
// the whole indicator stops rendering — a defect an operator finds, not CI.
var table xhud = table.new(position.top_right, 2, 16,
     border_width = 1, border_color = color.new(color.black, 60))

f_xrow(int r, string k, string v, color c) =>
    table.cell(xhud, 0, r, k, text_size = f_textSize(), text_color = color.silver,
         text_halign = text.align_left, bgcolor = BG_HUD)
    table.cell(xhud, 1, r, v, text_size = f_textSize(), text_color = c,
         text_halign = text.align_left, bgcolor = BG_HUD)

if barstate.islast and i_showHud
    table.set_position(xhud, f_hudPosition())
    r = 0
    table.cell(xhud, 0, r, "EXECUTION ORACLE", text_size = f_textSize(),
         text_color = color.white, text_halign = text.align_left, bgcolor = BG_HEAD)
    table.cell(xhud, 1, r, ORACLE_BUILD_TARGET, text_size = f_textSize(),
         text_color = color.white, text_halign = text.align_left, bgcolor = BG_HEAD)
    r += 1

    // ── the notice that must never be suppressible ──────────────────────────
    // Repeated from the always-on banner above deliberately: the rule is that
    // it renders on the HUD-ON path AND the HUD-OFF path, so both carry it.
    f_xrow(r, "mode", "SHADOW MODE · EXECUTION STATE UNKNOWN · NEWS UNAVAILABLE",
          color.orange)
    r += 1
    f_xrow(r, "S7", "NOT IMPLEMENTED — this build claims NO parity", color.orange)
    r += 1
    f_xrow(r, "owns", ORACLE_OWNED_STAGES, color.silver)
    r += 1

    // ── data context ────────────────────────────────────────────────────────
    f_xrow(r, "context", CTX_OK ? "SUPPORTED" : "UNSUPPORTED — " + xc_ctxReason,
          CTX_OK ? color.lime : color.red)
    r += 1
    f_xrow(r, "chart", syminfo.ticker + "  " + timeframe.period +
                       "  (needs " + ORACLE_TF_LABEL + ")",
          CTX_OK ? color.silver : color.red)
    r += 1
    f_xrow(r, "history", str.tostring(xc_barsLoaded) + " bars  ~" +
                         str.tostring(math.round(xc_daysLoaded)) + "d",
          color.silver)
    r += 1

    // ── the derived detection frame ─────────────────────────────────────────
    f_xrow(r, "15m frame", str.tostring(xf_detCount) + " bars  " +
                           str.tostring(xf_detGaps) + " empty dropped",
          xf_frameWarm ? color.orange : color.lime)
    r += 1
    f_xrow(r, "last 15m", na(xf_detBucket) ? "—" :
                          str.format_time(xf_detBucket, "yyyy-MM-dd HH:mm", "UTC") +
                          "  (" + str.tostring(xf_detBars) + " × 1m)",
          color.silver)
    r += 1
    f_xrow(r, "frame warm", xf_frameWarm ?
                            "WARMING " + str.tostring(xf_detCount) + "/" +
                            str.tostring(XF_MIN_DETECTION_BARS) : "ready",
          xf_frameWarm ? color.orange : color.lime)
    r += 1

    // ── shared, unmovable limitations ───────────────────────────────────────
    f_xrow(r, "feed", ORACLE_FEED_STATUS + "  (prod " + ORACLE_FEED_PROD_BASIS +
                      " / chart " + ORACLE_FEED_CHART_BASIS + ")", color.orange)
    r += 1
    f_xrow(r, "news", "CALENDAR UNAVAILABLE — Pine cannot read production's " +
                      "economic calendar", color.orange)
    r += 1
    // Production admits an order block at the 15-minute bucket's LEFT edge, i.e.
    // up to 14 minutes before that bucket closes. This build cannot: it is
    // causal. Measured effect over the chart window: 1 of 97 armed setups had
    // any decisive event inside that window, 0 of 97 outcomes changed.
    f_xrow(r, "L-23", "production admits at the bucket LABEL; this build waits " +
                      "for the bucket to close", color.orange)
