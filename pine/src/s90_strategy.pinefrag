// ─────────────────────────────────────────────────────────────────────────────
// s90 — THE ORDER LIFECYCLE
//
// PRODUCTION'S SEQUENCE, which this follows and does not shortcut:
//
//     RESTING
//       -> ARM            price penetrates TGT_TRIGGER_PCT into the block, at
//                         some MINUTE m of the arm bar
//       -> DELAY          earliest legal fill is m + TGT_DELAY_CANDLES MINUTES.
//                         The delay is counted in EXECUTION candles and
//                         production's execution frame is 1-minute, so three
//                         candles is THREE MINUTES — not three bars of this
//                         chart, and not zero.
//       -> FILL           first candle at or after that whose range STRADDLES
//                         the entry edge
//       -> resolve session / market state / cohort / TRADE-BLOCK / RR / TP
//                         AT THE FILL, never at creation and never at the arm
//       -> position
//
// WHY THIS IS AN ORDER AND NOT A CALCULATION. Production fills at the block
// EDGE. Measured against the recording, entering at the next bar's open instead
// lands a median of 0.49R away from that price, 17R at the 90th percentile and
// 41R at worst — a different strategy wearing the same name. Only a resting
// order AT the edge reproduces the price.
//
// WHICH KIND of resting order is decided per bar, not once. Production's fill
// test is a TOUCH — `low <= entry <= high`, indifferent to the direction of
// approach — and TradingView has no touch order. A buy limit is valid only
// below the market and a buy stop only above it, so a fixed choice is right
// about half the time and wrong expensively: submit a limit while the market is
// already through it and the emulator fills at the next bar's OPEN. Measured at
// the moment this code places the order, 60 of 89 resolvable setups had the
// market on the STOP side, a median 0.44R from the edge and up to 4.46R.
//
// It is not a broker order left working while the policy says no: it is
// cancelled and re-placed every bar against the CURRENT gates, so it cannot
// fill during a blackout or a blocked cohort.
//
// THE ONE THING THIS CHART CANNOT SEE is the minute. On M15 the arm minute m is
// unknown, so whether m + 3 falls inside the arm bar is unknown too — and a bar
// that has already closed cannot be traded in any case. That single fact is
// where the two modes differ, and nowhere else.
// ─────────────────────────────────────────────────────────────────────────────

// ── cohort resolution, identical to the oracle's ─────────────────────────────
f_cohortIdx() =>
    int found = -1
    for i = 0 to TGT_SESSION_N - 1
        if array.get(TGT_SESSION_NAME, i) == sessKey
            found := i
    found

f_cell(int sessIdx, bool isChoch, bool isLong) =>
    float rr = na
    bool ok = true
    if TGT_PRESENT and sessIdx >= 0
        base = (sessIdx * 2 + (isChoch ? 1 : 0)) * 2 + (isLong ? 0 : 1)
        if base >= 0 and base < TGT_BASE_N
            if array.get(TGT_BASE_PRESENT, base) == 0
                rr := TGT_GLOBAL_RR
            else
                rr := array.get(TGT_BASE_RR, base)
                ok := array.get(TGT_BASE_ON, base) == 1
                if s6_stateCode > 0 and s6_confirmed
                    st = f_tgtStateCol(s6_stateCode)
                    if st >= 0 and st < TGT_STATE_N
                        slot = base * TGT_STATE_N + st
                        elig = array.get(TGT_STATE_ELIG, slot)
                        if elig == 1
                            ok := true
                        else if elig == 2
                            ok := false
                        ov = array.get(TGT_STATE_RR, slot)
                        if ov >= 0
                            rr := ov
    [rr, ok]

// ── news, identical to the oracle's minute-grid test ─────────────────────────
SC_NEWS_OK      = 0
SC_NEWS_BLOCKED = 1
SC_NEWS_UNKNOWN = 2
SC_MIN_MS = 60000

f_news(int barStart, int barEnd) =>
    int st = SC_NEWS_UNKNOWN
    if not NEWS_PRESENT
        st := SC_NEWS_UNKNOWN
    else if not NEWS_ENABLED
        st := SC_NEWS_OK
    else
        lastK = math.floor((barEnd - barStart) / SC_MIN_MS) - 1
        int hit = 0
        for i = 0 to NEWS_COUNT - 1
            if hit == 0
                ws = array.get(NEWS_START, i)
                we = array.get(NEWS_END, i)
                kLo = math.max(0, math.ceil((ws - barStart) / SC_MIN_MS))
                kHi = math.min(lastK, math.floor((we - barStart) / SC_MIN_MS))
                if kLo <= kHi
                    hit := 1
        st := hit == 1 ? SC_NEWS_BLOCKED :
             barStart < NEWS_FIRST_MS or barEnd > NEWS_LAST_MS
                 ? SC_NEWS_UNKNOWN : SC_NEWS_OK
    st

// A KNOWN blackout is knowledge and blocks the fill. UNKNOWN is a missing
// input, not a refusal — it never blocks, and it is counted instead.
sc_news = CTX_OK ? f_news(time, time_close) : SC_NEWS_UNKNOWN
sc_sessIdx = f_cohortIdx()

// ── diagnostics ──────────────────────────────────────────────────────────────
var int n_detected    = 0    // order blocks the chart derived
var int n_armed       = 0    // reached 25% penetration
var int n_invalidated = 0    // through the far edge, no fill possible
var int n_undecidable = 0    // M15 cannot order the minutes
var int n_blocked     = 0    // cohort or state said no at the fill bar
var int n_newsBlocked = 0    // a known blackout at the fill bar
var int n_orders      = 0    // orders actually placed
var int n_filled      = 0    // orders that became positions
var int n_expired     = 0    // armed, never revisited, abandoned
var int n_delayed     = 0    // the arm bar already reached the entry edge
var int n_omitted     = 0    // STRICT: declined because of that
var int n_emulator    = 0    // PRACTICAL: taken anyway, emulator-dependent
var int n_emuFilled   = 0    // ...and of those, how many actually filled
var int n_fillThenBroke = 0  // filled on a bar that also broke the far edge
var int n_newsUnknown = 0    // filled with news unevaluable
var int n_opposite    = 0    // production could hold both sides; TV cannot
var int n_emuExit     = 0    // stop AND target inside one bar: TV chose

// ── open trades, so their EXIT can be judged as well as their entry ──────────
//
// `strategy.exit` hands the stop and the target to the broker, and the broker
// reports which one paid — never whether the other was also reachable in the
// same bar. A bar containing both is decided by TradingView's documented
// four-price assumption (up bar: open, low, high, close) and by nothing that
// happened in the market. Those trades are counted, because a win produced that
// way is a coin the emulator flipped.
type ScTrade
    string id
    float  stop
    float  target
    bool   counted

var array<ScTrade> sc_open = array.new<ScTrade>()

// ── the tracked setup ────────────────────────────────────────────────────────
type ScOb
    float top
    float bottom
    float entry
    float arm
    float stop
    bool  isLong
    bool  isChoch
    int   armedBar
    bool  armBarStraddled
    bool  working        // an order is live
    bool  oppCounted     // its clash with an open opposite position is counted
    bool  emuDependent   // its fill time is the emulator's, not production's
    float lastRr         // the RR the gates resolved on the bar it was placed
    string id
    int    bornBar

var array<ScOb> sc_all = array.new<ScOb>()
var int sc_seq = 0

// ── has this setup's order actually filled? ──────────────────────────────────
//
// IT MATTERS BECAUSE THE ORDER IS RE-PLACED EVERY BAR. `strategy.entry` with an
// id that is still PENDING replaces the pending order, which is the intent:
// the gates are re-read and a stale order cannot outlive the policy that
// allowed it. But an id that has already FILLED is not replaced — it opens a
// SECOND position, and with `pyramiding = 6` it does so silently, five more
// times. One order block would become six trades.
//
// So a filled setup stops being managed. Both trade lists are scanned: an entry
// that opened and closed inside a single bar never appears in `opentrades` at a
// bar boundary, so `opentrades` alone would miss exactly the fast trades.
f_isFilled(string eid) =>
    bool found = false
    if strategy.opentrades > 0
        for k = 0 to strategy.opentrades - 1
            if not found and strategy.opentrades.entry_id(k) == eid
                found := true
    if not found and strategy.closedtrades > 0
        // Newest first, and stop at the first miss going backwards is NOT safe
        // (ids close out of order), so this walks the recent tail in full.
        earliest = math.max(0, strategy.closedtrades - 40)
        for k = strategy.closedtrades - 1 to earliest
            if not found and strategy.closedtrades.entry_id(k) == eid
                found := true
    found

f_isOpen(string eid) =>
    bool found = false
    if strategy.opentrades > 0
        for k = 0 to strategy.opentrades - 1
            if not found and strategy.opentrades.entry_id(k) == eid
                found := true
    found

// The state name, as an if/else rather than a ternary. `array.get(…,
// s6_stateCode - 1)` inside a `?:` computes index -1 whenever the state is
// unresolved, and Pine does not reliably decline to evaluate the untaken
// branch. Line 1483 of the generated build already uses this shape; the panel
// now matches it rather than relying on the operator to be merciful.
f_stateName() =>
    string s = "(warming up)"
    if s6_stateCode > 0
        s := array.get(REGIME_STATE_NAME, s6_stateCode - 1)
    s

f_qty(float stopDist) =>
    // Risk-based: every trade risks i_riskPerTrade, so the cash commission
    // below deducts the same FRACTION OF R that production books.
    stopDist <= 0 ? 0.0 : i_riskPerTrade / (stopDist / syminfo.mintick *
         syminfo.pointvalue * syminfo.mintick)

// ── create on the bar the chart derives a block ──────────────────────────────
if CTX_OK and barstate.isconfirmed and s5_created_count > 0
     and (s5_last_side == 1 or s5_last_side == 2)
    isLong = s5_last_side == 1
    depth = s5_last_top - s5_last_bottom
    entry = isLong ? s5_last_top : s5_last_bottom
    arm = isLong ? s5_last_top - depth * (TGT_TRIGGER_PCT / 100.0)
                 : s5_last_bottom + depth * (TGT_TRIGGER_PCT / 100.0)
    sc_seq += 1
    n_detected += 1
    array.push(sc_all, ScOb.new(
         top = s5_last_top, bottom = s5_last_bottom, entry = entry, arm = arm,
         stop = isLong ? s5_last_bottom - TGT_STOP_BUFFER
                       : s5_last_top + TGT_STOP_BUFFER,
         isLong = isLong, isChoch = s5_last_tag == 2, armedBar = na,
         armBarStraddled = false, working = false, oppCounted = false,
         emuDependent = false, lastRr = na,
         id = "OB" + str.tostring(sc_seq), bornBar = bar_index))
    if array.size(sc_all) > 60
        ScOb gone = array.shift(sc_all)
        if gone.working
            strategy.cancel(gone.id)

// ── the per-bar pass ─────────────────────────────────────────────────────────
if CTX_OK and barstate.isconfirmed and array.size(sc_all) > 0
    for i = array.size(sc_all) - 1 to 0
        ScOb o = array.get(sc_all, i)
        // Computed BEFORE step 0 because step 0 needs `through`: a fill whose
        // own bar also broke the far edge is the one this chart cannot justify.
        armed = not na(o.armedBar)
        hitArm = o.isLong ? low <= o.arm : high >= o.arm
        through = o.isLong ? low < o.bottom : high > o.top
        straddle = low <= o.entry and high >= o.entry

        // ── 0. ALREADY FILLED? Then stop managing it. ────────────────────────
        // Before anything else, because every branch below either re-places or
        // cancels an order, and both are wrong once the order has become a
        // position: re-placing opens a second one, cancelling does nothing and
        // then the next bar re-places anyway.
        if o.working and f_isFilled(o.id)
            n_filled += 1
            // A TRADE, not just a setup. The setup counter says how many
            // setups PRACTICAL was willing to take on the emulator's word;
            // this says how many of them actually became a line in the
            // Strategy Tester, which is the number a reader would otherwise
            // assume was production's.
            if o.emuDependent
                n_emuFilled += 1
            array.push(sc_open, ScTrade.new(id = o.id, stop = o.stop,
                 target = o.isLong
                      ? o.entry + math.abs(o.entry - o.stop) * o.lastRr
                      : o.entry - math.abs(o.entry - o.stop) * o.lastRr,
                 counted = false))
            // THE UNPROVABLE FILL. This bar both delivered the entry and broke
            // the far edge. Production, on 1-minute candles, may well have seen
            // the break first and cancelled — that is exactly what it did to the
            // one divergent trade in the validation window. The order was the
            // broker's to match, so this is counted, never suppressed.
            if through
                n_fillThenBroke += 1
            array.remove(sc_all, i)
            continue

        // ── 1. ARM ───────────────────────────────────────────────────────────
        if not armed and bar_index > o.bornBar and hitArm and not through
            o.armedBar := bar_index
            o.armBarStraddled := straddle
            n_armed += 1
            armed := true
            // THE DELAY.
            //
            // The arm happened at some minute m of THIS bar. The earliest legal
            // fill is m + TGT_DELAY_CANDLES MINUTES. If m is early in the bar
            // that instant is still inside it; if m is late it is in the next.
            // M15 does not carry m, so the question is unanswerable here.
            //
            // IT IS ALSO MOOT, and that is worth stating plainly rather than
            // dressing a limitation up as a mode. A historical bar is evaluated
            // ONCE, at its close: by the time this code can see the arm, the arm
            // bar is over. An order placed now becomes active on the NEXT bar in
            // both modes. There is no setting that buys back the inside of a bar
            // that has already closed.
            //
            // So the delay is never violated — the wait is 15 minutes where
            // production waited 3. What IS lost is the arm bar itself, and that
            // is where the two modes part company.
            //
            // If the arm bar ALSO touched the entry edge, production may well
            // have filled inside it: measured on the recording, 28 of 46 fills
            // (61%) landed in the same 15-minute bar as their arm. This build
            // cannot. The order it would place instead waits for some LATER bar
            // to revisit the edge — same price, different hour, therefore a
            // different session, a different market state and possibly a
            // different cell of the matrix. That is not production's trade
            // arriving late; it is a different trade wearing its name.
            //
            //   STRICT declines it. The lifecycle cannot be established without
            //     guessing which minute came first, so no order is placed and
            //     the setup is counted as omitted.
            //   PRACTICAL takes it, because the price IS the block edge and the
            //     equity curve is the point, and counts it as emulator-
            //     dependent so the headline can never be read as parity.
            //
            // If the arm bar did NOT reach the entry, production could not have
            // filled inside it either, and the fill lies in a later bar for both
            // of them. Those setups are not affected by any of this.
            if o.armBarStraddled
                n_delayed += 1
                if f_strict()
                    n_omitted += 1
                else
                    n_emulator += 1
                    o.emuDependent := true

        // ── 2. INVALIDATION ──────────────────────────────────────────────────
        // Price through the far edge with no fill possible in this bar is
        // production's INVALIDATED_BEFORE_EDGE_ENTRY, and it is provable.
        if through and not straddle
            if o.working
                strategy.cancel(o.id)
            n_invalidated += 1
            array.remove(sc_all, i)
            continue

        // ── 3. THE UNPROVABLE BAR ────────────────────────────────────────────
        // A bar whose range BOTH contains the entry and breaches the far edge
        // holds production's fill and production's invalidation at once, and
        // OHLC cannot order the minutes between them.
        //
        // NEITHER MODE CAN DECLINE THIS ONCE AN ORDER IS WORKING, and saying so
        // is more useful than a mode name that implies otherwise. TradingView
        // matches orders against the bar BEFORE the script is evaluated at that
        // bar's close, so by the time this line runs the fill has either
        // happened or not — step 0 above has already removed it if it did.
        // Reaching here with a working order means the order survived the bar;
        // the block is broken either way, so it is withdrawn.
        //
        // What both modes CAN do is refuse to start. A setup that reaches its
        // unprovable bar before ever arming produces no order at all.
        if through and straddle
            n_undecidable += 1
            if o.working
                strategy.cancel(o.id)
            array.remove(sc_all, i)
            continue

        // STRICT's one refusal. It happens HERE rather than in the arm branch
        // so that the arm itself is still counted: the setup did arm, and
        // saying "never armed" would understate what production had.
        if f_strict() and o.armBarStraddled
            if o.working
                strategy.cancel(o.id)
            array.remove(sc_all, i)
            continue

        // ── 4. THE GATES, read at THIS bar ───────────────────────────────────
        [rr, cellOk] = f_cell(sc_sessIdx, o.isChoch, o.isLong)
        newsOk = sc_news != SC_NEWS_BLOCKED
        eligible = cellOk and newsOk and not na(rr)

        // ── 5. THE ORDER ─────────────────────────────────────────────────────
        // Placed once armed. `process_orders_on_close` is FALSE, so an order
        // submitted during this bar's close is active from the NEXT bar — the
        // 3-minute delay is satisfied with 12 minutes to spare, never violated.
        inWindow = not i_useWindow or (time >= i_windowFrom and time < i_windowTo)
        canFill = armed and inWindow
        expired = armed and bar_index - o.armedBar > i_maxWaitBars

        if expired
            if o.working
                strategy.cancel(o.id)
            n_expired += 1
            array.remove(sc_all, i)
            continue

        if canFill and eligible
            stopDist = math.abs(o.entry - o.stop)
            target = o.isLong ? o.entry + stopDist * rr : o.entry - stopDist * rr
            // ── WHICH ORDER TYPE ─────────────────────────────────────────────
            //
            // Production's fill test is `low <= entry <= high`: a TOUCH, and it
            // does not care which side price came from. TradingView has no touch
            // order. A buy LIMIT is only valid below the market and a buy STOP
            // only above it, so a single fixed type is right only half the time
            // — and wrong in a specific, expensive way: submit a buy limit while
            // the market is already below it and the emulator fills at the NEXT
            // BAR'S OPEN, not at the edge.
            //
            // Measured on the recording, at the moment this code would place
            // the order, 60 of 89 resolvable setups had the market on the STOP
            // side. A plain limit would have filled those a median of 0.44R from
            // the block edge, 1.86R at the 90th percentile and 4.46R at worst —
            // the same class of defect as entering at the next bar's open, which
            // was rejected for exactly this reason.
            //
            // So the side is chosen per bar from where price actually is. Both
            // forms fill AT the entry price; only their validity differs.
            useStop = o.isLong ? close < o.entry : close > o.entry
            // Re-placed every bar so the gates above are re-read every bar. A
            // working order can therefore never outlive the policy that allowed
            // it — which is what "resolve at the fill" means at bar resolution.
            strategy.entry(o.id, o.isLong ? strategy.long : strategy.short,
                 qty = f_qty(stopDist),
                 limit = useStop ? na : o.entry,
                 stop  = useStop ? o.entry : na)
            strategy.exit("x" + o.id, o.id, stop = o.stop, limit = target)
            o.lastRr := rr
            if not o.working
                n_orders += 1
                if sc_news == SC_NEWS_UNKNOWN
                    n_newsUnknown += 1
            o.working := true
        else if o.working
            // The policy moved against it. Pull the order rather than let it
            // fill on a rule that no longer holds.
            strategy.cancel(o.id)
            o.working := false
            if not cellOk
                n_blocked += 1
            if not newsOk
                n_newsBlocked += 1

// ── were the stop and the target both reachable in one bar? ─────────────────
if array.size(sc_open) > 0
    for i = array.size(sc_open) - 1 to 0
        ScTrade t = array.get(sc_open, i)
        if not t.counted and not na(t.target)
             and low <= t.stop and high >= t.stop
             and low <= t.target and high >= t.target
            t.counted := true
            n_emuExit += 1
        // Removed when it stops being OPEN. `f_isFilled` is the wrong test
        // here — it also matches closed trades, so it would never let go.
        if not f_isOpen(t.id)
            array.remove(sc_open, i)

// TradingView holds ONE NET POSITION. Production may hold a long and a short at
// the same time (measured: one such overlapping pair in the recorded history),
// and an opposite entry here REVERSES the position instead of coexisting with
// it. That is a structural limitation of the platform, not of this script, and
// the only honest response is to count it where it bites.
//
// Counted ONCE PER SETUP, not once per bar: a per-bar counter would report an
// order that sat opposite an open position for forty bars as forty
// incompatibilities, which reads as a catastrophe and is one.
if strategy.position_size != 0 and array.size(sc_all) > 0
    for i = 0 to array.size(sc_all) - 1
        ScOb o = array.get(sc_all, i)
        if o.working and not o.oppCounted
             and ((strategy.position_size > 0 and not o.isLong)
             or (strategy.position_size < 0 and o.isLong))
            o.oppCounted := true
            n_opposite += 1

plotshape(i_showMarkers and strategy.position_size != 0
     and strategy.position_size[1] == 0, "entry", shape.triangleup,
     location.belowbar, color.new(#2E86DE, 20), size = size.tiny)

// ── the diagnostics panel ────────────────────────────────────────────────────
//
// The Strategy Tester gives trades, win rate, PF and drawdown. It cannot give
// what was NOT traded and why, and on this script that is half the story: a
// setup skipped as unprovable is a deliberate result, not a gap.
// FOUR COLUMNS, not two. A 24-row panel is taller than a chart pane with the
// Strategy Tester open, and TradingView clips a table rather than scrolling it
// — the reported symptom was three visible rows and the rest below the edge.
// Two label/value pairs per row halves the height without dropping a counter.
var table sc_panel = table.new(f_panelPos(), 4, 13, border_width = 1,
     border_color = color.new(color.gray, 40))

// `c` is the LEFT column of the pair: 0 for the full-history half, 2 for the
// order-window half.
f_scCell(int r, int c, string k, string v, color col) =>
    table.cell(sc_panel, c, r, k, text_size = size.tiny,
         text_halign = text.align_left, text_color = color.silver,
         bgcolor = BG_HUD)
    table.cell(sc_panel, c + 1, r, v, text_size = size.tiny,
         text_halign = text.align_left, text_color = col, bgcolor = BG_HUD)

if barstate.islast and i_showPanel
    // FIXED LAYOUT. Every row index below is a literal, so the highest row this
    // block can reach is readable rather than inferred — by a person and by
    // `lint_pine`'s overflow check. A row rendered only in one mode would shift
    // every index beneath it and make that impossible, which is why the metrics
    // banner is drawn in BOTH modes and only its wording and colour change.

    // ── row 0 — what this is ─────────────────────────────────────────────
    table.cell(sc_panel, 0, 0, "TVO STRATEGY", text_size = size.tiny,
         text_color = color.white, bgcolor = BG_HEAD)
    table.cell(sc_panel, 1, 0, f_strict() ? "STRICT / PROVABLE"
         : "PRACTICAL / TV EMULATOR", text_size = size.tiny,
         text_color = color.white, bgcolor = f_strict() ? BG_HEAD : BG_STAT)
    table.cell(sc_panel, 2, 0, "PURPOSE", text_size = size.tiny,
         text_color = color.white, bgcolor = BG_HEAD)
    table.cell(sc_panel, 3, 0, f_strict()
         ? "diagnostic — what M15 can prove"
         : "backtest — equity, PF, drawdown", text_size = size.tiny,
         text_color = color.white, bgcolor = BG_HEAD)

    // ── row 1 — the caveat, on the same surface as the numbers ───────────
    table.cell(sc_panel, 0, 1, "METRICS", text_size = size.tiny,
         text_color = color.white,
         bgcolor = f_strict() ? BG_HEAD : BG_WARN)
    table.cell(sc_panel, 1, 1, f_strict() ? "PROVABLE SUBSET ONLY"
         : "APPROXIMATE · TV EMULATOR", text_size = size.tiny,
         text_color = color.white,
         bgcolor = f_strict() ? BG_HEAD : BG_WARN)
    table.cell(sc_panel, 2, 1, "M1", text_size = size.tiny,
         text_color = color.white, bgcolor = BG_STAT)
    table.cell(sc_panel, 3, 1, "production executes on 1m; this is 15m",
         text_size = size.tiny, text_color = color.white, bgcolor = BG_STAT)

    // ── row 2 — THE TWO POPULATIONS, and they are not the same one ───────
    //
    // Everything on the LEFT is counted over every bar TradingView has loaded:
    // detection, arming and invalidation all run upstream of the order branch
    // and no window gates them. Everything on the RIGHT is counted only inside
    // the configured window, gated by `canFill` or by a setup already having a
    // working order. Running the two together in one list is how `detected`
    // came to read 137 beside an `orders placed` of 12 with nothing saying why.
    table.cell(sc_panel, 0, 2, "FULL HISTORY", text_size = size.tiny,
         text_color = color.white, bgcolor = BG_HEAD)
    table.cell(sc_panel, 1, 2, str.tostring(bar_index + 1) + " bars loaded",
         text_size = size.tiny, text_color = color.silver, bgcolor = BG_HEAD)
    table.cell(sc_panel, 2, 2, "ORDER WINDOW", text_size = size.tiny,
         text_color = color.white, bgcolor = BG_HEAD)
    table.cell(sc_panel, 3, 2, i_useWindow
         ? str.format_time(i_windowFrom, "yyyy-MM-dd", "UTC") + " .. " +
           str.format_time(i_windowTo, "yyyy-MM-dd", "UTC")
         : "full chart history", text_size = size.tiny,
         text_color = i_useWindow ? color.new(#00BCD4, 0) : color.silver,
         bgcolor = BG_HEAD)

    // ── rows 3-12 — left: FULL HISTORY ───────────────────────────────────
    f_scCell(3, 0, "detected", str.tostring(n_detected), color.white)
    f_scCell(4, 0, "armed", str.tostring(n_armed), color.white)
    f_scCell(5, 0, "invalidated", str.tostring(n_invalidated),
         color.new(#9B59B6, 0))
    f_scCell(6, 0, "undecidable", str.tostring(n_undecidable) + "  (no order)",
         n_undecidable > 0 ? color.new(#00BCD4, 0) : color.silver)
    f_scCell(7, 0, "expired unfilled", str.tostring(n_expired), color.silver)
    f_scCell(8, 0, "delayed_because_M15", str.tostring(n_delayed),
         n_delayed > 0 ? color.new(#00BCD4, 0) : color.silver)
    f_scCell(9, 0, "omitted_because_unprovable", str.tostring(n_omitted),
         n_omitted > 0 ? color.orange : color.silver)
    f_scCell(10, 0, "session", sessLabel + "  " +
         str.tostring(londonHour, "00") + ":00 London", color.silver)
    f_scCell(11, 0, "state", f_stateName(), color.silver)
    f_scCell(12, 0, "parity claimed", "none, in either mode", color.silver)

    // ── rows 3-12 — right: ORDER WINDOW ──────────────────────────────────
    f_scCell(3, 2, "orders placed", str.tostring(n_orders), color.lime)
    f_scCell(4, 2, "orders filled", str.tostring(n_filled), color.lime)
    f_scCell(5, 2, "closed trades", str.tostring(strategy.closedtrades),
         color.lime)
    f_scCell(6, 2, "cohort blocked", str.tostring(n_blocked), color.orange)
    f_scCell(7, 2, "news blocked", str.tostring(n_newsBlocked), color.orange)
    f_scCell(8, 2, "news_unknown", str.tostring(n_newsUnknown) + " fills",
         n_newsUnknown > 0 ? color.orange : color.silver)
    f_scCell(9, 2, "emulator_dependent", str.tostring(n_emuFilled) + " of " +
         str.tostring(n_filled) + " fills",
         n_emuFilled > 0 ? color.new(#00BCD4, 0) : color.silver)
    f_scCell(10, 2, "fill_bar_also_broke_block", str.tostring(n_fillThenBroke),
         n_fillThenBroke > 0 ? color.orange : color.silver)
    f_scCell(11, 2, "emulator_ordered_exit", str.tostring(n_emuExit),
         n_emuExit > 0 ? color.orange : color.silver)
    f_scCell(12, 2, "opposite_direction_overlap", str.tostring(n_opposite),
         n_opposite > 0 ? color.orange : color.silver)
