# Backend environment (FastAPI) — copy to `.env` to override defaults.
#
# Both values are OPTIONAL. With MONGO_URL empty (the default), the backend
# runs in fixture mode: it serves backend/fixtures/world.v1.json and never
# touches a database. Set MONGO_URL to a running MongoDB instance to enable
# optional Mongo mode.
MONGO_URL=
DB_NAME=controltower

# Optional: comma-separated list of allowed CORS origins (defaults to "*").
# CORS_ORIGINS=http://localhost:3000

# L2-A Operational Transition Log projector. DEFAULT: DISABLED. Set to a truthy
# value (1/true/yes/on) to start the autonomous operational-event projector,
# which reads the canonical operational files (the node's cycles.jsonl via
# LIVE_STATE_DIR) and writes ONLY BotEvent narration plus its own checkpoint
# (backend/ops_journal_checkpoint.json). It owns no operational truth.
# OPS_JOURNAL_ENABLED=1

# L3-A Notifier policy engine. DEFAULT: DISABLED. Set to a truthy value
# (1/true/yes/on) to start the headless notifier, which reads the frozen L1A
# operational-status model (via LIVE_STATE_DIR) and records notification
# DECISIONS (initial/reminder/resolved) into its own durable state + outbox
# files (backend/ops_notifier_state.json, backend/ops_notifier_outbox.json).
# It owns no operational health.
# OPS_NOTIFIER_ENABLED=1
#
# L3-B webhook delivery (env-only, single destination). When the notifier is
# enabled AND this is set to an http(s) URL, due notifications are POSTed to it
# (JSON envelope + Idempotency-Key: <notification_id>), with bounded retry and
# dead-lettering. Absent/blank -> notifications remain pending (no attempt,
# never lost). Restart to change. The URL/secret is never logged.
# OPS_NOTIFIER_WEBHOOK_URL=https://hooks.example.com/ct-ops
