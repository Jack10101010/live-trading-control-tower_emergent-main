# Backend environment (FastAPI) — copy to `.env` to override defaults.
#
# Both values are OPTIONAL. With MONGO_URL empty (the default), the backend
# runs in fixture mode: it serves backend/fixtures/world.v1.json and never
# touches a database. Set MONGO_URL to a running MongoDB instance to enable
# optional Mongo mode.
MONGO_URL=
DB_NAME=controltower

# Optional: comma-separated list of allowed CORS origins (defaults to "*").
# CORS_ORIGINS=http://localhost:3000
