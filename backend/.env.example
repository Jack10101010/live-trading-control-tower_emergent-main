# Backend environment (FastAPI) — copy to `.env` to override defaults.
#
# Both values are OPTIONAL. With MONGO_URL empty (the default), the backend
# runs in fixture mode: it serves backend/fixtures/world.v1.json and never
# touches a database. Set MONGO_URL to a running MongoDB instance to enable
# optional Mongo mode.
MONGO_URL=
DB_NAME=controltower

# ── UI-10 BROWSER ORIGIN POLICY (CORS) ───────────────────────────────────────
# CORS restricts BROWSERS only. It is NOT authentication and does NOT protect the
# API from curl, scripts or any non-browser client — a request with no Origin
# header is unaffected by these settings. Exposing this API beyond loopback still
# requires authenticated, encrypted transport (see SECURITY-BASELINE.md).
#
# DEFAULT (both unset): local-only. Exactly these three browser origins are
# trusted, matching the Vite dev/preview port in frontend/package.json:
#     http://localhost:3000
#     http://127.0.0.1:3000
#     http://[::1]:3000
# In the normal local workflow CORS is not even exercised — Vite proxies /api to
# the backend server-side, so requests are same-origin.
#
# CORS_ORIGINS: comma-separated list of EXACT origins, `scheme://host[:port]`.
# No path, no query, no fragment, no credentials, no glob and no regex. Wildcard
# is UNSUPPORTED: `*` is rejected as invalid, which is why a credentialed wildcard
# cannot be configured at all. localhost, 127.0.0.1 and ::1 are distinct origins
# and are not interchangeable; trusting one port does not trust another.
# If every entry is invalid the safe local-only default stays in force and the
# security panel reports `invalid_fallback` — access is never broadened.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#
# CORS_ALLOW_CREDENTIALS: DEFAULT false, and the frontend needs it false — it uses
# no cookies, no sessions and no Authorization header. Only enable it alongside an
# explicit CORS_ORIGINS list, and only when a future slice actually introduces
# browser credentials. An unrecognised value is reported as an issue and leaves
# credentials DISABLED rather than silently enabling them.
# CORS_ALLOW_CREDENTIALS=false
#
# BIND HOST: uvicorn defaults to 127.0.0.1, so the API is loopback-only unless an
# operator passes --host explicitly. UI-10 preserves that default and adds no
# remote bind option.

# ── UI-11 REQUEST AUTHENTICATION (local contract) ────────────────────────────
# DISABLED BY DEFAULT. While CONTROL_TOWER_AUTH_ENABLED is unset, every route
# behaves exactly as before and no credential is required — the local dry-run
# workflow is untouched.
#
# When explicitly enabled, every route EXCEPT /api/health requires:
#     Authorization: Bearer <token>
# That includes /api/, /api/live/*, /api/security/*, /api/events*, every command
# and mutation route, /docs, /redoc and /openapi.json. Route classification is
# deny-by-default: a route added later is protected automatically.
#
# AUTHENTICATION IS NOT ENCRYPTION. A bearer token sent over plaintext HTTP is
# readable by anything on the network path, so this protects a LOCAL boundary only.
# Remote access remains FORBIDDEN until TLS and the rest of the UI-9 prerequisites
# are in place — enabling this variable does not authorise remote exposure.
#
# It is also not CORS: CORS restricts browsers, this restricts every client
# including curl. Neither substitutes for the other.
#
# FAIL-CLOSED: enabling authentication with a missing, blank or too-short token
# makes protected routes return 503 authentication_misconfigured. Authentication is
# never silently switched back off once explicitly enabled. /api/health stays
# reachable so the fault can be diagnosed.
#
# CONTROL_TOWER_AUTH_ENABLED: only an explicit 1/true/yes/on enables it. An
# unrecognised value leaves it DISABLED and is reported as a configuration issue.
# CONTROL_TOWER_AUTH_ENABLED=false
#
# CONTROL_TOWER_API_TOKEN: the shared bearer token. Minimum length 32 characters;
# no whitespace (it cannot survive the header). Blank means ABSENT. Generate one
# yourself with a random-string tool — this repository never generates, stores or
# rotates tokens, and no example value is provided so nothing here can be mistaken
# for a working credential. The value is never logged, never returned by
# diagnostics and never sent to the frontend.
# CONTROL_TOWER_API_TOKEN=

# L2-A Operational Transition Log projector. DEFAULT: DISABLED. Set to a truthy
# value (1/true/yes/on) to start the autonomous operational-event projector,
# which reads the canonical operational files (the node's cycles.jsonl via
# LIVE_STATE_DIR) and writes ONLY BotEvent narration plus its own checkpoint
# (backend/ops_journal_checkpoint.json). It owns no operational truth.
# OPS_JOURNAL_ENABLED=1

# L3-A Notifier policy engine. DEFAULT: DISABLED. Set to a truthy value
# (1/true/yes/on) to start the headless notifier, which reads the frozen L1A
# operational-status model (via LIVE_STATE_DIR) and records notification
# DECISIONS (initial/reminder/resolved) into its own durable state + outbox
# files (backend/ops_notifier_state.json, backend/ops_notifier_outbox.json).
# It owns no operational health.
# OPS_NOTIFIER_ENABLED=1
#
# L3-B webhook delivery (env-only, single destination). When the notifier is
# enabled AND this is set to an http(s) URL, due notifications are POSTed to it
# (JSON envelope + Idempotency-Key: <notification_id>), with bounded retry and
# dead-lettering. Absent/blank -> notifications remain pending (no attempt,
# never lost). Restart to change. The URL/secret is never logged.
# OPS_NOTIFIER_WEBHOOK_URL=https://hooks.example.com/ct-ops

# ─────────────────────────────────────────────────────────────────────────────
# UI-9 SECURITY BASELINE — PREPARATION ONLY. NOT ACTIVE.
#
# Every variable below is DECLARED, not used. There is no transport, no
# authentication, no TLS and no tunnel in this build, and setting any of these
# cannot create one: `security_config.is_active()` is hard-wired False, and
# enabling connectivity is a later slice that must add an adapter (UI-11).
#
# All are intentionally BLANK. A blank value means ABSENT, never "empty but set".
# Do not commit real values: `.env` is gitignored, only this example is tracked.
# Never place credentials in a URL — validation rejects `scheme://user:pass@host`.
# ─────────────────────────────────────────────────────────────────────────────

# Control Tower operating mode. Only "observe" is supported today.
# CONTROL_TOWER_MODE=observe

# Where a future adapter WOULD reach the execution node. Nothing contacts it now.
# Must be https for any non-local host; plaintext http is accepted only for
# localhost, and only with ALLOW_INSECURE_LOCALHOST=1.
# NODE_ENDPOINT=

# Which transport a future slice would select: none | https | mtls.
# None of these is implemented.
# NODE_TRANSPORT=none

# TLS posture. Contradicting the endpoint scheme is reported as an error.
# NODE_TLS_ENABLED=

# TLS material. PATHS ONLY — file contents never enter the process here, are
# never logged, and are never returned by any API. Keep the files outside the
# repository; *.pem, *.key and credentials.json are gitignored.
# NODE_CERT_PATH=
# NODE_CA_PATH=

# Client identity for mutual TLS. BOTH are required together; one alone is an
# error, because half a client identity cannot authenticate.
# NODE_CLIENT_CERT=
# NODE_CLIENT_KEY=

# Bearer token for a future authenticated transport. SECRET: only its PRESENCE is
# ever recorded — the value is dropped on load and never stored, logged or
# returned. Never commit a real token.
# NODE_API_TOKEN=

# Timeouts in seconds (0.1 – 300). Validated if supplied; no client uses them yet.
# NODE_CONNECT_TIMEOUT=5
# NODE_READ_TIMEOUT=15

# Local development escape hatch ONLY: permits plaintext http to localhost.
# Setting this always emits a warning and must never be set in production.
# ALLOW_INSECURE_LOCALHOST=
