# Frontend environment (Vite) — copy to `.env` to override defaults.
#
# Optional. When UNSET, `npm run dev` serves the app on http://localhost:3000
# and Vite proxies all `/api/*` requests to the local backend on port 8000
# (see vite.config.ts). No configuration is required for local development.
#
# Set this only if you want the browser to call the backend directly (a
# different host/port) instead of using the dev proxy.
REACT_APP_BACKEND_URL=http://localhost:8000
