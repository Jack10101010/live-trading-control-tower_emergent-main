# Frontend environment (Vite) — copy to `.env` to override defaults.
#
# Optional. When UNSET, `npm run dev` serves the app on http://localhost:3000
# and Vite proxies all `/api/*` requests to the local backend on port 8000
# (see vite.config.ts). No configuration is required for local development.
#
# Set this only if you want the browser to call the backend directly (a
# different host/port) instead of using the dev proxy.
#
# UI-10: setting this makes requests CROSS-ORIGIN, so the backend's CORS policy
# starts applying. The backend trusts http://localhost:3000, http://127.0.0.1:3000
# and http://[::1]:3000 by default — whichever of those the browser address bar
# actually shows must be in that list, or the browser will block the responses.
# Serve the frontend from a different port and you must add that exact origin to
# the backend's CORS_ORIGINS (see backend/.env.example). Leaving this unset avoids
# the whole question: the dev proxy keeps everything same-origin.
REACT_APP_BACKEND_URL=http://localhost:8000
